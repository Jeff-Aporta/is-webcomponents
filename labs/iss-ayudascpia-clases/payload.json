    "classes": [
      {
        "id": "catalogo",
        "name": "TCatalogoClientesISController<T>",
        "stereotype": "ispclientesisserver",
        "package": "pkg-stack",
        "methods": [
          "+ get() · insert() · update() · delete()",
          "+ lookUp(campos, pk)",
          "+ ctxUser: TContextUser"
        ]
      },
      {
        "id": "base",
        "name": "TBasePatyIA<T>",
        "stereotype": "abstract",
        "package": "pkg-base",
        "attributes": [
          "# itercero · icontacto · irol"
        ],
        "methods": [
          "+ verifyAuthorization(): Auth",
          "+ accionRecurso(accion): fila SEG",
          "+ upsert(pojo)",
          "+ deleteList() · updateList()"
        ]
      },
      {
        "id": "conv",
        "name": "TConversacionController",
        "package": "pkg-conv",
        "attributes": [
          "- nTbl = patyia_conversaciones"
        ],
        "methods": [
          "+ insert(): SSE",
          "+ get() · delete()",
          "+ getLogs() · getResumen()",
          "+ listConversaciones()",
          "+ auditConversaciones()",
          "+ probeMcpAsw()",
          "+ timerCerrarConversaciones()"
        ]
      },
      {
        "id": "log",
        "name": "TConversationLogController",
        "package": "pkg-conv",
        "attributes": [
          "- nTbl = patyia_conversacion_log"
        ],
        "methods": [
          "+ mensajes(iconversacion)",
          "+ contenido(iconversacion)",
          "+ purgarLogConversaciones()"
        ]
      },
      {
        "id": "tiq",
        "name": "TConversationTicketController",
        "package": "pkg-conv",
        "attributes": [
          "- nTbl = patyia_tiquetesconversacion"
        ],
        "methods": [
          "+ insert(): 201",
          "+ porConversacion(iconversacion)"
        ]
      },
      {
        "id": "msg",
        "name": "TQualifiedMessageController",
        "package": "pkg-conv",
        "attributes": [
          "- nTbl = patyia_mensajescalificados"
        ],
        "methods": [
          "+ insert()",
          "+ porConversacion(iconversacion)"
        ]
      },
      {
        "id": "mcp",
        "name": "TMcpSessionController",
        "package": "pkg-conv",
        "attributes": [
          "- nTbl = patyia_mcp_sesiones"
        ],
        "methods": [
          "+ GetCurrent(): sesión vigente",
          "+ UpdateOrInsert(sesión)"
        ]
      },
      {
        "id": "sys",
        "name": "TSysValueController",
        "package": "pkg-cfg",
        "attributes": [
          "- nTbl = patyia_sys_values"
        ],
        "methods": [
          "+ getConversacion() · putConversacion()",
          "+ getProveedor() · putProveedor()",
          "+ getRuntime() · putRuntime()",
          "+ docs()",
          "+ getOpenaiCfg() «static»"
        ]
      },
      {
        "id": "prov",
        "name": "TProviderController",
        "package": "pkg-cfg",
        "attributes": [
          "- nTbl = patyia_providers"
        ],
        "methods": [
          "+ getDetalle() · putDetalle()",
          "+ getCuenta(iproveedor)",
          "+ activo(iproveedor)"
        ]
      },
      {
        "id": "td",
        "name": "TTdConsultationController",
        "package": "pkg-cfg",
        "attributes": [
          "- nTbl = patyia_tdconsultas"
        ],
        "methods": [
          "+ list() · create() · upsert()",
          "+ instruccion(ntdconsulta)"
        ]
      },
      {
        "id": "ident",
        "name": "TIdentityController",
        "package": "pkg-ident",
        "methods": [
          "+ bootstrapJwt(): token",
          "+ portalLogin(): token | 409"
        ]
      },
      {
        "id": "perm",
        "name": "TPermissionsController",
        "package": "pkg-ident",
        "methods": [
          "+ me(): perfil SEG",
          "+ rolPrincipal(icontacto) «static»",
          "+ valorAccion(rol, accion) «static»"
        ]
      },
      {
        "id": "err",
        "name": "TErrorController",
        "package": "pkg-ops",
        "attributes": [
          "- nTbl = patyia_errores"
        ],
        "methods": [
          "+ insert() · registrar()",
          "+ list() · delete()",
          "+ purgarErroresAtendidos()"
        ]
      },
      {
        "id": "file",
        "name": "TFileStorageController",
        "package": "pkg-ops",
        "attributes": [
          "- nTbl = patyia_files_storage"
        ],
        "methods": [
          "+ upload(): 503"
        ]
      },
      {
        "id": "info",
        "name": "TInfoController",
        "package": "pkg-ops",
        "methods": [
          "+ info(): salud"
        ]
      },
      {
        "id": "cdn",
        "name": "TCdnController",
        "package": "pkg-ops",
