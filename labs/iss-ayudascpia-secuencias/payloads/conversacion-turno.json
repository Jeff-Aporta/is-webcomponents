        {
          "id": "f-post",
          "kind": "region",
          "name": "después de la respuesta",
          "messages": [
            "m16",
            "m17"
          ],
          "condition": "solo si la respuesta salió bien; un fallo aquí no rompe el turno"
        },
        {
          "id": "f-close",
          "kind": "region",
          "name": "cierre del turno",
          "messages": [
            "m18",
            "m19",
            "m20",
            "m21",
            "m22"
          ]
        }
      ],
      "preamble": [
        {
          "id": "m1",
          "from": "u",
          "to": "w",
