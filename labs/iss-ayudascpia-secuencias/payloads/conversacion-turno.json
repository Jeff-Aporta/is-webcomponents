          "group": "g-db"
        },
        {
          "id": "m7",
          "from": "c",
          "to": "w",
          "label": "evento begin",
          "kind": "async",
          "group": "g-sse"
        },
        {
          "id": "m8",
          "from": "w",
          "to": "u",
          "label": "abre el stream (200 text/event-stream) · begin",
          "kind": "reply",
          "group": "g-sse"
        },
        {
          "id": "m9",
          "from": "c",
          "to": "ai",
          "label": "transcribe las notas de voz (audio/transcriptions); si alguna no se entiende, aplica 9999.3",
          "kind": "sync",
          "group": "g-llm"
        },
        {
          "id": "m10",
          "from": "c",
          "to": "pg",
          "label": "clasifica la consulta (resolverContexto): instrucción de patyia_tdconsultas y vector stores",
          "kind": "sync",
          "group": "g-db"
        },
        {
          "id": "m11",
          "from": "c",
          "to": "ai",
          "label": "asegura el hilo de la conversación (Conversations API)",
          "kind": "sync",
          "group": "g-llm"
        },
        {
          "id": "m12",
          "from": "c",
          "to": "ai",
          "label": "Responses API en stream: instrucción, file_search sobre los vector stores, imágenes como input_image",
          "kind": "sync",
          "group": "g-llm"
        },
        {
          "id": "m13",
          "from": "ai",
          "to": "c",
          "label": "fragmentos de la respuesta (deltas)",
          "kind": "async",
          "group": "g-llm"
        },
        {
          "id": "m14",
          "from": "c",
          "to": "w",
          "label": "evento message por cada fragmento",
          "kind": "async",
          "group": "g-sse"
        },
        {
          "id": "m15",
          "from": "w",
          "to": "u",
          "label": "SSE message × N",
          "kind": "async",
          "group": "g-sse"
        },
        {
          "id": "m16",
          "from": "c",
          "to": "ai",
          "label": "regenera el título (9999.1) cada recalcularTituloCadaMensajesUsuario mensajes y extrae las consultas",
          "kind": "sync",
          "group": "g-llm"
        },
        {
          "id": "m17",
          "from": "c",
          "to": "pg",
          "label": "registra las consultas en patyia_consultas",
          "kind": "sync",
          "group": "g-db"
        },
        {
          "id": "m18",
          "from": "c",
          "to": "l",
          "label": "guarda el turno una sola vez: usuario, operativas y asistente (turno·1000+1 y +2)",
          "kind": "sync",
          "group": "g-ctl"
        },
        {
          "id": "m19",
          "from": "l",
          "to": "pg",
          "label": "escribe el historial bajo bloqueo y devuelve qmensajes",
          "kind": "sync",
          "group": "g-db"
        },
        {
          "id": "m20",
          "from": "c",
          "to": "pg",
          "label": "actualiza qmensajes, qtokens (+ uso de OpenAI), hilo y fhultact",
          "kind": "sync",
          "group": "g-db"
        },
        {
          "id": "m21",
          "from": "c",
          "to": "w",
          "label": "evento end (título, stream_ok, providerDegraded, imensaje, itdconsulta)",
          "kind": "async",
          "group": "g-sse"
        },
        {
          "id": "m22",
          "from": "w",
          "to": "u",
          "label": "SSE end · cierra el stream",
          "kind": "async",
          "group": "g-sse"
        }
      ],
      "boxes": [
        {
          "id": "iss",
          "name": "ISS PatyIA",
          "actors": [
            "w",
