          "id": "f-ctx",
          "kind": "region",
          "name": "contexto del turno",
          "messages": [
            "m9",
            "m10",
            "m11"
          ],
          "condition": "transcripción solo si hay notas de voz; hilo solo si aún no existe"
        },
        {
          "id": "f-stream",
          "kind": "async",
          "name": "respuesta en stream",
          "messages": [
            "m12",
            "m13",
            "m14",
            "m15"
          ],
