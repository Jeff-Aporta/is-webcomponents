          "kind": "sync",
          "group": "g-sse"
        },
        {
          "id": "m2",
          "from": "w",
          "to": "c",
          "label": "abre el turno con el emisor de eventos",
          "kind": "sync",
          "group": "g-ctl"
        },
        {
          "id": "m3",
          "from": "c",
          "to": "c",
          "label": "ya pasó la puerta SEG (JWT); valida el cuerpo, el contexto, que haya prompt o adjuntos y el modo libre",
          "kind": "self",
          "group": "g-ctl"
        }
      ],
      "alt": {
        "name": "según si la conversación existe",
        "branches": [
          {
            "condition": "continúa (iconversacion > 0)",
            "messages": [
              {
                "id": "m4",
                "from": "c",
                "to": "pg",
                "label": "comprueba que la conversación es suya y está abierta; actualiza la última actividad",
                "kind": "sync",
                "group": "g-db"
              }
            ]
          },
          {
            "condition": "nueva",
            "messages": [
              {
                "id": "m5",
                "from": "c",
                "to": "pg",
                "label": "crea la conversación (nuevo id de secuencia, título provisional, hilo, qmensajes = 1)",
                "kind": "sync",
                "group": "g-db"
              }
            ]
          }
        ]
      },
      "epilogue": [
        {
          "id": "m6",
          "from": "c",
          "to": "pg",
          "label": "lee el historial previo y la configuración: llave de patyia_providers, modelos de sys_values.OPENAI",
