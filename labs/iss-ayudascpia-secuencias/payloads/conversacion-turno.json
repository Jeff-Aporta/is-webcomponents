  },
  "payload": {
    "sequence": {
      "title": "ISS PatyIA · Turno de conversación (POST /conversacion, SSE)",
      "actors": [
        {
          "id": "u",
          "label": "Cliente",
          "kind": "actor",
          "icon": "mdi:account"
        },
        {
          "id": "w",
          "label": "abrirStreamSSE",
          "kind": "participant",
          "icon": "mdi:api"
        },
        {
          "id": "c",
          "label": "TConversacionController",
          "kind": "participant",
          "icon": "mdi:server"
        },
        {
          "id": "l",
          "label": "TConversationLogController",
          "kind": "participant",
          "icon": "mdi:text-box-multiple"
        },
        {
          "id": "pg",
          "label": "PostgreSQL",
          "kind": "participant",
          "icon": "mdi:database"
        },
        {
