        {
          "id": "f-timers",
          "kind": "region",
          "name": "los tres timers corren en paralelo, sin esperar al otro",
          "messages": [
            "m9",
            "m10",
            "m11"
          ],
          "condition": "registro `0 */30 * * * *` en src/functions/index.ts; un fallo queda en patyia_errores como TIMER:/<nombre>"
        }
      ],
      "messages": [
        {
          "id": "m1",
          "from": "h",
          "to": "a",
          "label": "el host arranca y dispara app.hook.appStart una vez; el trabajo de arranque corre en segundo plano, sin esperarlo",
          "kind": "sync",
          "group": "g-arranque"
        },
        {
          "id": "m2",
          "from": "a",
          "to": "p",
          "label": "pide aplicar los parches pendientes de patch/db/",
          "kind": "sync",
          "group": "g-patch"
        },
        {
          "id": "m3",
          "from": "p",
          "to": "pg",
          "label": "lee patyia_sys_values.patchdb para saber cuáles ya corrieron",
          "kind": "sync",
          "group": "g-patch"
        },
        {
          "id": "m4",
          "from": "pg",
          "to": "p",
          "label": "estado por archivo: aplicado · fallido · ausente",
          "kind": "reply",
          "group": "g-patch"
        },
        {
          "id": "m5",
          "from": "p",
          "to": "pg",
          "label": "ejecuta los ausentes en su propia transacción (orden de nombre) y registra el resultado",
          "kind": "sync",
          "group": "g-patch"
        },
        {
          "id": "m6",
          "from": "p",
          "to": "a",
          "label": "resumen: discovered / applied / failed / skipped-cooldown / skipped-done",
          "kind": "reply",
          "group": "g-patch"
        },
        {
          "id": "m7",
          "from": "a",
          "to": "tc",
          "label": "corre un barrido de cierre inmediato (por si los timers están apagados)",
          "kind": "sync",
          "group": "g-sweep"
        },
        {
          "id": "m8",
          "from": "tc",
          "to": "pg",
          "label": "cierra patyia_conversaciones con fhultact más vieja que timer_closeHours",
          "kind": "sync",
          "group": "g-sweep"
        },
        {
          "id": "m9",
          "from": "tc",
          "to": "pg",
          "label": "cierra por inactividad (itdestado = 1) y clasifica imodulo de hasta timer_batchImodulo cerradas",
          "kind": "sync",
          "group": "g-timers"
        },
        {
          "id": "m10",
          "from": "tl",
          "to": "pg",
          "label": "purgar log con fhultact más vieja que purga.dias o clean_convlog (21 días por defecto), si purga.habilitarEn lo permite (lotes de 200, 250 ms entre lotes)",
          "kind": "sync",
          "group": "g-timers"
        },
        {
          "id": "m11",
          "from": "te",
          "to": "pg",
          "label": "purgar errores atendidos de más de 90 días (lotes de 500, 20 lotes máx)",
          "kind": "sync",
          "group": "g-timers"
        }
      ],
      "alt": {
        "name": "si Azurite no está arriba en local",
        "branches": [
          {
            "condition": "runtime.jvalue.timers.<flag> = false",
            "messages": [
              {
                "id": "m12",
                "from": "h",
                "to": "a",
                "label": "el handler sale sin correr; el barrido inicial cubre el cierre",
                "kind": "self",
                "group": "g-timers"
              }
            ]
          },
          {
            "condition": "runtime.jvalue.timers.<flag> ausente o true (default)",
            "messages": [
              {
                "id": "m13",
                "from": "h",
                "to": "a",
                "label": "los timers toman lease en AzureWebJobsStorage; sin Azurite el host reintenta y llena el log",
                "kind": "self",
                "group": "g-timers"
              }
            ]
          }
        ]
      },
      "epilogue": [],
      "boxes": [
        {
          "id": "iss",
          "name": "ISS PatyIA",
          "actors": [
            "a",
            "p",
            "tc",
            "tl",
            "te"
