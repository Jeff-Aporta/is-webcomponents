          "icon": "mdi:api"
        },
        {
          "id": "b",
          "label": "TBasePatyIA",
          "kind": "participant",
          "icon": "mdi:server"
        },
        {
          "id": "pm",
          "label": "TPermissionsController",
          "kind": "participant",
          "icon": "mdi:shield-account"
        },
        {
          "id": "pg",
          "label": "PostgreSQL · seg_*",
          "kind": "participant",
          "icon": "mdi:database"
        }
      ],
      "groups": [
        {
          "id": "g-http",
          "name": "Petición y respuesta",
          "color": "stream",
          "icon": "mdi:swap-horizontal"
        },
        {
          "id": "g-jwt",
          "name": "Autenticación (JWT)",
          "color": "auth",
          "icon": "mdi:key-variant"
        },
        {
          "id": "g-seg",
          "name": "Autorización (SEG)",
          "color": "seg",
          "icon": "mdi:shield-check"
        },
        {
          "id": "g-db",
          "name": "Lectura en PostgreSQL",
          "color": "data",
          "icon": "mdi:database"
        }
      ],
      "fragments": [
        {
          "id": "f-anon",
          "kind": "region",
          "name": "evaluación como anónimo",
          "messages": [
            "m4",
            "m5",
            "m6"
          ],
          "condition": "fila de USR, que define por defecto todos los ids"
        },
        {
          "id": "f-rol",
          "kind": "region",
          "name": "rol vigente",
          "messages": [
            "m8",
            "m9",
            "m10"
          ],
          "condition": "seg_rolescontacto del grupo PATYIA, vigente, principal primero"
        },
        {
          "id": "f-accion",
          "kind": "region",
          "name": "valor efectivo",
          "messages": [
            "m11",
            "m12"
          ],
          "condition": "fila del rol; si no la tiene, la de USR"
        }
      ],
      "messages": [
        {
          "id": "m1",
          "from": "c",
          "to": "w",
          "label": "llega la petición, con o sin token (Authorization: Bearer)",
          "kind": "sync",
          "group": "g-http"
        },
        {
          "id": "m2",
          "from": "w",
          "to": "w",
          "label": "fija el id SEG por el prefijo: METHOD:/ruta · QUERY:/<ruta> (lista con filtro) · CFG:/<ruta> (configuración)",
          "kind": "self",
          "group": "g-seg"
        },
        {
          "id": "m3",
          "from": "w",
          "to": "b",
          "label": "autorizarRuta(), antes del handler",
          "kind": "sync",
          "group": "g-http"
        },
        {
          "id": "m4",
          "from": "b",
          "to": "pm",
          "label": "decide el id para un anónimo",
          "kind": "sync",
          "group": "g-seg"
        },
        {
          "id": "m5",
          "from": "pm",
          "to": "pg",
          "label": "lee la matriz seg_accionesxrol (caché de 90 s)",
          "kind": "sync",
          "group": "g-db"
        },
        {
          "id": "m6",
          "from": "pg",
          "to": "pm",
          "label": "sin fila en USR o { protected: false } → pública · cualquier otro valor → exige JWT",
          "kind": "reply",
          "group": "g-db"
        },
        {
          "id": "m7",
          "from": "b",
          "to": "b",
          "label": "si es pública, sigue sin token; si no, verifica el JWT (HS384) · sin token o inválido → 401",
          "kind": "self",
          "group": "g-jwt"
        },
        {
          "id": "m8",
          "from": "b",
          "to": "pm",
          "label": "pide el rol vigente del contacto",
          "kind": "sync",
          "group": "g-seg"
        },
        {
          "id": "m9",
          "from": "pm",
          "to": "pg",
          "label": "busca el rol en seg_rolescontacto",
          "kind": "sync",
          "group": "g-db"
        },
        {
          "id": "m10",
          "from": "pg",
          "to": "pm",
          "label": "rol del contacto · sin rol → USR · lectura fallida → 503",
          "kind": "reply",
          "group": "g-db"
        },
        {
          "id": "m11",
          "from": "b",
          "to": "pm",
          "label": "valor efectivo del id para el rol y el verbo",
          "kind": "sync",
          "group": "g-seg"
        },
        {
          "id": "m12",
          "from": "pm",
          "to": "b",
          "label": "el del rol o, si no lo define, el de USR (en CFG, partido por verbo)",
          "kind": "reply",
          "group": "g-seg"
        },
        {
          "id": "m13",
          "from": "b",
          "to": "b",
          "label": "false → 401 · { protected: true }, true o capacidad → pasa · SEG sin respuesta → 401",
          "kind": "self",
          "group": "g-seg"
        },
        {
          "id": "m14",
          "from": "b",
          "to": "c",
          "label": "corre el handler y responde",
          "kind": "reply",
          "group": "g-http"
        }
      ],
      "boxes": [
        {
          "id": "iss",
          "name": "ISS PatyIA",
          "actors": [
            "w",
            "b",
            "pm"
          ],
          "color": "primary"
        }
      ]
    }
  }
}
