{
  "slug": "seguridad-portal-login",
  "module": "010-General",
  "tag": "iswc-sequence-diagram",
  "script": "diagrams/sequence-diagram.min.js",
  "attrs": {
    "diagram-style": "insoft"
  },
  "payload": {
    "sequence": {
      "title": "ISS PatyIA · Login del portal (POST /auth/portal-login)",
      "actors": [
        {
          "id": "p",
          "label": "Portal / ISW",
          "kind": "actor",
          "icon": "mdi:monitor-dashboard"
        },
        {
          "id": "i",
          "label": "ISS · TIdentityController",
          "kind": "participant",
          "icon": "mdi:shield-key"
        },
        {
          "id": "d",
          "label": "DataSnap DSCLIENTES",
          "kind": "participant",
          "icon": "mdi:server-network"
        }
      ],
      "groups": [
        {
          "id": "g-http",
          "name": "Petición y respuesta",
          "color": "stream",
          "icon": "mdi:swap-horizontal"
        },
        {
          "id": "g-ds",
          "name": "Consulta a DataSnap",
          "color": "data",
          "icon": "mdi:server-network"
        },
        {
          "id": "g-jwt",
          "name": "Normalización y firma",
          "color": "auth",
          "icon": "mdi:key-variant"
        },
        {
          "id": "g-err",
          "name": "Salida de error",
          "color": "error",
          "icon": "mdi:alert-circle-outline"
        }
      ],
      "fragments": [
        {
          "id": "f-contacto",
          "kind": "region",
          "name": "contacto y empresas",
          "messages": [
            "m3",
            "m4",
            "m5",
            "m6"
          ],
          "condition": "se consulta DataSnap antes de validar credenciales"
        }
      ],
      "preamble": [
        {
          "id": "m1",
          "from": "p",
          "to": "i",
          "label": "inicia sesión con correo y contraseña (y empresa, si la eligió)",
          "kind": "sync",
          "group": "g-http"
        },
        {
          "id": "m2",
          "from": "i",
          "to": "i",
          "label": "normaliza el correo (sin @ → @contapyme.com) y cifra la contraseña (MD5)",
          "kind": "self",
          "group": "g-jwt"
        },
        {
          "id": "m3",
          "from": "i",
          "to": "d",
          "label": "¿existe el contacto y tiene acceso web?",
          "kind": "sync",
          "group": "g-ds"
        },
        {
          "id": "m4",
          "from": "d",
          "to": "i",
          "label": "existe · acceso web",
          "kind": "reply",
          "group": "g-ds"
        },
        {
          "id": "m5",
          "from": "i",
          "to": "d",
          "label": "¿a qué empresas pertenece el contacto?",
          "kind": "sync",
          "group": "g-ds"
        },
        {
          "id": "m6",
          "from": "d",
          "to": "i",
          "label": "empresas del contacto",
          "kind": "reply",
          "group": "g-ds"
        }
      ],
      "alt": {
        "name": "según las empresas del contacto",
        "branches": [
          {
            "condition": "varias empresas y sin itercero",
            "messages": [
              {
                "id": "m7",
                "from": "i",
                "to": "p",
                "label": "409 MULTI_EMPRESA · lista de empresas para que el portal pregunte y reintente",
                "kind": "reply",
                "group": "g-err"
              }
            ]
          },
          {
            "condition": "una empresa o itercero elegido",
            "messages": [
              {
                "id": "m8",
                "from": "i",
                "to": "d",
                "label": "valida las credenciales (LogInContacto)",
                "kind": "sync",
                "group": "g-ds"
              },
              {
                "id": "m9",
                "from": "d",
                "to": "i",
                "label": "llave de sesión e identidad (controlKey, empresa, contacto, nombres)",
                "kind": "reply",
                "group": "g-ds"
              },
              {
                "id": "m10",
                "from": "i",
                "to": "i",
                "label": "firma el token (HS384, 24 h)",
                "kind": "self",
                "group": "g-jwt"
              },
              {
                "id": "m11",
                "from": "i",
                "to": "p",
                "label": "entrega el token con usuario, nombre, vencimiento y claims",
                "kind": "reply",
                "group": "g-http"
              }
            ]
          }
        ]
      },
      "epilogue": []
    }
  }
}
