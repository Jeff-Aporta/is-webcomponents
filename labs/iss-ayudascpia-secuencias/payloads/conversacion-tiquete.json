{
  "slug": "conversacion-tiquete",
  "module": "020-Conversaciones",
  "tag": "iswc-sequence-diagram",
  "script": "diagrams/sequence-diagram.min.js",
  "attrs": {
    "diagram-style": "insoft"
  },
  "payload": {
    "sequence": {
      "title": "ISS PatyIA · Tiquete sobre una conversación (POST /tiquete)",
      "actors": [
        {
          "id": "u",
          "label": "Cliente",
          "kind": "actor",
          "icon": "mdi:account"
        },
        {
          "id": "t",
          "label": "TConversationTicketController",
          "kind": "participant",
          "icon": "mdi:ticket-confirmation"
        },
        {
          "id": "pg",
          "label": "PostgreSQL",
          "kind": "participant",
          "icon": "mdi:database"
        }
      ],
      "groups": [
        {
          "id": "g-http",
          "name": "Petición y respuesta",
          "color": "ticket",
          "icon": "mdi:swap-horizontal"
        },
        {
          "id": "g-ctl",
          "name": "Validación",
          "color": "neutral",
          "icon": "mdi:cog-outline"
        },
        {
          "id": "g-db",
          "name": "Persistencia en PostgreSQL",
          "color": "data",
          "icon": "mdi:database"
        },
        {
          "id": "g-err",
          "name": "Salida de error",
          "color": "error",
          "icon": "mdi:alert-circle-outline"
        }
      ],
      "fragments": [
        {
          "id": "f-alta",
          "kind": "region",
          "name": "alta del tiquete",
          "messages": [
            "m6",
            "m7"
          ],
          "condition": "solo el dueño puede cerrar la conversación"
        }
      ],
      "preamble": [
        {
          "id": "m1",
          "from": "u",
          "to": "t",
          "label": "crea un tiquete sobre la conversación (tema, clasificador, cerrar, autorizar visualización)",
          "kind": "sync",
          "group": "g-http"
        },
        {
          "id": "m2",
          "from": "t",
          "to": "t",
          "label": "ya pasó la puerta SEG (POST:/tiquete = { protected: true }, solo JWT); valida el cuerpo y recorta tema y clasificador a 30",
          "kind": "self",
          "group": "g-ctl"
        },
        {
          "id": "m3",
          "from": "t",
          "to": "pg",
          "label": "busca la conversación",
          "kind": "sync",
          "group": "g-db"
        }
      ],
      "alt": {
        "name": "según el estado de la conversación",
        "branches": [
          {
            "condition": "no existe",
            "messages": [
              {
                "id": "m4",
                "from": "t",
                "to": "u",
                "label": "404 · la conversación no existe (500 si no se pudo leer)",
                "kind": "reply",
                "group": "g-err"
              }
            ]
          },
          {
            "condition": "cerrada o eliminada",
            "messages": [
              {
                "id": "m5",
                "from": "t",
                "to": "u",
                "label": "400 · la conversación está cerrada o eliminada",
                "kind": "reply",
                "group": "g-err"
              }
            ]
          },
          {
            "condition": "abierta",
            "messages": [
              {
                "id": "m6",
                "from": "t",
                "to": "pg",
                "label": "crea el tiquete (nuevo id; si ya existe, no duplica)",
                "kind": "sync",
                "group": "g-db"
              },
              {
                "id": "m7",
                "from": "t",
                "to": "pg",
                "label": "si es el dueño: cierra la conversación y/o autoriza su visualización",
                "kind": "sync",
                "group": "g-db"
              },
              {
                "id": "m8",
                "from": "t",
                "to": "u",
                "label": "201 · tiquete creado con sus efectos",
                "kind": "reply",
                "group": "g-http"
              }
            ]
          }
        ]
      },
      "epilogue": []
    }
  }
}
