node_modules/
.DS_Store
Thumbs.db
*.log
.env
.env.*
.gitsecret/
.vscode/
.idea/
dist/**/*.map
.impeccable/

# Estado parcial de descarga de iconos (se regenera con scripts/download-icons.mjs)
assets/icons/.state/

# Tests locales: el repo commitea los .test.mjs pero ignora artefactos
# generados (snapshots, reports, node:test --test-reporter outputs).
tests/*.tmp
tests/coverage/
tests/.cache/

# Iconos descargados: commiteamos solo las dos colecciones mas usadas del repo
# (mdi y tabler). El resto se regenera bajo demanda con `node scripts/download-icons.mjs`.
assets/icons/*
!assets/icons/mdi/
!assets/icons/tabler/
!assets/icons/mdi.json
!assets/icons/tabler.json
!assets/icons/manifest.json
