node_modules/
.DS_Store
Thumbs.db
*.log
*.txt

# CSS generado a partir de SCSS. El .scss es la fuente; `deno task build:scss`
# regenera el .css hermano antes del build normal. Cualquier .css bajo `src/`
# (incluido `src/styles/` y `src/core/`) cae en esta regla — son artefactos
# del pipeline y no se versionan.
src/**/*.css

# Markdown: ignorar solo root y specs/ (WIPs, docs de equipo).
# IMPORTANTE: dist/ NO se ignora porque `dist/**/skills/**/*.md` se
# bundlea desde `skills/` y se sirve al público. Si ignoráramos
# `*.md` global, los PROMPT.md nunca llegarían al usuario final.
/*.md
/specs/**/*.md
*.tmp
!.gitkeep
!README.md
!CHANGELOG.md
.env
.env.*
src/utils/health/e2e/.artifacts/
src/utils/testing/e2e/.artifacts/
.gitsecret/
.vscode/
.idea/
dist/**/*.map
.impeccable/

dist/cdn/assets/icons/.state/

src/utils/health/**/*.tmp
src/utils/health/coverage/
src/utils/health/.cache/
src/utils/health/_author-index.json

.tmp/
.tmp-scss/
.iswc-render-tmp/


.superpowers/
.wrangler/

# Specs locales del superpowers (auto-generadas, decisión del proyecto).
# El plugin auditor tiene los templates canónicos en `specs/commons/auditoria/`
# y los replanta write-once; los duplicados locales se ignoran.
docs/superpowers/

# Bitácoras de plan/handoff de sesión: nunca versionar (se consolidan en specs/).
EXEC-PLAN-*.md
HANDOFF-*.md

# Worktrees scratch (admin-is-dsh strategy): carpeta local, nunca versionar.
WT/
/.workspaces/


# ── Peso del repo (2026-10-09): jsDelivr rechaza paquetes de más de 50 MB ──────────────
# Íconos: cada app lleva los suyos en assets/iconify/ (deno task icons); en ejecución, local o API.
# Del set completo solo viajan mdi y tabler (explorador y diagramas) y el catálogo.
dist/assets/icons/*/
!dist/assets/icons/mdi/
!dist/assets/icons/tabler/
# Solo viajan los SVG de mdi y tabler y el catalogo; las listas <set>.json salen de la API.
dist/assets/icons/*.json
!dist/assets/icons/index.json
!dist/assets/icons/collections.json
!dist/assets/icons/manifest.json
!dist/assets/icons/viewbox.snapshot.json
# Estado de `deno task icons:download` (cientos de MB): nunca se publica.
dist/assets/icons/.state/
# Capturas y salidas de pruebas/auditorías: artefactos locales.
**/.artifacts/
dist/assets/currstate/
.shots/
.tmp-scss-baseline/
.e2e-ux/
.tour/
scripts/_tmp/
/tmp-*
# Deno es el gestor del kit (deno.json/deno.lock); pnpm quedó de una etapa anterior.
pnpm-lock.yaml
pnpm-workspace.yaml
