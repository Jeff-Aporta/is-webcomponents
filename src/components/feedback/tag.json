{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-tag",
  "category": "feedback",
  "title": "&lt;iswc-tag&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-tag",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Etiqueta interactiva con variantes y botón de quitar opcional. Escala con <code class=\"code\">font-size</code> del contexto.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">\r\n            <iswc-tag>General</iswc-tag>\r\n            <iswc-tag color=\"brand\">InSoft</iswc-tag>\r\n            <iswc-tag color=\"neutral\">Neutral</iswc-tag>\r\n            <iswc-tag color=\"info\">Info</iswc-tag>\r\n            <iswc-tag color=\"success\">Success</iswc-tag>\r\n            <iswc-tag color=\"warning\">Warning</iswc-tag>\r\n            <iswc-tag color=\"danger\">Danger</iswc-tag>\r\n            <iswc-tag with-remove id=\"rmTag\">Removible</iswc-tag>\r\n          </div>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "success",
                "warning",
                "danger",
                "info"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:with-remove",
              "label": "with-remove"
            },
            {
              "control": "boolean",
              "prop": "attr:pill",
              "label": "pill"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Escala por contexto",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:.5rem;flex-wrap:wrap\">\r\n            <span style=\"font-size:.75rem\"><iswc-tag>0.75rem</iswc-tag></span>\r\n            <span style=\"font-size:1rem\"><iswc-tag>1rem</iswc-tag></span>\r\n            <span style=\"font-size:1.25rem\"><iswc-tag pill>1.25rem pill</iswc-tag></span>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<span style=\"font-size:1.25rem\">\n  <iswc-tag pill>Grande</iswc-tag>\n</span>"
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"tagLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Quita el tag removible para ver el evento.</div></div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Evento <code class=\"code\">iswc-remove</code> al pulsar quitar. Sin atributo <code class=\"code\">size</code> — usa <code class=\"code\">font-size</code>.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default"
          ],
          "rows": [
            [
              "<code>variant</code>",
              "brand · neutral · info · success · warning · danger (default brand)"
            ],
            [
              "<code>appearance</code>",
              "filled-outlined"
            ],
            [
              "<code>with-remove</code>",
              "false"
            ],
            [
              "<code>pill</code>",
              "false"
            ]
          ]
        }
      ]
    }
  ]
}
