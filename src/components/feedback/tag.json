{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-tag",
  "category": "feedback",
  "title": "&lt;iswc-tag&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-tag",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Etiqueta interactiva con variantes y botón de quitar opcional. Escala con <code class=\"code\">font-size</code> del contexto.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-tag id=\"tagPlay\">General</iswc-tag>",
          "target": "#tagPlay",
          "controls": [
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "text",
                "info",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:with-remove",
              "label": "with-remove"
            },
            {
              "control": "boolean",
              "prop": "attr:pill",
              "label": "pill"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Colores y apariencias",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">",
            "            <iswc-tag>General</iswc-tag>",
            "            <iswc-tag color=\"brand\">InSoft</iswc-tag>",
            "            <iswc-tag color=\"neutral\">Neutral</iswc-tag>",
            "            <iswc-tag color=\"info\">Info</iswc-tag>",
            "            <iswc-tag color=\"success\">Success</iswc-tag>",
            "            <iswc-tag color=\"warning\">Warning</iswc-tag>",
            "            <iswc-tag color=\"danger\">Danger</iswc-tag>",
            "            <iswc-tag with-remove id=\"rmTag\">Removible</iswc-tag>",
            "          </div>"
          ]
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"tagLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Quita el tag removible para ver el evento.</div></div>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala por contexto",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"align-items:center;gap:.5rem;flex-wrap:wrap\">",
            "            <span style=\"font-size:.75rem\"><iswc-tag>0.75rem</iswc-tag></span>",
            "            <span style=\"font-size:1rem\"><iswc-tag>1rem</iswc-tag></span>",
            "            <span style=\"font-size:1.25rem\"><iswc-tag pill>1.25rem pill</iswc-tag></span>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-tag\">",
            "  <iswc-tag color=\"brand\">Importante</iswc-tag>",
            "  <iswc-icon slot=\"start\" icon=\"mdi:star-outline\"></iswc-icon>",
            "  <iswc-icon slot=\"end\" icon=\"mdi:close\"></iswc-icon>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Evento <code class=\"code\">iswc-remove</code> al pulsar quitar. Sin atributo <code class=\"code\">size</code> — usa <code class=\"code\">font-size</code>.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>variant</code>"
            ],
            [
              "<code>appearance</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>with-remove</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>pill</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Etiqueta interactiva con variantes y botón de quitar opcional. Escala con <code class=\"code\">font-size</code> del contexto."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>variant</code>",
            "default": "brand · neutral · text · info · success · warning · danger (default brand)"
          },
          {
            "name": "<code>appearance</code>",
            "default": "filled-outlined"
          },
          {
            "name": "<code>with-remove</code>",
            "default": "false"
          },
          {
            "name": "<code>pill</code>",
            "default": "false"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-tag id=\"tagPlay\">General</iswc-tag>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
