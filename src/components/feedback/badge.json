{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-badge",
  "category": "feedback",
  "title": "&lt;iswc-badge&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-badge",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Etiqueta compacta con variantes semánticas y apariencias.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-badge id=\"badge-play\">Nuevo</iswc-badge>",
          "target": "#badge-play",
          "controls": [
            {
              "control": "select",
              "prop": "attr:color",
              "label": "Color",
              "options": [
                "brand",
                "neutral",
                "text",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "select",
              "prop": "attr:variant",
              "label": "Variante",
              "options": [
                "accent",
                "filled",
                "outlined",
                "filled-outlined"
              ]
            },
            {
              "control": "select",
              "prop": "attr:attention",
              "label": "Atención",
              "options": [
                "none",
                "pulse",
                "bounce"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:pill",
              "label": "Píldora"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Variantes y apariencias",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem\">",
            "            <iswc-badge color=\"brand\" variant=\"accent\">accent</iswc-badge>",
            "            <iswc-badge color=\"brand\" variant=\"filled\">filled</iswc-badge>",
            "            <iswc-badge color=\"brand\" variant=\"outlined\">outlined</iswc-badge>",
            "            <iswc-badge color=\"brand\" variant=\"filled-outlined\">filled-outlined</iswc-badge>",
            "            <iswc-badge color=\"danger\" pill attention=\"bounce\">pill bounce</iswc-badge>",
            "          </div>",
            "          <div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">",
            "            <iswc-badge color=\"neutral\" variant=\"filled\">neutral</iswc-badge>",
            "            <iswc-badge color=\"text\" variant=\"outlined\">text</iswc-badge>",
            "            <iswc-badge color=\"success\" variant=\"filled\">success</iswc-badge>",
            "            <iswc-badge color=\"warning\" variant=\"outlined\">warning</iswc-badge>",
            "            <iswc-badge color=\"danger\" variant=\"accent\">danger</iswc-badge>",
            "            <iswc-badge attention=\"pulse\">pulse</iswc-badge>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-badge\">",
            "  <iswc-badge color=\"success\">Activo</iswc-badge>",
            "  <iswc-icon slot=\"start\" icon=\"mdi:check-circle\"></iswc-icon>",
            "  <span slot=\"end\">12</span>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Slots: default, start, end.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>variant</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>appearance</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>pill</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>attention</code>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Etiqueta compacta con variantes semánticas y apariencias."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>variant</code>",
            "default": "brand"
          },
          {
            "name": "<code>appearance</code>",
            "default": "accent"
          },
          {
            "name": "<code>pill</code>",
            "default": "false"
          },
          {
            "name": "<code>attention</code>",
            "default": "none · pulse · bounce"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-badge id=\"badge-play\">Nuevo</iswc-badge>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
