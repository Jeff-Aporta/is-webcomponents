{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-confirm-modal",
  "category": "feedback",
  "title": "<iswc-confirm-modal>",
  "titleHtml": true,
  "description": "Documentación y demos de iswc-confirm-modal de InSoft.",
  "storageKey": "docs-iswc-confirm-modal",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Confirmación en modal centrado con backdrop. Para decisiones que\r\n          merecen foco total. Si prefieres confirmar en línea sin tapar la\r\n          pantalla, usa <code class=\"code\">&lt;iswc-popconfirm&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"btnDelete\" color=\"danger\">\r\n            <iswc-icon slot=\"start\" icon=\"mdi:trash-can\"></iswc-icon>\r\n            Eliminar cuenta\r\n          </iswc-button>\r\n          <iswc-confirm-modal for=\"btnDelete\" heading=\"Eliminar cuenta\" message=\"Se borrarán todos tus datos. Esta acción no se puede deshacer.\">\r\n            <iswc-button slot=\"confirm\" color=\"danger\">Sí, eliminar</iswc-button>\r\n            <iswc-button slot=\"cancel\">Cancelar</iswc-button>\r\n          </iswc-confirm-modal>\r\n          <p id=\"cmLog\">Última acción: <code class=\"code\">—</code></p>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:heading",
              "label": "heading",
              "options": [
                "Eliminar cuenta",
                "Publicar a producción"
              ]
            }
          ]
        },
        {
          "kind": "code",
          "code": "<iswc-button id=\"btnDelete\">Eliminar cuenta</iswc-button>\n<iswc-confirm-modal for=\"btnDelete\" heading=\"Eliminar cuenta\" message=\"¿Seguro?\">\n  <iswc-button slot=\"confirm\" color=\"danger\">Sí, eliminar</iswc-button>\n  <iswc-button slot=\"cancel\">Cancelar</iswc-button>\n</iswc-confirm-modal>"
        }
      ]
    },
    {
      "id": "custom",
      "title": "Mensaje propio",
      "lede": "El contenido del slot <code class=\"code\">message</code> reemplaza el atributo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"cmMega\" color=\"brand\">Publicar cambios</iswc-button>\r\n          <iswc-confirm-modal for=\"cmMega\" heading=\"Publicar a producción\">\r\n            <div slot=\"message\">\r\n              <strong>Vas a publicar 12 cambios.</strong>\r\n              <p style=\"margin:0.25rem 0;font-size:0.85em;color:color-mix(in srgb,currentColor 70%,transparent)\">\r\n                Los usuarios verán la nueva versión de inmediato.\r\n              </p>\r\n            </div>\r\n            <iswc-button slot=\"cancel\">Revisar de nuevo</iswc-button>\r\n            <iswc-button slot=\"confirm\" color=\"brand\">Publicar</iswc-button>\r\n          </iswc-confirm-modal>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
