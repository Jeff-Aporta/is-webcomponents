{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-popconfirm",
  "category": "feedback",
  "title": "&lt;iswc-popconfirm&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-popconfirm de InSoft.",
  "storageKey": "docs-iswc-popconfirm",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Cuadro de confirmación rápido anclado a un botón. Sin modal, sin tapar",
        "          la pantalla. Perfecto para \"¿Seguro que quieres borrar?\" en línea."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"btnDelete\" color=\"danger\">",
            "            <iswc-icon slot=\"start\" icon=\"mdi:trash-can\"></iswc-icon>",
            "            Borrar elemento",
            "          </iswc-button>",
            "          <iswc-popconfirm for=\"btnDelete\" message=\"¿Seguro que quieres borrarlo? Esta acción no se puede deshacer.\" placement=\"bottom-end\">",
            "            <iswc-button slot=\"confirm\" color=\"danger\">Sí, borrar</iswc-button>",
            "            <iswc-button slot=\"cancel\">Cancelar</iswc-button>",
            "          </iswc-popconfirm>",
            "          <p id=\"pcLog\">Última acción: <code class=\"code\">—</code></p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:placement",
              "label": "placement",
              "options": [
                "top",
                "bottom",
                "start",
                "end",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:hide-arrow",
              "label": "hide-arrow"
            }
          ]
        }
      ]
    },
    {
      "id": "placements",
      "title": "Posiciones",
      "lede": "top, top-start, top-end, bottom, bottom-start, bottom-end, start, end.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:flex;gap:0.5rem;flex-wrap:wrap\">",
            "            <iswc-button id=\"pc1\">top</iswc-button>",
            "            <iswc-popconfirm for=\"pc1\" message=\"Top popconfirm\" placement=\"top\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc2\">top-start</iswc-button>",
            "            <iswc-popconfirm for=\"pc2\" placement=\"top-start\" message=\"Top start\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc3\">top-end</iswc-button>",
            "            <iswc-popconfirm for=\"pc3\" placement=\"top-end\" message=\"Top end\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc4\">bottom</iswc-button>",
            "            <iswc-popconfirm for=\"pc4\" placement=\"bottom\" message=\"Bottom\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc5\">bottom-start</iswc-button>",
            "            <iswc-popconfirm for=\"pc5\" placement=\"bottom-start\" message=\"Bottom start\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc6\">bottom-end</iswc-button>",
            "            <iswc-popconfirm for=\"pc6\" placement=\"bottom-end\" message=\"Bottom end\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc7\">start</iswc-button>",
            "            <iswc-popconfirm for=\"pc7\" placement=\"start\" message=\"Start\"></iswc-popconfirm>",
            "",
            "            <iswc-button id=\"pc8\">end</iswc-button>",
            "            <iswc-popconfirm for=\"pc8\" placement=\"end\" message=\"End\"></iswc-popconfirm>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "custom",
      "title": "Mensaje propio",
      "lede": "El contenido del slot <code class=\"code\">message</code> reemplaza el atributo.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"pcMega\">Power action</iswc-button>",
            "          <iswc-popconfirm for=\"pcMega\" placement=\"bottom\" hide-arrow>",
            "            <div slot=\"message\">",
            "              <strong>¿Reiniciar el servidor?</strong>",
            "              <p style=\"margin:0.25rem 0;font-size:0.85em;color:color-mix(in srgb,currentColor 70%,transparent)\">",
            "                Esto detendrá todos los servicios activos.",
            "              </p>",
            "            </div>",
            "            <iswc-button slot=\"cancel\">Cancelar</iswc-button>",
            "            <iswc-button slot=\"confirm\" color=\"danger\">Reiniciar</iswc-button>",
            "          </iswc-popconfirm>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-popconfirm\">",
            "  <iswc-popconfirm>",
            "    <iswc-button color=\"danger\" variant=\"outlined\">",
            "      <iswc-icon icon=\"mdi:trash-can-outline\"></iswc-icon>",
            "      Eliminar",
            "    </iswc-button>",
            "  </iswc-popconfirm>",
            "  <span slot=\"message\">¿Eliminar este elemento?</span>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-popconfirm&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>for</code>",
              "id del trigger."
            ],
            [
              "<code>message</code>",
              "Texto del mensaje."
            ],
            [
              "<code>placement</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Posición. (valor por defecto)"
            ],
            [
              "<code>hide-arrow</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Oculta la flecha. (valor por defecto)"
            ],
            [
              "<code>open</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Estado controlado. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-popconfirm-show</code>",
              "Popconfirm visible."
            ],
            [
              "<code>iswc-popconfirm-hide</code>",
              "Popconfirm se cierra."
            ],
            [
              "<code>iswc-popconfirm-confirm</code>",
              "Click en confirmar."
            ],
            [
              "<code>iswc-popconfirm-cancel</code>",
              "Click en cancelar."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Cuadro de confirmación rápido anclado a un botón. Sin modal, sin tapar",
          "          la pantalla. Perfecto para \"¿Seguro que quieres borrar?\" en línea."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>for</code>",
            "type": "string",
            "default": "—",
            "desc": "id del trigger."
          },
          {
            "name": "<code>message</code>",
            "type": "string",
            "default": "—",
            "desc": "Texto del mensaje."
          },
          {
            "name": "<code>placement</code>",
            "type": "top | bottom | start | end | top-start | top-end | bottom-start | bottom-end",
            "default": "top",
            "desc": "Posición."
          },
          {
            "name": "<code>hide-arrow</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Oculta la flecha."
          },
          {
            "name": "<code>open</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Estado controlado."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-popconfirm-show</code>",
            "cuando": "Popconfirm visible."
          },
          {
            "evento": "<code>iswc-popconfirm-hide</code>",
            "cuando": "Popconfirm se cierra."
          },
          {
            "evento": "<code>iswc-popconfirm-confirm</code>",
            "cuando": "Click en confirmar."
          },
          {
            "evento": "<code>iswc-popconfirm-cancel</code>",
            "cuando": "Click en cancelar."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-button id=\"btnDelete\">Borrar</iswc-button>",
          "<iswc-popconfirm for=\"btnDelete\" message=\"¿Seguro?\">",
          "  <iswc-button slot=\"confirm\" color=\"danger\">Sí, borrar</iswc-button>",
          "  <iswc-button slot=\"cancel\">Cancelar</iswc-button>",
          "</iswc-popconfirm>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
