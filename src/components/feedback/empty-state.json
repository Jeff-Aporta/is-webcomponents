{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-empty-state",
  "category": "feedback",
  "title": "&lt;iswc-empty-state&gt;",
  "titleHtml": false,
  "description": "Estado vacío, cargando o error de una lista o un panel, con acción opcional.",
  "storageKey": "docs-iswc-empty-state",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Lo que se ve cuando una lista o un panel no tiene datos, está cargando o falló: ícono, título, texto y una acción opcional.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-empty-state id=\"v\" titulo=\"Sin proyectos\" texto=\"Crea un proyecto para empezar un tablero.\"><iswc-button color=\"brand\">Crear el primero</iswc-button></iswc-empty-state>"
          ],
          "target": "#v",
          "controls": [
            {
              "control": "select",
              "prop": "attr:estado",
              "label": "estado",
              "options": [
                "vacio",
                "cargando",
                "error"
              ]
            },
            {
              "control": "select",
              "prop": "attr:variante",
              "label": "variante",
              "options": [
                "caja",
                "tarjeta"
              ]
            },
            {
              "control": "text",
              "prop": "attr:titulo",
              "label": "titulo"
            },
            {
              "control": "text",
              "prop": "attr:texto",
              "label": "texto"
            },
            {
              "control": "text",
              "prop": "attr:icono",
              "label": "icono"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout tone=\"info\"><strong slot=\"title\">Cuándo usarlo</strong>Listas y paneles sin datos, cargando o con error.</iswc-callout><iswc-callout tone=\"warning\"><strong slot=\"title\">Cuándo no</strong>Validación de un formulario: <code class=\"code\">error-text</code> del campo.</iswc-callout>"
        }
      ]
    }
  ]
}
