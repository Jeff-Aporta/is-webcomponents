      "ejemplos": {
        "content": [
          "```html",
          "<iswc-cdn-snippet",
          "  tag=\"iswc-button\"",
          "  category=\"actions\"",
          "></iswc-cdn-snippet>",
          "```"
        ]
      }
    },
    "exclude": [
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
