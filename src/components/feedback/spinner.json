{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-spinner",
  "category": "feedback",
  "title": "&lt;iswc-spinner&gt;",
  "titleHtml": false,
  "styles": [
    ".speed-demo {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 1rem;",
    "      max-width: 28rem;",
    "    }",
    "    .speed-demo__row {",
    "      display: flex;",
    "      align-items: center;",
    "      gap: 1.25rem;",
    "    }",
    "    .speed-demo__control {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.35rem;",
    "      flex: 1;",
    "      min-width: 0;",
    "    }",
    "    .speed-demo__meta {",
    "      display: flex;",
    "      justify-content: space-between;",
    "      font-size: 0.8rem;",
    "      color: var(--iswc-text-dim);",
    "      font-variant-numeric: tabular-nums;",
    "    }",
    "    .speed-demo__meta strong { color: var(--iswc-text-soft); }",
    "    .speed-demo input[type=\"range\"] {",
    "      width: 100%;",
    "      accent-color: var(--iswc-accent, var(--iswc-color-brand));",
    "      cursor: pointer;",
    "    }"
  ],
  "storageKey": "docs-iswc-spinner",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Indicador de carga animado. Sin atributos; personalizable vía CSS vars.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-spinner></iswc-spinner>"
        }
      ]
    },
    {
      "id": "examples",
      "title": "Escala y colores",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"align-items:center;gap:1.5rem\">",
            "            <iswc-spinner style=\"font-size:1rem\"></iswc-spinner>",
            "            <iswc-spinner style=\"font-size:2rem;--indicator-color:var(--iswc-color-success)\"></iswc-spinner>",
            "            <iswc-spinner style=\"font-size:2.5rem;--track-width:4px\"></iswc-spinner>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "speed",
      "title": "Velocidad",
      "lede": "Controla <code class=\"code\">--speed</code> (duración de un giro). Más % = más rápido.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"speed-demo\">",
            "            <div class=\"speed-demo__row\">",
            "              <iswc-spinner id=\"speedSpinner\" style=\"font-size:2.5rem;--track-width:4px\"></iswc-spinner>",
            "              <div class=\"speed-demo__control\">",
            "                <div class=\"speed-demo__meta\">",
            "                  <span>Velocidad</span>",
            "                  <strong><span id=\"speedPct\">40</span>% · <span id=\"speedSec\">1.05</span>s</strong>",
            "                </div>",
            "                <input id=\"speedRange\" type=\"range\" min=\"5\" max=\"100\" value=\"40\" step=\"1\"",
            "                  aria-label=\"Velocidad del spinner\" />",
            "              </div>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Part: <code class=\"code\">::part(spinner)</code>. role=status.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Variable CSS"
          ],
          "rows": [
            [
              "<code>--track-width</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>--track-color</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>--indicator-color</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>--speed</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Indicador de carga animado. Sin atributos; personalizable vía CSS vars."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>--track-width</code>",
            "default": "0.15em"
          },
          {
            "name": "<code>--track-color</code>",
            "default": "borde control"
          },
          {
            "name": "<code>--indicator-color</code>",
            "default": "brand-500"
          },
          {
            "name": "<code>--speed</code>",
            "default": "0.75s"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-spinner></iswc-spinner>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
