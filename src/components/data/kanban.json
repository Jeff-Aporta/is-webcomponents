{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-kanban",
  "category": "data",
  "title": "&lt;iswc-kanban&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-kanban / iswc-kanban-column / iswc-kanban-card de InSoft.",
  "loads": ["iswc-kanban-card", "iswc-kanban-column"],
  "storageKey": "docs-iswc-kanban",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Tablero kanban con columnas y tarjetas. Cada columna tiene un accent",
        "          color, badge automático con el conteo, slots de header-actions y",
        "          cards con cover, heading, meta, tag y footer."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-kanban id=\"kb1\">",
            "            <iswc-kanban-column title=\"Pending\" accent=\"dodgerblue\">",
            "              <iswc-kanban-card heading=\"Diseñar landing\" meta=\"Asignado a Ana\" tag=\"Design\" tag-color=\"brand\">",
            "                Maquetar la nueva landing con el sistema de paneles.",
            "              </iswc-kanban-card>",
            "              <iswc-kanban-card heading=\"Investigar SSO\" meta=\"Asignado a Diego\" tag=\"R&amp;D\" tag-color=\"warning\">",
            "                Contactar con Auth0 y Okta para comparar planes.",
            "              </iswc-kanban-card>",
            "              <iswc-kanban-card heading=\"Newsletter mensual\" meta=\"Pendiente de copy\" tag=\"Marketing\" tag-color=\"neutral\">",
            "                Preparar el email de finales de mes.",
            "              </iswc-kanban-card>",
            "            </iswc-kanban-column>",
            "            <iswc-kanban-column title=\"In progress\" accent=\"var(--iswc-warning, #ffa800)\">",
            "              <iswc-kanban-card heading=\"Implementar /api/v2\" meta=\"Backend ⋅ 70%\" tag=\"Backend\" tag-color=\"warning\">",
            "                <span slot=\"footer\">",
            "                  <iswc-icon icon=\"mdi:clock-outline\"></iswc-icon>",
            "                  <span>3 días</span>",
            "                </span>",
            "              </iswc-kanban-card>",
            "              <iswc-kanban-card heading=\"Bug: scrollspy\" meta=\"Frontend\" tag=\"Frontend\" tag-color=\"brand\">",
            "                El observer no se desconecta al cambiar de pestaña.",
            "              </iswc-kanban-card>",
            "            </iswc-kanban-column>",
            "            <iswc-kanban-column title=\"QA\" accent=\"var(--iswc-success, #0bb783)\">",
            "              <iswc-kanban-card heading=\"Refactor pagination\" meta=\"PR #429\" tag=\"Refactor\" tag-color=\"success\">",
            "                Sustituir el paginador custom por iswc-pagination.",
            "              </iswc-kanban-card>",
            "            </iswc-kanban-column>",
            "            <iswc-kanban-column title=\"Done\" accent=\"var(--iswc-success, #0bb783)\">",
            "              <iswc-kanban-card heading=\"Calendar widget\" tag=\"UI\" tag-color=\"success\">Componente terminado y desplegado.</iswc-kanban-card>",
            "            </iswc-kanban-column>",
            "          </iswc-kanban>",
            "          <p id=\"kLog\">Click sobre una card: <code class=\"code\">—</code></p>"
          ]
        }
      ]
    },
    {
      "id": "cover",
      "title": "Con cover",
      "lede": "Atributo <code class=\"code\">cover</code> muestra una imagen de cabecera.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-kanban>",
            "            <iswc-kanban-column title=\"Features\" accent=\"dodgerblue\">",
            "              <iswc-kanban-card heading=\"Versión 2.0\" tag=\"Release\" tag-color=\"brand\" cover=\"https://picsum.photos/id/1015/600/300\">",
            "                Lanzamiento de la nueva versión con iswc-stepper.",
            "              </iswc-kanban-card>",
            "              <iswc-kanban-card heading=\"Componentes nuevos\" tag=\"Component\" tag-color=\"success\" cover=\"https://picsum.photos/id/1025/600/300\">",
            "                8 componentes añadidos en la fase 8.",
            "              </iswc-kanban-card>",
            "            </iswc-kanban-column>",
            "          </iswc-kanban>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-kanban-column&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>title</code>",
              "Nombre de la columna."
            ],
            [
              "<code>accent</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Color de acento. (valor por defecto)"
            ],
            [
              "<code>badge</code>",
              "Override del conteo."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-kanban-card&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>heading</code>",
              "Título de la card."
            ],
            [
              "<code>meta</code>",
              "Subtítulo."
            ],
            [
              "<code>tag</code>",
              "Tag de la cabecera."
            ],
            [
              "<code>tag-variant</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Color del tag. (valor por defecto)"
            ],
            [
              "<code>cover</code>",
              "URL de imagen."
            ],
            [
              "<code>without-shadow</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Sin sombra. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-kanban-card-click</code>",
              "Click. <code>detail: { card, column }</code>."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Tablero kanban con columnas y tarjetas. Cada columna tiene un accent",
          "          color, badge automático con el conteo, slots de header-actions y",
          "          cards con cover, heading, meta, tag y footer."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>title</code>",
            "type": "string",
            "default": "—",
            "desc": "Nombre de la columna."
          },
          {
            "name": "<code>accent</code>",
            "type": "string",
            "default": "brand",
            "desc": "Color de acento."
          },
          {
            "name": "<code>badge</code>",
            "type": "string",
            "default": "—",
            "desc": "Override del conteo."
          },
          {
            "name": "<code>heading</code>",
            "type": "string",
            "default": "—",
            "desc": "Título de la card."
          },
          {
            "name": "<code>meta</code>",
            "type": "string",
            "default": "—",
            "desc": "Subtítulo."
          },
          {
            "name": "<code>tag</code>",
            "type": "string",
            "default": "—",
            "desc": "Tag de la cabecera."
          },
          {
            "name": "<code>tag-variant</code>",
            "type": "brand | neutral | success | warning | danger",
            "default": "neutral",
            "desc": "Color del tag."
          },
          {
            "name": "<code>cover</code>",
            "type": "string",
            "default": "—",
            "desc": "URL de imagen."
          },
          {
            "name": "<code>without-shadow</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Sin sombra."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-kanban-card-click</code>",
            "cuando": "Click. <code>detail: { card, column }</code>."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-kanban>",
          "  <iswc-kanban-column title=\"Pending\" accent=\"dodgerblue\">",
          "    <iswc-kanban-card heading=\"Diseñar landing\" tag=\"Design\">…</iswc-kanban-card>",
          "  </iswc-kanban-column>",
          "</iswc-kanban>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
