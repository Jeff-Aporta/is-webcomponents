{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-stat",
  "category": "data",
  "title": "&lt;iswc-stat&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-stat (KPI Card) de InSoft.",
  "styles": [
    ".stats-grid {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));",
    "      gap: 0.75rem;",
    "    }"
  ],
  "storageKey": "docs-iswc-stat",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Tarjeta KPI para dashboards: label, número principal, helper text,",
        "          trend (subida/bajada) e icono. Detecta automáticamente la dirección",
        "          del trend según el signo del valor."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stats-grid\">",
            "            <iswc-stat label=\"Ingresos\" value=\"€ 1.249,00\" helper=\"vs mes anterior\" trend=\"+12.5%\" icon=\"mdi:cash-multiple\"></iswc-stat>",
            "            <iswc-stat label=\"Usuarios activos\" value=\"3.421\" helper=\"últimas 24h\" trend=\"+8.1%\" icon=\"mdi:account-group\" color=\"brand\"></iswc-stat>",
            "            <iswc-stat label=\"Tasa de conversión\" value=\"2.4%\" helper=\"vs objetivo\" trend=\"-0.3%\" icon=\"mdi:target\" color=\"danger\"></iswc-stat>",
            "            <iswc-stat label=\"Tickets abiertos\" value=\"47\" helper=\"12 críticos\" trend=\"flat\" icon=\"mdi:ticket-outline\" color=\"warning\"></iswc-stat>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "sizes",
      "title": "Tamaños",
      "lede": "small, medium, large.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stats-grid\">",
            "            <iswc-stat style=\"font-size:0.85em\" label=\"Visitas\" value=\"8.432\" trend=\"+3.2%\" icon=\"mdi:eye\"></iswc-stat>",
            "            <iswc-stat label=\"Visitas\" value=\"8.432\" trend=\"+3.2%\" icon=\"mdi:eye\"></iswc-stat>",
            "            <iswc-stat style=\"font-size:1.25em\" label=\"Visitas\" value=\"8.432\" trend=\"+3.2%\" icon=\"mdi:eye\"></iswc-stat>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "variants",
      "title": "Variantes",
      "lede": "brand, neutral, text, success, warning, danger.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stats-grid\">",
            "            <iswc-stat color=\"brand\" label=\"Brand\" value=\"42\" icon=\"mdi:star\"></iswc-stat>",
            "            <iswc-stat color=\"neutral\" label=\"Neutral\" value=\"42\" icon=\"mdi:cog\"></iswc-stat>",
            "            <iswc-stat color=\"text\" label=\"Text\" value=\"42\" icon=\"mdi:format-text\"></iswc-stat>",
            "            <iswc-stat color=\"success\" label=\"Success\" value=\"98%\" trend=\"+1.2%\" icon=\"mdi:check\"></iswc-stat>",
            "            <iswc-stat color=\"warning\" label=\"Warning\" value=\"12\" trend=\"+4\" icon=\"mdi:alert\"></iswc-stat>",
            "            <iswc-stat color=\"danger\" label=\"Danger\" value=\"3\" trend=\"-1\" icon=\"mdi:close\"></iswc-stat>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "dashboard",
      "title": "Dashboard de ejemplo",
      "lede": "Cuatro stats juntos para una sección de dashboard.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stats-grid\">",
            "            <iswc-stat label=\"MRR\" value=\"€ 48.230\" helper=\"Monthly recurring revenue\" trend=\"+12.5%\" icon=\"mdi:trending-up\" color=\"success\"></iswc-stat>",
            "            <iswc-stat label=\"Churn\" value=\"1.8%\" helper=\"Cancelaciones del mes\" trend=\"-0.4%\" icon=\"mdi:account-remove\" color=\"danger\"></iswc-stat>",
            "            <iswc-stat label=\"LTV\" value=\"€ 1.249\" helper=\"Promedio 12 meses\" trend=\"+5.2%\" icon=\"mdi:cash-multiple\" color=\"brand\"></iswc-stat>",
            "            <iswc-stat label=\"CAC\" value=\"€ 89\" helper=\"Coste de adquisición\" trend=\"flat\" icon=\"mdi:cart-outline\"></iswc-stat>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-stat\">",
            "  <iswc-stat value=\"1,234\">",
            "    <span slot=\"label\">Usuarios activos</span>",
            "    <iswc-icon slot=\"icon\" icon=\"mdi:account-multiple\"></iswc-icon>",
            "    <span slot=\"trend\">+12%</span>",
            "    <span slot=\"helper\">vs mes pasado</span>",
            "  </iswc-stat>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-stat&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>label</code>",
              "Título del KPI."
            ],
            [
              "<code>value</code>",
              "Valor principal."
            ],
            [
              "<code>helper</code>",
              "Texto aclaratorio."
            ],
            [
              "<code>trend</code>",
              "Valor de cambio (e.g. \"+12.5%\")."
            ],
            [
              "<code>trend-direction</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Dirección manual. (valor por defecto)"
            ],
            [
              "<code>icon</code>",
              "Iconify id."
            ],
            [
              "<code>variant</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Color. (valor por defecto)"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Tarjeta KPI para dashboards: label, número principal, helper text,",
          "          trend (subida/bajada) e icono. Detecta automáticamente la dirección",
          "          del trend según el signo del valor."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>label</code>",
            "type": "string",
            "default": "—",
            "desc": "Título del KPI."
          },
          {
            "name": "<code>value</code>",
            "type": "string",
            "default": "—",
            "desc": "Valor principal."
          },
          {
            "name": "<code>helper</code>",
            "type": "string",
            "default": "—",
            "desc": "Texto aclaratorio."
          },
          {
            "name": "<code>trend</code>",
            "type": "string",
            "default": "—",
            "desc": "Valor de cambio (e.g. \"+12.5%\")."
          },
          {
            "name": "<code>trend-direction</code>",
            "type": "up | down | flat",
            "default": "auto",
            "desc": "Dirección manual."
          },
          {
            "name": "<code>icon</code>",
            "type": "string",
            "default": "—",
            "desc": "Iconify id."
          },
          {
            "name": "<code>variant</code>",
            "type": "brand | neutral | text | success | warning | danger",
            "default": "neutral",
            "desc": "Color."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-stat",
          "  label=\"Ingresos\"",
          "  value=\"€ 1.249,00\"",
          "  helper=\"vs mes anterior\"",
          "  trend=\"+12.5%\"",
          "  icon=\"mdi:cash-multiple\"",
          "></iswc-stat>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
