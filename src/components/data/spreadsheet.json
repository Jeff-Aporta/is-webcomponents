{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-spreadsheet",
  "category": "data",
  "title": "&lt;iswc-spreadsheet&gt;",
  "titleHtml": false,
  "styles": [
    "pre.output {",
    "      font-family: ui-monospace, monospace; font-size: .78rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 12rem; overflow: auto;",
    "      white-space: pre-wrap;",
    "    }",
    "    .kbd-hint {",
    "      font-size: .78rem; color: var(--iswc-text-soft);",
    "    }",
    "    .kbd-hint kbd {",
    "      font-family: ui-monospace, monospace; font-size: .72rem;",
    "      padding: 1px 5px;",
    "      border-radius: 4px;",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg-elev);",
    "    }"
  ],
  "storageKey": "docs-iswc-spreadsheet",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Hoja de cálculo con edición por celda, fórmulas <code class=\"ic\">=SUM(A1:A5)</code> y navegación con flechas + Tab.",
      "blocks": [
        {
          "kind": "html",
          "html": "<p class=\"kbd-hint\">Click para editar · <kbd>Enter</kbd> bajar · <kbd>Tab</kbd> derecha · <kbd>Esc</kbd> cancelar · <kbd>Flechas</kbd> mover.</p>"
        }
      ]
    },
    {
      "id": "basico",
      "title": "Hoja de ejemplo",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-spreadsheet rows=\"8\" cols=\"6\"",
            "            value=\"[[10,20,30,40,'','=SUM(A1:D1)'],[11,21,31,41,'','=SUM(A2:D2)'],[12,22,32,42,'','=SUM(A3:D3)'],[13,23,33,43,'','=SUM(A4:D4)'],['','','','','','=AVERAGE(F1:F4)'],[15,25,35,45,'','=MIN(A5:D5)'],[16,26,36,46,'','=MAX(A1:A4)']]\">",
            "          </iswc-spreadsheet>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API / fórmulas",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const s = document.querySelector('iswc-spreadsheet');",
            "s.value;          // string JSON con la matriz",
            "s.addEventListener('iswc-change', e => {",
            "  console.log(`[${e.detail.row},${e.detail.col}] raw=${e.detail.raw} value=${e.detail.value}`);",
            "});",
            "",
            "// Fórmulas soportadas (en cualquier mayúscula o minúscula)",
            "//   =SUM(rango)        suma",
            "//   =AVERAGE(rango)    promedio",
            "//   =MIN(rango)        mínimo",
            "//   =MAX(rango)        máximo",
            "//   =COUNT(rango)      cuenta números",
            "//   +, -, *, /         aritmética",
            "//   =A1*B1             referencia a celdas individuales",
            "//",
            "// Rangos válidos:",
            "//   A1               celda única",
            "//   A1:B5            rectángulo",
            "//   A1,B2,C3         lista",
            "",
            "// Atributos: rows, cols, value (JSON), read-only"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Hoja de cálculo con edición por celda, fórmulas <code class=\"ic\">=SUM(A1:A5)</code> y navegación con flechas + Tab."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
