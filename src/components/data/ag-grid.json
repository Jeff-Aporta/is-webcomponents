{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-ag-grid",
  "category": "data",
  "title": "&lt;iswc-ag-grid&gt;",
  "titleHtml": false,
  "styles": [
    "pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .78rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 9rem; overflow: auto;",
    "      white-space: pre-wrap;",
    "    }",
    "    .grid-cta {",
    "      display: flex;",
    "      gap: .35rem;",
    "      flex-wrap: wrap;",
    "      align-items: center;",
    "    }",
    "    .grid-cta button {",
    "      font: inherit; font-size: .8rem;",
    "      padding: .25rem .55rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: 6px;",
    "      background: var(--iswc-bg-soft);",
    "      color: inherit;",
    "      cursor: pointer;",
    "    }",
    "    .grid-cta button:hover { background: color-mix(in srgb, var(--iswc-accent) 14%, transparent); }"
