  "storageKey": "docs-iswc-ag-grid",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Data grid estilo <strong>ag-grid.com</strong> pero vanilla web component: orden por columna, filtros, paginación, selección, edición y virtual scroll.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-ag-grid id=\"grid\"",
            "                      page-size=\"8\"",
            "                      page-size-options=\"5,8,20\"",
            "                      selectable",
            "                      style=\"height: 28rem\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"field\": \"sku\",       \"header\": \"SKU\",         \"width\": 100, \"sortable\": true,  \"align\": \"left\" },",
            "                { \"field\": \"name\",      \"header\": \"Producto\",    \"filter\": true, \"sortable\": true },",
            "                { \"field\": \"category\",  \"header\": \"Categoría\",  \"filter\": true, \"width\": 130 },",
            "                { \"field\": \"stock\",     \"header\": \"Stock\",      \"type\": \"number\", \"width\": 90,  \"align\": \"right\", \"decimals\": 0 },",
            "                { \"field\": \"price\",     \"header\": \"Precio\",     \"type\": \"currency\", \"currency\": \"COP\", \"decimals\": 0, \"width\": 130, \"align\": \"right\" },",
            "                { \"field\": \"status\",    \"header\": \"Estado\",     \"type\": \"enum\", \"width\": 110,",
            "                  \"enumColors\": { \"Activo\": \"var(--iswc-success, #16a34a)\", \"Bajo\": \"var(--iswc-warning, #d97706)\", \"Agotado\": \"var(--iswc-danger, #dc2626)\" } },",
            "                { \"field\": \"tags\",      \"header\": \"Tags\",       \"type\": \"tags\" },",
            "                { \"field\": \"updated\",   \"header\": \"Actualizado\",\"type\": \"date\", \"dateFormat\": \"short\", \"width\": 120, \"align\": \"right\" },",
            "                { \"field\": \"actions\",   \"header\": \"\",           \"type\": \"actions\", \"width\": 110,",
            "                  \"actions\": [",
            "                    { \"icon\": \"mdi:open-in-new\", \"label\": \"Ver\",    \"value\": \"view\" },",
            "                    { \"icon\": \"mdi:pencil\",      \"label\": \"Editar\", \"value\": \"edit\" },",
            "                    { \"icon\": \"mdi:delete\",      \"label\": \"Borrar\", \"value\": \"delete\" }",
            "                  ] }",
            "              ]",
            "            </script>",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"id\": 1,  \"sku\": \"IN-1001\", \"name\": \"Escritorio Ergo Pro\",  \"category\": \"Muebles\",     \"stock\": 24,  \"price\":  890000, \"status\": \"Activo\",   \"tags\": [\"nuevo\", \"top\"],      \"updated\": \"2026-07-12\" },",
            "                { \"id\": 2,  \"sku\": \"IN-1002\", \"name\": \"Silla LumbarCare\",      \"category\": \"Muebles\",     \"stock\": 6,   \"price\":  420000, \"status\": \"Bajo\",     \"tags\": [\"oferta\"],             \"updated\": \"2026-07-21\" },",
            "                { \"id\": 3,  \"sku\": \"IN-1003\", \"name\": \"Lámpara Halo 360\",      \"category\": \"Iluminación\", \"stock\": 38,  \"price\":  180000, \"status\": \"Activo\",   \"tags\": [\"viral\"],              \"updated\": \"2026-06-30\" },",
            "                { \"id\": 4,  \"sku\": \"IN-1004\", \"name\": \"Teclado Mech Tactile\",  \"category\": \"Periféricos\",\"stock\":  0,  \"price\":  320000, \"status\": \"Agotado\",  \"tags\": [\"limited\"],            \"updated\": \"2026-05-05\" },",
            "                { \"id\": 5,  \"sku\": \"IN-1005\", \"name\": \"Monitor 32\\\" 4K HDR\",   \"category\": \"Pantallas\",   \"stock\": 12,  \"price\": 1850000, \"status\": \"Activo\",   \"tags\": [\"top\",\"nuevo\"],        \"updated\": \"2026-07-25\" },",
            "                { \"id\": 6,  \"sku\": \"IN-1006\", \"name\": \"Torre servidor 4U\",     \"category\": \"Servidores\",  \"stock\":  4,  \"price\": 4200000, \"status\": \"Bajo\",     \"tags\": [\"enterprise\"],         \"updated\": \"2026-07-23\" },",
            "                { \"id\": 7,  \"sku\": \"IN-1007\", \"name\": \"UPS doble conversión\",  \"category\": \"Energía\",     \"stock\": 18,  \"price\":  760000, \"status\": \"Activo\",   \"tags\": [],                     \"updated\": \"2026-07-19\" },",
            "                { \"id\": 8,  \"sku\": \"IN-1008\", \"name\": \"Switch 24 puertos PoE\", \"category\": \"Redes\",       \"stock\": 11,  \"price\":  620000, \"status\": \"Activo\",   \"tags\": [\"nuevo\"],              \"updated\": \"2026-07-26\" },",
            "                { \"id\": 9,  \"sku\": \"IN-1009\", \"name\": \"Cámara 4K PTZ\",         \"category\": \"Seguridad\",   \"stock\":  3,  \"price\":  920000, \"status\": \"Bajo\",     \"tags\": [\"premium\"],            \"updated\": \"2026-07-22\" },",
            "                { \"id\": 10, \"sku\": \"IN-1010\", \"name\": \"Micrófono de mesa\",     \"category\": \"Audio\",       \"stock\": 22,  \"price\":  150000, \"status\": \"Activo\",   \"tags\": [\"oferta\"],             \"updated\": \"2026-07-20\" },",
            "                { \"id\": 11, \"sku\": \"IN-1011\", \"name\": \"Dock USB-C triple\",     \"category\": \"Periféricos\",\"stock\": 14,  \"price\":  220000, \"status\": \"Activo\",   \"tags\": [],                     \"updated\": \"2026-07-12\" },",
            "                { \"id\": 12, \"sku\": \"IN-1012\", \"name\": \"Webcam 1080p\",          \"category\": \"Periféricos\",\"stock\":  0,  \"price\":   98000, \"status\": \"Agotado\",  \"tags\": [],                     \"updated\": \"2026-07-04\" }",
            "              ]",
            "            </script>",
            "          </iswc-ag-grid>",
            "          <div class=\"grid-cta\" style=\"margin-top:.75rem\">",
            "            <button id=\"btnSelAll\">Seleccionar todo</button>",
            "            <button id=\"btnCSV\">Exportar CSV</button>",
            "            <button id=\"btnPage2\">Ir a pág. 2</button>",
            "            <small style=\"color:var(--iswc-text-soft)\">Click en el botón Editar de una fila dispara <code>iswc-action</code>.</small>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\">— eventos —</pre>"
        }
      ]
    },
    {
      "id": "density",
      "title": "Density + columnas + persistencia",
      "lede": "Toolbar: densidad, <strong>Columnas</strong> (checks show/hide), CSV y <strong>Reiniciar</strong> (borra personalización). Sidebar derecha: mismo panel de columnas/filtros. Con <code>remember-state</code> + <code>storage-key</code> se guarda en <code>localStorage['is-webcomponents']['iswc-ag-grid'][key]</code>: orden, visibilidad, anchos, pin, sort y filtros.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-ag-grid id=\"grid-density\" selectable",
            "                      page-size-options=\"10,20,50\"",
            "                      remember-state storage-key=\"demo-density\"",
            "                      style=\"height: 26rem\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"field\": \"sku\",       \"header\": \"SKU\",         \"width\": 100 },",
            "                { \"field\": \"name\",      \"header\": \"Producto\",    \"filter\": true, \"sortable\": true },",
            "                { \"field\": \"category\",  \"header\": \"Categoría\",  \"filter\": true, \"width\": 130 },",
            "                { \"field\": \"stock\",     \"header\": \"Stock\",      \"type\": \"number\", \"width\": 90,  \"align\": \"right\" },",
            "                { \"field\": \"price\",     \"header\": \"Precio\",     \"type\": \"currency\", \"currency\": \"COP\", \"decimals\": 0, \"width\": 130, \"align\": \"right\" },",
            "                { \"field\": \"updated\",   \"header\": \"Actualizado\",\"type\": \"date\", \"dateFormat\": \"short\", \"width\": 120, \"align\": \"right\" }",
            "              ]",
            "            </script>",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"id\": 1,  \"sku\": \"IN-1001\", \"name\": \"Escritorio Ergo Pro\",  \"category\": \"Muebles\",     \"stock\": 24,  \"price\":  890000, \"updated\": \"2026-07-12\" },",
            "                { \"id\": 2,  \"sku\": \"IN-1002\", \"name\": \"Silla LumbarCare\",      \"category\": \"Muebles\",     \"stock\": 6,   \"price\":  420000, \"updated\": \"2026-07-21\" },",
            "                { \"id\": 3,  \"sku\": \"IN-1003\", \"name\": \"Lámpara Halo 360\",      \"category\": \"Iluminación\", \"stock\": 38,  \"price\":  180000, \"updated\": \"2026-06-30\" },",
            "                { \"id\": 4,  \"sku\": \"IN-1004\", \"name\": \"Teclado Mech Tactile\",  \"category\": \"Periféricos\",\"stock\":  0,  \"price\":  320000, \"updated\": \"2026-05-05\" },",
            "                { \"id\": 5,  \"sku\": \"IN-1005\", \"name\": \"Monitor 32\\\" 4K HDR\",   \"category\": \"Pantallas\",   \"stock\": 12,  \"price\": 1850000, \"updated\": \"2026-07-25\" },",
            "                { \"id\": 6,  \"sku\": \"IN-1006\", \"name\": \"Torre servidor 4U\",     \"category\": \"Servidores\",  \"stock\":  4,  \"price\": 4200000, \"updated\": \"2026-07-23\" },",
            "                { \"id\": 7,  \"sku\": \"IN-1007\", \"name\": \"UPS doble conversión\",  \"category\": \"Energía\",     \"stock\": 18,  \"price\":  760000, \"updated\": \"2026-07-19\" },",
            "                { \"id\": 8,  \"sku\": \"IN-1008\", \"name\": \"Switch 24 puertos PoE\", \"category\": \"Redes\",       \"stock\": 11,  \"price\":  620000, \"updated\": \"2026-07-26\" }",
            "              ]",
            "            </script>",
            "          </iswc-ag-grid>",
            "          <div class=\"grid-cta\" style=\"margin-top:.75rem\">",
            "            <button id=\"btnCompact\">Compact</button>",
            "            <button id=\"btnNormal\">Normal</button>",
            "            <button id=\"btnComfy\">Comfortable</button>",
            "            <button id=\"btnResetState\">Reiniciar persistencia</button>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "grouping",
      "title": "Agrupar + agregar",
      "lede": "Arrastra cabeceras al panel de agrupación. Click en una fila de grupo la expande. Botones del panel: expandir/colapsar todos. Las celdas agregadas usan <code>aggFunc</code> por columna (default: <em>sum</em> para números).",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-ag-grid id=\"grid-grouping\" selectable",
            "                      page-size-options=\"10,20\"",
            "                      style=\"height: 26rem\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"field\": \"category\",  \"header\": \"Categoría\",  \"width\": 130, \"rowGroup\": true, \"enableRowGroup\": true },",
            "                { \"field\": \"name\",      \"header\": \"Producto\" },",
            "                { \"field\": \"stock\",     \"header\": \"Stock\",     \"type\": \"number\", \"width\": 90,  \"align\": \"right\", \"aggFunc\": \"sum\" },",
            "                { \"field\": \"price\",     \"header\": \"Ingresos\",  \"type\": \"currency\", \"currency\": \"COP\", \"decimals\": 0, \"width\": 140, \"align\": \"right\", \"aggFunc\": \"sum\" }",
            "              ]",
            "            </script>",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"id\": 1,  \"name\": \"Escritorio Ergo Pro\",  \"category\": \"Muebles\",     \"stock\": 24, \"price\":  890000 },",
            "                { \"id\": 2,  \"name\": \"Silla LumbarCare\",     \"category\": \"Muebles\",     \"stock\":  6, \"price\":  420000 },",
            "                { \"id\": 3,  \"name\": \"Lámpara Halo 360\",     \"category\": \"Iluminación\", \"stock\": 38, \"price\":  180000 },",
            "                { \"id\": 4,  \"name\": \"Teclado Mech Tactile\", \"category\": \"Periféricos\", \"stock\":  0, \"price\":  320000 },",
            "                { \"id\": 5,  \"name\": \"Monitor 32\\\" 4K HDR\",  \"category\": \"Pantallas\",   \"stock\": 12, \"price\": 1850000 },",
            "                { \"id\": 6,  \"name\": \"Torre servidor 4U\",    \"category\": \"Servidores\",  \"stock\":  4, \"price\": 4200000 },",
            "                { \"id\": 7,  \"name\": \"Switch 24 puertos PoE\",\"category\": \"Redes\",       \"stock\": 11, \"price\":  620000 }",
            "              ]",
            "            </script>",
            "          </iswc-ag-grid>"
          ]
        }
      ]
    },
    {
      "id": "filters",
      "title": "Filtros por columna + HeaderMenu",
      "lede": "Click en el ⋮ de cada cabecera: filtro (texto/número/fecha/set), pin, ocultar, autosize, agrupar. Drag del handle entre columnas para redimensionar. Drag del nombre de columna para reordenar (al body o a la izquierda del grupo).",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-ag-grid id=\"grid-filters\" selectable",
            "                      page-size-options=\"5,10,20\"",
            "                      style=\"height: 30rem\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"field\": \"id\",        \"header\": \"ID\",       \"width\": 70,  \"filter\": \"number\" },",
            "                { \"field\": \"name\",      \"header\": \"Producto\", \"filter\": \"text\", \"sortable\": true, \"flex\": 2 },",
            "                { \"field\": \"category\",  \"header\": \"Categoría\",\"filter\": \"set\", \"width\": 140 },",
            "                { \"field\": \"stock\",     \"header\": \"Stock\",   \"type\": \"number\", \"filter\": \"number\", \"width\": 110, \"align\": \"right\" },",
            "                { \"field\": \"price\",     \"header\": \"Precio\",  \"type\": \"currency\", \"currency\": \"COP\", \"decimals\": 0, \"width\": 130, \"align\": \"right\", \"filter\": \"number\" },",
            "                { \"field\": \"updated\",   \"header\": \"Actualizado\", \"type\": \"date\", \"width\": 140, \"filter\": \"date\" }",
            "              ]",
            "            </script>",
            "            <script type=\"application/json\">",
            "              []",
            "            </script>",
            "          </iswc-ag-grid>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const g = document.querySelector('iswc-ag-grid');",
            "g.rows;                  // array vivo (read-only)",
            "g.columns;               // column defs (read-only)",
            "g.api.getRows();",
            "g.api.goToPage(2);                  // legacy 1-based",
            "g.api.setPage(1);                   // nueva (0-based)",
            "g.api.setPageSize(20);",
            "g.api.setQuickFilter('oferta');",
            "g.api.setFilter('stock', 'gt', 5);  // legacy (text)",
            "g.api.setFilterModel({ stock: { type: 'number', op: 'gt', value: 5 } });",
            "g.api.setSortModel([{ colId: 'price', dir: 'desc' }]);",
            "g.api.toggleSort('price', additive);",
            "g.api.pinColumn('sku', 'left'); g.api.hideColumn('tags');",
            "g.api.resizeColumn('price', 160); g.api.autosizeColumn('name');",
            "g.api.reorderColumn('status', 0);",
            "g.api.setRowGroupCols(['category']);",
            "g.api.toggleGroup('Muebles'); g.api.expandAllGroups(); g.api.collapseAllGroups();",
            "g.api.getSelectedRows(); g.api.selectAll(); g.api.clearSelection();",
            "g.api.setDensity('compact');",
            "g.api.exportCSV('grid.csv');",
            "g.api.serializeState();             // JSON { columns, sortModel, filterModel, ... }",
            "g.api.loadState(json);",
            "g.api.resetPersistedState();        // borra localStorage[storage-key] y restaura defs",
            "g.api.openColumnsPanel();",
            "g.api.refresh();",
            "",
            "g.addEventListener('iswc-cell-click',      e => /* { row, column, value } */);",
            "g.addEventListener('iswc-cell-edit',       e => /* { row, column, oldValue, newValue } */);",
            "g.addEventListener('iswc-row-select',      e => /* { rows } */);",
            "g.addEventListener('iswc-sort-change',     e => /* { column, direction } */);",
            "g.addEventListener('iswc-filter-change',   e => /* { column, op, value } */);",
            "g.addEventListener('iswc-quick-filter',    e => /* { value } */);",
            "g.addEventListener('iswc-action',          e => /* { row, column, action } */);",
            "g.addEventListener('iswc-page-change',     e => /* { page, pageSize } */);",
            "g.addEventListener('iswc-column-reorder',  e => /* { colId, toIndex } */);",
            "g.addEventListener('iswc-column-resize',   e => /* { colId, width } */);",
            "g.addEventListener('iswc-column-pin',      e => /* { colId, side } */);",
            "g.addEventListener('iswc-column-hide',     e => /* { colId, hide } */);",
            "g.addEventListener('iswc-state-loaded',    e => /* GridState */);",
            "g.addEventListener('iswc-state-saved',     e => /* { json, key } */);",
            "g.addEventListener('iswc-state-reset',     e => /* { key } */);",
            "",
            "Atributos:",
            "  rows, columns                script JSON o atributo",
            "  get-row-id                   nombre de la propiedad como id (default `id`)",
            "  page-size, page-size-options",
            "  pagination                   boolean (activa pager con count)",
            "  row-selection                single | multiple",
            "  selectable                   boolean — checkbox",
            "  density                      compact | normal | comfortable",
            "  quick-filter                 texto",
            "  group-by                     CSV de colIds iniciales",
            "  remember-state               boolean — persiste en localStorage.is-webcomponents",
            "  storage-key                  keyid bajo is-webcomponents.iswc-ag-grid",
            "  toolbar                      true | false",
            "",
            "Tipos de columna:",
            "  text | number | currency | date | boolean | link | badge/enum | tags | actions",
            "",
            "Atributos por columna:",
            "  field, header, width, align (left|right|center), flex",
            "  sortable, resizable, hide, filterType (text|number|date|set)",
            "  rowGroup, enableRowGroup, aggFunc (sum|avg|min|max|count|first|last)",
            "  cellStyle (objeto CSS)",
            "  editable (true = prompt)",
            "  type, decimals, format, currency, dateFormat",
            "  enumColors (map valor → color CSS)",
            "  actions ([{ icon, label, value }, …])   type=actions",
            "",
            "Tokens CSS en el host:",
            "  --iswc-grid-row-h, --iswc-grid-header-h, --iswc-grid-header-bg,",
            "  --iswc-grid-stripe, --iswc-grid-row-hover, --iswc-grid-selected,",
            "  --iswc-grid-selected-bar, --iswc-grid-accent-row",
            ""
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
