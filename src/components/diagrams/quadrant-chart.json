{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-quadrant-chart",
  "category": "diagrams",
  "title": "&lt;iswc-quadrant-chart&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-quadrant-chart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Matriz 2×2 en SVG: dos ejes continuos, cuatro cuadrantes nombrados y los puntos ubicados en 0..1.",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Es el diagrama de priorización de siempre (impacto/esfuerzo, costo/calidad). Las etiquetas que caen juntas se apilan solas para no encimarse.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-quadrant-chart open-on-click>",
            "  <script type=\"application/json\">",
            "    {",
            "      \"quadrant\": {",
            "        \"title\": \"Modelos por etapa\",",
            "        \"xAxis\": { \"left\": \"Menor costo\", \"right\": \"Mayor costo\" },",
            "        \"yAxis\": { \"bottom\": \"Menor calidad\", \"top\": \"Mayor calidad\" },",
            "        \"quadrants\": {",
            "          \"topLeft\": \"Elegir\",",
            "          \"topRight\": \"Justificar\",",
            "          \"bottomLeft\": \"Descartar\",",
            "          \"bottomRight\": \"Evitar\"",
            "        },",
            "        \"groups\": [",
            "          { \"id\": \"g-chat\", \"name\": \"Conversación\", \"hue\": 210 },",
            "          { \"id\": \"g-ops\", \"name\": \"Operativo\", \"hue\": 160 }",
            "        ],",
            "        \"points\": [",
            "          { \"id\": \"p1\", \"label\": \"Modelo rápido\", \"x\": 0.24, \"y\": 0.72, \"group\": \"g-ops\" },",
            "          { \"id\": \"p2\", \"label\": \"Modelo razonador\", \"x\": 0.78, \"y\": 0.86, \"group\": \"g-chat\" },",
            "          { \"id\": \"p3\", \"label\": \"Modelo mínimo\", \"x\": 0.18, \"y\": 0.3, \"group\": \"g-ops\" },",
            "          { \"id\": \"p4\", \"label\": \"Modelo heredado\", \"x\": 0.66, \"y\": 0.28, \"group\": \"g-chat\" }",
            "        ]",
            "      }",
            "    }",
            "  </script>",
            "</iswc-quadrant-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            }
          ]
        }
      ]
    },
    {
      "id": "app-api",
      "title": "App API",
      "lede": "El mismo documento se abre en el visor o en el editor. El parámetro json no se reescribe al modificar el diagrama.",
      "blocks": [
        {
          "kind": "html",
          "html": "<p><a href=\"demos/diagramas/app/view.html?kind=quadrant\" target=\"_blank\" rel=\"noopener\">Abrir visor</a> · <a href=\"demos/diagramas/app/edit.html?kind=quadrant\" target=\"_blank\" rel=\"noopener\">Abrir editor</a></p>"
        }
      ]
    }
  ],
