{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-card",
  "category": "layout",
  "title": "&lt;iswc-card&gt;",
  "titleHtml": false,
  "description": "Documentación y demos del componente iswc-card de InSoft.",
  "storageKey": "docs-iswc-card",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Contenedor flexible con slots para <code class=\"code\">media</code>, <code class=\"code\">header</code>,",
        "          <code class=\"code\">body</code>, <code class=\"code\">footer</code> y <code class=\"code\">actions</code>.",
        "          Cinco apariencias y dos orientaciones."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">caso mínimo</span>",
            "          <iswc-card>Hola mundo</iswc-card>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:variant",
              "label": "variant",
              "options": [
                "accent",
                "filled",
                "outlined",
                "filled-outlined",
                "plain"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "appearances",
      "title": "Apariencias",
      "lede": [
        "El atributo <code class=\"code\">appearance</code> define el tratamiento visual.",
        "          Default: <code class=\"code\">outlined</code>."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<div class=\"card-grid\">",
            "          <iswc-card variant=\"outlined\">",
            "            <strong>outlined</strong>",
            "            <p class=\"card-meta\">Borde 1px, fondo transparente.</p>",
            "          </iswc-card>",
            "          <iswc-card variant=\"filled\">",
            "            <strong>filled</strong>",
            "            <p class=\"card-meta\">Fondo elevado, sin borde.</p>",
            "          </iswc-card>",
            "          <iswc-card variant=\"filled-outlined\">",
            "            <strong>filled-outlined</strong>",
            "            <p class=\"card-meta\">Fondo + borde.</p>",
            "          </iswc-card>",
            "          <iswc-card variant=\"plain\">",
            "            <strong>plain</strong>",
            "            <p class=\"card-meta\">Sin fondo ni borde, solo espaciado.</p>",
            "          </iswc-card>",
            "          <iswc-card variant=\"accent\">",
            "            <strong>accent</strong>",
            "            <p class=\"card-meta\">Borde lateral de color de marca.</p>",
            "          </iswc-card>",
            "        </div>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-card variant=\"accent\">...</iswc-card>",
            "<iswc-card variant=\"filled-outlined\">...</iswc-card>"
          ]
        }
      ]
    },
    {
      "id": "vertical-full",
      "title": "Vertical con header, media y footer",
      "lede": [
        "Composición vertical completa. El slot <code class=\"code\">media</code> va arriba,",
        "          <code class=\"code\">header</code> debajo, <code class=\"code\">body</code> en el centro y",
        "          <code class=\"code\">footer</code> al final."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<div class=\"card-stage-h\">",
            "          <iswc-card style=\"max-width: 360px; width: 100%;\">",
            "            <div slot=\"media\">",
            "              <div class=\"card-demo-img\" role=\"img\" aria-label=\"Mockup\"></div>",
            "            </div>",
            "            <div slot=\"header\"><strong>Notificación importante</strong></div>",
            "            <p>Hemos detectado actividad inusual en tu cuenta. Revisa los detalles y confirma si fuiste tú.</p>",
            "            <div slot=\"footer\" class=\"card-row-actions\">",
            "              <iswc-button color=\"neutral\" variant=\"plain\">Más tarde</iswc-button>",
            "              <iswc-button color=\"brand\">Revisar</iswc-button>",
            "            </div>",
            "          </iswc-card>",
            "        </div>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-card>",
            "  <div slot=\"media\"><img src=\"...\" alt=\"...\"/></div>",
            "  <div slot=\"header\">Título</div>",
            "  Contenido del body.",
            "  <div slot=\"footer\">",
            "    <iswc-button>Cancelar</iswc-button>",
            "    <iswc-button color=\"brand\">Aceptar</iswc-button>",
            "  </div>",
            "</iswc-card>"
          ]
        }
      ]
    },
    {
      "id": "horizontal",
      "title": "Horizontal",
      "lede": [
        "Con <code class=\"code\">orientation=\"horizontal\"</code> el card se vuelve una fila:",
        "          <code class=\"code\">media</code> a la izquierda, <code class=\"code\">body</code> crece, <code class=\"code\">actions</code> a la derecha."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<div class=\"card-stage-h\">",
            "          <iswc-card orientation=\"horizontal\" style=\"max-width: 560px; width: 100%;\">",
            "            <div slot=\"media\">",
            "              <iswc-icon icon=\"mdi:bell-ring-outline\" style=\"font-size: 2.4rem; color: var(--iswc-accent);\"></iswc-icon>",
            "            </div>",
            "            <div>",
            "              <strong>Nueva mención</strong>",
            "              <p class=\"card-meta\">Te han mencionado en <code>#general</code> hace 3 min.</p>",
            "            </div>",
            "            <div slot=\"actions\" class=\"card-row-actions\">",
            "              <iswc-button color=\"neutral\" variant=\"outlined\">Ignorar</iswc-button>",
            "              <iswc-button color=\"brand\">Ver</iswc-button>",
            "            </div>",
            "          </iswc-card>",
            "        </div>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-card orientation=\"horizontal\">",
            "  <iswc-icon slot=\"media\" icon=\"mdi:bell\"></iswc-icon>",
            "  <strong>Nueva mención</strong>",
            "  <div slot=\"actions\"><iswc-button>Ver</iswc-button></div>",
            "</iswc-card>"
          ]
        }
      ]
    },
    {
      "id": "header-footer-actions",
      "title": "Header / footer con acciones",
      "lede": [
        "Slots <code class=\"code\">header-actions</code> y <code class=\"code\">footer-actions</code>",
        "          reservan un extremo del header/footer para botones o iconos."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<div class=\"card-stage-h\">",
            "          <iswc-card style=\"max-width: 420px; width: 100%;\">",
            "            <div slot=\"header\"><strong>Proyecto InSoft</strong></div>",
            "            <div slot=\"header-actions\">",
            "              <iswc-button color=\"neutral\" variant=\"plain\" pill title=\"Más opciones\">",
            "                <iswc-icon icon=\"mdi:dots-horizontal\"></iswc-icon>",
            "              </iswc-button>",
            "            </div>",
            "            <p>Repositorio privado con 3 issues abiertos y 12 PRs en revisión.</p>",
            "            <div slot=\"footer\" class=\"card-meta\">Actualizado hace 2 horas</div>",
            "            <div slot=\"footer-actions\">",
            "              <iswc-button color=\"brand\" variant=\"outlined\">Ver repo</iswc-button>",
            "            </div>",
            "          </iswc-card>",
            "        </div>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-card>",
            "  <strong slot=\"header\">Título</strong>",
            "  <iswc-button slot=\"header-actions\">...</iswc-button>",
            "  Contenido.",
            "  <span slot=\"footer\">Meta</span>",
            "  <iswc-button slot=\"footer-actions\">CTA</iswc-button>",
            "</iswc-card>"
          ]
        }
      ]
    },
    {
      "id": "methods",
      "title": "API JavaScript",
      "lede": "Como cualquier custom element, accedes con <code class=\"code\">document.querySelector('iswc-card')</code>.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Propiedad",
            "Descripción"
          ],
          "rows": [
            [
              "<code>appearance</code>",
              "Tratamiento visual (atributo reflected)."
            ],
            [
              "<code>orientation</code>",
              "Layout del card (atributo reflected)."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h4>Demo en vivo</h4>"
        },
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">cambia propiedades</span>",
            "          <iswc-card id=\"apiCard\" variant=\"outlined\">",
            "            <strong id=\"apiLabel\">Hola</strong>",
            "            <p class=\"card-meta\">Cambia appearance / orientation desde los botones.</p>",
            "          </iswc-card>",
            "          <div class=\"demo-row\" style=\"margin-top: 12px; flex-wrap: wrap;\">",
            "            <iswc-button id=\"apiOutlined\"  color=\"neutral\" variant=\"outlined\">outlined</iswc-button>",
            "            <iswc-button id=\"apiFilled\"    color=\"neutral\" variant=\"outlined\">filled</iswc-button>",
            "            <iswc-button id=\"apiFilledOut\"  color=\"neutral\" variant=\"outlined\">filled-outlined</iswc-button>",
            "            <iswc-button id=\"apiAccent\"     color=\"neutral\" variant=\"outlined\">accent</iswc-button>",
            "            <iswc-button id=\"apiPlain\"      color=\"neutral\" variant=\"outlined\">plain</iswc-button>",
            "            <iswc-button id=\"apiOrient\"     color=\"brand\" variant=\"outlined\">toggle orientation</iswc-button>",
            "          </div>",
            "          <div class=\"log\" id=\"apiLog\" aria-live=\"polite\" style=\"margin-top: 12px;\">",
            "            <div class=\"row hint\">El log aparece al cambiar appearance u orientation.</div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-card\" default-tab=\"slots\">",
            "  <iswc-card>",
            "    <strong>Titulo de la tarjeta</strong>",
            "    <p>Descripcion principal del card.</p>",
            "  </iswc-card>",
            "  <div slot=\"media\" style=\"background: linear-gradient(135deg, #4f46e5, #06b6d4); height: 80px; border-radius: 8px;\"></div>",
            "  <strong slot=\"header\">Notificacion</strong>",
            "  <iswc-button slot=\"header-actions\" color=\"neutral\" variant=\"plain\" pill title=\"Mas opciones\">",
            "    <iswc-icon icon=\"mdi:dots-horizontal\"></iswc-icon>",
            "  </iswc-button>",
            "  <span slot=\"footer\">Hace 2 horas</span>",
            "  <iswc-button slot=\"footer-actions\" color=\"brand\" variant=\"outlined\">Ver mas</iswc-button>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-card\" default-tab=\"slots\">",
            "  <iswc-card>",
            "    <strong>Titulo de la tarjeta</strong>",
            "    <p>Descripcion principal del card.</p>",
            "  </iswc-card>",
            "  <div slot=\"media\" style=\"background: linear-gradient(135deg, #4f46e5, #06b6d4); height: 80px; border-radius: 8px;\"></div>",
            "  <strong slot=\"header\">Notificacion</strong>",
            "  <iswc-button slot=\"header-actions\" color=\"neutral\" variant=\"plain\" pill title=\"Mas opciones\">",
            "    <iswc-icon icon=\"mdi:dots-horizontal\"></iswc-icon>",
            "  </iswc-button>",
            "  <span slot=\"footer\">Hace 2 horas</span>",
            "  <iswc-button slot=\"footer-actions\" color=\"brand\" variant=\"outlined\">Ver mas</iswc-button>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia completa",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3>Atributos / propiedades</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>appearance</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Tratamiento visual. Reflected. (valor por defecto)"
            ],
            [
              "<code>orientation</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Layout. Reflected. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Slots</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Slot",
            "Descripción"
          ],
          "rows": [
            [
              "<code>(default)</code>",
              "Cuerpo principal (body, siempre presente)."
            ],
            [
              "<code>media</code>",
              "Sección de medios. Vertical: arriba. Horizontal: izquierda."
            ],
            [
              "<code>header</code>",
              "Encabezado (solo vertical)."
            ],
            [
              "<code>footer</code>",
              "Pie (solo vertical)."
            ],
            [
              "<code>actions</code>",
              "Acciones (solo horizontal, extremo derecho)."
            ],
            [
              "<code>header-actions</code>",
              "Acciones dentro del header (solo vertical)."
            ],
            [
              "<code>footer-actions</code>",
              "Acciones dentro del footer (solo vertical)."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>CSS Parts</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Part",
            "Descripción"
          ],
          "rows": [
            [
              "<code>::part(media)</code>",
              "Contenedor del slot <code>media</code>."
            ],
            [
              "<code>::part(header)</code>",
              "Contenedor del slot <code>header</code>."
            ],
            [
              "<code>::part(body)</code>",
              "Contenedor del slot por defecto."
            ],
            [
              "<code>::part(footer)</code>",
              "Contenedor del slot <code>footer</code>."
            ],
            [
              "<code>::part(actions)</code>",
              "Contenedor del slot <code>actions</code>."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>CSS custom properties</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Variable",
            "Descripción"
          ],
          "rows": [
            [
              "<code>--spacing</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Padding y gap entre secciones. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "callout",
          "html": [
            "<strong>Nota:</strong> AppWebcomponents no hace SSR; la detección de slots",
            "          vacíos se hace en cliente vía <code>slotchange</code>."
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Contenedor flexible con slots para <code class=\"code\">media</code>, <code class=\"code\">header</code>,",
          "          <code class=\"code\">body</code>, <code class=\"code\">footer</code> y <code class=\"code\">actions</code>.",
          "          Cinco apariencias y dos orientaciones."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>appearance</code>",
            "type": "accent · filled · outlined · filled-outlined · plain",
            "default": "outlined",
            "desc": "Tratamiento visual. Reflected."
          },
          {
            "name": "<code>orientation</code>",
            "type": "horizontal · vertical",
            "default": "vertical",
            "desc": "Layout. Reflected."
          },
          {
            "name": "<code>--spacing</code>",
            "default": "<code>var(--iswc-space-l, 1rem)</code>",
            "desc": "Padding y gap entre secciones."
          }
        ]
      },
      "slots": {
        "table": [
          {
            "slot": "<code>(default)</code>",
            "desc": "Cuerpo principal (body, siempre presente)."
          },
          {
            "slot": "<code>media</code>",
            "desc": "Sección de medios. Vertical: arriba. Horizontal: izquierda."
          },
          {
            "slot": "<code>header</code>",
            "desc": "Encabezado (solo vertical)."
          },
          {
            "slot": "<code>footer</code>",
            "desc": "Pie (solo vertical)."
          },
          {
            "slot": "<code>actions</code>",
            "desc": "Acciones (solo horizontal, extremo derecho)."
          },
          {
            "slot": "<code>header-actions</code>",
            "desc": "Acciones dentro del header (solo vertical)."
          },
          {
            "slot": "<code>footer-actions</code>",
            "desc": "Acciones dentro del footer (solo vertical)."
          }
        ]
      },
      "parts": {
        "table": [
          {
            "part": "<code>::part(media)</code>",
            "desc": "Contenedor del slot <code>media</code>."
          },
          {
            "part": "<code>::part(header)</code>",
            "desc": "Contenedor del slot <code>header</code>."
          },
          {
            "part": "<code>::part(body)</code>",
            "desc": "Contenedor del slot por defecto."
          },
          {
            "part": "<code>::part(footer)</code>",
            "desc": "Contenedor del slot <code>footer</code>."
          },
          {
            "part": "<code>::part(actions)</code>",
            "desc": "Contenedor del slot <code>actions</code>."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-card>Hola mundo</iswc-card>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "props",
      "states"
    ]
  }
}
