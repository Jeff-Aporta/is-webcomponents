              "<code>position-in-pixels</code>",
              "Posición en píxeles. Sobrevive a resize."
            ],
            [
              "<code>orientation</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Eje del divisor. (valor por defecto)"
            ],
            [
              "<code>primary</code>",
              "Panel que mantiene tamaño al resize."
            ],
