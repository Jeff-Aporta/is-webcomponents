            "          \"label\": \"end crece\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"H\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"V\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
