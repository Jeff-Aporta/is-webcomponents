            "          \"label\": \"primary=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"start crece\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
