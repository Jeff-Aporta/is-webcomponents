{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-divider",
  "category": "layout",
  "title": "&lt;iswc-divider&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-divider",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Separador horizontal o vertical. Opacidad default <code class=\"code\">20</code>; color vía tokens del theme.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<p>Sección A</p>",
            "          <iswc-divider></iswc-divider>",
            "          <p>Sección B</p>"
          ],
          "controls": [
            {
              "control": "number",
              "prop": "attr:opacity",
              "label": "opacity",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "text",
                "text-soft",
                "text-dim",
                "border",
                "control",
                "brand",
                "accent",
                "success",
                "warning",
                "danger"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Vertical · opacidad · colores",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:flex;align-items:stretch;height:3rem;gap:0\">",
            "            <span style=\"padding:0 1rem;display:flex;align-items:center\">Izq</span>",
            "            <iswc-divider orientation=\"vertical\"></iswc-divider>",
            "            <span style=\"padding:0 1rem;display:flex;align-items:center\">Der</span>",
            "          </div>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-direction:column;gap:0;width:100%\">",
            "            <span class=\"demo-label\">opacity 20 · 50 · 100</span>",
            "            <iswc-divider opacity=\"20\"></iswc-divider>",
            "            <iswc-divider opacity=\"50\"></iswc-divider>",
            "            <iswc-divider opacity=\"100\"></iswc-divider>",
            "          </div>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-direction:column;gap:0.35rem;width:100%\">",
            "            <span class=\"demo-label\">color theme</span>",
            "            <iswc-divider color=\"text\" opacity=\"80\"></iswc-divider>",
            "            <iswc-divider color=\"brand\" opacity=\"80\"></iswc-divider>",
            "            <iswc-divider color=\"success\" opacity=\"80\"></iswc-divider>",
            "            <iswc-divider color=\"warning\" opacity=\"80\"></iswc-divider>",
            "            <iswc-divider color=\"danger\" opacity=\"80\"></iswc-divider>",
            "            <iswc-divider color=\"border\" opacity=\"100\"></iswc-divider>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / var"
          ],
          "rows": [
            [
              "<code>orientation</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>opacity</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>color</code>"
            ],
            [
              "<code>--color</code>"
            ],
            [
              "<code>--opacity</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>--width</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>--spacing</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Separador horizontal o vertical. Opacidad default <code class=\"code\">20</code>; color vía tokens del theme."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>orientation</code>",
            "default": "horizontal"
          },
          {
            "name": "<code>opacity</code>",
            "default": "20 (0–100)"
          },
          {
            "name": "<code>color</code>",
            "default": "text · text-soft · text-dim · border · control · brand · accent · success · warning · danger"
          },
          {
            "name": "<code>--color</code>",
            "default": "override CSS (gana sobre attr color si se setea en el host)"
          },
          {
            "name": "<code>--opacity</code>",
            "default": "0.2"
          },
          {
            "name": "<code>--width</code>",
            "default": "1px"
          },
          {
            "name": "<code>--spacing</code>",
            "default": "0.75em"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<p>Sección A</p>",
          "          <iswc-divider></iswc-divider>",
          "          <p>Sección B</p>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
