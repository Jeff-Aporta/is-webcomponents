{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-divider",
  "category": "layout",
  "title": "&lt;iswc-divider&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-divider",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Separador horizontal o vertical. Opacidad default <code class=\"code\">20</code>; color vía tokens del theme.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p>Sección A</p>\r\n          <iswc-divider></iswc-divider>\r\n          <p>Sección B</p>",
          "controls": [
            {
              "control": "number",
              "prop": "attr:opacity",
              "label": "opacity",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "text",
                "text-soft",
                "text-dim",
                "border",
                "control",
                "brand",
                "accent",
                "success",
                "warning",
                "danger"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Vertical · opacidad · colores",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"display:flex;align-items:stretch;height:3rem;gap:0\">\r\n            <span style=\"padding:0 1rem;display:flex;align-items:center\">Izq</span>\r\n            <iswc-divider orientation=\"vertical\"></iswc-divider>\r\n            <span style=\"padding:0 1rem;display:flex;align-items:center\">Der</span>\r\n          </div>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"flex-direction:column;gap:0;width:100%\">\r\n            <span class=\"demo-label\">opacity 20 · 50 · 100</span>\r\n            <iswc-divider opacity=\"20\"></iswc-divider>\r\n            <iswc-divider opacity=\"50\"></iswc-divider>\r\n            <iswc-divider opacity=\"100\"></iswc-divider>\r\n          </div>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"flex-direction:column;gap:0.35rem;width:100%\">\r\n            <span class=\"demo-label\">color theme</span>\r\n            <iswc-divider color=\"text\" opacity=\"80\"></iswc-divider>\r\n            <iswc-divider color=\"brand\" opacity=\"80\"></iswc-divider>\r\n            <iswc-divider color=\"success\" opacity=\"80\"></iswc-divider>\r\n            <iswc-divider color=\"warning\" opacity=\"80\"></iswc-divider>\r\n            <iswc-divider color=\"danger\" opacity=\"80\"></iswc-divider>\r\n            <iswc-divider color=\"border\" opacity=\"100\"></iswc-divider>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-divider></iswc-divider>\n<iswc-divider opacity=\"80\" color=\"brand\"></iswc-divider>\n<iswc-divider orientation=\"vertical\" color=\"accent\"></iswc-divider>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
