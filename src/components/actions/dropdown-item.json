            "      \"title\": \"iswc-dropdown-item: tipo\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"type=checkbox?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"toggle + aria-checked\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"slot submenu?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
