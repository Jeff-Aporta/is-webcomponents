              "prop": "attr:text",
              "label": "text",
              "default": "Galería is-*"
            },
            {
              "control": "text",
              "prop": "attr:url",
              "label": "url",
              "default": "https://jeff-aporta.github.io/is-webcomponents/"
            },
            {
              "control": "boolean",
