    {
      "id": "placement",
      "title": "Tooltip placement",
      "lede": "El tooltip es un <code class=\"code\">is-tooltip</code> interno, así que acepta los\r\n          doce placements de <code class=\"code\">is-popover</code> y hace flip solo si no cabe\r\n          en la dirección pedida.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"placements\">\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"top\" tooltip-placement=\"top\" copy-label=\"top\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">top</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"top-start\" tooltip-placement=\"top-start\" copy-label=\"top-start\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">top-start</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"top-end\" tooltip-placement=\"top-end\" copy-label=\"top-end\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">top-end</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"right\" tooltip-placement=\"right\" copy-label=\"right\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">right</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"right-start\" tooltip-placement=\"right-start\" copy-label=\"right-start\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">right-start</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"right-end\" tooltip-placement=\"right-end\" copy-label=\"right-end\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">right-end</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"bottom\" tooltip-placement=\"bottom\" copy-label=\"bottom\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">bottom</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"bottom-start\" tooltip-placement=\"bottom-start\" copy-label=\"bottom-start\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">bottom-start</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"bottom-end\" tooltip-placement=\"bottom-end\" copy-label=\"bottom-end\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">bottom-end</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"left\" tooltip-placement=\"left\" copy-label=\"left\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">left</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"left-start\" tooltip-placement=\"left-start\" copy-label=\"left-start\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">left-start</small>\r\n            </span>\r\n            <span class=\"placement-cell\">\r\n              <is-copy-button value=\"left-end\" tooltip-placement=\"left-end\" copy-label=\"left-end\"></is-copy-button>\r\n              <small class=\"placement-cell__name\">left-end</small>\r\n            </span>\r\n          </div>"
        },
