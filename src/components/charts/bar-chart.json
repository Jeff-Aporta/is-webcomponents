  "titleHtml": false,
  "storageKey": "docs-iswc-bar-chart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Barras para comparar cantidades entre categorías.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-bar-chart open-on-click stacked>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Excelente\", \"Bueno\", \"Regular\", \"Malo\"],",
            "                  \"datasets\": [{ \"label\": \"Respuestas\", \"data\": [45, 30, 18, 7] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-bar-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "boolean",
              "prop": "attr:stacked",
              "label": "stacked"
            }
          ]
        }
      ]
    }
  ],
