{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-bar-chart",
  "category": "data-viz",
  "title": "&lt;iswc-bar-chart&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-bar-chart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Barras para comparar cantidades entre categorías.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-bar-chart open-on-click stacked>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Excelente\", \"Bueno\", \"Regular\", \"Malo\"],",
            "                  \"datasets\": [{ \"label\": \"Enero\", \"data\": [45, 30, 18, 7] }, { \"label\": \"Febrero\", \"data\": [38, 34, 20, 8] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-bar-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "boolean",
              "prop": "attr:stacked",
              "label": "stacked"
            },
            {
              "control": "text",
              "prop": "attr:label",
              "label": "label"
            },
            {
              "control": "select",
              "prop": "attr:legend-position",
              "label": "legend-position",
              "options": [
                "top",
                "bottom",
                "start",
                "end"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:without-legend",
              "label": "without-legend"
            },
            {
              "control": "boolean",
              "prop": "attr:without-tooltip",
              "label": "without-tooltip"
            },
            {
              "control": "boolean",
              "prop": "attr:without-animation",
              "label": "without-animation"
            },
            {
              "control": "select",
              "prop": "attr:index-axis",
              "label": "index-axis",
              "options": [
                "x",
                "y"
              ]
            },
            {
              "control": "text",
              "prop": "attr:x-label",
              "label": "x-label"
            },
            {
              "control": "text",
              "prop": "attr:y-label",
              "label": "y-label"
            }
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Barras para comparar cantidades entre categorías."
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-bar-chart open-on-click stacked>",
          "            <script type=\"application/json\">",
          "              {",
          "                \"data\": {",
          "                  \"labels\": [\"Excelente\", \"Bueno\", \"Regular\", \"Malo\"],",
          "                  \"datasets\": [{ \"label\": \"Respuestas\", \"data\": [45, 30, 18, 7] }]",
          "                }",
          "              }",
          "            </script>",
          "          </iswc-bar-chart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  },
  "description": "Gráfica de barras verticales u horizontales, agrupadas o apiladas, en SVG."
}
