{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-treemap",
  "category": "data-viz",
  "title": "&lt;iswc-treemap&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-treemap",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Treemap anidado en SVG, con el algoritmo squarified (Bruls/Huizing/",
        "          van Wijk): rectángulos con aspect-ratio cercano a 1, sin huecos ni",
        "          solapes."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p>",
            "          Declaras nodos con <code>value</code> y un <code>parent</code>",
            "          opcional; el componente arma la jerarquía y tesela cada nivel dentro",
            "          del rect de su padre.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-treemap open-on-click>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"treemap\": {",
            "                  \"title\": \"Estructura del activo\",",
            "                  \"nodes\": [",
            "                    { \"id\": \"inv\", \"label\": \"Inventario\", \"value\": 3200, \"hue\": 239 },",
            "                    { \"id\": \"inv-a\", \"parent\": \"inv\", \"label\": \"Materia prima\", \"value\": 1800 },",
            "                    { \"id\": \"inv-b\", \"parent\": \"inv\", \"label\": \"Producto terminado\", \"value\": 900 },",
            "                    { \"id\": \"inv-c\", \"parent\": \"inv\", \"label\": \"En proceso\", \"value\": 500 },",
            "                    { \"id\": \"cxc\", \"label\": \"Cartera\", \"value\": 2100, \"hue\": 199 },",
            "                    { \"id\": \"cxc-a\", \"parent\": \"cxc\", \"label\": \"Corriente\", \"value\": 1500 },",
            "                    { \"id\": \"cxc-b\", \"parent\": \"cxc\", \"label\": \"Vencida\", \"value\": 600 },",
            "                    { \"id\": \"caja\", \"label\": \"Caja y bancos\", \"value\": 1400, \"hue\": 38 },",
            "                    { \"id\": \"otros\", \"label\": \"Otros activos\", \"value\": 700, \"hue\": 280 }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-treemap>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            }
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3>Atributos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Nombre",
            "Valores",
            "Descripción"
          ],
          "rows": [
            [
              "<code>variant</code>",
              "<code>inline</code> · <code>viewer</code>",
              "inline abre el visor al hacer clic; viewer activa hover y tooltips."
            ],
            [
              "<code>open-on-click</code>",
              "booleano",
              "Habilita abrir el visor a pantalla completa al hacer clic. Por defecto el componente no tiene visor."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Esquema del JSON</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Campo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>nodes[].id</code>",
              "Identificador único."
            ],
            [
              "<code>nodes[].parent</code>",
              "Id del nodo padre; sin él, el nodo es un nivel raíz."
            ],
            [
              "<code>nodes[].label</code>",
              "Texto del rótulo (se oculta si el rect es muy chico)."
            ],
            [
              "<code>nodes[].value</code>",
              "Peso del rectángulo entre sus hermanos."
            ],
            [
              "<code>nodes[].hue</code>",
              "Tono HSL 0–360; si no se fija, hereda el de su rama de nivel raíz."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Propiedades y eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Nombre",
            "Descripción"
          ],
          "rows": [
            [
              "<code>payload</code>",
              "Configuración JSON; alternativa al script hijo."
            ],
            [
              "<code>layout</code>",
              "Geometría calculada (solo lectura)."
            ],
            [
              "<code>iswc-render</code>",
              "Evento: el SVG terminó de construirse."
            ],
            [
              "<code>iswc-open-viewer</code>",
              "Evento: se solicitó abrir el visor a pantalla completa."
            ]
          ]
        }
      ]
    }
  ],
