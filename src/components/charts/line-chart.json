{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-line-chart",
  "category": "data-viz",
  "title": "&lt;iswc-line-chart&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-line-chart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Tendencias en el tiempo.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-line-chart open-on-click>",
            "            <script type=\"application/json\">",
            "              {\"data\":{\"labels\":[\"Ene\",\"Feb\",\"Mar\",\"Abr\",\"May\",\"Jun\"],\"datasets\":[{\"label\":\"Visitas\",\"data\":[4200,4800,5100,4900,5500,6200]}]}}",
            "            </script>",
            "          </iswc-line-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "text",
              "prop": "attr:label",
              "label": "label"
            },
            {
              "control": "select",
              "prop": "attr:legend-position",
              "label": "legend-position",
              "options": [
                "top",
                "bottom",
                "start",
                "end"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:without-legend",
              "label": "without-legend"
            },
            {
              "control": "boolean",
              "prop": "attr:without-tooltip",
              "label": "without-tooltip"
            },
            {
              "control": "boolean",
              "prop": "attr:without-animation",
              "label": "without-animation"
            },
            {
              "control": "text",
              "prop": "attr:x-label",
              "label": "x-label"
            },
            {
              "control": "text",
              "prop": "attr:y-label",
              "label": "y-label"
            }
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Tendencias en el tiempo."
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-line-chart open-on-click>",
          "            <script type=\"application/json\">",
          "              {\"data\":{\"labels\":[\"Ene\",\"Feb\",\"Mar\",\"Abr\",\"May\",\"Jun\"],\"datasets\":[{\"label\":\"Visitas\",\"data\":[4200,4800,5100,4900,5500,6200]}]}}",
          "            </script>",
          "          </iswc-line-chart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  },
  "description": "Gráfica de líneas para series a lo largo de un eje continuo, con puntos y área opcional."
}
