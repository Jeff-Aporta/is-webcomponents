{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-icon",
  "category": "media",
  "title": "&lt;iswc-icon&gt;",
  "titleHtml": false,
  "styles": ".xp-embed {\r\n      border: 1px solid var(--iswc-border);\r\n      border-radius: 0.6rem;\r\n      overflow: hidden;\r\n      background: var(--iswc-bg);\r\n      /* Alto fijo: el explorador scrollea internamente (su .xp), así que un\r\n         alto en auto lo colapsaría a 0. */\r\n      height: min(72vh, 720px);\r\n    }\r\n    .xp-embed iframe { display: block; width: 100%; height: 100%; border: 0; }",
  "storageKey": "docs-iswc-icon",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "API única de iconos del kit. Usa <code class=\"code\">icon=\"grupo:nombre\"</code> (ids Iconify)\r\n          o <code class=\"code\">src</code> para un SVG/imagen. Escala con <code class=\"code\">font-size</code>.\r\n          Iconify se carga solo como dependencia interna.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"font-size:1.5rem; gap:1rem; align-items:center;\">\r\n            <iswc-icon id=\"pgIcon\" icon=\"mdi:home\"></iswc-icon>\r\n          </div>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Favorito",
                "Corazón"
              ]
            },
            {
              "control": "text",
              "prop": "attr:src",
              "label": "src"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Ejemplos",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">src personalizado</span>\r\n          <iswc-icon src=\"{assets}icons/mdi/heart.svg\" label=\"Corazón\" style=\"font-size:1.5rem;color:var(--iswc-accent)\"></iswc-icon>"
        },
        {
          "kind": "code",
          "code": "<iswc-icon icon=\"mdi:home\"></iswc-icon>\n<iswc-icon icon=\"mdi:check-circle\"></iswc-icon>\n<iswc-icon src=\"./logo.svg\" label=\"Logo\"></iswc-icon>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default",
            "Descripción"
          ],
          "rows": [
            [
              "<code>icon</code>",
              "—",
              "Iconify id <code>grupo:nombre</code> (ej. <code>mdi:home</code>)."
            ],
            [
              "<code>label</code>",
              "—",
              "aria-label; vacío → aria-hidden."
            ],
            [
              "<code>src</code>",
              "—",
              "URL img/svg (gana sobre icon)."
            ]
          ]
        }
      ]
    },
    {
      "id": "explorer",
      "title": "Explorador de iconos",
      "lede": "Las <b id=\"xpFamilies\">231</b> familias servidas por el CDN, con buscador global,\r\n          filtros por categoría, grid, paleta y licencia, y un personalizador que exporta\r\n          SVG, CSS o PNG. Es la misma página que <code class=\"code\">../_shell.html?tag=icon-explorer</code>,\r\n          embebida aquí.",
      "blocks": [
        {
          "kind": "html",
          "html": "<div class=\"xp-embed\">\r\n          <iframe id=\"xpFrame\" title=\"Explorador de iconos\" loading=\"lazy\"></iframe>\r\n        </div>\r\n        <p>\r\n          <iswc-button id=\"xpOpen\" color=\"neutral\" variant=\"outlined\" href=\"../_shell.html?tag=icon-explorer\" target=\"_blank\" rel=\"noopener\">\r\n            <iswc-icon icon=\"mdi:open-in-new\"></iswc-icon>\r\n            Abrir en una pestaña\r\n          </iswc-button>\r\n        </p>"
        }
      ]
    }
  ],
  "hasBehavior": true,
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "API única de iconos del kit. Usa <code class=\"code\">icon=\"grupo:nombre\"</code> (ids Iconify)\r\n          o <code class=\"code\">src</code> para un SVG/imagen. Escala con <code class=\"code\">font-size</code>.\r\n          Iconify se carga solo como dependencia interna."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>icon</code>",
            "default": "—",
            "desc": "Iconify id <code>grupo:nombre</code> (ej. <code>mdi:home</code>)."
          },
          {
            "name": "<code>label</code>",
            "default": "—",
            "desc": "aria-label; vacío → aria-hidden."
          },
          {
            "name": "<code>src</code>",
            "default": "—",
            "desc": "URL img/svg (gana sobre icon)."
          }
        ]
      },
      "ejemplos": {
        "content": "```html\n<div class=\"demo-row\" style=\"font-size:1.5rem; gap:1rem; align-items:center;\">\r\n            <iswc-icon icon=\"mdi:home\"></iswc-icon>\r\n          </div>\n```"
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
