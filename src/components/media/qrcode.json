{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-qrcode",
  "category": "media",
  "title": "&lt;iswc-qrcode&gt;",
  "titleHtml": false,
  "styles": [
    ".qr-row { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: start; }",
    "    pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .78rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 8rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-qrcode",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "QR en SVG. Carga bajo demanda la lib <code>qrcode-generator</code> (MIT, esm.sh) — sin esa red no funciona.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"qr-row\">",
            "            <iswc-qrcode id=\"pgQr\" value=\"https://iswc-root\" level=\"M\" cell=\"6\"></iswc-qrcode>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:level",
              "label": "level",
              "options": [
                "M",
                "Q",
                "H"
              ]
            },
            {
              "control": "number",
              "prop": "attr:cell",
              "label": "cell",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "text",
              "prop": "attr:bg",
              "label": "bg"
            }
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"qr-row\">",
            "            <iswc-qrcode value=\"mailto:hola@empresa.co\" level=\"Q\" cell=\"6\"></iswc-qrcode>",
            "            <iswc-qrcode value=\"WIFI:T:WPA;S:InSoft;P:clave123;;\" level=\"H\" cell=\"6\"></iswc-qrcode>",
            "          </div>"
          ],
          "heading": "Otros contenidos: mailto, wifi (mismo nivel/cell/bg)"
        }
      ]
    },
    {
      "id": "estilo",
      "title": "Personalizar",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"qr-row\">",
            "            <iswc-qrcode value=\"https://insoft.co\" fg=\"var(--iswc-accent)\" bg=\"var(--iswc-bg-soft)\" cell=\"8\"></iswc-qrcode>",
            "            <iswc-qrcode value=\"https://contapyme.co\" fg=\"var(--iswc-success, #16a34a)\" cell=\"8\"></iswc-qrcode>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "export",
      "title": "Exportar a PNG",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const qr = document.querySelector('iswc-qrcode');",
            "const dataURL = await qr.dataURL('image/png');",
            "// descargar, pegar en input[type=file], etc."
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "// Atributos",
            "// value        texto a codificar (requerido)",
            "// level        L | M | Q | H   (default L)",
            "// cell         tamaño en píxeles de cada módulo (default 4)",
            "// margin       módulos de zona de silencio (default 2)",
            "// fg, bg       colores",
            "",
            "// API JS",
            "qr.svg;        // nodo SVG",
            "qr.dataURL('image/png').then(url => /* … */);",
            "",
            "// Dependencias",
            "// Carga qrcode-generator@1.4.4 desde esm.sh. Si tu build no tiene",
            "// red, vendelo o usa otro loader."
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "QR en SVG. Carga bajo demanda la lib <code>qrcode-generator</code> (MIT, esm.sh) — sin esa red no funciona."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
