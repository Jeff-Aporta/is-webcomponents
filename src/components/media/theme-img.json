      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1.25rem;flex-wrap:wrap;font-size:3rem\">\n            <iswc-theme-img\n              src-dark=\"https://cdn.jsdelivr.net/gh/Jeff-Aporta/is-webcomponents@main/docs/favicon.svg\"\n              src-light=\"https://cdn.jsdelivr.net/gh/Jeff-Aporta/is-webcomponents@main/docs/favicon.svg\"\n              alt=\"Demo\"\n              shape=\"circle\"\n            ></iswc-theme-img>\n            <span style=\"font-size:0.35em;opacity:.7\">cambia el theme-toggle del chrome</span>\n          </div>",
          "controls": [
            {
              "control": "text",
              "prop": "attr:alt",
              "label": "alt"
            }
          ]
        },
        {
          "kind": "code",
          "code": "<span style=\"font-size:2rem\">\n  <iswc-theme-img\n    src-dark=\"./logo-dark.svg\"\n    src-light=\"./logo-light.svg\"\n    alt=\"Marca\"\n    shape=\"circle\"\n  ></iswc-theme-img>\n</span>"
        }
      ]
    }
  ],
