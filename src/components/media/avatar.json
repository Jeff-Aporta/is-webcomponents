{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-avatar",
  "category": "media",
  "title": "&lt;iswc-avatar&gt;",
  "titleHtml": false,
  "styles": "/* Rejilla formas x contenido: se lee como tabla de referencia. */\r\n    .shape-grid {\r\n      display: grid;\r\n      grid-template-columns: auto repeat(3, minmax(0, max-content));\r\n      align-items: center;\r\n      gap: 0.9rem 1.6rem;\r\n      font-size: 2.5rem;\r\n    }\r\n    .shape-grid > code.code { font-size: 0.8rem; }\r\n    .shape-grid__head {\r\n      font-size: 0.7rem;\r\n      font-weight: 700;\r\n      letter-spacing: 0.06em;\r\n      text-transform: uppercase;\r\n      color: var(--iswc-text-soft);\r\n    }\r\n\r\n    /* El acento del \"+N\" va en la parte de iniciales, que si respeta la forma. */\r\n    .stack-more::part(initials) {\r\n      background: var(--iswc-accent);\r\n      color: var(--iswc-on-accent, #fff);\r\n    }\r\n\r\n    .fallback-grid { display: flex; flex-wrap: wrap; gap: 2rem; }\r\n    .fallback-case {\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 0.75rem;\r\n      margin: 0;\r\n      font-size: 2.5rem;\r\n    }\r\n    .fallback-case figcaption {\r\n      display: flex;\r\n      flex-direction: column;\r\n      font-size: 0.85rem;\r\n      line-height: 1.35;\r\n    }\r\n    .fallback-case small { color: var(--iswc-text-soft); }",
  "storageKey": "docs-iswc-avatar",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Avatar con imagen, iniciales o icono fallback. Caja = <code class=\"code\">1em × 1em</code>; escala con <code class=\"code\">font-size</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1rem;flex-wrap:wrap;font-size:3rem\">\r\n            <iswc-avatar id=\"pgAvatar\" initials=\"JD\" label=\"Juan Díaz\"></iswc-avatar>\r\n          </div>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:initials",
              "label": "initials",
              "options": [
                "JD",
                "FB",
                "AN",
                "BE",
                "CA",
                "XS",
                "SM",
                "MD",
                "LG",
                "XL",
                "XXL",
                "NS",
                "+5",
                "MR",
                "OK",
                "ER"
              ]
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Juan Díaz",
                "Usuario demo",
                "Sin foto",
                "Imagen rota → iniciales",
                "Ana",
                "Sin datos",
                "Bea",
                "Caro",
                "XS",
                "SM",
                "MD",
                "LG",
                "XL",
                "XXL",
                "Foto",
                "Sin foto, iniciales",
                "Solo icono",
                "Carol",
                "5 más",
                "Lucía",
                "Marcos",
                "Sara",
                "Usuario",
                "Bot",
                "Soporte",
                "Comunidad",
                "Imagen correcta",
                "Error fallback",
                "Sin iniciales"
              ]
            },
            {
              "control": "select",
              "prop": "attr:shape",
              "label": "shape",
              "options": [
                {
                  "value": "circle",
                  "label": "circle",
                  "icon": "mdi:circle-outline"
                },
                {
                  "value": "square",
                  "label": "square",
                  "icon": "mdi:square-outline"
                },
                {
                  "value": "rounded",
                  "label": "rounded",
                  "icon": "mdi:rounded-corner"
                }
              ],
              "default": "circle"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Formas",
      "lede": "<code class=\"code\">shape=\"circle\"</code> · <code class=\"code\">square\"</code> · <code class=\"code\">rounded\"</code> — el border-radius se aplica al contenedor.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"shape-grid\">\r\n            <span class=\"shape-grid__head\"></span>\r\n            <span class=\"shape-grid__head\">imagen</span>\r\n            <span class=\"shape-grid__head\">iniciales</span>\r\n            <span class=\"shape-grid__head\">icono</span>\r\n\r\n            <code class=\"code\">circle</code>\r\n            <iswc-avatar shape=\"circle\" image=\"https://i.pravatar.cc/120?u=21\" label=\"Ana\"></iswc-avatar>\r\n            <iswc-avatar shape=\"circle\" initials=\"AN\" label=\"Ana\"></iswc-avatar>\r\n            <iswc-avatar shape=\"circle\" label=\"Sin datos\"></iswc-avatar>\r\n\r\n            <code class=\"code\">square</code>\r\n            <iswc-avatar shape=\"square\" image=\"https://i.pravatar.cc/120?u=22\" label=\"Bea\"></iswc-avatar>\r\n            <iswc-avatar shape=\"square\" initials=\"BE\" label=\"Bea\"></iswc-avatar>\r\n            <iswc-avatar shape=\"square\" label=\"Sin datos\"></iswc-avatar>\r\n\r\n            <code class=\"code\">rounded</code>\r\n            <iswc-avatar shape=\"rounded\" image=\"https://i.pravatar.cc/120?u=23\" label=\"Caro\"></iswc-avatar>\r\n            <iswc-avatar shape=\"rounded\" initials=\"CA\" label=\"Caro\"></iswc-avatar>\r\n            <iswc-avatar shape=\"rounded\" label=\"Sin datos\"></iswc-avatar>\r\n          </div>",
          "heading": "Cada forma con los tres contenidos posibles"
        },
        {
          "kind": "code",
          "code": "<span style=\"font-size:3rem\">\n  <iswc-avatar initials=\"AB\" shape=\"rounded\"></iswc-avatar>\n</span>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala con font-size",
      "lede": "Como la caja es <code class=\"code\">1em × 1em</code>, basta con subir el <code class=\"code\">font-size</code> del padre.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1rem;flex-wrap:wrap\">\r\n            <span style=\"font-size:1rem\"><iswc-avatar initials=\"XS\" label=\"XS\"></iswc-avatar></span>\r\n            <span style=\"font-size:1.5rem\"><iswc-avatar initials=\"SM\" label=\"SM\"></iswc-avatar></span>\r\n            <span style=\"font-size:2rem\"><iswc-avatar initials=\"MD\" label=\"MD\"></iswc-avatar></span>\r\n            <span style=\"font-size:3rem\"><iswc-avatar initials=\"LG\" label=\"LG\"></iswc-avatar></span>\r\n            <span style=\"font-size:4rem\"><iswc-avatar initials=\"XL\" label=\"XL\"></iswc-avatar></span>\r\n            <span style=\"font-size:6rem\"><iswc-avatar initials=\"XXL\" label=\"XXL\"></iswc-avatar></span>\r\n          </div>"
        }
      ]
    },
    {
      "id": "sources",
      "title": "Origen del contenido",
      "lede": "Prioridad: <code class=\"code\">image</code> → <code class=\"code\">initials</code> → slot <code class=\"code\">icon</code>. Si la imagen falla al cargar, emite <code class=\"code\">iswc-error</code> y cae a <code class=\"code\">initials</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1rem;flex-wrap:wrap;font-size:3rem\">\r\n            <iswc-avatar image=\"https://i.pravatar.cc/80?u=2\" label=\"Foto\"></iswc-avatar>\r\n            <iswc-avatar initials=\"NS\" label=\"Sin foto, iniciales\"></iswc-avatar>\r\n            <iswc-avatar label=\"Solo icono\">\r\n              <iswc-icon slot=\"icon\" icon=\"mdi:cog\"></iswc-icon>\r\n            </iswc-avatar>\r\n          </div>"
        }
      ]
    },
    {
      "id": "stacks",
      "title": "Stack / group de avatares",
      "lede": "Varios avatares juntos con margin-left negativo, como en chats o listas.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"display:flex;align-items:center;font-size:2rem;padding:0.5rem\">\r\n            <iswc-avatar image=\"https://i.pravatar.cc/80?u=10\" label=\"Ana\" shape=\"circle\"></iswc-avatar>\r\n            <iswc-avatar image=\"https://i.pravatar.cc/80?u=11\" label=\"Bea\" shape=\"circle\" style=\"margin-left:-0.6em\"></iswc-avatar>\r\n            <iswc-avatar image=\"https://i.pravatar.cc/80?u=12\" label=\"Carol\" shape=\"circle\" style=\"margin-left:-0.6em\"></iswc-avatar>\r\n            <!-- El acento va en ::part(initials), NO en el host: el host es\r\n                 cuadrado y pintarle el fondo dejaba un rectangulo asomando\r\n                 por detras del circulo. -->\r\n            <iswc-avatar class=\"stack-more\" initials=\"+5\" label=\"5 más\" shape=\"circle\" style=\"margin-left:-0.6em\"></iswc-avatar>\r\n          </div>"
        }
      ]
    },
    {
      "id": "list",
      "title": "Patrón lista de usuarios",
      "lede": "Avatar + nombre + email, alineado con la línea base.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<ul style=\"list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.75rem\">\r\n            <li style=\"display:flex;align-items:center;gap:0.75rem\">\r\n              <span style=\"font-size:2rem\">\r\n                <iswc-avatar image=\"https://i.pravatar.cc/80?u=20\" label=\"Lucía\" shape=\"circle\"></iswc-avatar>\r\n              </span>\r\n              <span>\r\n                <div><strong>Lucía Gómez</strong></div>\r\n                <div style=\"font-size:0.85em;opacity:0.7\">lucia.gomez@demo.com</div>\r\n              </span>\r\n            </li>\r\n            <li style=\"display:flex;align-items:center;gap:0.75rem\">\r\n              <span style=\"font-size:2rem\">\r\n                <iswc-avatar initials=\"MR\" label=\"Marcos\" shape=\"circle\"></iswc-avatar>\r\n              </span>\r\n              <span>\r\n                <div><strong>Marcos Reyes</strong></div>\r\n                <div style=\"font-size:0.85em;opacity:0.7\">marcos.reyes@demo.com</div>\r\n              </span>\r\n            </li>\r\n            <li style=\"display:flex;align-items:center;gap:0.75rem\">\r\n              <span style=\"font-size:2rem\">\r\n                <iswc-avatar image=\"https://i.pravatar.cc/80?u=21\" label=\"Sara\" shape=\"rounded\"></iswc-avatar>\r\n              </span>\r\n              <span>\r\n                <div><strong>Sara Pereira</strong></div>\r\n                <div style=\"font-size:0.85em;opacity:0.7\">sara.pereira@demo.com</div>\r\n              </span>\r\n            </li>\r\n          </ul>"
        }
      ]
    },
    {
      "id": "icons",
      "title": "Icono de respaldo",
      "lede": "Sin imagen ni iniciales, el slot <code class=\"code\">icon</code> pinta cualquier <code class=\"code\">&lt;iswc-icon&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1rem;flex-wrap:wrap;font-size:2.5rem\">\r\n            <iswc-avatar label=\"Usuario\">\r\n              <iswc-icon slot=\"icon\" icon=\"mdi:account\"></iswc-icon>\r\n            </iswc-avatar>\r\n            <iswc-avatar label=\"Bot\">\r\n              <iswc-icon slot=\"icon\" icon=\"mdi:robot\"></iswc-icon>\r\n            </iswc-avatar>\r\n            <iswc-avatar label=\"Soporte\">\r\n              <iswc-icon slot=\"icon\" icon=\"mdi:lifebuoy\"></iswc-icon>\r\n            </iswc-avatar>\r\n            <iswc-avatar label=\"Comunidad\">\r\n              <iswc-icon slot=\"icon\" icon=\"mdi:account-group\"></iswc-icon>\r\n            </iswc-avatar>\r\n          </div>"
        }
      ]
    },
    {
      "id": "error",
      "title": "Imagen rota",
      "lede": "Si <code class=\"code\">image</code> falla y hay <code class=\"code\">initials</code>, el avatar cae a las iniciales automáticamente y emite <code class=\"code\">iswc-error</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"fallback-grid\">\r\n            <figure class=\"fallback-case\">\r\n              <iswc-avatar image=\"https://i.pravatar.cc/120?u=31\" initials=\"OK\" label=\"Imagen correcta\"></iswc-avatar>\r\n              <figcaption>\r\n                <b>URL válida</b>\r\n                <small>se muestra la imagen</small>\r\n              </figcaption>\r\n            </figure>\r\n\r\n            <figure class=\"fallback-case\">\r\n              <iswc-avatar image=\"https://invalid.example/x.jpg\" initials=\"ER\" label=\"Error fallback\" id=\"errAv\"></iswc-avatar>\r\n              <figcaption>\r\n                <b>URL rota + initials</b>\r\n                <small id=\"errLog\">cargando…</small>\r\n              </figcaption>\r\n            </figure>\r\n\r\n            <figure class=\"fallback-case\">\r\n              <iswc-avatar image=\"https://invalid.example/y.jpg\" label=\"Sin iniciales\"></iswc-avatar>\r\n              <figcaption>\r\n                <b>URL rota, sin initials</b>\r\n                <small>cae al icono por defecto</small>\r\n              </figcaption>\r\n            </figure>\r\n          </div>",
          "heading": "El mismo avatar con la imagen buena y con la rota"
        },
        {
          "kind": "html",
          "html": "<script>\r\n          const a = document.getElementById('errAv');\r\n          const log = document.getElementById('errLog');\r\n          a.addEventListener('iswc-error', () => {\r\n            log.textContent = '✓ iswc-error emitido — avatar cayó a iniciales \"ER\"';\r\n          });\r\n        </script>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Evento <code class=\"code\">iswc-error</code> al fallar la imagen. Sin <code class=\"code\">size</code> ni <code class=\"code\">--size</code> — usa <code class=\"code\">font-size</code>.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default",
            "Descripción"
          ],
          "rows": [
            [
              "<code>image</code>",
              "—",
              "URL de imagen."
            ],
            [
              "<code>initials</code>",
              "—",
              "Hasta 2 letras si no hay imagen."
            ],
            [
              "<code>label</code>",
              "—",
              "aria-label."
            ],
            [
              "<code>shape</code>",
              "circle",
              "circle · square · rounded."
            ],
            [
              "<code>loading</code>",
              "eager",
              "eager · lazy."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
