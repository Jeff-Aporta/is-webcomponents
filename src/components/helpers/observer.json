{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-observer",
  "category": "helpers",
  "title": "&lt;iswc-observer&gt;",
  "titleHtml": false,
  "styles": [
    ".obs-scroller {",
    "      height: 260px;",
    "      overflow: auto;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background: var(--iswc-bg);",
    "      padding: 1rem;",
    "    }",
    "    .obs-spacer {",
    "      height: 100px;",
    "      display: grid;",
    "      place-items: center;",
    "      color: var(--iswc-text-dim);",
    "      font-size: 0.8rem;",
    "      border: 1px dashed var(--iswc-border-soft);",
    "      border-radius: var(--iswc-radius-sm);",
    "      margin-bottom: 0.75rem;",
    "    }",
    "    .obs-card {",
    "      display: flex;",
    "      align-items: center;",
    "      justify-content: space-between;",
    "      gap: 1rem;",
    "      padding: 1rem 1.1rem;",
    "      margin-bottom: 0.75rem;",
    "      border-radius: var(--iswc-radius);",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg-elev);",
    "      color: var(--iswc-text-soft);",
    "      opacity: 0.4;",
    "      transform: translateY(8px);",
    "      transition: opacity 280ms ease, transform 280ms ease, background 280ms ease, border-color 280ms ease, color 280ms ease;",
    "    }",
    "    .obs-card.iswc-in {",
    "      opacity: 1;",
    "      transform: none;",
    "      background: color-mix(in srgb, var(--iswc-color-brand) 14%, var(--iswc-bg-elev));",
    "      border-color: color-mix(in srgb, var(--iswc-color-brand) 45%, var(--iswc-border));",
    "      color: var(--iswc-text);",
    "    }",
    "    .obs-badge {",
    "      flex: 0 0 auto;",
    "      font-size: 0.7rem;",
    "      font-weight: 600;",
    "      letter-spacing: 0.04em;",
    "      text-transform: uppercase;",
    "      padding: 0.25em 0.55em;",
    "      border-radius: 999px;",
    "      background: var(--iswc-control-bg);",
    "      color: var(--iswc-text-dim);",
    "    }",
    "    .obs-card.iswc-in .obs-badge {",
    "      background: var(--iswc-brand-soft);",
    "      color: var(--iswc-brand-text);",
    "    }",
    "    .obs-panel {",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background: var(--iswc-bg);",
    "      padding: 0.85rem;",
    "    }",
    "    .obs-panel__title {",
    "      font-size: 0.72rem;",
    "      font-weight: 600;",
    "      letter-spacing: 0.05em;",
    "      text-transform: uppercase;",
    "      color: var(--iswc-text-dim);",
    "      margin-bottom: 0.65rem;",
    "    }",
    "    .obs-target {",
    "      padding: 1rem;",
    "      min-height: 3rem;",
    "      line-height: 1.5;",
    "      background: var(--iswc-control-bg);",
    "      border: 1px solid var(--iswc-border-soft);",
    "      border-radius: var(--iswc-radius-sm);",
    "      color: var(--iswc-text);",
    "    }",
    "    .obs-target [data-chip] {",
    "      display: inline-block;",
    "      margin-left: 0.35em;",
    "      padding: 0.1em 0.45em;",
    "      border-radius: 999px;",
    "      background: var(--iswc-brand-soft);",
    "      color: var(--iswc-brand-text);",
    "      font-size: 0.8em;",
    "    }",
    "    .obs-actions {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      gap: 0.5rem;",
    "      margin-top: 0.75rem;",
    "    }",
    "    .obs-hint {",
    "      margin-top: 0.65rem;",
    "      font-size: 0.85rem;",
    "      color: var(--iswc-text-soft);",
    "      line-height: 1.45;",
    "    }",
    "    .obs-resize-wrap {",
    "      display: grid;",
    "      gap: 0.75rem;",
    "    }",
    "    .obs-resize-box {",
    "      width: min(100%, 280px);",
    "      height: 140px;",
    "      resize: both;",
    "      overflow: auto;",
    "      padding: 1rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background:",
    "        repeating-linear-gradient(45deg,",
    "          color-mix(in srgb, var(--iswc-border) 35%, transparent) 0 8px,",
    "          transparent 8px 16px),",
    "        var(--iswc-bg-elev);",
    "      color: var(--iswc-text);",
    "      font-size: 0.9rem;",
    "      line-height: 1.4;",
    "    }",
    "    .obs-size {",
    "      font-variant-numeric: tabular-nums;",
    "      font-weight: 600;",
    "      color: var(--iswc-text);",
    "    }",
    "    .obs-uses {",
    "      display: grid;",
    "      gap: 0.55rem;",
    "      margin: 0;",
    "      padding: 0;",
    "      list-style: none;",
    "    }",
    "    .obs-uses li {",
    "      display: grid;",
    "      grid-template-columns: 1.5rem 1fr;",
    "      gap: 0.55rem;",
    "      align-items: start;",
    "      color: var(--iswc-text-soft);",
    "      font-size: 0.92rem;",
    "      line-height: 1.45;",
    "    }",
    "    .obs-uses iswc-icon {",
    "      width: 1.15em;",
    "      height: 1.15em;",
    "      color: var(--iswc-accent);",
    "      margin-top: 0.15em;",
    "    }",
    "    .log .type-in { color: #69db7c; }",
    "    .log .type-out { color: #ffa8a8; }",
    "    .log .type-mut { color: #ffe066; }",
    "    .log .type-res { color: #74c0fc; }"
  ],
  "storageKey": "docs-iswc-observer",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Un solo componente para <code class=\"code\">IntersectionObserver</code>,",
        "          <code class=\"code\">MutationObserver</code> y <code class=\"code\">ResizeObserver</code>",
        "          vía <code class=\"code\">type</code>. Los alias históricos",
        "          (<code class=\"code\">&lt;iswc-intersection-observer&gt;</code>, etc.) siguen válidos."
      ],
      "blocks": [
        {
          "kind": "callout",
          "html": [
            "El host usa <code class=\"code\">display: contents</code>: no ocupa caja propia.",
            "          Los hijos directos son lo observado (intersection / resize) o el subárbol a vigilar (mutation)."
          ]
        },
        {
          "kind": "html",
          "html": [
            "<ul class=\"obs-uses\">",
            "            <li>",
            "              <iswc-icon icon=\"mdi:eye-outline\" aria-hidden=\"true\"></iswc-icon>",
            "              <span><strong>intersection</strong> — ¿está visible en el viewport / un scroller?</span>",
            "            </li>",
            "            <li>",
            "              <iswc-icon icon=\"mdi:file-tree-outline\" aria-hidden=\"true\"></iswc-icon>",
            "              <span><strong>mutation</strong> — ¿cambió el DOM (hijos / atributos / texto)?</span>",
            "            </li>",
            "            <li>",
            "              <iswc-icon icon=\"mdi:arrow-expand-all\" aria-hidden=\"true\"></iswc-icon>",
            "              <span><strong>resize</strong> — ¿cambió el tamaño del hijo?</span>",
            "            </li>",
            "          </ul>"
          ]
        }
      ]
    },
    {
      "id": "intersection",
      "title": "Visibilidad",
      "titleHtml": false,
      "lede": [
        "Haz scroll en el panel. Las tarjetas arrancan atenuadas; al entrar (≥&nbsp;40&nbsp;% visible)",
        "          reciben <code class=\"code\">iswc-in</code>, se iluminan y el badge pasa a «en vista»."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">root = #obsScroller · threshold = 0.4 · intersect-class = iswc-in</span>",
            "          <div id=\"obsScroller\" class=\"obs-scroller\">",
            "            <div class=\"obs-spacer\">↓ baja para revelar las tarjetas ↓</div>",
            "            <iswc-observer id=\"io\" type=\"intersection\" root=\"#obsScroller\" intersect-class=\"iswc-in\" threshold=\"0.4\">",
            "              <article class=\"obs-card\" data-label=\"A\">",
            "                <span>Tarjeta A — fade al entrar</span>",
            "                <span class=\"obs-badge\" data-badge>fuera</span>",
            "              </article>",
            "              <article class=\"obs-card\" data-label=\"B\">",
            "                <span>Tarjeta B</span>",
            "                <span class=\"obs-badge\" data-badge>fuera</span>",
            "              </article>",
            "              <article class=\"obs-card\" data-label=\"C\">",
            "                <span>Tarjeta C</span>",
            "                <span class=\"obs-badge\" data-badge>fuera</span>",
            "              </article>",
            "            </iswc-observer>",
            "            <div class=\"obs-spacer\">fin del scroll</div>",
            "          </div>",
            "          <div class=\"log\" id=\"ioLog\" aria-live=\"polite\" style=\"margin-top:12px\">",
            "            <div class=\"row hint\">Eventos <code class=\"code\">iswc-intersect</code> al entrar/salir.</div>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:type",
              "label": "type",
              "options": [
                "intersection",
                "mutation",
                "resize"
              ]
            },
            {
              "control": "text",
              "prop": "attr:root",
              "label": "root"
            },
            {
              "control": "text",
              "prop": "attr:intersect-class",
              "label": "intersect-class"
            },
            {
              "control": "number",
              "prop": "attr:threshold",
              "label": "threshold",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "text",
              "prop": "attr:attr",
              "label": "attr"
            },
            {
              "control": "boolean",
              "prop": "attr:child-list",
              "label": "child-list"
            }
          ]
        }
      ]
    },
    {
      "id": "mutation",
      "title": "Cambios del árbol",
      "titleHtml": false,
      "lede": [
        "El nodo de la izquierda es el subárbol observado. Cada botón dispara una mutación",
        "          concreta; el log muestra <code class=\"code\">iswc-mutate</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">child-list + attr=&quot;data-tag&quot;</span>",
            "          <div class=\"obs-panel\">",
            "            <div class=\"obs-panel__title\">Nodo observado</div>",
            "            <iswc-observer id=\"mo\" type=\"mutation\" attr=\"data-tag\" child-list>",
            "              <div id=\"moTarget\" class=\"obs-target\" data-tag=\"init\">Contenido editable</div>",
            "            </iswc-observer>",
            "            <div class=\"obs-actions\">",
            "              <iswc-button id=\"moAdd\" color=\"brand\" variant=\"outlined\" type=\"button\">",
            "                <iswc-icon slot=\"start\" icon=\"mdi:plus\"></iswc-icon>",
            "                Añadir hijo",
            "              </iswc-button>",
            "              <iswc-button id=\"moAttr\" color=\"neutral\" variant=\"outlined\" type=\"button\">",
            "                <iswc-icon slot=\"start\" icon=\"mdi:tag-plus-outline\"></iswc-icon>",
            "                Cambiar data-tag",
            "              </iswc-button>",
            "              <iswc-button id=\"moReset\" color=\"neutral\" variant=\"plain\" type=\"button\">",
            "                Reset",
            "              </iswc-button>",
            "            </div>",
            "            <p class=\"obs-hint\" id=\"moExplain\">Pulsa un botón para mutar el DOM y ver el evento.</p>",
            "          </div>",
            "          <div class=\"log\" id=\"moLog\" aria-live=\"polite\" style=\"margin-top:12px\">",
            "            <div class=\"row hint\">Las mutaciones aparecen aquí.</div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "resize",
      "title": "Cambios de tamaño",
      "titleHtml": false,
      "lede": [
        "Arrastra la esquina inferior derecha del cuadro (CSS <code class=\"code\">resize: both</code>).",
        "          El tamaño en vivo y el log se actualizan con <code class=\"code\">iswc-resize</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">ResizeObserver sobre el hijo</span>",
            "          <div class=\"obs-resize-wrap\">",
            "            <iswc-observer id=\"ro\" type=\"resize\">",
            "              <div id=\"roBox\" class=\"obs-resize-box\">",
            "                Arrastra la esquina ↘ para redimensionar.",
            "              </div>",
            "            </iswc-observer>",
            "            <p class=\"obs-hint\">",
            "              Tamaño actual:",
            "              <span class=\"obs-size\" id=\"roSize\">— × —</span>",
            "            </p>",
            "          </div>",
            "          <div class=\"log\" id=\"roLog\" aria-live=\"polite\" style=\"margin-top:12px\">",
            "            <div class=\"row hint\">Cada resize emite <code class=\"code\">iswc-resize</code>.</div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Aplica a",
            "Descripción"
          ],
          "rows": [
            [
              "<code>type</code>",
              "todos",
              "<code>intersection | mutation | resize</code>"
            ],
            [
              "<code>disabled</code>",
              "todos",
              "boolean — desconecta el observer"
            ],
            [
              "<code>intersect-class</code>",
              "intersection",
              "clase a togglear en cada hijo"
            ],
            [
              "<code>once</code>",
              "intersection",
              "boolean — des-observa tras la primera"
            ],
            [
              "<code>root</code>",
              "intersection",
              "selector CSS del root (default viewport)"
            ],
            [
              "<code>root-margin</code>",
              "intersection",
              "ej. <code>\"10px 20px\"</code>"
            ],
            [
              "<code>threshold</code>",
              "intersection",
              "número 0–1"
            ],
            [
              "<code>attr</code>",
              "mutation",
              "filtro de atributos a vigilar"
            ],
            [
              "<code>child-list</code>",
              "mutation",
              "boolean (default true)"
            ],
            [
              "<code>character-data</code>",
              "mutation",
              "boolean"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Un solo componente para <code class=\"code\">IntersectionObserver</code>,",
          "          <code class=\"code\">MutationObserver</code> y <code class=\"code\">ResizeObserver</code>",
          "          vía <code class=\"code\">type</code>. Los alias históricos",
          "          (<code class=\"code\">&lt;iswc-intersection-observer&gt;</code>, etc.) siguen válidos."
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}