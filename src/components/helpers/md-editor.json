    {
      "id": "editable",
      "title": "Editable",
      "lede": "Con <code class=\"code\">can-edit</code>: herramientas activas, Descartar/Guardar.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-md-editor can-edit label=\"Plantilla de correo\" filename=\"plantilla.md\">",
            "  <script type=\"text/markdown\">",
            "Hola {{nombre_cliente}},",
            "",
            "Gracias por confiar en {{empresa}}. Tu próxima cita es el {{fecha_cita}}.",
            "",
            "Un saludo,",
            "{{firma}}",
            "  </script>",
            "</iswc-md-editor>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API HTTP vs actions",
      "lede": "Prioridad: <code class=\"code\">actions</code> (callbacks JS) → <code class=\"code\">api</code>/<code class=\"code\">src</code> (fetch) → solo eventos locales. Tipos en <code class=\"code\">md-editor-api.d.ts</code>.",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "// A) Custom actions (sin app URL)",
            "el.actions = {",
            "  load: async () => ({ content: await store.get('doc'), filename: 'doc.md' }),",
            "  persist: async (doc) => { await store.put(doc); return doc; },",
            "};",
            "await el.load();",
            "",
            "// B) Endpoints HTTP",
            "el.api = {",
            "  baseUrl: 'https://api.ejemplo.com',",
            "  endpoints: { get: '/docs/1', put: '/docs/1' },",
            "  token: () => localStorage.getItem('token'),",
            "};",
            "await el.load();",
            "",
            "// Atajo GET:",
            "// <iswc-md-editor src=\"/api/docs/1\" can-edit></iswc-md-editor>"
          ],
          "lang": "js"
        }
      ]
    },
    {
      "id": "vs-render",
      "title": "Frente al visor",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Necesitas",
            "Usar"
          ],
          "rows": [
            [
              "Pintar MD / edición ligera",
              "<code>iswc-md-render</code>"
            ],
            [
              "Toolbar, diálogo, CRUD + hydrate",
              "<code>iswc-md-editor</code>"
            ]
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Notas"
          ],
          "rows": [
            [
              "<code>load()</code> / <code>persistRemote()</code>",
              "actions → api endpoints"
            ],
            [
              "<code>el.actions</code>",
              "load / persist / delete (JS only)"
            ],
            [
              "<code>el.api</code> / <code>src</code>",
              "IsMdEditorApiConfig"
            ],
            [
              "<code>setDocument(doc)</code>",
              "content + filename + updatedAt/By"
            ],
            [
              "<code>download()</code>",
              "siempre habilitado"
            ],
            [
              "<code>iswc-persist</code>",
              "<code>{ value, document }</code>"
            ]
          ]
        }
      ]
    }
  ],
