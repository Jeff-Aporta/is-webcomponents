{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-format-bytes",
  "category": "helpers",
  "title": "&lt;iswc-format-bytes&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-format-bytes",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Tamaños de archivo legibles. <code class=\"code\">value</code> se interpreta según <code class=\"code\">unit</code> (default byte).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p>Demo: <iswc-format-bytes value=\"1536000\"></iswc-format-bytes></p>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "1536000",
                "1024",
                "1",
                "2.5",
                "512",
                "1073741824",
                "204800",
                "1048576",
                "0",
                "-2048"
              ]
            },
            {
              "control": "select",
              "prop": "attr:unit",
              "label": "unit",
              "options": [
                "byte",
                "kilobyte",
                "megabyte",
                "gigabyte",
                "terabyte",
                "petabyte"
              ]
            },
            {
              "control": "select",
              "prop": "attr:display",
              "label": "display",
              "options": [
                "short",
                "long"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:autofit",
              "label": "autofit"
            },
            {
              "control": "select",
              "prop": "attr:locale",
              "label": "locale",
              "options": [
                "en",
                "es",
                "fr",
                "ar-EG",
                "de",
                "ja"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "units",
      "title": "Unidades de entrada",
      "titleHtml": false,
      "lede": "El mismo tamaño conceptual con distinta unidad de entrada.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1024&quot; unit=&quot;byte&quot;\">",
            "              <code class=\"format-grid__tag\">byte 1024</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1024\" unit=\"byte\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;kilobyte&quot;\">",
            "              <code class=\"format-grid__tag\">kilobyte 1</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"kilobyte\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;2.5&quot; unit=&quot;megabyte&quot;\">",
            "              <code class=\"format-grid__tag\">megabyte 2.5</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"2.5\" unit=\"megabyte\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;gigabyte&quot;\">",
            "              <code class=\"format-grid__tag\">gigabyte 1</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"gigabyte\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;terabyte&quot;\">",
            "              <code class=\"format-grid__tag\">terabyte 1</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"terabyte\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;petabyte&quot;\">",
            "              <code class=\"format-grid__tag\">petabyte 1</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"petabyte\"></iswc-format-bytes>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "display",
      "title": "Display short / long",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;512&quot; display=&quot;short&quot;\">",
            "              <code class=\"format-grid__tag\">short · 512 B</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"512\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;512&quot; display=&quot;long&quot;\">",
            "              <code class=\"format-grid__tag\">long · 512</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"512\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1073741824&quot; display=&quot;short&quot;\">",
            "              <code class=\"format-grid__tag\">short · 1 GiB</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1073741824\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1073741824&quot; display=&quot;long&quot;\">",
            "              <code class=\"format-grid__tag\">long · 1 GiB</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1073741824\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;2.5&quot; unit=&quot;megabyte&quot; display=&quot;short&quot;\">",
            "              <code class=\"format-grid__tag\">short · 2.5 MB in</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"2.5\" unit=\"megabyte\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;2.5&quot; unit=&quot;megabyte&quot; display=&quot;long&quot;\">",
            "              <code class=\"format-grid__tag\">long · 2.5 MB in</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"2.5\" unit=\"megabyte\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "autofit",
      "title": "Autofit · unidad ≥ 1",
      "lede": "Con <code class=\"code\">autofit</code> se elige la unidad más alta cuyo valor sea al menos 1. <code class=\"code\">204800</code> → 200 KB (no 0.2 MB); desde 1 MiB sí MB.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\" data-code=\"autofit value=&quot;204800&quot;\">",
            "              <code class=\"format-grid__tag\">autofit · 204800 B</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" autofit value=\"204800\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"autofit value=&quot;1048576&quot;\">",
            "              <code class=\"format-grid__tag\">autofit · 1 MiB</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" autofit value=\"1048576\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"autofit value=&quot;512&quot;\">",
            "              <code class=\"format-grid__tag\">autofit · 512 B</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" autofit value=\"512\"></iswc-format-bytes>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "locale",
      "title": "Locale · mismo valor, distinto resultado",
      "lede": "Mismo tamaño (<code class=\"code\">1 536 000</code> bytes ≈ 1,5 MB). Cambia el <strong>separador decimal</strong> (<code class=\"code\">.</code> vs <code class=\"code\">,</code>), la <strong>unidad</strong> (MB / Mo / م.ب / メガバイト) y, con <code class=\"code\">display=\"long\"</code>, el nombre completo traducido.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">value=\"1536000\" · short</span>",
            "          <div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">en → 1.5 MB</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"en\" value=\"1536000\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">es → 1,5 MB</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"es\" value=\"1536000\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">fr → 1,5 Mo</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"fr\" value=\"1536000\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">ar-EG → ١٫٥ م.ب</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"ar-EG\" value=\"1536000\" display=\"short\"></iswc-format-bytes>",
            "            </div>",
            "          </div>",
            "          <span class=\"demo-label\">value=\"1536000\" · long (unidad traducida)</span>",
            "          <div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">en</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"en\" value=\"1536000\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">es</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"es\" value=\"1536000\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">de</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"de\" value=\"1536000\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">fr</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"fr\" value=\"1536000\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">ja</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"ja\" value=\"1536000\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">ar-EG</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" locale=\"ar-EG\" value=\"1536000\" display=\"long\"></iswc-format-bytes>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "edge",
      "title": "Casos límite",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;0&quot;\">",
            "              <code class=\"format-grid__tag\">0</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"0\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot;\">",
            "              <code class=\"format-grid__tag\">1 byte</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"1\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"value=&quot;-2048&quot;\">",
            "              <code class=\"format-grid__tag\">negativo</code>",
            "              <iswc-format-bytes class=\"format-grid__value\" value=\"-2048\"></iswc-format-bytes>",
            "            </div>",
            "            <div class=\"format-grid__row\" data-code=\"\">",
            "              <code class=\"format-grid__tag\">sin value</code>",
            "              <iswc-format-bytes class=\"format-grid__value\">«<span></span>» (vacío)</iswc-format-bytes>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Notas"
          ],
          "rows": [
            [
              "<code>value</code>",
              "número (bytes o según <code>unit</code>)"
            ],
            [
              "<code>unit</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "byte · kilobyte · megabyte · gigabyte · terabyte · petabyte (valor por defecto)"
            ],
            [
              "<code>display</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "short · long (valor por defecto)"
            ],
            [
              "<code>locale</code>",
              "BCP 47 — cambia separador decimal y nombre de unidad (p. ej. en <code>1.5 MB</code> vs es <code>1,5 MB</code> vs fr <code>1,5 Mo</code>)"
            ]
          ]
        }
      ]
    }
  ],
