{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-relative-time",
  "category": "helpers",
  "title": "&lt;iswc-relative-time&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-relative-time",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Fechas relativas con <code class=\"code\">Intl.RelativeTimeFormat</code> (nativo).",
        "          Locale por defecto: <code class=\"code\">html lang</code> (sistema al boot) → <strong>es</strong>.",
        "          Alias de <code class=\"code\">&lt;iswc-format type=\"relative\"&gt;</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">sync · refresca cada ~30s · locale del sistema</span>",
            "          <p style=\"margin:0;font-size:1.15rem\">Actualizado <iswc-relative-time id=\"live\" sync></iswc-relative-time></p>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:sync",
              "label": "sync"
            },
            {
              "control": "select",
              "prop": "attr:data-rt-offset",
              "label": "data-rt-offset",
              "options": [
                "-86400",
                "-3600",
                "-120",
                "0",
                "259200"
              ]
            },
            {
              "control": "select",
              "prop": "attr:format",
              "label": "format",
              "options": [
                "long",
                "short",
                "narrow"
              ]
            },
            {
              "control": "text",
              "prop": "attr:numeric",
              "label": "numeric"
            }
          ]
        }
      ]
    },
    {
      "id": "formats",
      "title": "Formatos",
      "lede": "Mismos offsets relativos; cambia solo <code class=\"code\">format</code> / <code class=\"code\">numeric</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">long</code>",
            "              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"-86400\" format=\"long\"></iswc-relative-time>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">short</code>",
            "              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"-3600\" format=\"short\"></iswc-relative-time>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">narrow</code>",
            "              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"-120\" format=\"narrow\"></iswc-relative-time>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">numeric=always</code>",
            "              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"0\" numeric=\"always\"></iswc-relative-time>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">en 3 días</code>",
            "              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"259200\" format=\"long\"></iswc-relative-time>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "locales",
      "title": "Idiomas",
      "lede": [
        "Se filtran con <code class=\"code\">Intl.RelativeTimeFormat.supportedLocalesOf()</code>.",
        "          Cada tarjeta muestra el mismo instante relativo en ese locale. Como mínimo",
        "          verás <strong>es</strong> y <strong>en</strong> en cualquier motor moderno."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p class=\"demo-caption\" id=\"localeCaption\">Cargando locales…</p>",
            "          <div class=\"demo-locale-grid\" id=\"localeGrid\"></div>",
            "          <label class=\"demo-caption\" style=\"display:flex;align-items:center;gap:.5rem;margin-top:1rem;flex-wrap:wrap\">",
            "            Probar locale",
            "            <input id=\"localeProbe\" type=\"text\" value=\"es-CO\" list=\"localeHints\"",
            "              style=\"font:inherit;padding:.35em .6em;border:1px solid var(--iswc-border);border-radius:var(--iswc-radius-sm);background:var(--iswc-control-bg);color:var(--iswc-text);max-width:10rem\" />",
            "            <datalist id=\"localeHints\"></datalist>",
            "            <span id=\"localeProbeOut\"></span>",
            "          </label>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-relative-time date=\"…\" locale=\"es\"></iswc-relative-time>",
            "<iswc-relative-time date=\"…\" locale=\"en\"></iswc-relative-time>",
            "<iswc-relative-time date=\"…\" locale=\"ja\" format=\"short\"></iswc-relative-time>"
          ],
          "lang": "html"
        }
      ]
    },
    {
      "id": "alias",
      "title": "Equivalente unificado",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<p style=\"margin:0\">",
            "            <iswc-format type=\"relative\" data-rt-offset=\"-7200\" style=\"short\"></iswc-format>",
            "          </p>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>date</code>"
            ],
            [
              "<code>format</code>"
            ],
            [
              "<code>numeric</code>"
            ],
            [
              "<code>locale</code>"
            ],
            [
              "<code>sync</code>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Fechas relativas con <code class=\"code\">Intl.RelativeTimeFormat</code> (nativo).",
          "          Locale por defecto: <code class=\"code\">html lang</code> (sistema al boot) → <strong>es</strong>.",
          "          Alias de <code class=\"code\">&lt;iswc-format type=\"relative\"&gt;</code>."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>date</code>",
            "default": "ISO o timestamp"
          },
          {
            "name": "<code>format</code>",
            "default": "long · short · narrow"
          },
          {
            "name": "<code>numeric</code>",
            "default": "auto · always"
          },
          {
            "name": "<code>locale</code>",
            "default": "<code>html lang</code> (sistema) → <code>es</code>"
          },
          {
            "name": "<code>sync</code>",
            "default": "actualiza cada ~30s"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<span class=\"demo-label\">sync · refresca cada ~30s · locale del sistema</span>",
          "          <p style=\"margin:0;font-size:1.15rem\">Actualizado <iswc-relative-time id=\"live\" sync></iswc-relative-time></p>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
