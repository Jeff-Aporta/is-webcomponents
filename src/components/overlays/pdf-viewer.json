{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-pdf-viewer",
  "category": "overlays",
  "title": "&lt;iswc-pdf-viewer&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-pdf-viewer",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Visor de PDF. Por defecto delega en el visor nativo del navegador (<code class=\"code\">&lt;iframe type=\"application/pdf\"&gt;</code>) — sin dependencias, sin peso adicional.",
      "blocks": []
    },
    {
      "id": "demo",
      "title": "Demo",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-pdf-viewer",
            "            src=\"{assets}documento-ejemplo.pdf\"",
            "            download",
            "            print",
            "            height=\"70vh\">",
            "            <span slot=\"title\">Documento de ejemplo</span>",
            "            <a slot=\"toolbar\" href=\"{assets}documento-ejemplo.pdf\" target=\"_blank\" rel=\"noopener\" style=\"font-size:.8rem; color:var(--iswc-text-soft);\">abrir en pestaña ↗</a>",
            "          </iswc-pdf-viewer>"
          ],
          "controls": [
            {
              "control": "text",
              "prop": "attr:src",
              "label": "src"
            },
            {
              "control": "boolean",
              "prop": "attr:download",
              "label": "download"
            },
            {
              "control": "boolean",
              "prop": "attr:print",
              "label": "print"
            },
            {
              "control": "text",
              "prop": "attr:height",
              "label": "height"
            }
          ],
          "equivNote": "engine elige motor; flags de toolbar son independientes.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-pdf-viewer: engine\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"engine=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"native → iframe\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"pdfjs → page/zoom\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"download / print\",",
            "          \"shape\": \"round\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"native\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"pdfjs\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const v = document.querySelector('iswc-pdf-viewer');",
            "v.src = '/files/manual.pdf';",
            "v.currentPage;  // número de página actual (iframe + #page=N)",
            "",
            "// Eventos",
            "v.addEventListener('iswc-load',  () => /* listo */);",
            "v.addEventListener('iswc-error', () => /* error de carga */);",
            "",
            "// Slots",
            "//   title       texto de la izquierda",
            "//   toolbar     contenido extra a la derecha",
            "",
            "// Atributos",
            "// src           URL del PDF (requerido)",
            "// engine        native (default) | pdfjs",
            "// height        alto del iframe",
            "// download      boolean — botón Descargar",
            "// print         boolean — botón Imprimir",
            "// page, zoom    sólo con engine=pdfjs (cuando integres pdfjs en tu build)"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Visor de PDF. Por defecto delega en el visor nativo del navegador (<code class=\"code\">&lt;iframe type=\"application/pdf\"&gt;</code>) — sin dependencias, sin peso adicional."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
