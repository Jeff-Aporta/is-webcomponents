{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-window",
  "category": "overlays",
  "title": "&lt;iswc-window&gt;",
  "titleHtml": false,
  "styles": [
    ".desk {",
    "      position: relative;",
    "      transform: translateZ(0);",
    "      height: 30rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      overflow: hidden;",
    "      background:",
    "        linear-gradient(180deg,",
    "          color-mix(in srgb, var(--iswc-accent) 6%, transparent) 0%,",
    "          transparent 40%),",
    "        repeating-linear-gradient(45deg,",
    "          color-mix(in srgb, var(--iswc-text) 4%, transparent) 0 8px,",
    "          transparent 8px 16px);",
    "    }",
    "    .desk note { position: absolute; pointer-events: none; color: var(--iswc-text-soft); font-size: .85rem; padding: 1rem; }"
  ],
  "storageKey": "docs-iswc-window",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Ventana flotante con botones minimizar/maximizar/cerrar y drag del header. La esquina inferior derecha redimensiona cuando tiene el atributo <code>resizable</code>.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Escritorio",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"desk\">",
            "            <note>Arrastra el header · minimizar las deja como pastillas abajo · esquina redimensiona · clic en la pastilla restaura</note>",
            "            <iswc-window id=\"pgWindow\"",
            "              title=\"Editor — reporte mensual.txt\"",
            "              x=\"40\" y=\"40\"",
            "              width=\"22rem\" height=\"14rem\"",
            "              minimizable maximizable closable resizable>",
            "              <p>Diseño minimalista del reporte mensual: KPIs arriba, treemap al medio, tabla abajo. Prueba a arrastrarlo y maximizarlo.</p>",
            "            </iswc-window>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "number",
              "prop": "attr:x",
              "label": "x",
              "min": 0,
              "max": 360,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:y",
              "label": "y",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:width",
              "label": "width",
              "options": [
                "22rem",
                "18rem"
              ]
            },
            {
              "control": "select",
              "prop": "attr:height",
              "label": "height",
              "options": [
                "14rem",
                "12rem"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:minimizable",
              "label": "minimizable"
            },
            {
              "control": "boolean",
              "prop": "attr:maximizable",
              "label": "maximizable"
            },
            {
              "control": "boolean",
              "prop": "attr:closable",
              "label": "closable"
            },
            {
              "control": "boolean",
              "prop": "attr:resizable",
              "label": "resizable"
            },
            {
              "control": "select",
              "prop": "attr:scope",
              "label": "scope",
              "options": [
                "local",
                "global"
              ]
            },
            {
              "control": "select",
              "prop": "attr:position",
              "label": "position",
              "options": [
                "absolute",
                "fixed"
              ]
            }
          ],
          "contain": true
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"desk\">",
            "            <iswc-window",
            "              title=\"Clientes\"",
            "              x=\"360\" y=\"100\"",
            "              width=\"18rem\" height=\"12rem\"",
            "              minimizable maximizable closable>",
            "              <ul style=\"margin:0; padding-left: 1.25rem; font-size:.85rem; color:var(--iswc-text-soft)\">",
            "                <li>InSoft S.A. — contacto@ins.co</li>",
            "                <li>ContaPyme — hola@conta.co</li>",
            "                <li>AgroWin — soporte@agro.co</li>",
            "              </ul>",
            "            </iswc-window>",
            "          </div>"
          ],
          "heading": "Dos ventanas: la del playground (con controles) y una segunda independiente (con título/contenido distintos)"
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const w = document.querySelector('iswc-window');",
            "w.minimize(); w.restore(); w.maximize(); w.unmaximize(); w.close();",
            "",
            "w.addEventListener('iswc-minimize',  () => /* guardó la posición y bajó a la barra de pastillas */);",
            "w.addEventListener('iswc-restore',   () => /* volvió a su posición anterior */);",
            "w.addEventListener('iswc-maximize',  () => /* ocupa toda la pantalla */);",
            "w.addEventListener('iswc-close',     () => /* se eliminó del DOM */);",
            "",
            "// Atributos",
            "// title, x, y, width, height",
            "// maximizable, minimizable, closable, resizable",
            "// default    normal | maximized | minimized",
            "// scope      local (default) | global",
            "// position   absolute | fixed",
            "",
            "// z-index se autoeleva al hacer click (sigue el foco del usuario)"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Ventana flotante con botones minimizar/maximizar/cerrar y drag del header. La esquina inferior derecha redimensiona cuando tiene el atributo <code>resizable</code>."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
