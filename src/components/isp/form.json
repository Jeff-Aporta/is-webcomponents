{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-form",
  "category": "isp",
  "title": "&lt;iswc-form&gt;",
  "titleHtml": false,
  "description": "Ficha ISP — cuerpo en JSON compacto (json2html / html2json).",
  "storageKey": "docs-iswc-form",
  "hasBehavior": true,
  "styles": [
    ".f-json-row {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      gap: 0.5rem;",
    "      margin: 0.5rem 0 0.75rem;",
    "    }",
    "    .f-json-out {",
    "      margin: 0.5rem 0 0;",
    "      padding: 0.65rem 0.75rem;",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg-elev);",
    "      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;",
    "      font-size: 0.75rem;",
    "      line-height: 1.4;",
    "      white-space: pre-wrap;",
    "      word-break: break-word;",
    "      max-height: 16rem;",
    "      overflow: auto;",
    "    }",
    "    .f-frame {",
    "      height: 24rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: 0.5rem;",
    "    }"
  ],
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Ficha con Aceptar / Cancelar. El cuerpo se define en JSON compacto",
        "          (<code class=\"code\">[tag, attrs?, …hijos]</code>) vía",
        "          <code class=\"code\">json2html</code> / <code class=\"code\">html2json</code>."
      ],
      "blocks": [
        {
          "kind": "callout",
          "html": [
            "Lenguaje de definición = JSON. En BD se guarda el HTML como JSON;",
            "          en runtime: <code class=\"code\">form.fromJSON({ body, values })</code>."
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"f-frame\">",
            "            <iswc-form id=\"fDemo\"></iswc-form>",
            "          </div>",
            "          <div class=\"f-json-row\">",
            "            <iswc-button id=\"fBtnToJson\" variant=\"outlined\" color=\"neutral\">html2json / toJSON</iswc-button>",
            "            <iswc-button id=\"fBtnSet\" variant=\"outlined\" color=\"neutral\">setValues(demo)</iswc-button>",
            "          </div>",
            "          <pre class=\"f-json-out\" id=\"fJsonOut\"></pre>",
            "          <p id=\"fLog\">Última acción: <code class=\"code\">—</code></p>"
          ],
          "controls": [
            {
              "control": "text",
              "prop": "attr:submit-label",
              "label": "submit-label"
            }
          ]
        }
      ]
    },
    {
      "id": "roundtrip",
      "title": "Round-trip JSON",
      "lede": "Pulsa <code class=\"code\">html2json</code>, edita mentalmente el JSON de BD, y vuelve a montar.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"f-frame\" style=\"height:20rem\">",
            "            <iswc-form id=\"fRound\" submit-label=\"Guardar\"></iswc-form>",
            "          </div>",
            "          <div class=\"f-json-row\">",
            "            <iswc-button id=\"fBtnRemount\" color=\"brand\">fromJSON(body)</iswc-button>",
            "          </div>",
            "          <pre class=\"f-json-out\" id=\"fBodyOut\"></pre>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Notas"
          ],
          "rows": [
            [
              "<code>json2html(body)</code>",
              "monta light DOM desde JSON compacto"
            ],
            [
              "<code>html2json()</code>",
              "serializa light DOM"
            ],
            [
              "<code>toJSON()</code>",
              "<code>{ mode, body, values, … }</code>"
            ],
            [
              "<code>fromJSON(json)</code>",
              "chrome + body + values"
            ],
            [
              "<code>getValues</code> / <code>setValues</code>",
              "mapa de controles con <code>name</code>"
            ],
            [
              "<code>IswcForm.json2html</code> / <code>html2json</code>",
              "estáticos (mismo codec global)"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Ficha con Aceptar / Cancelar. El cuerpo se define en JSON compacto",
          "          (<code class=\"code\">[tag, attrs?, …hijos]</code>) vía",
          "          <code class=\"code\">json2html</code> / <code class=\"code\">html2json</code>."
        ]
      },
      "apiJs": {
        "table": [
          {
            "metodo": "<code>json2html(body)</code>",
            "desc": "monta light DOM desde JSON compacto"
          },
          {
            "metodo": "<code>html2json()</code>",
            "desc": "serializa light DOM"
          },
          {
            "metodo": "<code>toJSON()</code>",
            "desc": "<code>{ mode, body, values, … }</code>"
          },
          {
            "metodo": "<code>fromJSON(json)</code>",
            "desc": "chrome + body + values"
          },
          {
            "metodo": "<code>getValues</code> / <code>setValues</code>",
            "desc": "mapa de controles con <code>name</code>"
          },
          {
            "metodo": "<code>IswcForm.json2html</code> / <code>html2json</code>",
            "desc": "estáticos (mismo codec global)"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```js",
          "form.fromJSON({",
          "  mode: 'edit',",
          "  body: [",
          "    ['h3', { slot: 'header' }, 'Curso'],",
          "    ['div', { slot: 'content', style: 'display:flex;flex-direction:column;gap:0.75rem;padding:0.5rem' },",
          "      ['iswc-input', { name: 'icurso', label: 'Código', required: true, 'full-width': true }],",
          "      ['iswc-input', { name: 'ncurso', label: 'Nombre', 'full-width': true }],",
          "      ['iswc-switch', { name: 'activo' }, 'Activo'],",
          "    ],",
          "  ],",
          "  values: { icurso: 'C001', ncurso: 'Nómina', activo: true },",
          "});",
          "",
          "form.html2json(); // solo el light DOM",
          "form.toJSON();    // chrome + body + values",
          "```"
        ]
      }
    },
    "exclude": [
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}