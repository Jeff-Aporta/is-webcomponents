{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-float-card",
  "category": "isp",
  "title": "&lt;iswc-float-card&gt;",
  "titleHtml": false,
  "description": "Panel flotante anclado (port FloatingComponent). Hover muestra tools ya montadas.",
  "storageKey": "docs-iswc-float-card",
  "hasBehavior": true,
  "styles": [
    ".fc-demo {",
    "      position: relative;",
    "      padding: 1.25rem 1rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      background: var(--iswc-bg-elev);",
    "      min-height: 4.5rem;",
    "    }"
  ],
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Port de <code class=\"code\">FloatingComponent</code>. El slot <code class=\"code\">float</code> no se desmonta: <code class=\"code\">open</code> solo cambia opacidad. Pasá el mouse por la fila.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"fc-demo\">",
            "            <iswc-float-card id=\"fcDemo\" horizontal=\"right\" vertical=\"center\">",
            "              <span>Lección — hover aquí</span>",
            "              <iswc-flex-options id=\"fcOpts\" slot=\"float\" compact></iswc-flex-options>",
            "            </iswc-float-card>",
            "          </div>"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Port de <code class=\"code\">FloatingComponent</code>. El slot <code class=\"code\">float</code> no se desmonta: <code class=\"code\">open</code> solo cambia opacidad. Pasá el mouse por la fila."
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-float-card open horizontal=\"right\" vertical=\"center\">",
          "  <span>Fila</span>",
          "  <iswc-button slot=\"float\" variant=\"plain\">Acción</iswc-button>",
          "</iswc-float-card>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
