{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-flex-layout",
  "category": "isp",
  "title": "&lt;iswc-flex-layout&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-flex-layout",
  "hasBehavior": true,
  "styles": [
    ".fx-controls {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      gap: 0.75rem 1.25rem;",
    "      align-items: flex-end;",
    "      margin-bottom: 0.85rem;",
    "      padding: 0.75rem 0.85rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      background: var(--iswc-bg-elev);",
    "    }",
    "    .fx-controls label.fx-field {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.25rem;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-soft);",
    "      min-width: 7.5rem;",
    "    }",
    "    .fx-controls select {",
    "      font: inherit;",
    "      font-size: 0.875rem;",
    "      color: var(--iswc-text);",
    "      background: var(--iswc-bg);",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius-sm, 0.35em);",
    "      padding: 0.35rem 0.5rem;",
    "    }",
    "    .fx-bools {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      gap: 0.75rem 1.1rem;",
    "      align-items: center;",
    "    }",
    "    .fx-attr {",
    "      margin: 0.35rem 0 0.85rem;",
    "      font-size: 0.8rem;",
    "      color: var(--iswc-text-soft);",
    "      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;",
    "      word-break: break-all;",
    "    }",
    "    .fx-stage {",
    "      resize: both;",
    "      overflow: auto;",
    "      display: flex;",
    "      align-items: stretch;",
    "      box-sizing: border-box;",
    "      min-width: 10rem;",
    "      min-height: 5.5rem;",
    "      width: min(100%, 28rem);",
    "      height: 9rem;",
    "      padding: 0.65rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      background:",
    "        repeating-linear-gradient(45deg,",
    "          color-mix(in srgb, var(--iswc-border) 28%, transparent) 0 7px,",
    "          transparent 7px 14px),",
    "        var(--iswc-bg);",
    "    }",
    "    .fx-stage > iswc-flex-layout {",
    "      outline: 1px solid color-mix(in srgb, var(--iswc-brand, #3b82f6) 45%, transparent);",
    "      outline-offset: -1px;",
    "      border-radius: 0.35em;",
    "      background: color-mix(in srgb, var(--iswc-bg-elev) 88%, transparent);",
    "      padding: 0.35rem;",
    "      box-sizing: border-box;",
    "      min-height: 0;",
    "    }",
    "    .fx-stage--tall { height: 12rem; width: min(100%, 22rem); }",
    "    .fx-stage--wide { width: min(100%, 36rem); height: 7.5rem; }",
    "    .fx-hint {",
    "      margin: 0.4rem 0 0;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-dim);",
    "    }",
    "    .fx-chip {",
    "      display: inline-flex;",
    "      align-items: center;",
    "      gap: 0.35rem;",
    "      box-sizing: border-box;",
    "      padding: 0.35rem 0.55rem;",
    "      border-radius: 0.55em;",
    "      border: 1px solid color-mix(in srgb, var(--iswc-border) 70%, transparent);",
    "      background: var(--iswc-bg-elev);",
    "      color: var(--iswc-text);",
    "      font-size: 1.05rem;",
    "      line-height: 1.2;",
    "      white-space: nowrap;",
    "      user-select: none;",
    "    }",
    "    .fx-chip .lbl {",
    "      font-size: 0.78rem;",
    "      font-weight: 600;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .fx-chip--sm { font-size: 0.95rem; padding: 0.2rem 0.4rem; }",
    "    .fx-chip--md { font-size: 1.15rem; padding: 0.45rem 0.65rem; }",
    "    .fx-chip--lg {",
    "      font-size: 1.45rem;",
    "      padding: 0.6rem 0.85rem;",
    "      flex-direction: column;",
    "      align-items: flex-start;",
    "    }",
    "    .fx-chip--lg .lbl { font-size: 0.72rem; }",
    "    .fx-chip--xl {",
    "      font-size: 1.75rem;",
    "      padding: 0.75rem 1rem;",
    "      min-height: 3.25rem;",
    "    }",
    "    .fx-demo-stack { display: flex; flex-direction: column; gap: 1.25rem; }",
    "    .fx-demo-block h3 {",
    "      margin: 0 0 0.35rem;",
    "      font-size: 0.95rem;",
    "      font-weight: 650;",
    "    }"
  ],
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Contenedor flex declarativo (port ISP). Arrastra la esquina ↘ del escenario",
        "          para redimensionar; los switches activan/desactivan props booleanas",
        "          (<code class=\"code\">wrap</code>, <code class=\"code\">grow</code>, <code class=\"code\">inline</code>)."
      ],
      "blocks": [
        {
          "kind": "callout",
          "html": [
            "Los ítems son emojis con etiquetas de distinto tamaño para que",
            "          <code class=\"code\">align</code>, <code class=\"code\">wrap</code> y el gap se noten al instante."
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"fx-controls\" id=\"fxControls\">",
            "            <label class=\"fx-field\">direction",
            "              <select id=\"fxDirection\">",
            "                <option value=\"row\" selected>row</option>",
            "                <option value=\"column\">column</option>",
            "              </select>",
            "            </label>",
            "            <label class=\"fx-field\">justify",
            "              <select id=\"fxJustify\">",
            "                <option value=\"\">(default)</option>",
            "                <option value=\"start\">start</option>",
            "                <option value=\"center\" selected>center</option>",
            "                <option value=\"end\">end</option>",
            "                <option value=\"between\">between</option>",
            "                <option value=\"around\">around</option>",
            "                <option value=\"evenly\">evenly</option>",
            "              </select>",
            "            </label>",
            "            <label class=\"fx-field\">align",
            "              <select id=\"fxAlign\">",
            "                <option value=\"\">(default)</option>",
            "                <option value=\"start\">start</option>",
            "                <option value=\"center\" selected>center</option>",
            "                <option value=\"end\">end</option>",
            "                <option value=\"stretch\">stretch</option>",
            "                <option value=\"baseline\">baseline</option>",
            "              </select>",
            "            </label>",
            "            <label class=\"fx-field\">gap",
            "              <select id=\"fxGap\">",
            "                <option value=\"\">(responsive)</option>",
            "                <option value=\"0.25rem\">0.25rem</option>",
            "                <option value=\"0.5rem\" selected>0.5rem</option>",
            "                <option value=\"1rem\">1rem</option>",
            "              </select>",
            "            </label>",
            "            <div class=\"fx-bools\">",
            "              <iswc-switch id=\"fxWrap\">wrap</iswc-switch>",
            "              <iswc-switch id=\"fxGrow\">grow</iswc-switch>",
            "              <iswc-switch id=\"fxInline\">inline</iswc-switch>",
            "            </div>",
            "          </div>",
            "          <p class=\"fx-attr\" id=\"fxAttrSnippet\">&lt;iswc-flex-layout&gt;</p>",
            "          <div class=\"fx-stage\" id=\"fxStage\" title=\"Redimensionar ↘\">",
            "            <iswc-flex-layout id=\"fxPlay\" gap=\"0.5rem\" justify=\"center\" align=\"center\">",
            "              <span class=\"fx-chip fx-chip--sm\">🍎</span>",
            "              <span class=\"fx-chip fx-chip--md\">🧀 <span class=\"lbl\">Queso</span></span>",
            "              <span class=\"fx-chip fx-chip--lg\">🦒 <span class=\"lbl\">Jirafa alta</span></span>",
            "              <span class=\"fx-chip fx-chip--sm\">🥝 <span class=\"lbl\">Kiwi</span></span>",
            "              <span class=\"fx-chip fx-chip--xl\">🍕</span>",
            "              <span class=\"fx-chip fx-chip--md\">🌮 <span class=\"lbl\">Taco XL</span></span>",
            "            </iswc-flex-layout>",
            "          </div>",
            "          <p class=\"fx-hint\">Redimensiona el recuadro (↘). El contorno marca el área del flex.",
            "            <code class=\"code\">grow</code> llena el escenario; <code class=\"code\">wrap</code> salta de línea al estrechar;",
            "            <code class=\"code\">inline</code> encoge al contenido.</p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:gap",
              "label": "gap",
              "options": [
                "0.5rem",
                "0.35rem"
              ]
            },
            {
              "control": "select",
              "prop": "attr:justify",
              "label": "justify",
              "options": [
                "center",
                "between"
              ]
            },
            {
              "control": "select",
              "prop": "attr:align",
              "label": "align",
              "options": [
                "center",
                "start"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:wrap",
              "label": "wrap"
            },
            {
              "control": "text",
              "prop": "attr:max-width",
              "label": "max-width"
            },
            {
              "control": "boolean",
              "prop": "attr:grow",
              "label": "grow"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Casos típicos",
      "lede": [
        "Cada escenario es redimensionable. Los emojis mantienen tamaños distintos",
        "          para que se note la alineación."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"fx-demo-stack\">",
            "            <div class=\"fx-demo-block\">",
            "              <iswc-heading level=\"3\">direction=\"column\" · align=\"start\"</iswc-heading>",
            "              <div class=\"fx-stage fx-stage--tall\" title=\"Redimensionar ↘\">",
            "                <iswc-flex-layout direction=\"column\" gap=\"0.5rem\" align=\"start\">",
            "                  <span class=\"fx-chip fx-chip--sm\">🚀</span>",
            "                  <span class=\"fx-chip fx-chip--md\">🌙 <span class=\"lbl\">Luna</span></span>",
            "                  <span class=\"fx-chip fx-chip--lg\">⭐ <span class=\"lbl\">Estrella grande</span></span>",
            "                </iswc-flex-layout>",
            "              </div>",
            "            </div>",
            "",
            "            <div class=\"fx-demo-block\">",
            "              <iswc-heading level=\"3\">justify=\"between\"</iswc-heading>",
            "              <div class=\"fx-stage fx-stage--wide\" title=\"Redimensionar ↘\">",
            "                <iswc-flex-layout justify=\"between\" align=\"center\" style=\"width:100%;height:100%\">",
            "                  <span class=\"fx-chip fx-chip--sm\">🐣</span>",
            "                  <span class=\"fx-chip fx-chip--md\">🦊 <span class=\"lbl\">Medio</span></span>",
            "                  <span class=\"fx-chip fx-chip--lg\">🐘 <span class=\"lbl\">Final</span></span>",
            "                </iswc-flex-layout>",
            "              </div>",
            "            </div>",
            "",
            "            <div class=\"fx-demo-block\">",
            "              <iswc-heading level=\"3\">wrap + max-width (estrecha el wrapper)</iswc-heading>",
            "              <div class=\"fx-stage\" style=\"width:16rem;height:10rem\" title=\"Redimensionar ↘\">",
            "                <iswc-flex-layout wrap gap=\"0.35rem\" max-width=\"100%\">",
            "                  <span class=\"fx-chip fx-chip--sm\">🔴</span>",
            "                  <span class=\"fx-chip fx-chip--sm\">🟠 <span class=\"lbl\">naranja</span></span>",
            "                  <span class=\"fx-chip fx-chip--md\">🟡</span>",
            "                  <span class=\"fx-chip fx-chip--sm\">🟢 <span class=\"lbl\">verde</span></span>",
            "                  <span class=\"fx-chip fx-chip--md\">🔵 <span class=\"lbl\">azul</span></span>",
            "                  <span class=\"fx-chip fx-chip--sm\">🟣</span>",
            "                </iswc-flex-layout>",
            "              </div>",
            "            </div>",
            "",
            "            <div class=\"fx-demo-block\">",
            "              <iswc-heading level=\"3\">grow — hijos con flex:1</iswc-heading>",
            "              <div class=\"fx-stage fx-stage--wide\" title=\"Redimensionar ↘\">",
            "                <iswc-flex-layout grow gap=\"0.5rem\" style=\"width:100%;height:100%\">",
            "                  <span class=\"fx-chip fx-chip--md\" style=\"flex:1 1 0;justify-content:center\">🐶 <span class=\"lbl\">A</span></span>",
            "                  <span class=\"fx-chip fx-chip--lg\" style=\"flex:1 1 0;justify-content:center\">🐱 <span class=\"lbl\">B</span></span>",
            "                </iswc-flex-layout>",
            "              </div>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Valores / default"
          ],
          "rows": [
            [
              "<code>gap</code>",
              "CSS · default responsive 0.2 / 0.35 / 0.5rem"
            ],
            [
              "<code>direction</code>",
              "row (default) · column"
            ],
            [
              "<code>wrap</code>",
              "boolean (switch en el playground)"
            ],
            [
              "<code>justify</code>",
              "start · center · end · between · around · evenly · …"
            ],
            [
              "<code>align</code> / <code>items</code>",
              "start · center · end · stretch · baseline"
            ],
            [
              "<code>grow</code>",
              "boolean → <code>flex: 1 1 auto</code>"
            ],
            [
              "<code>inline</code>",
              "boolean → <code>display: inline-flex</code>"
            ],
            [
              "<code>width</code>, <code>height</code>, <code>min-*</code>, <code>max-*</code>",
              "valores CSS"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
