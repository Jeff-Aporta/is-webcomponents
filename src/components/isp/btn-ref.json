{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-btn-ref",
  "category": "isp",
  "title": "&lt;iswc-btn-ref&gt;",
  "titleHtml": false,
  "description": "Campo + modal de selección ISP (BtnRef).",
  "storageKey": "docs-iswc-btn-ref",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Campo con selector modal (port <code class=\"code\">BtnRef</code>). El modal usa",
        "          <code class=\"code\">&lt;iswc-catalogo-gen select-mode&gt;</code> centrado. Controller vía",
        "          <code class=\"code\">createBtnRefController</code> — <strong>sin acciones CRUD</strong>, solo listado y selección."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-btn-ref id=\"btnRefDemo\" label=\"Aplicación\" required style=\"width: 22rem;\"></iswc-btn-ref>",
            "          <p id=\"btnRefLog\">Seleccionado: <code class=\"code\">—</code></p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Aplicación",
                "Aplicaciones"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            },
            {
              "control": "boolean",
              "prop": "attr:multi",
              "label": "multi"
            }
          ]
        }
      ]
    },
    {
      "id": "multi",
      "title": "Multi-select",
      "lede": [
        "Atributo <code class=\"code\">multi</code> (o <code class=\"code\">multiSelect: true</code> en el JSON).",
        "          El modal permite marcar varias filas; al confirmar se aplica el registro elegido (último / pick)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-btn-ref id=\"btnRefMulti\" label=\"Aplicaciones\" multi style=\"width: 22rem;\"></iswc-btn-ref>",
            "          <p id=\"btnRefMultiLog\">Seleccionado: <code class=\"code\">—</code></p>"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Campo con selector modal (port <code class=\"code\">BtnRef</code>). El modal usa",
          "          <code class=\"code\">&lt;iswc-catalogo-gen select-mode&gt;</code> centrado. Controller vía",
          "          <code class=\"code\">createBtnRefController</code> — <strong>sin acciones CRUD</strong>, solo listado y selección."
        ]
      },
      "ejemplos": {
        "content": [
          "```js",
          "import { createBtnRefController } from './isp/controller-from-config.min.js';",
          "",
          "el.controller = createBtnRefController({",
          "  entrie: 'Aplicación',",
          "  primaryKeys: ['app'],",
          "  ColumnsBtnRef: ['app'],",
          "  columns: [{ field: 'app', header: 'Aplicación' }],",
          "  mock: [{ app: 'ContaPyme' }, { app: 'AgroWin' }],",
          "});",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
