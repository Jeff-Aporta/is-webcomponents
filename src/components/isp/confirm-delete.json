{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-confirm-delete",
  "category": "isp",
  "title": "&lt;iswc-confirm-delete&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-confirm-delete de InSoft.",
  "storageKey": "docs-iswc-confirm-delete",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Confirmación destructiva \"escribe para confirmar\": el botón Eliminar\r\n          sigue bloqueado hasta que el usuario re-escribe la clave del registro.\r\n          En la demo, el NIT es <code class=\"code\">900123456</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"cdBtn\" color=\"danger\">\r\n            <iswc-icon slot=\"start\" icon=\"mdi:trash-can\"></iswc-icon>\r\n            Eliminar tercero\r\n          </iswc-button>\r\n          <iswc-confirm-delete\r\n            id=\"cdDemo\"\r\n            for=\"cdBtn\"\r\n            entity=\"tercero\"\r\n            pk-label=\"NIT\"\r\n            confirm-value=\"900123456\"\r\n            maxlength=\"15\"></iswc-confirm-delete>\r\n          <p id=\"cdLog\">Última acción: <code class=\"code\">—</code></p>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:entity",
              "label": "entity",
              "options": [
                "tercero",
                "plantilla"
              ]
            },
            {
              "control": "select",
              "prop": "attr:pk-label",
              "label": "pk-label",
              "options": [
                "NIT",
                "código"
              ]
            },
            {
              "control": "select",
              "prop": "attr:confirm-value",
              "label": "confirm-value",
              "options": [
                "900123456",
                "PLT-Alfa"
              ]
            },
            {
              "control": "number",
              "prop": "attr:maxlength",
              "label": "maxlength",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:case-sensitive",
              "label": "case-sensitive"
            }
          ]
        },
        {
          "kind": "code",
          "code": "<iswc-button id=\"del\" color=\"danger\">Eliminar</iswc-button>\n<iswc-confirm-delete for=\"del\" entity=\"tercero\"\n  pk-label=\"NIT\" confirm-value=\"900123456\"></iswc-confirm-delete>"
        }
      ]
    },
    {
      "id": "sensible",
      "title": "Comparación sensible a mayúsculas",
      "lede": "Por defecto se compara sin distinguir mayúsculas. Con\r\n          <code class=\"code\">case-sensitive</code> la coincidencia debe ser exacta\r\n          (<code class=\"code\">PLT-Alfa</code>).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"cdBtn2\" color=\"danger\" variant=\"outlined\">Eliminar plantilla</iswc-button>\r\n          <iswc-confirm-delete\r\n            for=\"cdBtn2\"\r\n            case-sensitive\r\n            entity=\"plantilla\"\r\n            pk-label=\"código\"\r\n            confirm-value=\"PLT-Alfa\"\r\n            message=\"Esta plantilla se usa en 12 documentos. No hay vuelta atrás.\"></iswc-confirm-delete>"
        },
        {
          "kind": "code",
          "code": "<iswc-confirm-delete case-sensitive confirm-value=\"PLT-Alfa\"></iswc-confirm-delete>"
        }
      ]
    },
    {
      "id": "cuando",
      "title": "Cuándo NO usarlo",
      "lede": "Para confirmaciones ordinarias siguen estando\r\n          <code class=\"code\">&lt;iswc-confirm-modal&gt;</code> y\r\n          <code class=\"code\">&lt;iswc-popconfirm&gt;</code>. La fricción de re-escribir la clave\r\n          solo se justifica si el dato no se puede recuperar.",
      "blocks": []
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Confirmación destructiva \"escribe para confirmar\": el botón Eliminar\r\n          sigue bloqueado hasta que el usuario re-escribe la clave del registro.\r\n          En la demo, el NIT es <code class=\"code\">900123456</code>."
      },
      "ejemplos": {
        "content": "```html\n<iswc-button id=\"del\" color=\"danger\">Eliminar</iswc-button>\n<iswc-confirm-delete for=\"del\" entity=\"tercero\"\n  pk-label=\"NIT\" confirm-value=\"900123456\"></iswc-confirm-delete>\n```"
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
