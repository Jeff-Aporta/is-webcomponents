{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-heading",
  "category": "isp",
  "title": "&lt;iswc-heading&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-heading",
  "hasBehavior": true,
  "styles": [
    ".hd-pg {",
    "      display: grid;",
    "      gap: 1rem;",
    "      padding: 0.85rem 1rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      background: var(--iswc-bg-elev);",
    "    }",
    "    .hd-stage {",
    "      min-height: 3.5rem;",
    "      padding: 0.75rem 0;",
    "      border-bottom: 1px dashed var(--iswc-border);",
    "    }",
    "    .hd-controls {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));",
    "      gap: 0.75rem 1rem;",
    "      align-items: end;",
    "    }",
    "    .hd-field {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.3rem;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .hd-field input[type=\"text\"],",
    "    .hd-field input[type=\"number\"],",
    "    .hd-field select {",
    "      font: inherit;",
    "      font-size: 0.875rem;",
    "      color: var(--iswc-text);",
    "      background: var(--iswc-bg);",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius-sm, 0.35em);",
    "      padding: 0.35rem 0.5rem;",
    "    }",
    "    .hd-field input[type=\"range\"] { width: 100%; accent-color: var(--iswc-accent, var(--iswc-brand)); }",
    "    .hd-range-row { display: flex; align-items: center; gap: 0.5rem; }",
    "    .hd-range-val {",
    "      font-variant-numeric: tabular-nums;",
    "      font-size: 0.8rem;",
    "      color: var(--iswc-text);",
    "      min-width: 2.75rem;",
    "    }",
    "    .hd-caption {",
    "      margin: 0;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-dim);",
    "    }",
    "    .hd-caption code { font-size: 0.85em; }",
    "    .hd-snippet {",
    "      margin: 0;",
    "      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-soft);",
    "      word-break: break-all;",
    "    }",
    "    .hd-stack { display: flex; flex-direction: column; gap: 0.85rem; }",
    "    .hd-ex {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.25rem;",
    "    }"
  ],
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Niveles tipográficos con color semántico, CSS libre o <code class=\"code\">current</code>. <code class=\"code\">mix</code> / <code class=\"code\">mix-with</code> atenúan hacia texto, transparente, blanco o negro.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"hd-pg\" id=\"hdPlayground\">",
            "            <div class=\"hd-stage\" style=\"color:#339af0\">",
            "              <iswc-heading id=\"hdLive\" level=\"2\">Título de ejemplo</iswc-heading>",
            "            </div>",
            "            <div class=\"hd-controls\">",
            "              <label class=\"hd-field\">level",
            "                <div class=\"hd-range-row\">",
            "                  <input id=\"hdLevel\" type=\"range\" min=\"1\" max=\"6\" step=\"1\" value=\"2\" />",
            "                  <span class=\"hd-range-val\" id=\"hdLevelVal\">2</span>",
            "                </div>",
            "              </label>",
            "              <label class=\"hd-field\">color",
            "                <select id=\"hdColorMode\">",
            "                  <option value=\"\" selected>(acento / default)</option>",
            "                  <option value=\"brand\">brand</option>",
            "                  <option value=\"neutral\">neutral</option>",
            "                  <option value=\"info\">info</option>",
            "                  <option value=\"success\">success</option>",
            "                  <option value=\"warning\">warning</option>",
            "                  <option value=\"danger\">danger</option>",
            "                  <option value=\"current\">current</option>",
            "                  <option value=\"css\">CSS libre…</option>",
            "                </select>",
            "              </label>",
            "              <label class=\"hd-field\">color CSS",
            "                <input id=\"hdColorCss\" type=\"text\" value=\"#e8590c\" disabled />",
            "              </label>",
            "              <label class=\"hd-field\">mix (%)",
            "                <div class=\"hd-range-row\">",
            "                  <input id=\"hdMix\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"30\" />",
            "                  <span class=\"hd-range-val\" id=\"hdMixVal\">30%</span>",
            "                </div>",
            "              </label>",
            "              <label class=\"hd-field\">",
            "                <span><input id=\"hdMixDefault\" type=\"checkbox\" /> usar default mix</span>",
            "              </label>",
            "              <label class=\"hd-field\">mix-with",
            "                <select id=\"hdMixWith\">",
            "                  <option value=\"\" selected>text (default)</option>",
            "                  <option value=\"transparent\">transparent</option>",
            "                  <option value=\"white\">white</option>",
            "                  <option value=\"black\">black</option>",
            "                  <option value=\"current\">current</option>",
            "                </select>",
            "              </label>",
            "              <label class=\"hd-field\">size",
            "                <input id=\"hdSize\" type=\"text\" placeholder=\"(default nivel)\" value=\"\" />",
            "              </label>",
            "              <label class=\"hd-field\">texto",
            "                <input id=\"hdText\" type=\"text\" value=\"Título de ejemplo\" />",
            "              </label>",
            "            </div>",
            "            <p class=\"hd-caption\">Props: <code>level</code>, <code>color</code>, <code>mix</code>, <code>mix-with</code>, <code>size</code></p>",
            "            <pre class=\"hd-snippet\" id=\"hdSnippet\"></pre>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:level",
              "label": "level",
              "options": [
                "2",
                "1",
                "3",
                "4",
                "5",
                "6"
              ]
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "info",
                "success",
                "warning",
                "danger",
                "current",
                "#e8590c",
                "oklch(0.65 0.2 250)"
              ]
            },
            {
              "control": "select",
              "prop": "attr:mix",
              "label": "mix",
              "options": [
                "0%",
                "50%",
                "100%"
              ]
            },
            {
              "control": "text",
              "prop": "attr:mix-with",
              "label": "mix-with"
            }
          ]
        }
      ]
    },
    {
      "id": "levels",
      "title": "Niveles",
      "lede": "Sin <code class=\"code\">mix</code> cada nivel usa su default (15 · 30 · 45 · 65 · 80 · 90 %).",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"hd-stack\">",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"1\">Nivel 1</iswc-heading>",
            "              <p class=\"hd-caption\"><code>level=\"1\"</code> · (default mix)</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"2\">Nivel 2</iswc-heading>",
            "              <p class=\"hd-caption\"><code>level=\"2\"</code> · (default mix)</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\">Nivel 3</iswc-heading>",
            "              <p class=\"hd-caption\"><code>level=\"3\"</code> · (default mix)</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"4\">Nivel 4</iswc-heading>",
            "              <p class=\"hd-caption\"><code>level=\"4\"</code> · (default mix)</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"5\">Nivel 5</iswc-heading>",
            "              <p class=\"hd-caption\"><code>level=\"5\"</code> · (default mix)</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"6\">Nivel 6</iswc-heading>",
            "              <p class=\"hd-caption\"><code>level=\"6\"</code> · (default mix)</p>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "color",
      "title": "color",
      "lede": "Prop <code class=\"code\">color</code> — tinte semántico del acento base.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"hd-stack\">",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"brand\">brand</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"brand\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"neutral\">neutral</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"neutral\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"info\">info</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"info\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"success\">success</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"success\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"warning\">warning</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"warning\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"danger\">danger</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"danger\"</code></p>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "css-current",
      "title": "CSS libre y current",
      "lede": "Si no es semántico, <code class=\"code\">color</code> es un color CSS. <code class=\"code\">current</code> hereda el color tipográfico del contexto.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"hd-stack\">",
            "            <div class=\"hd-ex\" style=\"color:#339af0\">",
            "              <iswc-heading level=\"3\" color=\"current\">current (hereda azul del padre)</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"current\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"#e8590c\">Naranja CSS</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"#e8590c\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"oklch(0.65 0.2 250)\" mix=\"0%\">oklch sin mix</iswc-heading>",
            "              <p class=\"hd-caption\"><code>color=\"oklch(…)\"</code> · <code>mix=\"0%\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"3\" color=\"#e8590c\" mix=\"50%\" mix-with=\"transparent\">50% transparent</iswc-heading>",
            "              <p class=\"hd-caption\"><code>mix=\"50%\"</code> · <code>mix-with=\"transparent\"</code></p>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "mix",
      "title": "mix",
      "lede": [
        "Prop <code class=\"code\">mix</code> (antes <code class=\"code\">style=\"--h-mix\"</code>). Porcentaje de",
        "          <code class=\"code\">--iswc-text</code> mezclado sobre el acento."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"hd-stack\">",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"2\">Sin override</iswc-heading>",
            "              <p class=\"hd-caption\">sin <code>mix</code> · (default mix)</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"2\" mix=\"0%\">Solo acento</iswc-heading>",
            "              <p class=\"hd-caption\"><code>mix=\"0%\"</code> · sin mezcla con texto</p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"2\" mix=\"50%\">Mitad</iswc-heading>",
            "              <p class=\"hd-caption\"><code>mix=\"50%\"</code></p>",
            "            </div>",
            "            <div class=\"hd-ex\">",
            "              <iswc-heading level=\"2\" mix=\"100%\">Todo texto</iswc-heading>",
            "              <p class=\"hd-caption\"><code>mix=\"100%\"</code> · color de texto</p>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Valores / default"
          ],
          "rows": [
            [
              "<code>level</code>",
              "1…6 (default 1)"
            ],
            [
              "<code>color</code>",
              "semántico · <code>current</code> · color CSS"
            ],
            [
              "<code>mix</code>",
              "% → <code>--h-mix</code>; ausente = default del nivel"
            ],
            [
              "<code>mix-with</code>",
              "text · transparent · white · black · current · CSS"
            ],
            [
              "<code>size</code>",
              "CSS → <code>--h-size</code>"
            ],
            [
              "<code>::part(heading)</code>",
              "el <code>&lt;hN&gt;</code> interno"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Niveles tipográficos con color semántico, CSS libre o <code class=\"code\">current</code>. <code class=\"code\">mix</code> / <code class=\"code\">mix-with</code> atenúan hacia texto, transparente, blanco o negro."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>level</code>",
            "type": "1…6 (default 1)"
          },
          {
            "name": "<code>color</code>",
            "type": "semántico · <code>current</code> · color CSS"
          },
          {
            "name": "<code>mix</code>",
            "type": "% → <code>--h-mix</code>; ausente = default del nivel"
          },
          {
            "name": "<code>mix-with</code>",
            "type": "text · transparent · white · black · current · CSS"
          },
          {
            "name": "<code>size</code>",
            "type": "CSS → <code>--h-size</code>"
          },
          {
            "name": "<code>::part(heading)</code>",
            "type": "el <code>&lt;hN&gt;</code> interno"
          }
        ]
      },
