{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-date-field",
  "category": "forms",
  "title": "&lt;iswc-date-field&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-date-field",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Campo editable por secciones (DateField de MUI X). Cada sección es un spinbutton: flechas, dígitos, izquierda/derecha, Retroceso. El orden lo decide el locale.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-field id=\"df\" label=\"Fecha\" value=\"2026-07-30\" locale=\"es\" clearable></iswc-date-field>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Fecha",
                "Date",
                "Requerido",
                "Min 2026-08-01",
                "Solo lectura"
              ]
            },
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "2026-07-30",
                "2026-07-15"
              ]
            },
            {
              "control": "select",
              "prop": "attr:locale",
              "label": "locale",
              "options": [
                "es",
                "en-US"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:clearable",
              "label": "clearable"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            },
            {
              "control": "text",
              "prop": "attr:min",
              "label": "min"
            },
            {
              "control": "boolean",
              "prop": "attr:readonly",
              "label": "readonly"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\" style=\"font-family:var(--iswc-mono);font-size:.85em\"></p>"
        }
      ]
    },
    {
      "id": "time",
      "title": "Campo de hora",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-time-field label=\"Hora 24 h\" value=\"14:05\" hour24 locale=\"es\"></iswc-time-field>",
            "          <iswc-time-field label=\"Time\" value=\"14:05\" ampm locale=\"en-US\"></iswc-time-field>",
            "          <iswc-time-field label=\"Con segundos\" value=\"14:05:30\" hour24 seconds locale=\"es\"></iswc-time-field>"
          ]
        }
      ]
    },
    {
      "id": "datetime",
      "title": "Fecha y hora",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-time-field id=\"dtf\" label=\"Fecha y hora\" value=\"2026-07-30T09:30\" locale=\"es\" clearable></iswc-date-time-field>"
        }
      ]
    },
    {
      "id": "validation",
      "title": "Validación",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-date-field label=\"Requerido\" required locale=\"es\"></iswc-date-field>",
            "          <iswc-date-field label=\"Min 2026-08-01\" value=\"2026-07-15\" min=\"2026-08-01\" locale=\"es\"></iswc-date-field>",
            "          <iswc-date-field label=\"Solo lectura\" value=\"2026-07-30\" readonly locale=\"es\"></iswc-date-field>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>iswc-change</code>, <code>iswc-input</code>. Slots: <code>start</code>, <code>end</code>. Form-associated.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>value</code>"
            ],
            [
              "<code>label</code> / <code>hint</code>"
            ],
            [
              "<code>min</code> / <code>max</code> / <code>required</code>"
            ],
            [
              "<code>ampm</code> / <code>hour24</code> / <code>seconds</code>"
            ],
            [
              "<code>clearable</code> / <code>disabled</code> / <code>readonly</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Campo editable por secciones (DateField de MUI X). Cada sección es un spinbutton: flechas, dígitos, izquierda/derecha, Retroceso. El orden lo decide el locale."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>value</code>",
            "default": "fecha · HH:mm[:ss] · yyyy-mm-ddTHH:mm"
          },
          {
            "name": "<code>label</code> / <code>hint</code>",
            "default": "—"
          },
          {
            "name": "<code>min</code> / <code>max</code> / <code>required</code>",
            "default": "—"
          },
          {
            "name": "<code>ampm</code> / <code>hour24</code> / <code>seconds</code>",
            "default": "según locale · fuerza 24 h · off"
          },
          {
            "name": "<code>clearable</code> / <code>disabled</code> / <code>readonly</code>",
            "default": "off"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-date-field id=\"df\" label=\"Fecha\" value=\"2026-07-30\" locale=\"es\" clearable></iswc-date-field>",
          "          <iswc-date-field label=\"Date\" value=\"2026-07-30\" locale=\"en-US\" clearable></iswc-date-field>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
