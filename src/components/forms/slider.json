            ],
            [
              "métodos",
              "<code>stepUp(i)</code> <code>stepDown(i)</code> <code>focus()</code> <code>checkValidity()</code>"
            ],
            [
              "tokens",
              "<code>--iswc-slider-track-size</code> <code>--iswc-slider-thumb-size</code> <code>--iswc-slider-length</code> <code>--iswc-slider-rail</code> <code>--iswc-slider-fill</code>"
            ]
          ]
        }
      ]
    }
  ],
