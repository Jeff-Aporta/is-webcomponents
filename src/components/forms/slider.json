{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-slider",
  "category": "forms",
  "title": "&lt;iswc-slider&gt;",
  "titleHtml": false,
  "styles": ".stack { display: grid; gap: 1.5rem; max-width: 28rem; }\r\n    .row { display: flex; align-items: center; gap: 1rem; }\r\n    .row iswc-slider { flex: 1; }\r\n    .verticals { display: flex; gap: 3rem; align-items: flex-end; }",
  "storageKey": "docs-iswc-slider",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Control de rango form-associated con paridad funcional con el\r\n          <a href=\"https://mui.com/material-ui/react-slider/\" target=\"_blank\" rel=\"noreferrer\">Slider de MUI</a>:\r\n          rango de dos thumbs, marks, escala no lineal, orientación vertical y track invertido.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-slider id=\"demo\" label=\"Volumen\" hint=\"Arrastra o usa las flechas\" value=\"40\" value-label=\"auto\" name=\"volumen\"></iswc-slider>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "40",
                "30",
                "70",
                "50",
                "20",
                "80",
                "20,37",
                "10,40,80",
                "45",
                "60",
                "75",
                "90",
                "10"
              ]
            },
            {
              "control": "select",
              "prop": "attr:value-label",
              "label": "value-label",
              "options": [
                "auto",
                "on"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            },
            {
              "control": "number",
              "prop": "attr:min",
              "label": "min",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:max",
              "label": "max",
              "min": 0,
              "max": 110,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:step",
              "label": "step",
              "options": [
                "10",
                "null",
                "1"
              ]
            },
            {
              "control": "number",
              "prop": "attr:shift-step",
              "label": "shift-step",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:min-distance",
              "label": "min-distance",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:disable-swap",
              "label": "disable-swap"
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "neutral",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "select",
              "prop": "attr:track",
              "label": "track",
              "options": [
                "none",
                "inverted"
              ]
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\">value: <code class=\"code\">40</code></p>"
        }
      ]
    },
    {
      "id": "continuous",
      "title": "Continuo",
      "lede": "Sin <code class=\"code\">marks</code>: cualquier valor del rango, redondeado al <code class=\"code\">step</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <div class=\"row\">\r\n              <iswc-icon name=\"tabler:volume-2\" aria-hidden=\"true\"></iswc-icon>\r\n              <iswc-slider label=\"Volumen\" value=\"30\"></iswc-slider>\r\n              <iswc-icon name=\"tabler:volume\" aria-hidden=\"true\"></iswc-icon>\r\n            </div>\r\n            <iswc-slider label=\"Deshabilitado\" value=\"30\" disabled></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "sizes",
      "title": "Tamaños",
      "lede": "El tamaño va en <code class=\"code\">em</code>: baja el <code class=\"code\">font-size</code> y pista, thumb y etiquetas se reducen a la vez.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-slider style=\"font-size:0.8em\" label=\"0.8em\" value=\"70\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider label=\"medium (default)\" value=\"50\" value-label=\"auto\"></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "discrete",
      "title": "Discreto",
      "lede": "<code class=\"code\">marks</code> sin valor dibuja un punto por step.\r\n          <code class=\"code\">shift-step</code> define el salto de <code class=\"code\">PageUp/PageDown</code> y <code class=\"code\">Shift + flechas</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-slider label=\"Temperatura\" min=\"10\" max=\"110\" step=\"10\" shift-step=\"30\" value=\"30\" marks value-label=\"auto\" format=\"{v}°C\"></iswc-slider>\r\n            <iswc-slider min=\"10\" max=\"110\" step=\"10\" value=\"30\" marks disabled></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "marks",
      "title": "Marks personalizados",
      "lede": "<code class=\"code\">marks=\"valor:etiqueta, …\"</code> para etiquetas propias, o la propiedad\r\n          <code class=\"code\">.marks = [{ value, label }]</code>. Con <code class=\"code\">step=\"null\"</code>\r\n          los valores quedan restringidos a los marks.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-slider label=\"Marks con etiqueta\" step=\"10\" value=\"20\"\r\n              marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider label=\"Valores restringidos (step null)\" step=\"null\" value=\"20\"\r\n              marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider label=\"Etiqueta siempre visible\" step=\"10\" value=\"80\"\r\n              marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\" value-label=\"on\"></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "range",
      "title": "Rango",
      "lede": "Dos o más valores separados por coma crean un thumb por valor.\r\n          <code class=\"code\">disable-swap</code> evita que se crucen y <code class=\"code\">min-distance</code>\r\n          impone una separación mínima.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-slider id=\"rangeDemo\" label=\"Temperatura (rango)\" value=\"20,37\" value-label=\"auto\" format=\"{v}°C\"></iswc-slider>\r\n            <iswc-slider label=\"min-distance 10 · disable-swap\" value=\"20,37\" min-distance=\"10\" disable-swap value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider label=\"Tres thumbs\" value=\"10,40,80\" value-label=\"auto\"></iswc-slider>\r\n          </div>\r\n          <p class=\"lede\" id=\"rangeLog\">rango: <code class=\"code\">20 – 37</code></p>"
        }
      ]
    },
    {
      "id": "with-input",
      "title": "Slider con input",
      "lede": "Slider e <code class=\"code\">iswc-input</code> sincronizados en ambos sentidos.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"row\" style=\"max-width:28rem;\">\r\n            <iswc-icon name=\"tabler:volume-2\" aria-hidden=\"true\"></iswc-icon>\r\n            <iswc-slider id=\"linkedSlider\" label=\"Volumen\" value=\"30\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-input id=\"linkedInput\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"30\" style=\"width:5.5rem;\"></iswc-input>\r\n          </div>"
        }
      ]
    },
    {
      "id": "color",
      "title": "Color",
      "lede": "<code class=\"code\">variant</code> cambia el color de pista, thumb y burbuja.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-slider label=\"brand (default)\" value=\"30\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider color=\"neutral\" label=\"neutral\" value=\"45\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider color=\"success\" label=\"success\" value=\"60\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider color=\"warning\" label=\"warning\" value=\"75\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider color=\"danger\" label=\"danger\" value=\"90\" value-label=\"auto\"></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "vertical",
      "title": "Vertical",
      "lede": "<code class=\"code\">orientation=\"vertical\"</code>. La longitud se controla con\r\n          <code class=\"code\">--iswc-slider-length</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"verticals\">\r\n            <iswc-slider orientation=\"vertical\" value=\"30\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider orientation=\"vertical\" value=\"30\" disabled></iswc-slider>\r\n            <iswc-slider orientation=\"vertical\" step=\"10\" value=\"20\"\r\n              marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\" value-label=\"auto\"></iswc-slider>\r\n            <iswc-slider orientation=\"vertical\" value=\"20,37\" value-label=\"auto\"></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "track",
      "title": "Track",
      "lede": "<code class=\"code\">track=\"none\"</code> oculta el relleno; <code class=\"code\">track=\"inverted\"</code>\r\n          rellena el tramo complementario.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-slider label=\"normal\" value=\"30\" marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\"></iswc-slider>\r\n            <iswc-slider label=\"none\" track=\"none\" value=\"30\" marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\"></iswc-slider>\r\n            <iswc-slider label=\"none · rango\" track=\"none\" value=\"20,37\" marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\"></iswc-slider>\r\n            <iswc-slider label=\"inverted\" track=\"inverted\" value=\"30\" marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\"></iswc-slider>\r\n            <iswc-slider label=\"inverted · rango\" track=\"inverted\" value=\"20,37\" marks=\"0:0°C, 20:20°C, 37:37°C, 100:100°C\"></iswc-slider>\r\n          </div>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala no lineal",
      "lede": "La propiedad <code class=\"code\">scale</code> traduce el valor interno al valor mostrado.\r\n          Aquí <em>x</em> representa 2<sup>x</sup>: cada paso duplica el almacenamiento.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p id=\"scaleLabel\" class=\"lede\">Almacenamiento: <code class=\"code\">1 MB</code></p>\r\n          <iswc-slider id=\"scaleDemo\" min=\"5\" max=\"30\" step=\"1\" value=\"10\" value-label=\"auto\" style=\"max-width:28rem;\"></iswc-slider>"
        }
      ]
    },
    {
      "id": "keyboard",
      "title": "Teclado",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Tecla",
            "Acción"
          ],
          "rows": [
            [
              "<code>←</code> <code>↓</code>",
              "−1 step (o mark anterior si <code>step=\"null\"</code>)"
            ],
            [
              "<code>→</code> <code>↑</code>",
              "+1 step (o mark siguiente)"
            ],
            [
              "<code>Shift</code> + flechas",
              "± <code>shift-step</code>"
            ],
            [
              "<code>PageUp</code> <code>PageDown</code>",
              "± <code>shift-step</code> (default step × 10)"
            ],
            [
              "<code>Home</code> <code>End</code>",
              "mínimo / máximo"
            ]
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
