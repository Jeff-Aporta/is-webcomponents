{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-rte",
  "category": "forms",
  "title": "&lt;iswc-rte&gt;",
  "titleHtml": false,
  "styles": [
    ".rte-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }",
    "    @media (max-width: 800px) { .rte-pair { grid-template-columns: 1fr; } }",
    "    pre.output {",
    "      font-family: ui-monospace, monospace; font-size: .78rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .65rem .85rem;",
    "      max-height: 12rem; overflow: auto;",
    "      white-space: pre-wrap;",
    "    }"
  ],
  "storageKey": "docs-iswc-rte",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Editor de texto enriquecido mínimo sobre <code>contentEditable</code>. Toolbar configurable; salida en HTML.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-rte id=\"rte\" placeholder=\"Empezá a escribir…\"",
            "                  value=\"<h2>Hola</h2><p><b>Bienvenido</b> al editor de ejemplo. Prueba <i>negrita</i>, <u>subrayado</u>, listas y enlaces.</p>\">",
            "          </iswc-rte>",
            "          <pre class=\"code output\" id=\"outHTML\" data-lang=\"html\"></pre>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:placeholder",
              "label": "placeholder",
              "options": [
                "Empezá a escribir…",
                "Solo lo esencial…"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:value",
              "label": "value"
            },
            {
              "control": "boolean",
              "prop": "attr:h2",
              "label": "h2"
            }
          ]
        }
      ]
    },
    {
      "id": "toolbar",
      "title": "Toolbar a medida",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Pasá una lista separada por comas con <code class=\"code\">|</code> como separador.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-rte placeholder=\"Solo lo esencial…\"",
            "                  toolbar=\"bold, italic, link,|, undo, redo\">",
            "          </iswc-rte>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const r = document.querySelector('iswc-rte');",
            "r.value;        // HTML actual",
            "r.text;         // texto plano",
            "r.focus();",
            "r.exec('bold'); // bold, italic, underline, strike",
            "r.format('h2'); // h1..h6, p, blockquote, pre",
            "r.link();       // prompt → crea <a>",
            "r.clear();      // sin formato, sin listas",
            "r.undo(); r.redo();",
            "",
            "r.addEventListener('iswc-input',  e => /* cada keystroke */);",
            "r.addEventListener('iswc-change', e => console.log(e.detail.value));",
            "r.addEventListener('iswc-blur',   () => /* perdió foco */);",
            "",
            "// Atributos",
            "// value, placeholder, autofocus, readonly",
            "// toolbar   lista separada por comas"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Editor de texto enriquecido mínimo sobre <code>contentEditable</code>. Toolbar configurable; salida en HTML."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
