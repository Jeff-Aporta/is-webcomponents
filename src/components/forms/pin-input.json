{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-pin-input",
  "category": "forms",
  "title": "&lt;iswc-pin-input&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-pin-input de InSoft.",
  "storageKey": "docs-iswc-pin-input",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Casillas para OTP / PIN de 3 a 8 dígitos. Auto-avance al escribir,",
        "          Backspace retrocede, pegar reparte todos los dígitos, navegación con",
        "          flechas y soporte para enmascarar el contenido."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-pin-input id=\"otp1\" length=\"6\"></iswc-pin-input>",
            "          <p>Valor: <code class=\"code\" id=\"otp1Val\">—</code></p>"
          ],
          "controls": [
            {
              "control": "number",
              "prop": "attr:length",
              "label": "length",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "text",
              "prop": "attr:placeholder",
              "label": "placeholder"
            },
            {
              "control": "boolean",
              "prop": "attr:mask",
              "label": "mask"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            },
            {
              "control": "number",
              "prop": "attr:value",
              "label": "value",
              "min": 0,
              "max": 123456,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:invalid",
              "label": "invalid"
            }
          ]
        }
      ]
    },
    {
      "id": "lengths",
      "title": "Diferentes longitudes",
      "lede": "3, 4, 5, 6, 8 dígitos.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:flex;flex-direction:column;gap:0.75rem\">",
            "            <div>",
            "              <small>3 dígitos</small>",
            "              <iswc-pin-input length=\"3\"></iswc-pin-input>",
            "            </div>",
            "            <div>",
            "              <small>4 dígitos</small>",
            "              <iswc-pin-input length=\"4\"></iswc-pin-input>",
            "            </div>",
            "            <div>",
            "              <small>6 dígitos</small>",
            "              <iswc-pin-input length=\"6\"></iswc-pin-input>",
            "            </div>",
            "            <div>",
            "              <small>8 dígitos</small>",
            "              <iswc-pin-input length=\"8\"></iswc-pin-input>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "sizes",
      "title": "Tamaños",
      "lede": "small, medium, large.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:flex;flex-direction:column;gap:0.75rem;align-items:flex-start\">",
            "            <div><small>0.8em</small><iswc-pin-input style=\"font-size:0.8em\" length=\"6\"></iswc-pin-input></div>",
            "            <div><small>1em</small><iswc-pin-input length=\"6\"></iswc-pin-input></div>",
            "            <div><small>1.25em</small><iswc-pin-input style=\"font-size:1.25em\" length=\"6\"></iswc-pin-input></div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "text",
      "title": "Tipo texto",
      "lede": "Con <code class=\"code\">type=\"text\"</code> admite letras y números.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-pin-input length=\"6\" type=\"text\" placeholder=\"·\"></iswc-pin-input>"
        }
      ]
    },
    {
      "id": "mask",
      "title": "Enmascarado",
      "lede": "Con <code class=\"code\">mask</code> los caracteres se ocultan con bullets.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-pin-input length=\"6\" mask></iswc-pin-input>"
        }
      ]
    },
    {
      "id": "states",
      "title": "Estados",
      "lede": "Disabled e invalid.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:flex;flex-direction:column;gap:0.75rem\">",
            "            <div>",
            "              <small>disabled</small>",
            "              <iswc-pin-input length=\"6\" disabled value=\"123456\"></iswc-pin-input>",
            "            </div>",
            "            <div>",
            "              <small>invalid</small>",
            "              <iswc-pin-input id=\"otpErr\" length=\"6\" invalid></iswc-pin-input>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-pin-input&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>length</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Cantidad de dígitos (3-8). (valor por defecto)"
            ],
            [
              "<code>type</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Tipo de carácter aceptado. (valor por defecto)"
            ],
            [
              "<code>mask</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Oculta el contenido. (valor por defecto)"
            ],
            [
              "<code>disabled</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Deshabilita. (valor por defecto)"
            ],
            [
              "<code>invalid</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Marca error. (valor por defecto)"
            ],
            [
              "<code>placeholder</code>",
              "Marcador para casillas vacías."
            ],
            [
              "<code>value</code>",
              "Valor inicial."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-pin-change</code>",
              "Cambia cualquier dígito. <code>detail: { value, index }</code>."
            ],
            [
              "<code>iswc-pin-complete</code>",
              "Todos los dígitos completos."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Casillas para OTP / PIN de 3 a 8 dígitos. Auto-avance al escribir,",
          "          Backspace retrocede, pegar reparte todos los dígitos, navegación con",
          "          flechas y soporte para enmascarar el contenido."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>length</code>",
            "type": "number",
            "default": "6",
            "desc": "Cantidad de dígitos (3-8)."
          },
          {
            "name": "<code>type</code>",
            "type": "number | text",
            "default": "number",
            "desc": "Tipo de carácter aceptado."
          },
          {
            "name": "<code>mask</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Oculta el contenido."
          },
          {
            "name": "<code>disabled</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Deshabilita."
          },
          {
            "name": "<code>invalid</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Marca error."
          },
          {
            "name": "<code>placeholder</code>",
            "type": "string",
            "default": "—",
            "desc": "Marcador para casillas vacías."
          },
          {
            "name": "<code>value</code>",
            "type": "string",
            "default": "—",
            "desc": "Valor inicial."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-pin-change</code>",
            "cuando": "Cambia cualquier dígito. <code>detail: { value, index }</code>."
          },
          {
            "evento": "<code>iswc-pin-complete</code>",
            "cuando": "Todos los dígitos completos."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-pin-input length=\"6\"></iswc-pin-input>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
