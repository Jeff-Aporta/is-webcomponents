{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-switch",
  "category": "forms",
  "title": "&lt;iswc-switch&gt;",
  "titleHtml": false,
  "styles": ".stack { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; }\r\n    .inline { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }\r\n    .placements { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 2rem; }\r\n    .settings { display: flex; flex-direction: column; gap: 0.9rem; max-width: 26rem; }\r\n    .settings iswc-switch::part(base) { justify-content: space-between; }",
  "storageKey": "docs-iswc-switch",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Interruptor <em>form-associated</em> con paridad funcional con el\r\n          <a href=\"https://mui.com/material-ui/react-switch/\" target=\"_blank\" rel=\"noreferrer\">Switch de MUI</a>:\r\n          mismo contrato de formulario que <code class=\"code\">iswc-checkbox</code>, con carril y perilla deslizante,\r\n          color por <code class=\"code\">variant</code>, iconos en la perilla y rótulos dentro del carril.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-switch name=\"notificaciones\" checked>Notificaciones</iswc-switch>\r\n            <iswc-switch name=\"beta\">Funciones beta</iswc-switch>\r\n            <iswc-switch name=\"bloqueado\" checked disabled>Bloqueado por política</iswc-switch>\r\n          </div>",
          "controls": [
              {
                "control": "boolean",
                "prop": "attr:checked",
                "label": "checked"
              },
              {
                "control": "boolean",
                "prop": "attr:disabled",
                "label": "disabled"
              },
              {
                "control": "select",
                "prop": "attr:color",
                "label": "color",
                "options": [
                  "neutral",
                  "success",
                  "warning",
                  "danger"
                ]
              },
              {
                "control": "select",
                "prop": "attr:label-placement",
                "label": "label-placement",
                "options": [
                  "start",
                  "top",
                  "bottom"
                ]
              },
              {
                "control": "select",
                "prop": "attr:checked-icon",
                "label": "checked-icon",
                "options": [
                  "mdi:white-balance-sunny",
                  "mdi:check",
                  "mdi:lock"
                ]
              },
              {
                "control": "select",
                "prop": "attr:on-label",
                "label": "on-label",
                "options": [
                  "ON",
                  "SÍ",
                  "24h"
                ]
              },
              {
                "control": "select",
                "prop": "attr:off-label",
                "label": "off-label",
                "options": [
                  "OFF",
                  "NO",
                  "12h"
                ]
              },
              {
                "control": "boolean",
                "prop": "attr:readonly",
                "label": "readonly"
              },
              {
                "control": "boolean",
                "prop": "attr:error",
                "label": "error"
              },
              {
                "control": "boolean",
                "prop": "attr:required",
                "label": "required"
              },
              {
                "control": "select",
                "prop": "attr:value",
                "label": "value",
                "options": [
                  "si",
                  "semanal"
                ]
              }
          ],
          "equivNote": "Como checkbox: solo el estado on aporta al FormData.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": "<iswc-flowchart open-on-click animation=\"flow\">\n  <script type=\"application/json\">\n  {\n    \"flowchart\": {\n      \"title\": \"iswc-switch: FormData\",\n      \"direction\": \"TB\",\n      \"nodes\": [\n        {\n          \"id\": \"q\",\n          \"label\": \"checked?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"a\",\n          \"label\": \"on → aporta value\",\n          \"shape\": \"stadium\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"off → no envía\",\n          \"shape\": \"stadium\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"readonly / disabled\",\n          \"shape\": \"round\"\n        }\n      ],\n      \"edges\": [\n        {\n          \"from\": \"q\",\n          \"to\": \"a\",\n          \"label\": \"si\"\n        },\n        {\n          \"from\": \"q\",\n          \"to\": \"b\",\n          \"label\": \"no\"\n        },\n        {\n          \"from\": \"a\",\n          \"to\": \"c\"\n        },\n        {\n          \"from\": \"b\",\n          \"to\": \"c\"\n        }\n      ]\n    }\n  }\n  </script>\n</iswc-flowchart>"
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"swLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Cambia un interruptor para ver el evento.</div></div>"
        }
      ]
    },
    {
      "id": "color",
      "title": "Color",
      "lede": "<code class=\"code\">variant</code> equivale a la prop <code class=\"code\">color</code> de MUI: redefine el\r\n          carril encendido, el halo de la perilla y el anillo de foco.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-switch checked>brand (default)</iswc-switch>\r\n            <iswc-switch color=\"neutral\" checked>neutral</iswc-switch>\r\n            <iswc-switch color=\"success\" checked>success</iswc-switch>\r\n            <iswc-switch color=\"warning\" checked>warning</iswc-switch>\r\n            <iswc-switch color=\"danger\" checked>danger</iswc-switch>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-switch color=\"success\" checked>success</iswc-switch>"
        }
      ]
    },
    {
      "id": "label-placement",
      "title": "Posición de la etiqueta",
      "lede": "<code class=\"code\">label-placement</code> equivale a <code class=\"code\">labelPlacement</code> del\r\n          <code class=\"code\">FormControlLabel</code> de MUI.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"placements\">\r\n            <iswc-switch checked>end (default)</iswc-switch>\r\n            <iswc-switch label-placement=\"start\" checked>start</iswc-switch>\r\n            <iswc-switch label-placement=\"top\" checked>top</iswc-switch>\r\n            <iswc-switch label-placement=\"bottom\" checked>bottom</iswc-switch>\r\n          </div>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">\r\n          Para un panel de ajustes con la etiqueta a la izquierda y el interruptor pegado al borde derecho,\r\n          combina <code class=\"code\">label-placement=\"start\"</code> con\r\n          <code class=\"code\">::part(base) { justify-content: space-between }</code>.\r\n        </p>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"settings\">\r\n            <iswc-switch label-placement=\"start\" checked>Modo compacto</iswc-switch>\r\n            <iswc-switch label-placement=\"start\">Sonidos de la interfaz</iswc-switch>\r\n            <iswc-switch label-placement=\"start\" checked>Guardado automático</iswc-switch>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": ".settings { display: flex; flex-direction: column; }\n.settings iswc-switch::part(base) { justify-content: space-between; }"
        }
      ]
    },
    {
      "id": "icons",
      "title": "Iconos en la perilla",
      "lede": "<code class=\"code\">icon</code> (apagado) y <code class=\"code\">checked-icon</code> (encendido) reciben\r\n          nombres de <code class=\"code\">iswc-icon</code>, como el ejemplo de <em>customized switches</em> de MUI.\r\n          Al usarlos el control crece para dar sitio al glifo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-switch icon=\"mdi:weather-night\" checked-icon=\"mdi:white-balance-sunny\" color=\"warning\" checked>Tema claro</iswc-switch>\r\n            <iswc-switch icon=\"mdi:close\" checked-icon=\"mdi:check\" color=\"success\">Sincronizar</iswc-switch>\r\n            <iswc-switch checked-icon=\"mdi:lock\" checked>Bloquear pantalla</iswc-switch>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-switch icon=\"mdi:weather-night\" checked-icon=\"mdi:white-balance-sunny\"\n  color=\"warning\" checked>Tema claro</iswc-switch>"
        }
      ]
    },
    {
      "id": "track-labels",
      "title": "Rótulos en el carril",
      "lede": "<code class=\"code\">on-label</code> y <code class=\"code\">off-label</code> pintan un texto corto dentro del\r\n          carril, en el hueco que deja la perilla. Pensados para dos o tres caracteres.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-switch on-label=\"ON\" off-label=\"OFF\" checked>Encendido</iswc-switch>\r\n            <iswc-switch on-label=\"SÍ\" off-label=\"NO\" color=\"success\">Confirmación</iswc-switch>\r\n            <iswc-switch on-label=\"24h\" off-label=\"12h\" checked>Formato de hora</iswc-switch>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-switch on-label=\"ON\" off-label=\"OFF\" checked>Encendido</iswc-switch>"
        }
      ]
    },
    {
      "id": "readonly",
      "title": "Solo lectura y deshabilitado",
      "lede": "<code class=\"code\">readonly</code> bloquea el cambio pero mantiene el valor en el formulario y el foco\r\n          navegable con <code class=\"code\">Tab</code>. <code class=\"code\">disabled</code> saca el control del orden\r\n          de tabulación y no aporta entrada al <code class=\"code\">FormData</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-switch name=\"ro1\" checked readonly>Solo lectura (encendido)</iswc-switch>\r\n            <iswc-switch name=\"ro2\" readonly>Solo lectura (apagado)</iswc-switch>\r\n            <iswc-switch name=\"di1\" checked disabled>Deshabilitado</iswc-switch>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-switch name=\"ro1\" checked readonly>Solo lectura</iswc-switch>"
        }
      ]
    },
    {
      "id": "error",
      "title": "Error y texto de ayuda",
      "lede": "<code class=\"code\">hint</code> pinta un texto bajo el control (atributo o slot homónimo).\r\n          <code class=\"code\">error</code> tiñe carril y ayuda con el color de peligro y marca\r\n          <code class=\"code\">aria-invalid</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-switch hint=\"Se aplica de inmediato, sin guardar.\" checked>Sincronización en la nube</iswc-switch>\r\n            <iswc-switch error hint=\"Actívalo para poder facturar electrónicamente.\" required>Firma electrónica</iswc-switch>\r\n            <iswc-switch error checked>\r\n              Modo mantenimiento\r\n              <span slot=\"hint\">El texto de ayuda también admite un <b>slot</b>.</span>\r\n            </iswc-switch>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-switch error hint=\"Actívalo para poder facturar electrónicamente.\" required>\n  Firma electrónica\n</iswc-switch>"
        }
      ]
    },
    {
      "id": "form",
      "title": "Dentro de un formulario",
      "lede": "Apagado no aporta entrada al <code class=\"code\">FormData</code>, igual que una casilla nativa. Con\r\n          <code class=\"code\">required</code> reporta <code class=\"code\">valueMissing</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<form id=\"demoForm\">\r\n            <div class=\"stack\">\r\n              <iswc-switch name=\"privacidad\" value=\"si\" required>Acepto la política de privacidad (obligatorio)</iswc-switch>\r\n              <iswc-switch name=\"boletin\" value=\"semanal\" checked>Boletín semanal</iswc-switch>\r\n              <iswc-switch name=\"auditoria\" value=\"si\" checked readonly hint=\"Fijado por la política de la empresa.\">Registro de auditoría</iswc-switch>\r\n              <div class=\"inline\" style=\"gap:.5rem\">\r\n                <iswc-button color=\"brand\" id=\"btnSend\">Enviar</iswc-button>\r\n                <iswc-button variant=\"outlined\" id=\"btnReset\">Reset</iswc-button>\r\n              </div>\r\n            </div>\r\n          </form>"
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"formLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Envía el formulario para ver el FormData.</div></div>"
        },
        {
          "kind": "code",
          "code": "<iswc-switch name=\"boletin\" value=\"semanal\" checked>Boletín semanal</iswc-switch>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala por contexto",
      "lede": "Sin atributo <code class=\"code\">size</code>: carril y perilla se miden en <code class=\"code\">em</code> y\r\n          heredan el <code class=\"code\">font-size</code> del contenedor.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <span style=\"font-size:.8rem\"><iswc-switch checked>0.8rem</iswc-switch></span>\r\n            <span style=\"font-size:1rem\"><iswc-switch checked>1rem</iswc-switch></span>\r\n            <span style=\"font-size:1.35rem\"><iswc-switch checked>1.35rem</iswc-switch></span>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<span style=\"font-size:1.35rem\"><iswc-switch checked>Grande</iswc-switch></span>"
        }
      ]
    },
    {
      "id": "keyboard",
      "title": "Teclado",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Tecla",
            "Acción"
          ],
          "rows": [
            [
              "<code>Tab</code>",
              "enfoca el interruptor (también con <code>readonly</code>; no con <code>disabled</code>)"
            ],
            [
              "<code>Espacio</code> <code>Enter</code>",
              "alterna encendido / apagado y emite <code>iswc-change</code>"
            ]
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "<code>name</code>",
              "clave en FormData"
            ],
            [
              "<code>value</code>",
              "default <code>on</code>; solo se envía si está encendido"
            ],
            [
              "<code>checked</code>",
              "boolean, reflejado"
            ],
            [
              "<code>disabled</code> <code>readonly</code> <code>required</code> <code>error</code>",
              "boolean"
            ],
            [
              "<code>variant</code>",
              "<code>brand</code> (default) · <code>neutral</code> · <code>success</code> · <code>warning</code> · <code>danger</code>"
            ],
            [
              "<code>label-placement</code>",
              "<code>end</code> (default) · <code>start</code> · <code>top</code> · <code>bottom</code>"
            ],
            [
              "<code>icon</code> <code>checked-icon</code>",
              "iconos <code>iswc-icon</code> dentro de la perilla (apagado / encendido)"
            ],
            [
              "<code>on-label</code> <code>off-label</code>",
              "texto corto dentro del carril"
            ],
            [
              "<code>hint</code>",
              "texto de ayuda bajo el control; también slot <code>hint</code>"
            ],
            [
              "propiedades JS",
              "<code>checked</code> <code>value</code> <code>name</code> <code>variant</code> <code>labelPlacement</code> <code>icon</code> <code>checkedIcon</code> <code>onLabel</code> <code>offLabel</code> <code>hint</code> <code>error</code> <code>readonly</code> <code>disabled</code> <code>required</code>"
            ],
            [
              "slots",
              "default (etiqueta) · <code>hint</code>"
            ],
            [
              "parts",
              "<code>form-control</code> <code>base</code> <code>control</code> <code>track-label</code> <code>thumb</code> <code>mark</code> <code>label</code> <code>hint</code>"
            ],
            [
              "states",
              "<code>:state(checked)</code> <code>:state(disabled)</code> <code>:state(readonly)</code> <code>:state(error)</code>"
            ],
            [
              "eventos",
              "<code>iswc-change</code> · detail <code>{ checked, value }</code>"
            ],
            [
              "métodos",
              "<code>checkValidity()</code> <code>reportValidity()</code> <code>setCustomValidity()</code>"
            ],
            [
              "rol",
              "<code>switch</code> · Espacio y Enter alternan"
            ],
            [
              "tokens",
              "<code>--iswc-switch-height</code> <code>--iswc-switch-width</code> <code>--iswc-switch-bg</code> <code>--iswc-switch-bg-hover</code> <code>--iswc-switch-border</code> <code>--iswc-switch-accent</code> <code>--iswc-switch-thumb</code> <code>--iswc-switch-icon</code> <code>--iswc-switch-icon-checked</code> <code>--iswc-switch-focus</code> <code>--iswc-switch-halo</code>"
            ]
          ]
        }
      ]
    }
  ]
}
