{
  "$schema": "is-preview/v1",
  "tag": "is-inline-edit",
  "category": "forms",
  "title": "<is-inline-edit>",
  "titleHtml": true,
  "styles": ".ie-row { padding: .55rem 0; display: flex; gap: 1.25rem; align-items: baseline; flex-wrap: wrap; }\r\n    .ie-row > span.label { font-size: .82rem; color: var(--is-text-soft); width: 7rem; flex: 0 0 auto; }\r\n    .ie-row p { margin: 0; font-size: .82rem; color: var(--is-text-dim); }",
  "storageKey": "docs-is-inline-edit",
  "sections": [
    {
      "id": "intro",
      "title": "<is-inline-edit>",
      "lede": "Texto plano que se vuelve editable al clic. Enter guarda y sale. Esc cancela y revierte. Blur guarda por defecto; usá <code class=\"code\">cancel-on-blur</code> para invertirlo.",
      "blocks": []
    },
    {
      "id": "texto",
      "title": "Texto",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"ie-row\">\r\n            <span class=\"label\">Nombre</span>\r\n            <is-inline-edit id=\"ie1\" value=\"Carolina Méndez\" placeholder=\"Sin nombre\"></is-inline-edit>\r\n          </div>\r\n          <div class=\"ie-row\">\r\n            <span class=\"label\">Email</span>\r\n            <is-inline-edit id=\"ie2\" value=\"caro@empresa.co\"></is-inline-edit>\r\n          </div>\r\n          <div class=\"ie-row\">\r\n            <span class=\"label\">Vacío</span>\r\n            <is-inline-edit placeholder=\"Clic para escribir\"></is-inline-edit>\r\n          </div>",
          "controls": [
              {
                "control": "select",
                "prop": "attr:placeholder",
                "label": "placeholder",
                "options": [
                  "Sin nombre",
                  "Clic para escribir"
                ]
              },
              {
                "control": "text",
                "prop": "attr:mode",
                "label": "mode"
              },
              {
                "control": "number",
                "prop": "attr:rows",
                "label": "rows",
                "min": 0,
                "max": 100,
                "step": 1
              }
          ],
          "equivNote": "mode elige control; cancel-on-blur decide si blur guarda o cancela.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": "<is-flowchart open-on-click animation=\"flow\">\n  <script type=\"application/json\">\n  {\n    \"flowchart\": {\n      \"title\": \"is-inline-edit: blur\",\n      \"direction\": \"TB\",\n      \"nodes\": [\n        {\n          \"id\": \"q\",\n          \"label\": \"mode=?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"a\",\n          \"label\": \"text → input\",\n          \"shape\": \"round\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"textarea\",\n          \"shape\": \"round\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"cancel-on-blur?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"d\",\n          \"label\": \"descarta\",\n          \"shape\": \"stadium\"\n        },\n        {\n          \"id\": \"e\",\n          \"label\": \"guarda (is-change)\",\n          \"shape\": \"stadium\"\n        }\n      ],\n      \"edges\": [\n        {\n          \"from\": \"q\",\n          \"to\": \"a\",\n          \"label\": \"text\"\n        },\n        {\n          \"from\": \"q\",\n          \"to\": \"b\",\n          \"label\": \"textarea\"\n        },\n        {\n          \"from\": \"a\",\n          \"to\": \"c\"\n        },\n        {\n          \"from\": \"b\",\n          \"to\": \"c\"\n        },\n        {\n          \"from\": \"c\",\n          \"to\": \"d\",\n          \"label\": \"si\"\n        },\n        {\n          \"from\": \"c\",\n          \"to\": \"e\",\n          \"label\": \"no\"\n        }\n      ]\n    }\n  }\n  </script>\n</is-flowchart>"
        }
      ]
    },
    {
      "id": "textarea",
      "title": "Multilínea",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-inline-edit mode=\"textarea\" rows=\"3\" value=\"Acá podés tipear varias líneas. Enter adentro inserta un salto de línea; afuera del área Enter sigue guardando.\" style=\"--is-inline-edit-min-h: 4.5rem; width: 100%;\"></is-inline-edit>"
        }
      ]
    },
    {
      "id": "contenido",
      "title": "Slot display (HTML personalizado)",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Si el slot <code class=\"code\">display</code> tiene contenido, ése se muestra en lectura; al editar vuelve al editor interno.</p>"
        },
        {
          "kind": "demo",
          "html": "<is-inline-edit value=\"InSoft\" style=\"font-size:1.15rem; font-weight:600;\">\r\n            <span slot=\"display\"><is-icon icon=\"mdi:office-building\" style=\"vertical-align:middle\"></is-icon> InSoft S.A.</span>\r\n          </is-inline-edit>"
        }
      ]
    },
    {
      "id": "api",
      "title": "API JS",
      "blocks": [
        {
          "kind": "code",
          "code": "const ie = document.querySelector('is-inline-edit');\nie.value              // string actual\nie.editing            // boolean\nie.edit()             // entra en modo edición (programáticamente)\nie.save()             // guarda y sale\nie.cancel()           // revierte y sale\nie.addEventListener('is-save',   e => console.log('nuevo:', e.detail.value, 'prev:', e.detail.previous));\nie.addEventListener('is-cancel', e => ...);\nie.addEventListener('is-edit',   () => ...);\n\n// form-associated\n// <form><is-inline-edit name=\"label\"></is-inline-edit></form>\nnew FormData(form).get('label')  // = ie.value"
        }
      ]
    }
  ]
}
