{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-inline-edit",
  "category": "forms",
  "title": "&lt;iswc-inline-edit&gt;",
  "titleHtml": false,
  "styles": [
    ".ie-row { padding: .55rem 0; display: flex; gap: 1.25rem; align-items: baseline; flex-wrap: wrap; }",
    "    .ie-row > span.label { font-size: .82rem; color: var(--iswc-text-soft); width: 7rem; flex: 0 0 auto; }",
    "    .ie-row p { margin: 0; font-size: .82rem; color: var(--iswc-text-dim); }"
  ],
  "storageKey": "docs-iswc-inline-edit",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Texto plano que se vuelve editable al clic. Enter guarda y sale. Esc cancela y revierte. Blur guarda por defecto; usá <code class=\"code\">cancel-on-blur</code> para invertirlo.",
      "blocks": []
    },
    {
      "id": "texto",
      "title": "Texto",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"ie-row\">",
            "            <span class=\"label\">Nombre</span>",
            "            <iswc-inline-edit id=\"ie1\" value=\"Carolina Méndez\" placeholder=\"Sin nombre\"></iswc-inline-edit>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:placeholder",
              "label": "placeholder",
              "options": [
                "Sin nombre",
                "Clic para escribir"
              ]
            },
            {
              "control": "text",
              "prop": "attr:mode",
              "label": "mode"
            },
            {
              "control": "number",
              "prop": "attr:rows",
              "label": "rows",
              "min": 0,
              "max": 100,
              "step": 1
            }
          ],
          "equivNote": "mode elige control; cancel-on-blur decide si blur guarda o cancela.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-inline-edit: blur\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"mode=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"text → input\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"textarea\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"cancel-on-blur?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"descarta\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"e\",",
            "          \"label\": \"guarda (iswc-change)\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"text\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"textarea\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"d\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"e\",",
            "          \"label\": \"no\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "textarea",
      "title": "Multilínea",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-inline-edit mode=\"textarea\" rows=\"3\" value=\"Acá podés tipear varias líneas. Enter adentro inserta un salto de línea; afuera del área Enter sigue guardando.\" style=\"--iswc-inline-edit-min-h: 4.5rem; width: 100%;\"></iswc-inline-edit>"
        }
      ]
    },
    {
      "id": "contenido",
      "title": "Texto visible",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Si el slot <code class=\"code\">display</code> tiene contenido, ése se muestra en lectura; al editar vuelve al editor interno.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-inline-edit value=\"InSoft\" style=\"font-size:1.15rem; font-weight:600;\">",
            "            <span slot=\"display\"><iswc-icon icon=\"mdi:office-building\" style=\"vertical-align:middle\"></iswc-icon> InSoft S.A.</span>",
            "          </iswc-inline-edit>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API JS",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const ie = document.querySelector('iswc-inline-edit');",
            "ie.value              // string actual",
            "ie.editing            // boolean",
            "ie.edit()             // entra en modo edición (programáticamente)",
            "ie.save()             // guarda y sale",
            "ie.cancel()           // revierte y sale",
            "ie.addEventListener('iswc-save',   e => console.log('nuevo:', e.detail.value, 'prev:', e.detail.previous));",
            "ie.addEventListener('iswc-cancel', e => ...);",
            "ie.addEventListener('iswc-edit',   () => ...);",
            "",
            "// form-associated",
            "// <form><iswc-inline-edit name=\"label\"></iswc-inline-edit></form>",
            "new FormData(form).get('label')  // = ie.value"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Texto plano que se vuelve editable al clic. Enter guarda y sale. Esc cancela y revierte. Blur guarda por defecto; usá <code class=\"code\">cancel-on-blur</code> para invertirlo."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
