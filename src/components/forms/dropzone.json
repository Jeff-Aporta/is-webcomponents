{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-dropzone",
  "category": "forms",
  "title": "&lt;iswc-dropzone&gt;",
  "titleHtml": false,
  "styles": [
    "pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 8rem; overflow: auto;",
    "    }",
    "    button.go {",
    "      font: inherit;",
    "      padding: .5rem 1rem;",
    "      background: var(--iswc-accent);",
    "      color: var(--iswc-on-accent, #fff);",
    "      border: 0; border-radius: 999px;",
    "      cursor: pointer;",
    "    }"
  ],
  "storageKey": "docs-iswc-dropzone",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Zona de arrastre con cola de archivos, preview de imagen, límite de tamaño y simulación de progreso chunked.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-dropzone id=\"dz\" accept=\"image/*\" max-files=\"6\" max-size=\"5242880\">",
            "          </iswc-dropzone>",
            "          <div style=\"display:flex; gap:.5rem; margin-top:.55rem; align-items:center\">",
            "            <button class=\"go\" id=\"uploadBtn\">Simular upload</button>",
            "            <small style=\"color:var(--iswc-text-soft); font-size:.78rem\">Arrastra o selecciona archivos; click \"Simular upload\" para ver el progreso.</small>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "text",
              "prop": "attr:accept",
              "label": "accept"
            },
            {
              "control": "number",
              "prop": "attr:max-files",
              "label": "max-files",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:max-size",
              "label": "max-size",
              "min": 0,
              "max": 5242880,
              "step": 1
            }
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\">— eventos —</pre>"
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const dz = document.querySelector('iswc-dropzone');",
            "dz.files;                 // array de FileRecord",
            "dz.addFile(file);",
            "dz.removeFile(id);",
            "dz.upload();              // dispara iswc-upload-progress por chunk",
            "dz.addEventListener('iswc-files-change',   e => console.log(e.detail.files));",
            "dz.addEventListener('iswc-upload-start',   e => ...);",
            "dz.addEventListener('iswc-upload-progress',e => console.log(e.detail.progress));",
            "dz.addEventListener('iswc-upload-end',     e => ...);",
            "dz.addEventListener('iswc-error',          e => /* reason: max-size | accept | max-files */);",
            "",
            "// Atributos",
            "// accept, multiple, max-files, max-size (bytes), chunked"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Zona de arrastre con cola de archivos, preview de imagen, límite de tamaño y simulación de progreso chunked."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
