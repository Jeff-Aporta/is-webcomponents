{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-masked-input",
  "category": "forms",
  "title": "&lt;iswc-masked-input&gt;",
  "titleHtml": false,
  "styles": [
    ".mask-row { display: grid; grid-template-columns: 12rem 1fr; gap: 1rem; align-items: center; padding: .35rem 0; }",
    "    .mask-row label { font-size: .82rem; color: var(--iswc-text-soft); }"
  ],
  "storageKey": "docs-iswc-masked-input",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Campo de texto que aplica un patrón mientras el usuario tipea. Útil para tarjetas, fechas, teléfonos y todo formato con estructura fija.",
      "blocks": []
    },
    {
      "id": "tokens",
      "title": "Patrones de la máscara",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Char",
            "Acepta",
            "¿Requerido?",
            "Nota"
          ],
          "rows": [
            [
              "<code>0</code>",
              "0–9",
              "sí",
              "Dígito obligatorio."
            ],
            [
              "<code>9</code>",
              "0–9",
              "no",
              "Dígito opcional."
            ],
            [
              "<code>A</code>",
              "A–Z / a–z",
              "sí",
              "Forzado a mayúsculas (case fold)."
            ],
            [
              "<code>a</code>",
              "a–z",
              "no",
              "Minúscula."
            ],
            [
              "<code>*</code>",
              "A–Z / a–z / 0–9",
              "no",
              "Alfanumérico opcional."
            ],
            [
              "cualquier otro",
              "—",
              "—",
              "Literal: se imprime tal cual cuando hay datos."
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "title": "Patrones comunes",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"mask-row\"><label>Tarjeta</label>",
            "            <iswc-masked-input id=\"card\" pattern=\"0000 0000 0000 0000\" autocomplete=\"cc-number\"></iswc-masked-input>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:pattern",
              "label": "pattern",
              "options": [
                "0000 0000 0000 0000",
                "00/00",
                "00/00/0000",
                "(+00) 0000-0000",
                "00:00",
                "A0A 0A0",
                "AAA-0000",
                "#000000"
              ]
            },
            {
              "control": "text",
              "prop": "attr:autocomplete",
              "label": "autocomplete"
            },
            {
              "control": "select",
              "prop": "attr:placeholder",
              "label": "placeholder",
              "options": [
                "MM/AA",
                "DD/MM/AAAA",
                "(+57) 3000-0000",
                "HH:MM",
                "#000000"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            },
            {
              "control": "text",
              "prop": "attr:value",
              "label": "value"
            }
          ]
        }
      ]
    },
    {
      "id": "valor",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const m = document.querySelector('iswc-masked-input');",
            "m.value           // texto formateado: \"1234 5678 9012 3456\"",
            "m.raw             // caracteres limpios: \"1234567890123456\"",
            "m.complete        // boolean: ¿rellenó todos los slots requeridos?",
            "m.formatted       // alias de value",
            "",
            "m.addEventListener('iswc-input',    e => /* cada keystroke */);",
            "m.addEventListener('iswc-complete', e => /* completó el patrón */);",
            "",
            "// API HTML:  invisible participa en formularios vía ElementInternals",
            "//   <form><iswc-masked-input name=\"card\" pattern=\"0000 0000 0000 0000\"></iswc-masked-input></form>",
            "formData.get('card');  // texto formateado (no raw; usar raw attr si se quiere limpio)"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Campo de texto que aplica un patrón mientras el usuario tipea. Útil para tarjetas, fechas, teléfonos y todo formato con estructura fija."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
