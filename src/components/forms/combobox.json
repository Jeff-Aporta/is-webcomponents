{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-combobox",
  "category": "forms",
  "title": "&lt;iswc-combobox&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-combobox",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Input + listbox filtrable con teclado y opciones <code>iswc-option</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-combobox label=\"Ciudad\" hint=\"Escribe para filtrar\" placeholder=\"Buscar…\" clearable name=\"city\" style=\"max-width:20rem\">",
            "            <iswc-option value=\"bog\">Bogotá</iswc-option>",
            "            <iswc-option value=\"med\">Medellín</iswc-option>",
            "            <iswc-option value=\"cal\">Cali</iswc-option>",
            "            <iswc-option value=\"barr\">Barranquilla</iswc-option>",
            "            <iswc-option value=\"buc\">Bucaramanga</iswc-option>",
            "          </iswc-combobox>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Ciudad",
                "País"
              ]
            },
            {
              "control": "text",
              "prop": "attr:placeholder",
              "label": "placeholder"
            },
            {
              "control": "boolean",
              "prop": "attr:clearable",
              "label": "clearable"
            },
            {
              "control": "text",
              "prop": "attr:value",
              "label": "value"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "Con valor inicial",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-combobox label=\"País\" value=\"co\" required style=\"max-width:20rem\">",
            "            <option value=\"co\">Colombia</option>",
            "            <option value=\"mx\">México</option>",
            "            <option value=\"es\">España</option>",
            "          </iswc-combobox>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>iswc-change</code>, <code>iswc-input</code>, <code>iswc-show</code>, <code>iswc-hide</code>. Teclado: ↑↓ Enter Esc.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>label</code> / <code>hint</code>"
            ],
            [
              "<code>name</code> / <code>value</code>"
            ],
            [
              "<code>placeholder</code>"
            ],
            [
              "<code>disabled</code> / <code>required</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>open</code> / <code>clearable</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Input + listbox filtrable con teclado y opciones <code>iswc-option</code>."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>label</code> / <code>hint</code>",
            "default": "—"
          },
          {
            "name": "<code>name</code> / <code>value</code>",
            "default": "—"
          },
          {
            "name": "<code>placeholder</code>",
            "default": "—"
          },
          {
            "name": "<code>disabled</code> / <code>required</code>",
            "default": "false"
          },
          {
            "name": "<code>open</code> / <code>clearable</code>",
            "default": "false"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-combobox label=\"Ciudad\" hint=\"Escribe para filtrar\" placeholder=\"Buscar…\" clearable name=\"city\" style=\"max-width:20rem\">",
          "            <iswc-option value=\"bog\">Bogotá</iswc-option>",
          "            <iswc-option value=\"med\">Medellín</iswc-option>",
          "            <iswc-option value=\"cal\">Cali</iswc-option>",
          "            <iswc-option value=\"barr\">Barranquilla</iswc-option>",
          "            <iswc-option value=\"buc\">Bucaramanga</iswc-option>",
          "          </iswc-combobox>",
          "```"
        ]
