{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-select",
  "category": "forms",
  "title": "&lt;iswc-select&gt;",
  "titleHtml": false,
  "styles": ".stack { display: grid; gap: 1.25rem; max-width: 22rem; }\r\n    .grid { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start; }\r\n    .grid iswc-select { min-width: 15rem; }",
  "storageKey": "docs-iswc-select",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Select form-associated con paridad funcional con el\r\n          <a href=\"https://mui.com/material-ui/react-select/\" target=\"_blank\" rel=\"noreferrer\">Select de MUI</a>:\r\n          variants, error, selección múltiple con chips o checkmarks, agrupación, opciones ricas y typeahead.\r\n          El listbox vive en un <code class=\"code\">&lt;dialog&gt;</code> del top layer, así que nunca lo recorta\r\n          el <code class=\"code\">overflow</code> de un ancestro.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-select id=\"sel\" label=\"Ciudad\" hint=\"Una sola opción\" placeholder=\"Elige una ciudad…\" name=\"city\" clearable style=\"max-width:20rem\">\r\n            <iswc-option value=\"bog\">Bogotá</iswc-option>\r\n            <iswc-option value=\"med\">Medellín</iswc-option>\r\n            <iswc-option value=\"cal\">Cali</iswc-option>\r\n            <iswc-option value=\"barr\">Barranquilla</iswc-option>\r\n            <iswc-option value=\"buc\" disabled>Bucaramanga (no disponible)</iswc-option>\r\n            <iswc-option value=\"cta\">Cartagena</iswc-option>\r\n          </iswc-select>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Ciudad",
                "outlined (default)",
                "filled",
                "underlined",
                "Con hint",
                "Con error",
                "Error + filled",
                "normal",
                "full-width",
                "auto-width",
                "max-visible 4.5",
                "tags (default)",
                "text",
                "count",
                "limit-tags 2",
                "Personas",
                "Categoría",
                "Destino",
                "País",
                "Etiquetas",
                "Deshabilitado",
                "Con slot start",
                "Clearable"
              ]
            },
            {
              "control": "select",
              "prop": "attr:placeholder",
              "label": "placeholder",
              "options": [
                "Elige una ciudad…",
                "Sin selección…",
                "Ancho por defecto…",
                "Ocupa el resto…",
                "Estrecho…",
                "20 opciones…",
                "Selecciona…",
                "Elige una…",
                "Elige un destino…",
                "Obligatorio…",
                "Opcional…",
                "Buscar…"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:clearable",
              "label": "clearable"
            },
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "a",
                "js,css",
                "js,css,html",
                "js,ts,css,html",
                "oliver,april",
                "1"
              ]
            },
            {
              "control": "select",
              "prop": "attr:variant",
              "label": "variant",
              "options": [
                "filled",
                "underlined"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:error",
              "label": "error"
            },
            {
              "control": "boolean",
              "prop": "attr:full-width",
              "label": "full-width"
            },
            {
              "control": "boolean",
              "prop": "attr:auto-width",
              "label": "auto-width"
            },
            {
              "control": "number",
              "prop": "attr:max-visible",
              "label": "max-visible",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:multiple",
              "label": "multiple"
            },
            {
              "control": "select",
              "prop": "attr:selection-display",
              "label": "selection-display",
              "options": [
                "text",
                "count"
              ]
            },
            {
              "control": "number",
              "prop": "attr:limit-tags",
              "label": "limit-tags",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:checkmarks",
              "label": "checkmarks"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            }
          ],
          "equivNote": "Ramas de selección: multiple cambia FormData y cómo se muestra el valor.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": "<iswc-flowchart open-on-click animation=\"flow\">\n  <script type=\"application/json\">\n  {\n    \"flowchart\": {\n      \"title\": \"iswc-select: ramas\",\n      \"direction\": \"TB\",\n      \"nodes\": [\n        {\n          \"id\": \"q\",\n          \"label\": \"multiple?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"s\",\n          \"label\": \"single → value string\",\n          \"shape\": \"stadium\"\n        },\n        {\n          \"id\": \"m\",\n          \"label\": \"multiple → CSV / tags\",\n          \"shape\": \"round\"\n        },\n        {\n          \"id\": \"d\",\n          \"label\": \"selection-display?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"t\",\n          \"label\": \"tags | text | count\",\n          \"shape\": \"stadium\"\n        }\n      ],\n      \"edges\": [\n        {\n          \"from\": \"q\",\n          \"to\": \"s\",\n          \"label\": \"no\"\n        },\n        {\n          \"from\": \"q\",\n          \"to\": \"m\",\n          \"label\": \"si\"\n        },\n        {\n          \"from\": \"m\",\n          \"to\": \"d\"\n        },\n        {\n          \"from\": \"d\",\n          \"to\": \"t\"\n        }\n      ]\n    }\n  }\n  </script>\n</iswc-flowchart>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log-single\">value: —</p>"
        },
        {
          "kind": "code",
          "code": "<iswc-select label=\"Ciudad\" name=\"city\" placeholder=\"Elige una ciudad…\" clearable>\n  <iswc-option value=\"bog\">Bogotá</iswc-option>\n  <iswc-option value=\"med\">Medellín</iswc-option>\n</iswc-select>"
        }
      ]
    },
    {
      "id": "appearance",
      "title": "Appearance",
      "lede": "<code class=\"code\">appearance</code> equivale a las <em>variants</em> de MUI:\r\n          <code class=\"code\">outlined</code> (default), <code class=\"code\">filled</code> y\r\n          <code class=\"code\">underlined</code> (el <em>standard</em> de MUI).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-select label=\"outlined (default)\" value=\"a\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select variant=\"filled\" label=\"filled\" value=\"a\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select variant=\"underlined\" label=\"underlined\" value=\"a\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-select variant=\"filled\" label=\"filled\">…</iswc-select>\n<iswc-select variant=\"underlined\" label=\"underlined\">…</iswc-select>"
        }
      ]
    },
    {
      "id": "labels",
      "title": "Label, hint y error",
      "lede": "<code class=\"code\">label</code>, <code class=\"code\">hint</code> y <code class=\"code\">placeholder</code>\r\n          aceptan texto o los slots homónimos. Con <code class=\"code\">error</code> el borde y la etiqueta pasan a\r\n          color de peligro y <code class=\"code\">error-text</code> sustituye al <code class=\"code\">hint</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-select label=\"Con hint\" hint=\"Texto de ayuda\" placeholder=\"Sin selección…\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"Con error\" hint=\"Este hint queda oculto\" error error-text=\"Selecciona un valor válido\" placeholder=\"Sin selección…\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select variant=\"filled\" label=\"Error + filled\" error error-text=\"Campo obligatorio\" placeholder=\"Sin selección…\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-select label=\"Con error\" error error-text=\"Selecciona un valor válido\">\n  <iswc-option value=\"a\">Opción A</iswc-option>\n</iswc-select>"
        }
      ]
    },
    {
      "id": "width",
      "title": "Ancho",
      "lede": "<code class=\"code\">full-width</code> estira el control al 100 % del contenedor.\r\n          <code class=\"code\">auto-width</code> hace que el listbox se ajuste a su contenido en lugar de al ancho\r\n          del trigger (el <code class=\"code\">autoWidth</code> de MUI); se mantiene dentro del viewport.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"display:flex;gap:1rem;max-width:32rem\">\r\n            <iswc-select label=\"normal\" placeholder=\"Ancho por defecto…\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select full-width label=\"full-width\" placeholder=\"Ocupa el resto…\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n              <iswc-option value=\"b\">Opción B</iswc-option>\r\n            </iswc-select>\r\n          </div>\r\n          <div style=\"max-width:11rem;margin-top:1rem\">\r\n            <iswc-select auto-width label=\"auto-width\" placeholder=\"Estrecho…\">\r\n              <iswc-option value=\"a\">Contenido bastante más ancho que el trigger</iswc-option>\r\n              <iswc-option value=\"b\">Corto</iswc-option>\r\n              <iswc-option value=\"c\">Otra opción de longitud considerable</iswc-option>\r\n            </iswc-select>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-select full-width label=\"full-width\">…</iswc-select>\n<iswc-select auto-width label=\"auto-width\">…</iswc-select>"
        }
      ]
    },
    {
      "id": "max-visible",
      "title": "Alto del listbox",
      "lede": "<code class=\"code\">max-visible</code> fija el alto máximo del listbox en número de opciones antes de\r\n          hacer scroll. Admite decimales (<code class=\"code\">4.5</code>) para dejar media fila a la vista y\r\n          sugerir que hay más.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-select max-visible=\"4.5\" label=\"max-visible 4.5\" placeholder=\"20 opciones…\" style=\"max-width:18rem\">\r\n            <iswc-option value=\"1\">Opción 01</iswc-option>\r\n            <iswc-option value=\"2\">Opción 02</iswc-option>\r\n            <iswc-option value=\"3\">Opción 03</iswc-option>\r\n            <iswc-option value=\"4\">Opción 04</iswc-option>\r\n            <iswc-option value=\"5\">Opción 05</iswc-option>\r\n            <iswc-option value=\"6\">Opción 06</iswc-option>\r\n            <iswc-option value=\"7\">Opción 07</iswc-option>\r\n            <iswc-option value=\"8\">Opción 08</iswc-option>\r\n            <iswc-option value=\"9\">Opción 09</iswc-option>\r\n            <iswc-option value=\"10\">Opción 10</iswc-option>\r\n            <iswc-option value=\"11\">Opción 11</iswc-option>\r\n            <iswc-option value=\"12\">Opción 12</iswc-option>\r\n          </iswc-select>"
        },
        {
          "kind": "code",
          "code": "<iswc-select max-visible=\"4.5\">…</iswc-select>"
        }
      ]
    },
    {
      "id": "multiple",
      "title": "Selección múltiple",
      "lede": "Con <code class=\"code\">multiple</code>, <code class=\"code\">value</code> es una lista separada por comas\r\n          y en un <code class=\"code\">&lt;form&gt;</code> se envía una entrada de FormData por valor.\r\n          <code class=\"code\">selection-display</code> decide cómo se pinta la selección en el trigger:\r\n          <code class=\"code\">tags</code> (default), <code class=\"code\">text</code> o <code class=\"code\">count</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\" style=\"max-width:24rem\">\r\n            <iswc-select id=\"multi\" label=\"tags (default)\" hint=\"Chips con botón de quitar\" placeholder=\"Selecciona…\" name=\"stack\" multiple clearable value=\"js,css\">\r\n              <iswc-option value=\"js\">JavaScript</iswc-option>\r\n              <iswc-option value=\"ts\">TypeScript</iswc-option>\r\n              <iswc-option value=\"css\">CSS</iswc-option>\r\n              <iswc-option value=\"html\">HTML</iswc-option>\r\n              <iswc-option value=\"svelte\">Svelte</iswc-option>\r\n              <iswc-option value=\"wc\">Web Components</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"text\" selection-display=\"text\" placeholder=\"Selecciona…\" multiple value=\"js,css,html\">\r\n              <iswc-option value=\"js\">JavaScript</iswc-option>\r\n              <iswc-option value=\"ts\">TypeScript</iswc-option>\r\n              <iswc-option value=\"css\">CSS</iswc-option>\r\n              <iswc-option value=\"html\">HTML</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"count\" selection-display=\"count\" placeholder=\"Selecciona…\" multiple value=\"js,css,html\">\r\n              <iswc-option value=\"js\">JavaScript</iswc-option>\r\n              <iswc-option value=\"ts\">TypeScript</iswc-option>\r\n              <iswc-option value=\"css\">CSS</iswc-option>\r\n              <iswc-option value=\"html\">HTML</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"limit-tags 2\" limit-tags=\"2\" placeholder=\"Selecciona…\" multiple value=\"js,ts,css,html\">\r\n              <iswc-option value=\"js\">JavaScript</iswc-option>\r\n              <iswc-option value=\"ts\">TypeScript</iswc-option>\r\n              <iswc-option value=\"css\">CSS</iswc-option>\r\n              <iswc-option value=\"html\">HTML</iswc-option>\r\n            </iswc-select>\r\n          </div>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log-multi\">values: —</p>"
        },
        {
          "kind": "code",
          "code": "<iswc-select multiple label=\"Tecnologías\" value=\"js,css\">…</iswc-select>\n<iswc-select multiple selection-display=\"count\">…</iswc-select>\n<iswc-select multiple limit-tags=\"2\">…</iswc-select>"
        }
      ]
    },
    {
      "id": "checkmarks",
      "title": "Checkmarks",
      "lede": "<code class=\"code\">checkmarks</code> dibuja una casilla a la izquierda de cada opción del listbox, marcada\r\n          cuando la opción está seleccionada. Solo aplica en <code class=\"code\">multiple</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-select label=\"Personas\" checkmarks multiple selection-display=\"text\" placeholder=\"Selecciona…\" value=\"oliver,april\" style=\"max-width:22rem\">\r\n            <iswc-option value=\"oliver\">Oliver Hansen</iswc-option>\r\n            <iswc-option value=\"van\">Van Henry</iswc-option>\r\n            <iswc-option value=\"april\">April Tucker</iswc-option>\r\n            <iswc-option value=\"ralph\">Ralph Hubbard</iswc-option>\r\n            <iswc-option value=\"omar\">Omar Alexander</iswc-option>\r\n            <iswc-option value=\"carlos\">Carlos Abbott</iswc-option>\r\n          </iswc-select>"
        },
        {
          "kind": "code",
          "code": "<iswc-select multiple checkmarks selection-display=\"text\">\n  <iswc-option value=\"oliver\">Oliver Hansen</iswc-option>\n</iswc-select>"
        }
      ]
    },
    {
      "id": "groups",
      "title": "Agrupación",
      "lede": "El atributo <code class=\"code\">group</code> de <code class=\"code\">iswc-option</code> agrupa las opciones bajo\r\n          una cabecera no seleccionable (<code class=\"code\">role=\"group\"</code> +\r\n          <code class=\"code\">aria-labelledby</code>). Las opciones se reordenan por grupo respetando el orden de\r\n          aparición; las que no tienen <code class=\"code\">group</code> quedan arriba.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-select label=\"Categoría\" placeholder=\"Elige una…\" style=\"max-width:20rem\">\r\n            <iswc-option value=\"todas\">Todas</iswc-option>\r\n            <iswc-option value=\"op1\" group=\"Categoría 1\">Opción 1</iswc-option>\r\n            <iswc-option value=\"op2\" group=\"Categoría 1\">Opción 2</iswc-option>\r\n            <iswc-option value=\"op3\" group=\"Categoría 2\">Opción 3</iswc-option>\r\n            <iswc-option value=\"op4\" group=\"Categoría 2\">Opción 4</iswc-option>\r\n          </iswc-select>"
        },
        {
          "kind": "code",
          "code": "<iswc-select label=\"Categoría\">\n  <iswc-option value=\"todas\">Todas</iswc-option>\n  <iswc-option value=\"op1\" group=\"Categoría 1\">Opción 1</iswc-option>\n  <iswc-option value=\"op3\" group=\"Categoría 2\">Opción 3</iswc-option>\n</iswc-select>"
        }
      ]
    },
    {
      "id": "rich",
      "title": "Opciones ricas",
      "lede": "<code class=\"code\">iswc-option</code> acepta un slot <code class=\"code\">start</code> (icono o avatar) y un slot\r\n          <code class=\"code\">description</code> (texto secundario). El texto del slot por defecto sigue siendo la\r\n          etiqueta: lo de los slots con nombre no cuenta como tal.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-select label=\"Destino\" placeholder=\"Elige un destino…\" max-visible=\"4\" style=\"max-width:24rem\">\r\n            <iswc-option value=\"drive\">\r\n              <iswc-icon slot=\"start\" icon=\"mdi:google-drive\"></iswc-icon>\r\n              Google Drive\r\n              <span slot=\"description\">Sincroniza con tu cuenta corporativa</span>\r\n            </iswc-option>\r\n            <iswc-option value=\"s3\">\r\n              <iswc-icon slot=\"start\" icon=\"mdi:aws\"></iswc-icon>\r\n              Amazon S3\r\n              <span slot=\"description\">Bucket privado, cifrado en reposo</span>\r\n            </iswc-option>\r\n            <iswc-option value=\"ftp\" disabled>\r\n              <iswc-icon slot=\"start\" icon=\"mdi:server-network\"></iswc-icon>\r\n              FTP\r\n              <span slot=\"description\">Deshabilitado por política de seguridad</span>\r\n            </iswc-option>\r\n            <iswc-option value=\"local\">\r\n              <iswc-icon slot=\"start\" icon=\"mdi:folder\"></iswc-icon>\r\n              Carpeta local\r\n              <span slot=\"description\">Solo en este equipo</span>\r\n            </iswc-option>\r\n          </iswc-select>"
        },
        {
          "kind": "code",
          "code": "<iswc-option value=\"drive\">\n  <iswc-icon slot=\"start\" icon=\"mdi:google-drive\"></iswc-icon>\n  Google Drive\n  <span slot=\"description\">Sincroniza con tu cuenta corporativa</span>\n</iswc-option>"
        }
      ]
    },
    {
      "id": "form",
      "title": "Dentro de un formulario",
      "lede": "Form-associated: participa en <code class=\"code\">FormData</code>, en el reset y en la validación nativa\r\n          (<code class=\"code\">required</code> → <code class=\"code\">valueMissing</code>).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<form id=\"demo-form\" style=\"display:flex;flex-direction:column;gap:0.75rem;max-width:22rem\">\r\n            <iswc-select label=\"País\" name=\"country\" required placeholder=\"Obligatorio…\">\r\n              <iswc-option value=\"co\">Colombia</iswc-option>\r\n              <iswc-option value=\"mx\">México</iswc-option>\r\n              <iswc-option value=\"es\">España</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"Etiquetas\" name=\"tags\" multiple placeholder=\"Opcional…\">\r\n              <iswc-option value=\"urgente\">Urgente</iswc-option>\r\n              <iswc-option value=\"revisar\">Revisar</iswc-option>\r\n              <iswc-option value=\"archivado\">Archivado</iswc-option>\r\n            </iswc-select>\r\n            <div style=\"display:flex;gap:0.5rem\">\r\n              <button type=\"submit\">Enviar</button>\r\n              <button type=\"reset\">Reset</button>\r\n            </div>\r\n          </form>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log-form\">FormData: —</p>"
        },
        {
          "kind": "code",
          "code": "<iswc-select label=\"Etiquetas\" name=\"tags\" multiple>\n  <iswc-option value=\"urgente\">Urgente</iswc-option>\n</iswc-select>"
        }
      ]
    },
    {
      "id": "states",
      "title": "Estados",
      "lede": "<code class=\"code\">disabled</code>, <code class=\"code\">clearable</code> y el slot\r\n          <code class=\"code\">start</code> del propio select para un adorno fijo en el trigger.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"grid\">\r\n            <iswc-select label=\"Deshabilitado\" disabled value=\"a\">\r\n              <iswc-option value=\"a\">Opción A</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"Con slot start\" placeholder=\"Buscar…\">\r\n              <iswc-icon slot=\"start\" icon=\"mdi:magnify\"></iswc-icon>\r\n              <iswc-option value=\"1\">Uno</iswc-option>\r\n              <iswc-option value=\"2\">Dos</iswc-option>\r\n            </iswc-select>\r\n            <iswc-select label=\"Clearable\" clearable value=\"1\">\r\n              <iswc-option value=\"1\">Uno</iswc-option>\r\n              <iswc-option value=\"2\">Dos</iswc-option>\r\n            </iswc-select>\r\n          </div>"
        }
      ]
    },
    {
      "id": "keyboard",
      "title": "Teclado",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Tecla",
            "Acción"
          ],
          "rows": [
            [
              "<code>↓</code> <code>↑</code>",
              "cerrado: abre · abierto: mueve el foco de opción"
            ],
            [
              "<code>Alt</code> + <code>↓</code>",
              "abre el listbox sin mover la selección"
            ],
            [
              "<code>Alt</code> + <code>↑</code>",
              "cierra y devuelve el foco al trigger"
            ],
            [
              "<code>Home</code> <code>End</code>",
              "primera / última opción habilitada"
            ],
            [
              "<code>Enter</code>",
              "cerrado: abre · abierto: selecciona (en <code>multiple</code> alterna sin cerrar)"
            ],
            [
              "<code>Espacio</code>",
              "igual que <code>Enter</code>; si hay búsqueda en curso, se añade al término"
            ],
            [
              "<code>Esc</code>",
              "cierra sin cambiar la selección"
            ],
            [
              "<code>Tab</code>",
              "cierra confirmando lo ya seleccionado"
            ],
            [
              "letras",
              "typeahead: salta a la primera opción que empieza así (buffer de 500 ms)"
            ],
            [
              "misma letra repetida",
              "cicla entre las opciones que empiezan por ella"
            ]
          ]
