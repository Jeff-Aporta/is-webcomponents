  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Select form-associated con paridad funcional con el\r\n          <a href=\"https://mui.com/material-ui/react-select/\" target=\"_blank\" rel=\"noreferrer\">Select de MUI</a>:\r\n          variants, error, selección múltiple con chips o checkmarks, agrupación, opciones ricas y typeahead.\r\n          El listbox vive en un <code class=\"code\">&lt;dialog&gt;</code> del top layer, así que nunca lo recorta\r\n          el <code class=\"code\">overflow</code> de un ancestro."
      },
