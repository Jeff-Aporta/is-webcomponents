{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-full-calendar",
  "category": "forms",
  "title": "&lt;iswc-full-calendar&gt;",
  "titleHtml": false,
  "styles": [
    "pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 6rem; overflow: auto;",
    "    }",
    "    .kbds {",
    "      display: flex; gap: 1rem; flex-wrap: wrap;",
    "      font-size: .78rem; color: var(--iswc-text-soft);",
    "    }",
    "    .kbds b { color: var(--iswc-text); }"
  ],
  "storageKey": "docs-iswc-full-calendar",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Vista mes / semana / día con eventos por día y franjas horarias en week/day.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Mes actual",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-full-calendar id=\"cal\" first-day=\"1\" hours-start=\"8\" hours-end=\"20\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"events\": [",
            "                  { \"id\": \"e1\", \"title\": \"Sprint planning\",      \"date\": \"2026-08-03\", \"start\": \"09:00\", \"end\": \"10:30\", \"color\": \"var(--iswc-accent)\" },",
            "                  { \"id\": \"e2\", \"title\": \"Demo interna\",         \"date\": \"2026-08-03\", \"start\": \"15:00\", \"end\": \"16:00\", \"color\": \"var(--iswc-success, #16a34a)\" },",
            "                  { \"id\": \"e3\", \"title\": \"Cierre mensual\",       \"date\": \"2026-08-04\", \"start\": \"14:00\", \"end\": \"17:00\", \"color\": \"var(--iswc-danger, #dc2626)\" },",
            "                  { \"id\": \"e4\", \"title\": \"Standup\",              \"date\": \"2026-08-04\", \"start\": \"09:15\", \"end\": \"09:30\", \"color\": \"var(--iswc-warning, #d97706)\" },",
            "                  { \"id\": \"e5\", \"title\": \"1:1 con Sofía\",        \"date\": \"2026-08-05\", \"start\": \"11:00\", \"end\": \"11:30\", \"color\": \"var(--iswc-accent)\" },",
            "                  { \"id\": \"e6\", \"title\": \"Lanzamiento v8\",       \"date\": \"2026-08-12\", \"start\": \"10:00\", \"end\": \"12:00\", \"color\": \"var(--iswc-success, #16a34a)\" },",
            "                  { \"id\": \"e7\", \"title\": \"Sprint review\",        \"date\": \"2026-08-14\", \"start\": \"15:00\", \"end\": \"17:00\", \"color\": \"var(--iswc-accent)\" },",
            "                  { \"id\": \"e8\", \"title\": \"Onboarding (4 pasos)\",\"date\": \"2026-08-18\", \"start\": \"08:00\", \"end\": \"12:00\", \"color\": \"var(--iswc-warning, #d97706)\" },",
            "                  { \"id\": \"e9\", \"title\": \"Sprint retrospective\", \"date\": \"2026-08-21\", \"start\": \"16:00\", \"end\": \"17:30\", \"color\": \"var(--iswc-accent)\" }",
            "                ]",
            "              }",
            "            </script>",
            "          </iswc-full-calendar>"
          ],
          "controls": [
            {
              "control": "number",
              "prop": "attr:first-day",
              "label": "first-day",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:hours-start",
              "label": "hours-start",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:hours-end",
              "label": "hours-end",
              "min": 0,
              "max": 100,
              "step": 1
            }
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\">— clicks —</pre>"
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const cal = document.querySelector('iswc-full-calendar');",
            "cal.prev(); cal.next(); cal.today();",
            "cal.setDate('2026-09-15');",
            "cal.setView('week');",
            "cal.addEventListener('iswc-day-click',  e => console.log(e.detail.date));",
            "cal.addEventListener('iswc-event-click',e => console.log(e.detail.event));",
            "",
            "// Atributos",
            "// view          month | week | day",
            "// date          ISO inicial (default hoy)",
            "// first-day     0=Dom, 1=Lun (default 1)",
            "// locale        (default 'es')",
            "// hours-start, hours-end  rango en week/day (default 7..20)",
            "",
            "// Datos",
            "// { events: [ { id, title, date:'YYYY-MM-DD', start:'HH:MM', end?, color? } ] }"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Vista mes / semana / día con eventos por día y franjas horarias en week/day."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
