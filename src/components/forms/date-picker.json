{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-date-picker",
  "category": "forms",
  "title": "&lt;iswc-date-picker&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-date-picker",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Calendario inline (DateCalendar de <a href=\"https://mui.com/x/react-date-pickers/\" target=\"_blank\" rel=\"noopener\">MUI X</a>). Tres vistas (día, mes, año), teclado, números de semana y reglas de deshabilitado. El mes y el año del encabezado abren un <code>iswc-dropdown</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-picker id=\"dp\" value=\"2026-07-30\" locale=\"es\"></iswc-date-picker>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "2026-07-30",
                "2026-07-01",
                "2026-07-15"
              ]
            },
            {
              "control": "select",
              "prop": "attr:locale",
              "label": "locale",
              "options": [
                "es",
                "en-US"
              ]
            },
            {
              "control": "text",
              "prop": "attr:min",
              "label": "min"
            },
            {
              "control": "text",
              "prop": "attr:max",
              "label": "max"
            },
            {
              "control": "text",
              "prop": "attr:open-to",
              "label": "open-to"
            },
            {
              "control": "text",
              "prop": "attr:view",
              "label": "view"
            },
            {
              "control": "number",
              "prop": "attr:first-day-of-week",
              "label": "first-day-of-week",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:show-outside-days",
              "label": "show-outside-days"
            },
            {
              "control": "boolean",
              "prop": "attr:fixed-weeks",
              "label": "fixed-weeks"
            },
            {
              "control": "boolean",
              "prop": "attr:show-week-numbers",
              "label": "show-week-numbers"
            },
            {
              "control": "boolean",
              "prop": "attr:disable-past",
              "label": "disable-past"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\" style=\"font-family:var(--iswc-mono);font-size:.85em\"></p>"
        }
      ]
    },
    {
      "id": "range",
      "title": "Rango",
      "lede": "Tras elegir el inicio, el calendario pinta el rango tentativo hasta el día bajo el cursor o el foco, y el extremo móvil se marca con un anillo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-picker mode=\"range\" min=\"2026-01-01\" max=\"2026-12-31\" locale=\"es\"></iswc-date-picker>"
        }
      ]
    },
    {
      "id": "views",
      "title": "Vistas",
      "lede": "<code>view</code> fuerza la vista; <code>views</code> limita las permitidas. Un picker de solo mes/año fija valor al elegir mes.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div>",
            "            <div class=\"demo-label\">open-to=\"year\"</div>",
            "            <iswc-date-picker locale=\"es\" open-to=\"year\" value=\"2026-07-30\"></iswc-date-picker>",
            "          </div>",
            "          <div>",
            "            <div class=\"demo-label\">views=\"month year\"</div>",
            "            <iswc-date-picker locale=\"es\" views=\"month year\" view=\"month\" value=\"2026-07-01\"></iswc-date-picker>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "week",
      "title": "Semana y rejilla",
      "lede": "<code>first-day-of-week</code>, <code>show-outside-days</code>, <code>fixed-weeks</code> y <code>show-week-numbers</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div>",
            "            <div class=\"demo-label\">domingo + outside + week numbers</div>",
            "            <iswc-date-picker locale=\"en-US\" first-day-of-week=\"0\" show-outside-days fixed-weeks show-week-numbers value=\"2026-07-15\"></iswc-date-picker>",
            "          </div>",
            "          <div>",
            "            <div class=\"demo-label\">fines de semana off</div>",
            "            <iswc-date-picker locale=\"es\" disabled-days=\"0 6\" value=\"2026-07-15\"></iswc-date-picker>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "disable",
      "title": "Deshabilitado",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div>",
            "            <div class=\"demo-label\">disable-past</div>",
            "            <iswc-date-picker locale=\"es\" disable-past></iswc-date-picker>",
            "          </div>",
            "          <div>",
            "            <div class=\"demo-label\">disabled-dates</div>",
            "            <iswc-date-picker locale=\"es\" value=\"2026-07-01\" disabled-dates=\"2026-07-04 2026-07-05 2026-07-20\"></iswc-date-picker>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "standalone",
      "title": "Mes y año sueltos",
      "lede": "<code>iswc-month-calendar</code> e <code>iswc-year-calendar</code> también se usan solos.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-month-calendar year=\"2026\" value=\"2026-07\" locale=\"es\" style=\"width:16em\"></iswc-month-calendar>",
            "          <iswc-year-calendar value=\"2026\" min=\"2010\" max=\"2035\" style=\"width:16em\"></iswc-year-calendar>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>iswc-change</code>, <code>iswc-view-change</code>, <code>iswc-month-change</code>, <code>iswc-day-hover</code>. Métodos: <code>navigate(n)</code>, <code>focusDate(iso)</code>, <code>clear()</code>.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>value</code>"
            ],
            [
              "<code>mode</code>"
            ],
            [
              "<code>view</code> / <code>views</code> / <code>open-to</code>"
            ],
            [
              "<code>min</code> / <code>max</code>"
            ],
            [
              "<code>locale</code> / <code>first-day-of-week</code>"
            ],
            [
              "<code>show-outside-days</code> / <code>fixed-weeks</code> / <code>show-week-numbers</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>disable-past</code> / <code>disable-future</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>disabled-dates</code> / <code>disabled-days</code>"
            ],
            [
              "<code>nav</code>"
            ],
            [
              "<code>frameless</code>"
            ],
            [
              "<code>preview-to</code>"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">Parts: <code>base</code>, <code>nav</code>, <code>month-label</code>, <code>month-select</code>, <code>year-select</code>, <code>weekdays</code>, <code>grid</code>, <code>day</code>, <code>week-number</code>, <code>month-view</code>, <code>year-view</code>.</p>"
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Calendario inline (DateCalendar de <a href=\"https://mui.com/x/react-date-pickers/\" target=\"_blank\" rel=\"noopener\">MUI X</a>). Tres vistas (día, mes, año), teclado, números de semana y reglas de deshabilitado. El mes y el año del encabezado abren un <code>iswc-dropdown</code>."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>value</code>",
            "default": "— · rango: <code>start/end</code>"
          },
          {
            "name": "<code>mode</code>",
            "default": "single · range"
          },
          {
            "name": "<code>view</code> / <code>views</code> / <code>open-to</code>",
            "default": "day · day month year · day"
          },
          {
            "name": "<code>min</code> / <code>max</code>",
            "default": "—"
          },
          {
            "name": "<code>locale</code> / <code>first-day-of-week</code>",
            "default": "document.lang · Intl"
          },
          {
            "name": "<code>show-outside-days</code> / <code>fixed-weeks</code> / <code>show-week-numbers</code>",
            "default": "off"
          },
          {
            "name": "<code>disable-past</code> / <code>disable-future</code>",
            "default": "off"
          },
          {
            "name": "<code>disabled-dates</code> / <code>disabled-days</code>",
            "default": "—"
          },
          {
            "name": "<code>nav</code>",
            "default": "both · prev · next · none"
          },
          {
            "name": "<code>frameless</code>",
            "default": "off (para meter varios en una tarjeta)"
          },
          {
            "name": "<code>preview-to</code>",
            "default": "— (rango tentativo impuesto desde fuera)"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-date-picker id=\"dp\" value=\"2026-07-30\" locale=\"es\"></iswc-date-picker>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
