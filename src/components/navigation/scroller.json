{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-scroller",
  "category": "navigation",
  "title": "&lt;iswc-scroller&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-scroller de InSoft.",
  "storageKey": "docs-iswc-scroller",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Wrapper que añade scroll horizontal (o vertical) con botones prev/next\r\n          automáticos cuando el contenido del slot desborda. Ideal para\r\n          listas de pills, carruseles de chips, drawers inline, etc.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scroller id=\"sc1\" style=\"max-width: 480px;\">\r\n            <iswc-button>Pills 1</iswc-button>\r\n            <iswc-button>Pills 2</iswc-button>\r\n            <iswc-button>Pills 3</iswc-button>\r\n            <iswc-button>Pills 4</iswc-button>\r\n            <iswc-button>Pills 5</iswc-button>\r\n            <iswc-button>Pills 6</iswc-button>\r\n            <iswc-button>Pills 7</iswc-button>\r\n            <iswc-button>Pills 8</iswc-button>\r\n            <iswc-button>Pills 9</iswc-button>\r\n            <iswc-button>Pills 10</iswc-button>\r\n            <iswc-button>Pills 11</iswc-button>\r\n            <iswc-button>Pills 12</iswc-button>\r\n          </iswc-scroller>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:orientation",
              "label": "orientation",
              "options": [
                "horizontal",
                "vertical",
                "both"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:without-scroll-buttons",
              "label": "without-scroll-buttons"
            }
          ]
        },
        {
          "kind": "code",
          "code": "<iswc-scroller>\n  <iswc-button>Pills 1</iswc-button>\n  <iswc-button>Pills 2</iswc-button>\n  …\n</iswc-scroller>"
        }
      ]
    },
    {
      "id": "cards",
      "title": "Con cards",
      "lede": "Funciona con cualquier hijo: cards, avatares, breadcrumbs, etc.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scroller orientation=\"horizontal\" style=\"max-width: 640px;\">\r\n            <iswc-card style=\"min-width:240px\" header=\"Inbox\">\r\n              <p>3 mensajes sin leer.</p>\r\n            </iswc-card>\r\n            <iswc-card style=\"min-width:240px\" header=\"Calendar\">\r\n              <p>2 reuniones hoy.</p>\r\n            </iswc-card>\r\n            <iswc-card style=\"min-width:240px\" header=\"Tasks\">\r\n              <p>5 tareas pendientes.</p>\r\n            </iswc-card>\r\n            <iswc-card style=\"min-width:240px\" header=\"Notes\">\r\n              <p>1 nota actualizada.</p>\r\n            </iswc-card>\r\n            <iswc-card style=\"min-width:240px\" header=\"Files\">\r\n              <p>12 archivos recientes.</p>\r\n            </iswc-card>\r\n          </iswc-scroller>"
        }
      ]
    },
    {
      "id": "vertical",
      "title": "Vertical",
      "lede": "Con <code class=\"code\">orientation=\"vertical\"</code> el scroll es en columna.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scroller orientation=\"vertical\" style=\"height: 200px; max-width: 480px;\">\r\n            <p>Elemento 1</p>\r\n            <p>Elemento 2</p>\r\n            <p>Elemento 3</p>\r\n            <p>Elemento 4</p>\r\n            <p>Elemento 5</p>\r\n            <p>Elemento 6</p>\r\n            <p>Elemento 7</p>\r\n            <p>Elemento 8</p>\r\n            <p>Elemento 9</p>\r\n            <p>Elemento 10</p>\r\n          </iswc-scroller>"
        }
      ]
    },
    {
      "id": "both",
      "title": "Bidimensional",
      "lede": "Con <code class=\"code\">orientation=\"both\"</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scroller orientation=\"both\" style=\"height: 180px;\">\r\n            <div style=\"min-width:600px;display:grid;grid-template-columns:repeat(6,1fr);gap:0.5rem\">\r\n              <iswc-button>1</iswc-button><iswc-button>2</iswc-button><iswc-button>3</iswc-button>\r\n              <iswc-button>4</iswc-button><iswc-button>5</iswc-button><iswc-button>6</iswc-button>\r\n              <iswc-button>7</iswc-button><iswc-button>8</iswc-button><iswc-button>9</iswc-button>\r\n              <iswc-button>10</iswc-button><iswc-button>11</iswc-button><iswc-button>12</iswc-button>\r\n            </div>\r\n          </iswc-scroller>"
        }
      ]
    },
    {
      "id": "plain",
      "title": "Sin botones",
      "lede": "Con <code class=\"code\">without-scroll-buttons</code> solo se queda el scrollbar nativo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scroller without-scroll-buttons style=\"max-width: 480px;\">\r\n            <iswc-button>1</iswc-button>\r\n            <iswc-button>2</iswc-button>\r\n            <iswc-button>3</iswc-button>\r\n            <iswc-button>4</iswc-button>\r\n            <iswc-button>5</iswc-button>\r\n            <iswc-button>6</iswc-button>\r\n            <iswc-button>7</iswc-button>\r\n            <iswc-button>8</iswc-button>\r\n            <iswc-button>9</iswc-button>\r\n            <iswc-button>10</iswc-button>\r\n          </iswc-scroller>"
        }
      ]
    },
