{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-carousel",
  "category": "navigation",
  "title": "&lt;iswc-carousel&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-carousel / iswc-carousel-item de InSoft.",
  "styles": [
    ".slide {",
    "      width: 100%;",
    "      height: 100%;",
    "      display: flex;",
    "      align-items: center;",
    "      justify-content: center;",
    "      font-size: 2rem;",
    "      color: white;",
    "      border-radius: 0.5rem;",
    "    }",
    "    .slide.s1 { background: linear-gradient(135deg, #3699ff, #1f5aa6); }",
    "    .slide.s2 { background: linear-gradient(135deg, #f64e60, #b5283a); }",
    "    .slide.s3 { background: linear-gradient(135deg, #0bb783, #086c4d); }",
    "    .slide.s4 { background: linear-gradient(135deg, #ffa800, #cc8400); }",
    "    .slide.s5 { background: linear-gradient(135deg, #8950fc, #5a30a8); }"
  ],
  "storageKey": "docs-iswc-carousel",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Carrusel tipo slides con paginación, autoplay, loop, navegación prev/next,",
        "          indicadores, scroll-snap y soporte para swipe en touch."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-carousel id=\"c1\" loop>",
            "            <iswc-carousel-item><div class=\"slide s1\">Slide 1</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s2\">Slide 2</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s3\">Slide 3</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s4\">Slide 4</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s5\">Slide 5</div></iswc-carousel-item>",
            "          </iswc-carousel>",
            "          <p id=\"c1Log\" class=\"lede\">Slide: <code class=\"code\">0</code></p>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:loop",
              "label": "loop"
            },
            {
              "control": "number",
              "prop": "attr:autoplay",
              "label": "autoplay",
              "min": 0,
              "max": 2000,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:slides-per-page",
              "label": "slides-per-page",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:vertical",
              "label": "vertical"
            },
            {
              "control": "text",
              "prop": "attr:aspect-ratio",
              "label": "aspect-ratio"
            },
            {
              "control": "boolean",
              "prop": "attr:without-indicators",
              "label": "without-indicators"
            },
            {
              "control": "boolean",
              "prop": "attr:without-controls",
              "label": "without-controls"
            }
          ],
          "equivNote": "autoplay y flags de chrome (controls/indicators).",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-carousel: autoplay\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"autoplay?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"timer (+ pause hover)\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"solo manual\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"without-controls?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"sin flechas\",",
            "          \"shape\": \"round\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"no\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"d\",",
            "          \"label\": \"si\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "autoplay",
      "title": "Autoplay",
      "lede": "Con <code class=\"code\">autoplay=\"2000\"</code> avanza cada 2 segundos. Se pausa al hover.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-carousel autoplay=\"2000\" loop>",
            "            <iswc-carousel-item><div class=\"slide s1\">Auto 1</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s2\">Auto 2</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s3\">Auto 3</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s4\">Auto 4</div></iswc-carousel-item>",
            "          </iswc-carousel>"
          ]
        }
      ]
    },
    {
      "id": "per-page",
      "title": "Múltiples slides por página",
      "lede": "Con <code class=\"code\">slides-per-page=\"3\"</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-carousel slides-per-page=\"3\" loop>",
            "            <iswc-carousel-item><div class=\"slide s1\">A</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s2\">B</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s3\">C</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s4\">D</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s5\">E</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s1\">F</div></iswc-carousel-item>",
            "          </iswc-carousel>"
          ]
        }
      ]
    },
    {
      "id": "vertical",
      "title": "Vertical",
      "lede": "Con <code class=\"code\">vertical</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-carousel vertical style=\"max-width: 320px;\">",
            "            <iswc-carousel-item><div class=\"slide s1\">Top</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s2\">Middle</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s3\">Bottom</div></iswc-carousel-item>",
            "          </iswc-carousel>"
          ]
        }
      ]
    },
    {
      "id": "ratio",
      "title": "Aspect ratio personalizado",
      "lede": "Con <code class=\"code\">aspect-ratio=\"4/3\"</code> o cualquier valor CSS.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-carousel aspect-ratio=\"4/3\">",
            "            <iswc-carousel-item><div class=\"slide s1\">4:3 #1</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s2\">4:3 #2</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s3\">4:3 #3</div></iswc-carousel-item>",
            "          </iswc-carousel>"
          ]
        }
      ]
    },
    {
      "id": "plain",
      "title": "Sin indicadores ni controles",
      "lede": "Con <code class=\"code\">without-indicators without-controls</code> solo swipe.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-carousel without-indicators without-controls style=\"max-width: 320px;\">",
            "            <iswc-carousel-item><div class=\"slide s1\">A</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s2\">B</div></iswc-carousel-item>",
            "            <iswc-carousel-item><div class=\"slide s3\">C</div></iswc-carousel-item>",
            "          </iswc-carousel>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-carousel&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>active</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Slide activo (0-indexed). (valor por defecto)"
            ],
            [
              "<code>loop</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Vuelve al inicio al llegar al final. (valor por defecto)"
            ],
            [
              "<code>autoplay</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Avance automático (0 = desactivado). (valor por defecto)"
            ],
            [
              "<code>vertical</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Orientación vertical. (valor por defecto)"
            ],
            [
              "<code>slides-per-page</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Slides visibles por vista. (valor por defecto)"
            ],
            [
              "<code>aspect-ratio</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "CSS aspect-ratio del contenedor. (valor por defecto)"
            ],
            [
              "<code>without-controls</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Oculta prev/next. (valor por defecto)"
            ],
            [
              "<code>without-indicators</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Oculta los puntos. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>API</h3>"
        },
        {
          "kind": "code",
          "code": [
            "carousel.next();        // Avanza",
            "carousel.prev();        // Retrocede",
            "carousel.pause();       // Pausa autoplay",
            "carousel.play();        // Reanuda autoplay",
            "carousel.active = 2;    // Salta a slide",
            "carousel.getViewport(); // Devuelve el viewport del scroll"
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-carousel-change</code>",
              "Cambia el slide. <code>detail: { from, to, item }</code>."
            ],
            [
              "<code>iswc-carousel-play</code>",
              "Comienza autoplay."
            ],
            [
              "<code>iswc-carousel-pause</code>",
              "Pausa autoplay. <code>detail: { reason }</code>."
            ],
            [
              "<code>iswc-carousel-slide-end</code>",
              "Termina un swipe."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Carrusel tipo slides con paginación, autoplay, loop, navegación prev/next,",
          "          indicadores, scroll-snap y soporte para swipe en touch."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>active</code>",
            "type": "number",
            "default": "0",
            "desc": "Slide activo (0-indexed)."
          },
          {
            "name": "<code>loop</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Vuelve al inicio al llegar al final."
          },
          {
            "name": "<code>autoplay</code>",
            "type": "number (ms)",
            "default": "0",
            "desc": "Avance automático (0 = desactivado)."
          },
          {
            "name": "<code>vertical</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Orientación vertical."
          },
          {
            "name": "<code>slides-per-page</code>",
            "type": "number",
            "default": "1",
            "desc": "Slides visibles por vista."
          },
          {
            "name": "<code>aspect-ratio</code>",
            "type": "string",
            "default": "16/9",
            "desc": "CSS aspect-ratio del contenedor."
          },
          {
            "name": "<code>without-controls</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Oculta prev/next."
          },
          {
            "name": "<code>without-indicators</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Oculta los puntos."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-carousel-change</code>",
            "cuando": "Cambia el slide. <code>detail: { from, to, item }</code>."
          },
          {
            "evento": "<code>iswc-carousel-play</code>",
            "cuando": "Comienza autoplay."
          },
          {
            "evento": "<code>iswc-carousel-pause</code>",
            "cuando": "Pausa autoplay. <code>detail: { reason }</code>."
          },
          {
            "evento": "<code>iswc-carousel-slide-end</code>",
            "cuando": "Termina un swipe."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-carousel loop>",
          "  <iswc-carousel-item>Slide 1</iswc-carousel-item>",
          "  <iswc-carousel-item>Slide 2</iswc-carousel-item>",
          "  …",
          "</iswc-carousel>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
