          "kind": "html",
          "html": "<h3>API</h3>"
        },
        {
          "kind": "code",
          "code": "carousel.next();        // Avanza\ncarousel.prev();        // Retrocede\ncarousel.pause();       // Pausa autoplay\ncarousel.play();        // Reanuda autoplay\ncarousel.active = 2;    // Salta a slide\ncarousel.getViewport(); // Devuelve el viewport del scroll"
        },
