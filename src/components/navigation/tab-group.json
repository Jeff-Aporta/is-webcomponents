{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-tab-group",
  "category": "navigation",
  "title": "&lt;iswc-tab-group&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-tab-group / iswc-tab / iswc-tab-panel de InSoft.",
  "storageKey": "docs-iswc-tab-group",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Tabs accesibles con navegación por teclado (←/→), activación automática o",
        "          manual, indicator animado, placements (top/bottom/start/end), scroll horizontal",
        "          automático y soporte para tabs cerrables."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tab-group active=\"general\">",
            "            <iswc-tab slot=\"nav\" panel=\"general\">General</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"custom\">Custom</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"advanced\">Avanzado</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"disabled\" disabled>Deshabilitado</iswc-tab>",
            "",
            "            <iswc-tab-panel name=\"general\">Panel General: configuración por defecto del sistema.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"custom\">Panel Custom: ajustes personalizables.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"advanced\">Panel Avanzado: opciones experimentales.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"disabled\">No accesible.</iswc-tab-panel>",
            "          </iswc-tab-group>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:active",
              "label": "active",
              "options": [
                "general",
                "a1",
                "b1",
                "c1",
                "d1",
                "home",
                "x1",
                "t1"
              ]
            },
            {
              "control": "select",
              "prop": "attr:placement",
              "label": "placement",
              "options": [
                "top",
                "bottom",
                "start",
                "end"
              ]
            }
          ],
          "equivNote": "activation define teclado; closable añade cierre de pestaña.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-tab-group: activation\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"activation=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"auto → flechas cambian\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"manual → Space/Enter\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"closable?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"emite close\",",
            "          \"shape\": \"round\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"auto\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"manual\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"d\",",
            "          \"label\": \"si\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "placements",
      "title": "Placements",
      "lede": "Posiciona los tabs en cualquiera de los cuatro lados.",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<div class=\"demo-stack\">",
            "          <div>",
            "            <h4>top (default)</h4>",
            "            <iswc-tab-group active=\"a1\" style=\"min-height:140px\">",
            "              <iswc-tab slot=\"nav\" panel=\"a1\">Uno</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"a2\">Dos</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"a3\">Tres</iswc-tab>",
            "              <iswc-tab-panel name=\"a1\">Uno.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"a2\">Dos.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"a3\">Tres.</iswc-tab-panel>",
            "            </iswc-tab-group>",
            "          </div>",
            "",
            "          <div>",
            "            <h4>bottom</h4>",
            "            <iswc-tab-group active=\"b1\" placement=\"bottom\" style=\"min-height:140px\">",
            "              <iswc-tab slot=\"nav\" panel=\"b1\">Uno</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"b2\">Dos</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"b3\">Tres</iswc-tab>",
            "              <iswc-tab-panel name=\"b1\">Uno.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"b2\">Dos.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"b3\">Tres.</iswc-tab-panel>",
            "            </iswc-tab-group>",
            "          </div>",
            "",
            "          <div>",
            "            <h4>start</h4>",
            "            <iswc-tab-group active=\"c1\" placement=\"start\" style=\"min-height:140px\">",
            "              <iswc-tab slot=\"nav\" panel=\"c1\">Uno</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"c2\">Dos</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"c3\">Tres</iswc-tab>",
            "              <iswc-tab-panel name=\"c1\">Uno.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"c2\">Dos.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"c3\">Tres.</iswc-tab-panel>",
            "            </iswc-tab-group>",
            "          </div>",
            "",
            "          <div>",
            "            <h4>end</h4>",
            "            <iswc-tab-group active=\"d1\" placement=\"end\" style=\"min-height:140px\">",
            "              <iswc-tab slot=\"nav\" panel=\"d1\">Uno</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"d2\">Dos</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"d3\">Tres</iswc-tab>",
            "              <iswc-tab-panel name=\"d1\">Uno.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"d2\">Dos.</iswc-tab-panel>",
            "              <iswc-tab-panel name=\"d3\">Tres.</iswc-tab-panel>",
            "            </iswc-tab-group>",
            "          </div>",
            "        </div>"
          ]
        }
      ]
    },
    {
      "id": "icons",
      "title": "Tabs con icono",
      "lede": "Usa los slots <code class=\"code\">start</code> y <code class=\"code\">end</code> para iconos.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tab-group active=\"home\">",
            "            <iswc-tab slot=\"nav\" panel=\"home\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:home\" aria-hidden=\"true\"></iswc-icon>",
            "              Inicio",
            "            </iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"users\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:account-group\" aria-hidden=\"true\"></iswc-icon>",
            "              Usuarios",
            "            </iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"settings\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:cog\" aria-hidden=\"true\"></iswc-icon>",
            "              Configuración",
            "            </iswc-tab>",
            "            <iswc-tab-panel name=\"home\">Bienvenido.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"users\">Listado de usuarios.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"settings\">Preferencias de la app.</iswc-tab-panel>",
            "          </iswc-tab-group>"
          ]
        }
      ]
    },
    {
      "id": "activation",
      "title": "Activación manual vs automática",
      "lede": [
        "Con <code class=\"code\">activation=\"manual\"</code>, las flechas cambian foco sin mostrar",
        "          el panel hasta pulsar Space/Enter."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tab-group active=\"x1\" activation=\"manual\">",
            "            <iswc-tab slot=\"nav\" panel=\"x1\">Uno</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"x2\">Dos</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"x3\">Tres</iswc-tab>",
            "            <iswc-tab-panel name=\"x1\">Panel Uno.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"x2\">Panel Dos.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"x3\">Panel Tres.</iswc-tab-panel>",
            "          </iswc-tab-group>"
          ]
        }
      ]
    },
    {
      "id": "closable",
      "title": "Tabs cerrables",
      "lede": "Con el atributo <code class=\"code\">closable</code>, el tab muestra una X. El evento <code class=\"code\">iswc-tab-close</code> burbujea.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tab-group id=\"closable\" active=\"t1\">",
            "            <iswc-tab slot=\"nav\" panel=\"t1\">General</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"t2\" closable>Cerrable</iswc-tab>",
            "            <iswc-tab slot=\"nav\" panel=\"t3\">Avanzado</iswc-tab>",
            "            <iswc-tab-panel name=\"t1\">General.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"t2\">Cerrable.</iswc-tab-panel>",
            "            <iswc-tab-panel name=\"t3\">Avanzado.</iswc-tab-panel>",
            "          </iswc-tab-group>",
            "          <iswc-button id=\"restoreTab\" disabled>Restaurar tab</iswc-button>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
