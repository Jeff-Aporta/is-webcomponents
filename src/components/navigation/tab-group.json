              "Activación por teclado. (valor por defecto)"
            ],
            [
              "<code>without-scroll-controls</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Sin botones de scroll horizontal. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-tab&gt;</code></h3>"
        },
        {
