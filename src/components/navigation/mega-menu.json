{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-mega-menu",
  "category": "navigation",
  "title": "&lt;iswc-mega-menu&gt;",
  "titleHtml": false,
  "styles": [
    "pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 6rem; overflow: auto;",
    "    }",
    "    /* ::slotted no alcanza descendientes; los links viven en light DOM. */",
    "    iswc-mega-menu [slot=\"column\"] a,",
    "    iswc-mega-menu [slot=\"feature\"] a {",
    "      display: block;",
    "      padding: 0.25rem 0;",
    "      color: var(--iswc-text-soft);",
    "      text-decoration: none;",
    "      font-size: 0.88rem;",
    "    }",
    "    iswc-mega-menu [slot=\"column\"] a:hover,",
    "    iswc-mega-menu [slot=\"feature\"] a:hover {",
    "      color: var(--iswc-accent);",
    "    }"
  ],
  "storageKey": "docs-iswc-mega-menu",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Mega-menú con varias columnas y un bloque destacado opcional. Útil para e-commerce, portales masivos o headers corporativos.",
      "blocks": []
    },
    {
      "id": "basic",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<header style=\"display:flex; align-items:center; gap:.5rem; padding:1rem 0;\">",
            "            <strong style=\"font-size:1rem\">InSoft</strong>",
            "            <iswc-mega-menu id=\"pgMegaMenu\" label=\"Catálogo\" placement=\"bottom-start\" hover>",
            "              <div slot=\"column\" title=\"Muebles\">",
            "                <a href=\"#\" data-nav=\"/sillas\">Sillas</a>",
            "                <a href=\"#\" data-nav=\"/mesas\">Mesas</a>",
            "                <a href=\"#\" data-nav=\"/escritorios\">Escritorios</a>",
            "                <a href=\"#\" data-nav=\"/estanterias\">Estanterías</a>",
            "              </div>",
            "              <div slot=\"column\" title=\"Iluminación\">",
            "                <a href=\"#\" data-nav=\"/lamparas\">Lámparas</a>",
            "                <a href=\"#\" data-nav=\"/techo\">Plafón de techo</a>",
            "                <a href=\"#\" data-nav=\"/exterior\">Exterior</a>",
            "                <a href=\"#\" data-nav=\"/tiras\">Tiras LED</a>",
            "              </div>",
            "              <div slot=\"column\" title=\"Cocina\">",
            "                <a href=\"#\" data-nav=\"/mesones\">Mesones</a>",
            "                <a href=\"#\" data-nav=\"/griferia\">Grifería</a>",
            "                <a href=\"#\" data-nav=\"/electrodomesticos\">Electrodomésticos</a>",
            "              </div>",
            "              <div slot=\"feature\">",
            "                <strong style=\"font-size:1.05rem\">Envío gratis</strong>",
            "                <p style=\"margin:0; color:var(--iswc-text-soft); font-size:.82rem\">En pedidos mayores a $300.000 antes del 30 de septiembre.</p>",
            "                <a href=\"#\" data-nav=\"/promo\" style=\"margin-top:auto; padding:.55rem .85rem; background:var(--iswc-accent); color:var(--iswc-on-accent,#fff); border-radius:999px; text-decoration:none; font-size:.82rem; align-self:flex-start\">Ver promoción</a>",
            "              </div>",
            "            </iswc-mega-menu>",
            "          </header>",
            "          <p class=\"kbd-hint\" style=\"color:var(--iswc-text-soft); font-size:.78rem\">El primer mega-menú abre al pasar el cursor (<code>hover</code>); el segundo, al clic.</p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Catálogo",
                "Soporte"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:hover",
              "label": "hover"
            }
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<header style=\"display:flex; align-items:center; gap:.5rem; padding:1rem 0;\">",
            "            <strong style=\"font-size:1rem\">InSoft</strong>",
            "            <iswc-mega-menu label=\"Soporte\" placement=\"bottom-start\">",
            "              <div slot=\"column\" title=\"Canales\">",
            "                <a href=\"#\" data-nav=\"/chat\">Chat en vivo</a>",
            "                <a href=\"#\" data-nav=\"/covid\">Reporte de fallas</a>",
            "                <a href=\"#\" data-nav=\"/ticket\">Tickets</a>",
            "              </div>",
            "              <div slot=\"column\" title=\"Recursos\">",
            "                <a href=\"#\" data-nav=\"/docs\">Documentación</a>",
            "                <a href=\"#\" data-nav=\"/faq\">Preguntas frecuentes</a>",
            "              </div>",
            "            </iswc-mega-menu>",
            "",
            "          </header>"
          ],
          "heading": "Otro menú en la misma página: el label/hover ya no se comparte entre los dos (cada uno tiene su propio estado)"
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\">— clicks —</pre>"
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "// Atributos",
            "// label        texto del trigger",
            "// icon         icono del trigger",
            "// placement    bottom-start | bottom | bottom-end | ...",
            "// width        ancho del panel (default min(60rem, 92vw))",
            "// hover        boolean — abre al hover, no al clic",
            "//",
            "// Slots",
            "// default      columnas (slot=\"column\" con atributo title)",
            "// slot=\"feature\"  bloque destacado (imagen/CTA extra)",
            "//",
            "// Eventos",
            "menu.addEventListener('iswc-select', e => console.log(e.detail.href));"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Mega-menú con varias columnas y un bloque destacado opcional. Útil para e-commerce, portales masivos o headers corporativos."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
