# Configuracion E2E de is-webcomponents (Stagehand + MiniMax).
# Copia este archivo a `src/utils/health/e2e/.env` y completa.
# `.env` y `.env.*` estan en .gitignore: NUNCA versionar secretos.

# E2E_AUTOSERVE=1 (default): la suite levanta su propio servidor con la galeria
# (transpilando TS al vuelo, igual que serve.mjs) en E2E_PORT y lo apaga SIEMPRE
# al terminar (pase o falle, y ante Ctrl+C). Para apuntar a un host ya levantado
# usa E2E_AUTOSERVE=0 y fija E2E_BASE_URL.
# E2E_AUTOSERVE=0
# E2E_BASE_URL=http://127.0.0.1:8391/index.html

# Puerto controlado del autoservidor. 0 (default) = puerto libre aleatorio:
# nunca colisiona. Para fijar uno (CI/shared) indica E2E_PORT; si está ocupado
# el arranque falla con aviso claro en vez de chocar con otro servicio.
# E2E_PORT=8450
# E2E_HOST=127.0.0.1

# false abre Chrome visible (depurar), true es headless
E2E_HEADLESS=true

# MiniMax: modelo para act/extract/observe de Stagehand. Misma cuenta que el
# auditor RAG (la key canonica vive en Personal/secrets.json como
# MINIMAX_API_KEY_50USD o en la config del RAG: C:/ContaPyme/RAG).
MINIMAX_API_KEY=
E2E_MINIMAX_MODEL=MiniMax-M3
E2E_MINIMAX_URL=https://api.minimax.io/v1

# Componentes (tags del manifest) del barrido "ataque" de 03-problemas.
# E2E_SWEEP=is-code,is-component-diagram,is-bar-chart

# 1 = fallar si faltan variables (por defecto los tests se saltan con aviso)
E2E_STRICT=false

# Directorio de evidencias (capturas y volcados). Gitignored.
E2E_ARTIFACTS=src/utils/health/e2e/.artifacts
