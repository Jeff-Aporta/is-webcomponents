{
  "$schema": "iswc-preview/v1",
  "tag": "phase7",
  "category": "",
  "title": "Fase 7 — Composiciones",
  "titleHtml": false,
  "description": "Composiciones reales integrando múltiples componentes IS: dialogs con forms, cards con acciones, drawers con tabs, selects múltiples y listas con avatares.",
  "styles": ".grid-2 {\r\n      display: grid;\r\n      grid-template-columns: 1fr 1fr;\r\n      gap: 0.5rem;\r\n    }\r\n    .muted {\r\n      color: var(--iswc-text-muted, #8a90a0);\r\n      font-size: 0.85em;\r\n    }\r\n    .list-custom {\r\n      list-style: none;\r\n      margin: 0;\r\n      padding: 0;\r\n      display: flex;\r\n      flex-direction: column;\r\n      gap: 0.25rem;\r\n    }\r\n    .list-row {\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 0.75rem;\r\n      padding: 0.5rem 0.75rem;\r\n      border-radius: 0.5rem;\r\n      transition: background 0.1s;\r\n    }\r\n    .list-row:hover {\r\n      background: rgba(255,255,255,0.04);\r\n    }\r\n    .list-meta {\r\n      flex: 1 1 auto;\r\n      display: flex;\r\n      flex-direction: column;\r\n    }",
  "storageKey": "docs-phase7",
  "sections": [
    {
      "id": "intro",
      "title": "Fase 7 — Composiciones",
      "lede": "Aquí se demuestra la integración real de los componentes: dialogs con\r\n          forms, cards con header-actions, drawers con tabs, selects múltiples y\r\n          listas con avatares. Cada demo es una composición viva, no un mockup.",
      "blocks": []
    },
    {
      "id": "dialog-form",
      "title": "Diálogo con formulario",
      "lede": "Un mini-CRM: crear contacto con nombre, email, rol, suscripción a newsletter y notas.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openNewContact\">\r\n            <iswc-icon slot=\"start\" icon=\"mdi:account-plus\"></iswc-icon>\r\n            Nuevo contacto\r\n          </iswc-button>\r\n\r\n          <iswc-dialog id=\"dlgNewContact\" label=\"Nuevo contacto\">\r\n            <form id=\"contactForm\" slot=\"body\" style=\"display:grid;gap:0.75rem;min-width:420px\">\r\n              <iswc-input name=\"nombre\" label=\"Nombre\" placeholder=\"Jane Doe\" required></iswc-input>\r\n              <iswc-input name=\"email\" type=\"email\" label=\"Email\" placeholder=\"jane@empresa.com\" required></iswc-input>\r\n              <iswc-select name=\"rol\" label=\"Rol\">\r\n                <iswc-option value=\"admin\">Administrador</iswc-option>\r\n                <iswc-option value=\"user\" selected>Usuario</iswc-option>\r\n                <iswc-option value=\"viewer\">Sólo lectura</iswc-option>\r\n              </iswc-select>\r\n              <iswc-textarea name=\"notas\" label=\"Notas\" rows=\"3\" placeholder=\"Información adicional\"></iswc-textarea>\r\n              <iswc-switch name=\"newsletter\" checked>Suscribir al newsletter</iswc-switch>\r\n            </form>\r\n\r\n            <iswc-button slot=\"footer\" variant=\"plain\" data-dialog-close>Cancelar</iswc-button>\r\n            <iswc-button slot=\"footer\" color=\"brand\" id=\"submitContact\">Crear contacto</iswc-button>\r\n          </iswc-dialog>\r\n\r\n          <iswc-callout id=\"contactSaved\" color=\"success\" hidden style=\"margin-top:1rem\">\r\n            <strong>Contacto guardado.</strong>\r\n            <div id=\"contactSavedDetails\"></div>\r\n          </iswc-callout>"
        },
        {
          "kind": "code",
          "code": "<iswc-dialog id=\"dlg\" label=\"Nuevo contacto\">\n  <form slot=\"body\">\n    <iswc-input name=\"nombre\" label=\"Nombre\" required></iswc-input>\n    <iswc-select name=\"rol\" label=\"Rol\">\n      <iswc-option value=\"admin\">Admin</iswc-option>\n    </iswc-select>\n  </form>\n  <iswc-button slot=\"footer\" data-dialog-close>Cancelar</iswc-button>\n  <iswc-button slot=\"footer\" color=\"brand\">Crear</iswc-button>\n</iswc-dialog>"
        }
      ]
    },
    {
      "id": "card-actions",
      "title": "Tarjeta con acciones",
      "lede": "Card con badges, dropdown de más acciones y tabs de detalle dentro.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-card header=\"Pedido #4290\" style=\"max-width:640px\">\r\n            <div slot=\"header-actions\" style=\"display:flex;gap:0.5rem;align-items:center\">\r\n              <iswc-badge color=\"success\">Pagado</iswc-badge>\r\n              <iswc-dropdown id=\"ddOrder\">\r\n                <iswc-button slot=\"trigger\" variant=\"plain\" caret>\r\n                  <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>\r\n                </iswc-button>\r\n                <iswc-dropdown-item>Reenviar factura</iswc-dropdown-item>\r\n                <iswc-dropdown-item>Marcar pendiente</iswc-dropdown-item>\r\n                <iswc-dropdown-item color=\"danger\">Cancelar pedido</iswc-dropdown-item>\r\n              </iswc-dropdown>\r\n            </div>\r\n\r\n            <div class=\"grid-2\">\r\n              <div>\r\n                <p class=\"muted\">Cliente</p>\r\n                <p>Jane Doe <iswc-tag>jane@empresa.com</iswc-tag></p>\r\n              </div>\r\n              <div>\r\n                <p class=\"muted\">Total</p>\r\n                <p><strong>€ 1.249,00</strong></p>\r\n              </div>\r\n            </div>\r\n\r\n            <iswc-tab-group style=\"margin-top:1rem\">\r\n              <iswc-tab slot=\"nav\" panel=\"resumen\">Resumen</iswc-tab>\r\n              <iswc-tab slot=\"nav\" panel=\"envio\">Envío</iswc-tab>\r\n              <iswc-tab slot=\"nav\" panel=\"historial\">Historial</iswc-tab>\r\n\r\n              <iswc-tab-panel name=\"resumen\">\r\n                <iswc-scroller>\r\n                  <iswc-tag size=\"sm\">SKU-001</iswc-tag>\r\n                  <iswc-tag size=\"sm\">SKU-002</iswc-tag>\r\n                  <iswc-tag size=\"sm\">SKU-003</iswc-tag>\r\n                  <iswc-tag size=\"sm\">SKU-004</iswc-tag>\r\n                  <iswc-tag size=\"sm\">SKU-005</iswc-tag>\r\n                  <iswc-tag size=\"sm\">SKU-006</iswc-tag>\r\n                </iswc-scroller>\r\n              </iswc-tab-panel>\r\n              <iswc-tab-panel name=\"envio\">\r\n                <p>Calle Mayor 12, 28013 Madrid</p>\r\n                <p>Estimado: 28 jul — 30 jul</p>\r\n              </iswc-tab-panel>\r\n              <iswc-tab-panel name=\"historial\">\r\n                <p>· 30 jul — Pago recibido</p>\r\n                <p>· 28 jul — Pedido creado</p>\r\n              </iswc-tab-panel>\r\n            </iswc-tab-group>\r\n          </iswc-card>"
        }
      ]
    },
    {
      "id": "drawer-tabs",
      "title": "Cajón, pestañas y panel",
      "lede": "Sidebar persistente a la izquierda + drawer deslizante a la derecha con tabs.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openDrawer\">\r\n            <iswc-icon slot=\"start\" icon=\"mdi:menu-open\"></iswc-icon>\r\n            Abrir inspector\r\n          </iswc-button>\r\n\r\n          <iswc-split-panel id=\"fullSplit\" style=\"height: 320px; margin-top:1rem\">\r\n            <div slot=\"start\" style=\"padding:1rem;background:rgba(255,255,255,0.03);border-radius:0.5rem\">\r\n              <iswc-tree selection=\"leaf\" expanded>\r\n                <iswc-tree-item>\r\n                  <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>\r\n                  Documentos\r\n                  <iswc-tree-item>factura.pdf</iswc-tree-item>\r\n                  <iswc-tree-item>contrato.odt</iswc-tree-item>\r\n                </iswc-tree-item>\r\n                <iswc-tree-item>\r\n                  <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>\r\n                  Proyectos\r\n                  <iswc-tree-item>app.ts</iswc-tree-item>\r\n                  <iswc-tree-item>styles.css</iswc-tree-item>\r\n                </iswc-tree-item>\r\n              </iswc-tree>\r\n            </div>\r\n            <div slot=\"end\" style=\"padding:1rem\">\r\n              <p>Selecciona un archivo del árbol para inspeccionarlo.</p>\r\n            </div>\r\n          </iswc-split-panel>\r\n\r\n          <iswc-drawer id=\"inspector\" label=\"Inspector\" placement=\"end\" style=\"--size: 380px\">\r\n            <iswc-tab-group>\r\n              <iswc-tab slot=\"nav\" panel=\"props\">Propiedades</iswc-tab>\r\n              <iswc-tab slot=\"nav\" panel=\"events\">Eventos</iswc-tab>\r\n              <iswc-tab slot=\"nav\" panel=\"acl\">Permisos</iswc-tab>\r\n\r\n              <iswc-tab-panel name=\"props\">\r\n                <iswc-card header=\"propiedades.md\">\r\n                  <p>1 <strong>app.ts</strong> · 67 líneas</p>\r\n                  <p>Última edición: hoy 14:21</p>\r\n                </iswc-card>\r\n              </iswc-tab-panel>\r\n              <iswc-tab-panel name=\"events\">\r\n                <p>· onSelect</p>\r\n                <p>· onEdit</p>\r\n                <p>· onDelete</p>\r\n              </iswc-tab-panel>\r\n              <iswc-tab-panel name=\"acl\">\r\n                <iswc-switch checked>Lectura</iswc-switch>\r\n                <iswc-switch>Escritura</iswc-switch>\r\n                <iswc-switch>Compartir</iswc-switch>\r\n              </iswc-tab-panel>\r\n            </iswc-tab-group>\r\n            <iswc-button slot=\"footer\" data-drawer-close variant=\"plain\">Cerrar</iswc-button>\r\n          </iswc-drawer>"
        }
      ]
    },
    {
      "id": "multi-select",
      "title": "Selección múltiple",
      "lede": "Tags seleccionados + popover para agregar/quitar. Patrón típico de invitaciones.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-card header=\"Asignar responsables\" style=\"max-width:520px\">\r\n            <div style=\"display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center\">\r\n              <iswc-tag id=\"tag1\" removable>Jane Doe</iswc-tag>\r\n              <iswc-tag id=\"tag2\" removable>Mike Ross</iswc-tag>\r\n              <iswc-button id=\"addAssignee\" variant=\"plain\">\r\n                <iswc-icon slot=\"start\" icon=\"mdi:plus\"></iswc-icon>\r\n                Añadir\r\n              </iswc-button>\r\n            </div>\r\n\r\n            <iswc-dialog id=\"assigneeDialog\" label=\"Seleccionar responsables\">\r\n              <div slot=\"body\" style=\"display:grid;gap:0.25rem;min-width:280px\">\r\n                <iswc-checkbox name=\"u1\" checked>Jane Doe</iswc-checkbox>\r\n                <iswc-checkbox name=\"u2\" checked>Mike Ross</iswc-checkbox>\r\n                <iswc-checkbox name=\"u3\">Ana López</iswc-checkbox>\r\n                <iswc-checkbox name=\"u4\">Carlos Pérez</iswc-checkbox>\r\n                <iswc-checkbox name=\"u5\">Sara Núñez</iswc-checkbox>\r\n              </div>\r\n              <iswc-button slot=\"footer\" data-dialog-close variant=\"plain\">Cancelar</iswc-button>\r\n              <iswc-button slot=\"footer\" color=\"brand\" data-dialog-close id=\"saveAssignees\">Aplicar</iswc-button>\r\n            </iswc-dialog>\r\n          </iswc-card>"
        }
      ]
    },
    {
      "id": "list",
      "title": "Listas con avatar y acciones",
      "lede": "Una lista de equipo combinando avatar + badge + button + dropdown.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-card style=\"max-width:640px\">\r\n            <ul class=\"list-custom\" id=\"teamList\">\r\n              <li class=\"list-row\">\r\n                <iswc-avatar name=\"Jane Doe\" status=\"online\"></iswc-avatar>\r\n                <div class=\"list-meta\">\r\n                  <strong>Jane Doe</strong>\r\n                  <span class=\"muted\">jane@empresa.com</span>\r\n                </div>\r\n                <iswc-badge color=\"success\">Admin</iswc-badge>\r\n                <iswc-dropdown>\r\n                  <iswc-button slot=\"trigger\" variant=\"plain\">\r\n                    <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>\r\n                  </iswc-button>\r\n                  <iswc-dropdown-item>Ver perfil</iswc-dropdown-item>\r\n                  <iswc-dropdown-item>Enviar mensaje</iswc-dropdown-item>\r\n                  <iswc-dropdown-item color=\"danger\">Quitar</iswc-dropdown-item>\r\n                </iswc-dropdown>\r\n              </li>\r\n              <li class=\"list-row\">\r\n                <iswc-avatar name=\"Mike Ross\" status=\"away\"></iswc-avatar>\r\n                <div class=\"list-meta\">\r\n                  <strong>Mike Ross</strong>\r\n                  <span class=\"muted\">mike@empresa.com</span>\r\n                </div>\r\n                <iswc-badge color=\"warning\">Editor</iswc-badge>\r\n                <iswc-dropdown>\r\n                  <iswc-button slot=\"trigger\" variant=\"plain\">\r\n                    <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>\r\n                  </iswc-button>\r\n                  <iswc-dropdown-item>Ver perfil</iswc-dropdown-item>\r\n                  <iswc-dropdown-item>Enviar mensaje</iswc-dropdown-item>\r\n                  <iswc-dropdown-item color=\"danger\">Quitar</iswc-dropdown-item>\r\n                </iswc-dropdown>\r\n              </li>\r\n              <li class=\"list-row\">\r\n                <iswc-avatar name=\"Ana López\" status=\"offline\"></iswc-avatar>\r\n                <div class=\"list-meta\">\r\n                  <strong>Ana López</strong>\r\n                  <span class=\"muted\">ana@empresa.com</span>\r\n                </div>\r\n                <iswc-badge>Viewer</iswc-badge>\r\n                <iswc-dropdown>\r\n                  <iswc-button slot=\"trigger\" variant=\"plain\">\r\n                    <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>\r\n                  </iswc-button>\r\n                  <iswc-dropdown-item>Ver perfil</iswc-dropdown-item>\r\n                  <iswc-dropdown-item>Enviar mensaje</iswc-dropdown-item>\r\n                  <iswc-dropdown-item color=\"danger\">Quitar</iswc-dropdown-item>\r\n                </iswc-dropdown>\r\n              </li>\r\n            </ul>\r\n          </iswc-card>"
        }
      ]
    }
  ]
}
