{
  "$schema": "iswc-preview/v1",
  "tag": "phase7",
  "category": "",
  "title": "Fase 7 — Composiciones",
  "titleHtml": false,
  "description": "Composiciones reales integrando múltiples componentes IS: dialogs con forms, cards con acciones, drawers con tabs, selects múltiples y listas con avatares.",
  "styles": [
    ".grid-2 {",
    "      display: grid;",
    "      grid-template-columns: 1fr 1fr;",
    "      gap: 0.5rem;",
    "    }",
    "    .muted {",
    "      color: var(--iswc-text-muted, #8a90a0);",
    "      font-size: 0.85em;",
    "    }",
    "    .list-custom {",
    "      list-style: none;",
    "      margin: 0;",
    "      padding: 0;",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.25rem;",
    "    }",
    "    .list-row {",
    "      display: flex;",
    "      align-items: center;",
    "      gap: 0.75rem;",
    "      padding: 0.5rem 0.75rem;",
    "      border-radius: 0.5rem;",
    "      transition: background 0.1s;",
    "    }",
    "    .list-row:hover {",
    "      background: rgba(255,255,255,0.04);",
    "    }",
    "    .list-meta {",
    "      flex: 1 1 auto;",
    "      display: flex;",
    "      flex-direction: column;",
    "    }"
  ],
  "storageKey": "docs-phase7",
  "sections": [
    {
      "id": "intro",
      "title": "Fase 7 — Composiciones",
      "lede": [
        "Aquí se demuestra la integración real de los componentes: dialogs con",
        "          forms, cards con header-actions, drawers con tabs, selects múltiples y",
        "          listas con avatares. Cada demo es una composición viva, no un mockup."
      ],
      "blocks": []
    },
    {
      "id": "dialog-form",
      "title": "Diálogo con formulario",
      "lede": "Un mini-CRM: crear contacto con nombre, email, rol, suscripción a newsletter y notas.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"openNewContact\">",
            "            <iswc-icon slot=\"start\" icon=\"mdi:account-plus\"></iswc-icon>",
            "            Nuevo contacto",
            "          </iswc-button>",
            "",
            "          <iswc-dialog id=\"dlgNewContact\" label=\"Nuevo contacto\">",
            "            <form id=\"contactForm\" slot=\"body\" style=\"display:grid;gap:0.75rem;min-width:420px\">",
            "              <iswc-input name=\"nombre\" label=\"Nombre\" placeholder=\"Jane Doe\" required></iswc-input>",
            "              <iswc-input name=\"email\" type=\"email\" label=\"Email\" placeholder=\"jane@empresa.com\" required></iswc-input>",
            "              <iswc-select name=\"rol\" label=\"Rol\">",
            "                <iswc-option value=\"admin\">Administrador</iswc-option>",
            "                <iswc-option value=\"user\" selected>Usuario</iswc-option>",
            "                <iswc-option value=\"viewer\">Sólo lectura</iswc-option>",
            "              </iswc-select>",
            "              <iswc-textarea name=\"notas\" label=\"Notas\" rows=\"3\" placeholder=\"Información adicional\"></iswc-textarea>",
            "              <iswc-switch name=\"newsletter\" checked>Suscribir al newsletter</iswc-switch>",
            "            </form>",
            "",
            "            <iswc-button slot=\"footer\" variant=\"plain\" data-dialog-close>Cancelar</iswc-button>",
            "            <iswc-button slot=\"footer\" color=\"brand\" id=\"submitContact\">Crear contacto</iswc-button>",
            "          </iswc-dialog>",
            "",
            "          <iswc-callout id=\"contactSaved\" color=\"success\" hidden style=\"margin-top:1rem\">",
            "            <strong>Contacto guardado.</strong>",
            "            <div id=\"contactSavedDetails\"></div>",
            "          </iswc-callout>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-dialog id=\"dlg\" label=\"Nuevo contacto\">",
            "  <form slot=\"body\">",
            "    <iswc-input name=\"nombre\" label=\"Nombre\" required></iswc-input>",
            "    <iswc-select name=\"rol\" label=\"Rol\">",
            "      <iswc-option value=\"admin\">Admin</iswc-option>",
            "    </iswc-select>",
            "  </form>",
            "  <iswc-button slot=\"footer\" data-dialog-close>Cancelar</iswc-button>",
            "  <iswc-button slot=\"footer\" color=\"brand\">Crear</iswc-button>",
            "</iswc-dialog>"
          ]
        }
      ]
    },
    {
      "id": "card-actions",
      "title": "Tarjeta con acciones",
      "lede": "Card con badges, dropdown de más acciones y tabs de detalle dentro.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-card header=\"Pedido #4290\" style=\"max-width:640px\">",
            "            <div slot=\"header-actions\" style=\"display:flex;gap:0.5rem;align-items:center\">",
            "              <iswc-badge color=\"success\">Pagado</iswc-badge>",
            "              <iswc-dropdown id=\"ddOrder\">",
            "                <iswc-button slot=\"trigger\" variant=\"plain\" caret>",
            "                  <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>",
            "                </iswc-button>",
            "                <iswc-dropdown-item>Reenviar factura</iswc-dropdown-item>",
            "                <iswc-dropdown-item>Marcar pendiente</iswc-dropdown-item>",
            "                <iswc-dropdown-item color=\"danger\">Cancelar pedido</iswc-dropdown-item>",
            "              </iswc-dropdown>",
            "            </div>",
            "",
            "            <div class=\"grid-2\">",
            "              <div>",
            "                <p class=\"muted\">Cliente</p>",
            "                <p>Jane Doe <iswc-tag>jane@empresa.com</iswc-tag></p>",
            "              </div>",
            "              <div>",
            "                <p class=\"muted\">Total</p>",
            "                <p><strong>€ 1.249,00</strong></p>",
            "              </div>",
            "            </div>",
            "",
            "            <iswc-tab-group style=\"margin-top:1rem\">",
            "              <iswc-tab slot=\"nav\" panel=\"resumen\">Resumen</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"envio\">Envío</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"historial\">Historial</iswc-tab>",
            "",
            "              <iswc-tab-panel name=\"resumen\">",
            "                <iswc-scroller>",
            "                  <iswc-tag size=\"sm\">SKU-001</iswc-tag>",
            "                  <iswc-tag size=\"sm\">SKU-002</iswc-tag>",
            "                  <iswc-tag size=\"sm\">SKU-003</iswc-tag>",
            "                  <iswc-tag size=\"sm\">SKU-004</iswc-tag>",
            "                  <iswc-tag size=\"sm\">SKU-005</iswc-tag>",
            "                  <iswc-tag size=\"sm\">SKU-006</iswc-tag>",
            "                </iswc-scroller>",
            "              </iswc-tab-panel>",
            "              <iswc-tab-panel name=\"envio\">",
            "                <p>Calle Mayor 12, 28013 Madrid</p>",
            "                <p>Estimado: 28 jul — 30 jul</p>",
            "              </iswc-tab-panel>",
            "              <iswc-tab-panel name=\"historial\">",
            "                <p>· 30 jul — Pago recibido</p>",
            "                <p>· 28 jul — Pedido creado</p>",
            "              </iswc-tab-panel>",
            "            </iswc-tab-group>",
            "          </iswc-card>"
          ]
        }
      ]
    },
    {
      "id": "drawer-tabs",
      "title": "Cajón, pestañas y panel",
      "lede": "Sidebar persistente a la izquierda + drawer deslizante a la derecha con tabs.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"openDrawer\">",
            "            <iswc-icon slot=\"start\" icon=\"mdi:menu-open\"></iswc-icon>",
            "            Abrir inspector",
            "          </iswc-button>",
            "",
            "          <iswc-split-panel id=\"fullSplit\" style=\"height: 320px; margin-top:1rem\">",
            "            <div slot=\"start\" style=\"padding:1rem;background:rgba(255,255,255,0.03);border-radius:0.5rem\">",
            "              <iswc-tree selection=\"leaf\" expanded>",
            "                <iswc-tree-item>",
            "                  <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "                  Documentos",
            "                  <iswc-tree-item>factura.pdf</iswc-tree-item>",
            "                  <iswc-tree-item>contrato.odt</iswc-tree-item>",
            "                </iswc-tree-item>",
            "                <iswc-tree-item>",
            "                  <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "                  Proyectos",
            "                  <iswc-tree-item>app.ts</iswc-tree-item>",
            "                  <iswc-tree-item>styles.css</iswc-tree-item>",
            "                </iswc-tree-item>",
            "              </iswc-tree>",
            "            </div>",
            "            <div slot=\"end\" style=\"padding:1rem\">",
            "              <p>Selecciona un archivo del árbol para inspeccionarlo.</p>",
            "            </div>",
            "          </iswc-split-panel>",
            "",
            "          <iswc-drawer id=\"inspector\" label=\"Inspector\" placement=\"end\" style=\"--size: 380px\">",
            "            <iswc-tab-group>",
            "              <iswc-tab slot=\"nav\" panel=\"props\">Propiedades</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"events\">Eventos</iswc-tab>",
            "              <iswc-tab slot=\"nav\" panel=\"acl\">Permisos</iswc-tab>",
            "",
            "              <iswc-tab-panel name=\"props\">",
            "                <iswc-card header=\"propiedades.md\">",
            "                  <p>1 <strong>app.ts</strong> · 67 líneas</p>",
            "                  <p>Última edición: hoy 14:21</p>",
            "                </iswc-card>",
            "              </iswc-tab-panel>",
            "              <iswc-tab-panel name=\"events\">",
            "                <p>· onSelect</p>",
            "                <p>· onEdit</p>",
            "                <p>· onDelete</p>",
            "              </iswc-tab-panel>",
            "              <iswc-tab-panel name=\"acl\">",
            "                <iswc-switch checked>Lectura</iswc-switch>",
            "                <iswc-switch>Escritura</iswc-switch>",
            "                <iswc-switch>Compartir</iswc-switch>",
            "              </iswc-tab-panel>",
            "            </iswc-tab-group>",
            "            <iswc-button slot=\"footer\" data-drawer-close variant=\"plain\">Cerrar</iswc-button>",
            "          </iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "multi-select",
      "title": "Selección múltiple",
      "lede": "Tags seleccionados + popover para agregar/quitar. Patrón típico de invitaciones.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-card header=\"Asignar responsables\" style=\"max-width:520px\">",
            "            <div style=\"display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center\">",
            "              <iswc-tag id=\"tag1\" removable>Jane Doe</iswc-tag>",
            "              <iswc-tag id=\"tag2\" removable>Mike Ross</iswc-tag>",
            "              <iswc-button id=\"addAssignee\" variant=\"plain\">",
            "                <iswc-icon slot=\"start\" icon=\"mdi:plus\"></iswc-icon>",
            "                Añadir",
            "              </iswc-button>",
            "            </div>",
            "",
            "            <iswc-dialog id=\"assigneeDialog\" label=\"Seleccionar responsables\">",
            "              <div slot=\"body\" style=\"display:grid;gap:0.25rem;min-width:280px\">",
            "                <iswc-checkbox name=\"u1\" checked>Jane Doe</iswc-checkbox>",
            "                <iswc-checkbox name=\"u2\" checked>Mike Ross</iswc-checkbox>",
            "                <iswc-checkbox name=\"u3\">Ana López</iswc-checkbox>",
            "                <iswc-checkbox name=\"u4\">Carlos Pérez</iswc-checkbox>",
            "                <iswc-checkbox name=\"u5\">Sara Núñez</iswc-checkbox>",
            "              </div>",
            "              <iswc-button slot=\"footer\" data-dialog-close variant=\"plain\">Cancelar</iswc-button>",
            "              <iswc-button slot=\"footer\" color=\"brand\" data-dialog-close id=\"saveAssignees\">Aplicar</iswc-button>",
            "            </iswc-dialog>",
            "          </iswc-card>"
          ]
        }
      ]
    },
    {
      "id": "list",
      "title": "Listas con avatar y acciones",
      "lede": "Una lista de equipo combinando avatar + badge + button + dropdown.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-card style=\"max-width:640px\">",
            "            <ul class=\"list-custom\" id=\"teamList\">",
            "              <li class=\"list-row\">",
            "                <iswc-avatar name=\"Jane Doe\" status=\"online\"></iswc-avatar>",
            "                <div class=\"list-meta\">",
            "                  <strong>Jane Doe</strong>",
            "                  <span class=\"muted\">jane@empresa.com</span>",
            "                </div>",
            "                <iswc-badge color=\"success\">Admin</iswc-badge>",
            "                <iswc-dropdown>",
            "                  <iswc-button slot=\"trigger\" variant=\"plain\">",
            "                    <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>",
            "                  </iswc-button>",
            "                  <iswc-dropdown-item>Ver perfil</iswc-dropdown-item>",
            "                  <iswc-dropdown-item>Enviar mensaje</iswc-dropdown-item>",
            "                  <iswc-dropdown-item color=\"danger\">Quitar</iswc-dropdown-item>",
            "                </iswc-dropdown>",
            "              </li>",
            "              <li class=\"list-row\">",
            "                <iswc-avatar name=\"Mike Ross\" status=\"away\"></iswc-avatar>",
            "                <div class=\"list-meta\">",
            "                  <strong>Mike Ross</strong>",
            "                  <span class=\"muted\">mike@empresa.com</span>",
            "                </div>",
            "                <iswc-badge color=\"warning\">Editor</iswc-badge>",
            "                <iswc-dropdown>",
            "                  <iswc-button slot=\"trigger\" variant=\"plain\">",
            "                    <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>",
            "                  </iswc-button>",
            "                  <iswc-dropdown-item>Ver perfil</iswc-dropdown-item>",
            "                  <iswc-dropdown-item>Enviar mensaje</iswc-dropdown-item>",
            "                  <iswc-dropdown-item color=\"danger\">Quitar</iswc-dropdown-item>",
            "                </iswc-dropdown>",
            "              </li>",
            "              <li class=\"list-row\">",
            "                <iswc-avatar name=\"Ana López\" status=\"offline\"></iswc-avatar>",
            "                <div class=\"list-meta\">",
            "                  <strong>Ana López</strong>",
            "                  <span class=\"muted\">ana@empresa.com</span>",
            "                </div>",
            "                <iswc-badge>Viewer</iswc-badge>",
            "                <iswc-dropdown>",
            "                  <iswc-button slot=\"trigger\" variant=\"plain\">",
            "                    <iswc-icon icon=\"mdi:dots-vertical\"></iswc-icon>",
            "                  </iswc-button>",
            "                  <iswc-dropdown-item>Ver perfil</iswc-dropdown-item>",
            "                  <iswc-dropdown-item>Enviar mensaje</iswc-dropdown-item>",
            "                  <iswc-dropdown-item color=\"danger\">Quitar</iswc-dropdown-item>",
            "                </iswc-dropdown>",
            "              </li>",
            "            </ul>",
            "          </iswc-card>"
          ]
        }
      ]
    }
  ]
}
