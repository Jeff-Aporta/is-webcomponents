{
  "$schema": "iswc-preview/v1",
  "tag": "icons",
  "category": "",
  "title": "Componentes",
  "titleHtml": false,
  "storageKey": "docs-icons-map",
  "mainClass": "icons-main",
  "wrapperClass": "icons-map",
  "hasBehavior": true,
  "withoutToc": true,
  "sections": [
    {
      "id": "map",
      "title": "Todos los componentes",
      "hideTitle": true,
      "className": "section--plain",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<header class=\"imap__hero\">",
            "  <p class=\"imap__kicker\">Catálogo</p>",
            "  <h1 class=\"imap__title\">Todos los componentes</h1>",
            "  <p class=\"imap__lede\">Categorías y tags del kit, en el mismo orden que el nav. Clic abre el preview.</p>",
            "  <iswc-input id=\"imapFilter\" type=\"search\" clearable placeholder=\"Filtrar por nombre o tag…\" aria-label=\"Filtrar componentes\"></iswc-input>",
            "</header>",
            "<div id=\"iconsMap\" class=\"imap\" aria-label=\"Todos los componentes\"></div>"
          ]
        }
      ]
    }
  ],
  "styles": [
    ".icons-main {",
    "  display: block;",
    "  height: 100%;",
    "  overflow: auto;",
    "  padding: 0;",
    "  background:",
    "    radial-gradient(48rem 32rem at 6% -12%, color-mix(in srgb, var(--iswc-accent) 16%, transparent), transparent 68%),",
    "    radial-gradient(40rem 28rem at 94% 4%, color-mix(in srgb, var(--iswc-accent) 10%, transparent), transparent 65%),",
    "    radial-gradient(28rem 20rem at 50% 100%, color-mix(in srgb, var(--iswc-accent) 6%, transparent), transparent 70%),",
    "    var(--iswc-bg);",
    "}",
    ".icons-map {",
    "  max-width: 76rem;",
    "  margin: 0 auto;",
    "  padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem) 3.5rem;",
    "  box-sizing: border-box;",
    "  font-family: var(--iswc-font, \"Poppins\", system-ui, sans-serif);",
    "}",
    ".imap__hero {",
    "  display: grid;",
    "  gap: 0.45rem;",
    "  margin-bottom: 2rem;",
    "  max-width: 40rem;",
    "}",
    ".imap__kicker {",
    "  margin: 0;",
    "  font-size: 0.65rem;",
    "  font-weight: 700;",
    "  letter-spacing: 0.16em;",
    "  text-transform: uppercase;",
    "  color: var(--iswc-accent);",
    "  text-shadow: 0 0 18px color-mix(in srgb, var(--iswc-accent) 45%, transparent);",
    "}",
    ".imap__title {",
    "  margin: 0;",
    "  font-size: clamp(1.45rem, 2.6vw, 1.9rem);",
    "  font-weight: 750;",
    "  letter-spacing: -0.035em;",
    "  line-height: 1.15;",
    "  color: var(--iswc-text);",
    "}",
    ".imap__lede {",
    "  margin: 0;",
    "  font-size: 0.92rem;",
    "  line-height: 1.55;",
    "  color: var(--iswc-text-soft);",
    "}",
    ".imap__hero iswc-input { width: min(100%, 22rem); margin-top: 0.35rem; }",
    ".imap {",
    "  display: flex;",
    "  flex-direction: column;",
    "  gap: 1.65rem;",
    "}",
    "/* Título flotante — fuera de la card, compacto. */",
    ".imap__cat.section h2.imap__cat-head,",
    ".imap__cat.section:first-of-type h2.imap__cat-head {",
    "  display: flex;",
    "  align-items: center;",
    "  gap: 0.5rem;",
    "  margin: 0 0 0.55rem;",
    "  padding: 0;",
    "  border: 0;",
    "  background: none;",
    "  font-size: clamp(0.95rem, 1.4vw, 1.15rem);",
    "  font-weight: 700;",
    "  letter-spacing: -0.02em;",
    "  text-transform: none;",
    "  color: var(--iswc-text);",
    "  line-height: 1.25;",
    "}",
    ".imap__cat-head iswc-icon {",
    "  color: var(--iswc-accent);",
    "  font-size: 1.15rem;",
    "  filter: drop-shadow(0 0 8px color-mix(in srgb, var(--iswc-accent) 55%, transparent));",
    "}",
    ".imap__cat-count {",
    "  font-variant-numeric: tabular-nums;",
    "  font-size: 0.78rem;",
    "  font-weight: 650;",
    "  letter-spacing: 0.02em;",
    "  color: var(--iswc-text-soft);",
    "  padding: 0.12rem 0.45rem;",
    "  border-radius: 999px;",
    "  border: 1px solid color-mix(in srgb, var(--iswc-accent) 28%, var(--iswc-border));",
    "  background: color-mix(in srgb, var(--iswc-accent) 10%, transparent);",
    "}",
    ".imap__cat-rule {",
    "  flex: 1 1 auto;",
    "  height: 1px;",
    "  min-width: 2rem;",
    "  margin-inline-start: 0.35rem;",
    "  background: linear-gradient(90deg,",
    "    color-mix(in srgb, var(--iswc-accent) 55%, transparent),",
    "    transparent 90%);",
    "  opacity: 0.85;",
    "}",
    ".imap__cat.section h2.imap__cat-head::after,",
    ".imap__cat.section:first-of-type h2.imap__cat-head::after { display: none !important; }",
    ".imap__grid {",
    "  display: grid;",
    "  grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));",
    "  gap: 0.65rem;",
    "}",
    ".imap__card {",
    "  appearance: none;",
    "  display: grid;",
    "  grid-template-rows: auto auto 1fr;",
    "  justify-items: start;",
    "  gap: 0.35rem;",
    "  min-height: 5.75rem;",
    "  padding: 0.8rem 0.75rem;",
    "  border-radius: calc(var(--iswc-radius) + 2px);",
    "  border: 1px solid color-mix(in srgb, var(--iswc-accent) 18%, var(--iswc-border));",
    "  background:",
    "    linear-gradient(145deg,",
    "      color-mix(in srgb, var(--iswc-accent) 9%, transparent),",
    "      transparent 55%),",
    "    color-mix(in srgb, var(--iswc-bg-elev, var(--iswc-bg)) 82%, transparent);",
    "  color: var(--iswc-text);",
    "  text-align: left;",
    "  cursor: pointer;",
    "  box-shadow:",
    "    inset 0 1px 0 color-mix(in srgb, #fff 7%, transparent),",
    "    0 6px 18px color-mix(in srgb, var(--iswc-accent) 6%, transparent);",
    "  backdrop-filter: blur(10px);",
    "  -webkit-backdrop-filter: blur(10px);",
    "  transition: transform 180ms cubic-bezier(.2,.7,.3,1), border-color 180ms ease,",
    "              box-shadow 180ms ease, background 180ms ease;",
    "}",
    ".imap__card:hover,",
    ".imap__card:focus-visible {",
    "  transform: translateY(-2px);",
    "  border-color: color-mix(in srgb, var(--iswc-accent) 48%, var(--iswc-border));",
    "  box-shadow:",
    "    inset 0 1px 0 color-mix(in srgb, #fff 10%, transparent),",
    "    0 0 0 1px color-mix(in srgb, var(--iswc-accent) 18%, transparent),",
    "    0 12px 28px color-mix(in srgb, var(--iswc-accent) 16%, transparent);",
    "  outline: none;",
    "}",
    ".imap__card:active { transform: translateY(0) scale(0.98); }",
    ".imap__card iswc-icon {",
    "  font-size: 1.35rem;",
    "  color: var(--iswc-accent);",
    "  filter: drop-shadow(0 0 6px color-mix(in srgb, var(--iswc-accent) 40%, transparent));",
    "}",
    ".imap__card-title {",
    "  margin: 0;",
    "  font-size: 0.8rem;",
    "  font-weight: 700;",
    "  line-height: 1.25;",
    "  color: var(--iswc-text);",
    "}",
    ".imap__card-tag {",
    "  margin: 0;",
    "  font-family: var(--iswc-mono, ui-monospace, Consolas, monospace);",
    "  font-size: 0.58rem;",
    "  color: var(--iswc-text-dim);",
    "  word-break: break-all;",
    "}",
    ".imap__empty {",
    "  margin: 1rem 0 0;",
    "  color: var(--iswc-text-soft);",
    "  font-size: 0.9rem;",
    "}",
    ".imap__cat[hidden],",
    ".imap__card[hidden] { display: none !important; }",
    ""
  ]
}
