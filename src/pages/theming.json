{
  "$schema": "iswc-preview/v1",
  "tag": "theming",
  "category": "",
  "title": "Personalización",
  "titleHtml": false,
  "mainClass": "tw-main",
  "styles": [
    "iswc-main.tw-main {",
    "  background:",
    "    radial-gradient(46rem 30rem at 10% -10%, color-mix(in srgb, var(--iswc-accent) 14%, transparent), transparent 68%),",
    "    radial-gradient(34rem 22rem at 92% 8%, color-mix(in srgb, var(--iswc-accent) 9%, transparent), transparent 64%),",
    "    var(--iswc-bg);",
    "}",
    "/* ═══════════════════════════════════════════════════════════════",
    "      Personalización — taller de temas.",
    "      Solo layout de la página: ni un color literal, todo sale de los",
    "      tokens --iswc-* para que la propia página respete la marca activa.",
    "      ═══════════════════════════════════════════════════════════════ */",
    "",
    "    .tw-seeds {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));",
    "      gap: 1rem;",
    "      align-items: start;",
    "",
    "      & .tw-seed-name { grid-column: 1 / -1; max-width: 22rem; }",
    "    }",
    "",
    "    .tw-actions {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      align-items: center;",
    "      gap: 0.75rem;",
    "      margin-top: 0.9rem;",
    "    }",
    "",
    "    /* ── Doble panel: dark y light a la vez ───────────────────────── */",
    "    .tw-panels {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));",
    "      gap: 1.15rem;",
    "",
    "      @media (max-width: 720px) {",
    "        grid-template-columns: minmax(0, 1fr);",
    "      }",
    "    }",
    "",
    "    /* El panel ES el ámbito del tema: lleva .theme-dark/.theme-light y",
    "      encima los tokens generados como propiedades inline. Todo lo que",
    "      cuelga dentro —incluidos los shadow roots de los is-*— los hereda. */",
    "    .tw-panel {",
    "      display: block;",
    "      padding: 1.15rem;",
    "      border-radius: calc(var(--iswc-radius) + 4px);",
    "      border: 1px solid color-mix(in srgb, var(--iswc-accent) 20%, var(--iswc-border));",
    "      background:",
    "        linear-gradient(145deg, color-mix(in srgb, var(--iswc-accent) 8%, transparent), transparent 48%),",
    "        color-mix(in srgb, var(--iswc-bg) 92%, transparent);",
    "      color: var(--iswc-text);",
    "      box-shadow:",
    "        inset 0 1px 0 color-mix(in srgb, #fff 7%, transparent),",
    "        0 12px 32px color-mix(in srgb, var(--iswc-accent) 8%, transparent),",
    "        var(--iswc-shadow);",
    "      backdrop-filter: blur(12px);",
    "      -webkit-backdrop-filter: blur(12px);",
    "      min-width: 0;",
    "",
    "      & .tw-panel__head {",
    "        display: flex;",
    "        align-items: center;",
    "        justify-content: space-between;",
    "        gap: 0.6rem;",
    "        margin: 0 0 0.9rem;",
    "        padding-bottom: 0.55rem;",
    "        border-bottom: 1px solid var(--iswc-border-soft);",
    "        font-size: 0.72rem;",
    "        font-weight: 700;",
    "        letter-spacing: 0.08em;",
    "        text-transform: uppercase;",
    "        color: var(--iswc-text-soft);",
    "      }",
    "",
    "      & .tw-panel__body {",
    "        display: flex;",
    "        flex-direction: column;",
    "        gap: 0.95rem;",
    "      }",
    "",
    "      & .tw-row {",
    "        display: flex;",
    "        flex-wrap: wrap;",
    "        align-items: center;",
    "        gap: 0.55rem;",
    "      }",
    "",
    "      & .tw-grid2 {",
    "        display: grid;",
    "        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));",
    "        gap: 0.7rem;",
    "      }",
    "",
    "      & .tw-note {",
    "        margin: 0;",
    "        font-size: 0.8rem;",
    "        line-height: 1.5;",
    "        color: var(--iswc-text-soft);",
    "      }",
    "    }",
    "",
    "    /* Muestras de la rampa generada */",
    "    .tw-ramp {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(4.5rem, 1fr));",
    "      gap: 0.4rem;",
    "      margin-top: 0.9rem;",
    "",
    "      & .tw-chip {",
    "        display: grid;",
    "        gap: 0.15rem;",
    "        padding: 0.5rem 0.4rem;",
    "        border-radius: var(--iswc-radius-sm);",
    "        border: 1px solid var(--iswc-border);",
    "        font-family: var(--iswc-mono);",
    "        font-size: 0.62rem;",
    "        text-align: center;",
    "",
    "        & b { font-size: 0.6rem; letter-spacing: 0.04em; opacity: 0.85; }",
    "        & span { font-size: 0.62rem; }",
    "      }",
    "    }",
    "",
    "    /* ── Bloque de exportación: barra + salida, una sola pieza ────── */",
    "    .tw-export {",
    "      margin-top: 1rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background: var(--iswc-bg-elev);",
    "      box-shadow: var(--iswc-shadow);",
    "      overflow: hidden;",
    "    }",
    "",
    "    .tw-export__bar {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      align-items: center;",
    "      gap: 0.6rem;",
    "      padding: 0.6rem 0.7rem;",
    "      border-bottom: 1px solid var(--iswc-border-soft);",
    "      background: color-mix(in srgb, var(--iswc-bg-elev) 60%, transparent);",
    "",
    "      & .tw-export__file {",
    "        display: inline-flex;",
    "        align-items: center;",
    "        gap: 0.35rem;",
    "        font-family: var(--iswc-mono);",
    "        font-size: 0.78rem;",
    "        color: var(--iswc-text);",
    "      }",
    "",
    "      & .tw-export__meta {",
    "        display: inline-flex;",
    "        align-items: center;",
    "        gap: 0.35rem;",
    "        font-family: var(--iswc-mono);",
    "        font-size: 0.7rem;",
    "        color: var(--iswc-text-soft);",
    "      }",
    "",
    "      /* Empuja copiar/descargar al extremo: la barra se lee de izquierda",
    "        (qué archivo es) a derecha (qué hago con él). */",
    "      & .tw-export__spacer { flex: 1 1 auto; min-width: 0.5rem; }",
    "    }",
    "",
    "    /* La salida ES un `pre.code`: la colorea `<iswc-code>` (motor nativo) como cualquier otro",
    "      snippet, y el observer del highlighter la repinta en cada `iswc-input`",
    "      del picker. Aquí solo queda encajarla en la tarjeta. */",
    "    .tw-output {",
    "      margin: 0;",
    "      max-height: 26rem;",
    "      overflow: auto;",
    "      overscroll-behavior: contain;",
    "      border: 0;",
    "      border-radius: 0;",
    "      box-shadow: none;",
    "      font-size: 0.76rem;",
    "    }",
    "    .tw-persist-hint {",
    "      margin: 0.5rem 0 0;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-dim);",
    "    }",
    "",
    "    .tw-export-tabs { display: block; }",
    "",
    "    .tw-tuto {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.75rem;",
    "      margin-top: 0.85rem;",
    "      max-width: 52rem;",
    "      font-size: 0.92rem;",
    "      line-height: 1.55;",
    "      color: var(--iswc-text);",
    "",
    "      & p { margin: 0; }",
    "",
    "      & ol {",
    "        margin: 0;",
    "        padding-left: 1.15rem;",
    "        display: flex;",
    "        flex-direction: column;",
    "        gap: 0.55rem;",
    "      }",
    "",
    "      & code {",
    "        font-family: var(--iswc-mono);",
    "        font-size: 0.84em;",
    "      }",
    "",
    "      & .tw-note {",
    "        margin: 0;",
    "        color: var(--iswc-text-soft);",
    "        font-size: 0.8rem;",
    "      }",
    "    }",
    ""
  ],
  "storageKey": "docs-theming",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Personalización",
      "lede": [
        "Taller de temas: elige unos pocos colores semilla, míralos aplicados",
        "          en vivo sobre componentes reales —en <strong>oscuro y claro a la",
        "          vez</strong>— y llévate el CSS listo para pegar en tu proyecto junto a",
        "          <code>is-base.css</code>."
      ],
      "blocks": [
        {
          "kind": "callout",
          "html": [
            "No hace falta escribir 30 variables a mano: de la semilla de marca se",
            "          derivan la rampa completa, los <em>soft</em>, el <code>accent-bg</code>",
            "          y el foco con las mismas relaciones que ya usa <code>palettes.css</code>."
          ]
        }
      ]
    },
    {
      "id": "sistema",
      "title": "Cómo está montado el sistema",
      "lede": "Tres capas, en este orden de carga:",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<ol class=\"lede\">",
            "          <li>",
            "            <code>is-base.css</code> — define los <strong>dos temas</strong>",
            "            (superficies, texto, controles, estados de campo, scrollbars) sin",
            "            ningún color de marca. Con solo este archivo ya tienes dark/light",
            "            gris neutro.",
            "          </li>",
            "          <li>",
            "            <code>palettes.css</code> — opcional. Aporta la",
            "            <strong>marca</strong> (<code>--iswc-color-brand-*</code>,",
            "            <code>--iswc-accent</code>, <code>--iswc-brand-*</code>,",
            "            <code>--iswc-focus</code>) y <strong>re-tinta las superficies</strong>",
            "            por pareja tema+paleta.",
            "          </li>",
            "          <li>",
            "            Tu paleta — exactamente la misma forma que <code>palettes.css</code>.",
            "            Es lo que genera esta página.",
            "          </li>",
            "        </ol>",
            "",
            "        <p class=\"lede\">",
            "          La selección combina <strong>dos cosas</strong>: la clase de tema y el",
            "          atributo de paleta. Las variables de marca cuelgan solo del atributo",
            "          (valen para los dos temas); las superficies cuelgan de la",
            "          <strong>pareja</strong>:",
            "        </p>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "/* cada paleta solo declara h, s, b. La rampa la calcula la capa comun. */",
            "[data-palette=\"contapyme\"] {",
            "  --iswc-brand-h: 210;",
            "  --iswc-brand-s: 100%;",
            "  --iswc-brand-b: 56%;",
            "}",
            "",
            "[data-palette] {",
            "  --iswc-color-brand: hsl(calc(var(--iswc-brand-h) * 1deg) var(--iswc-brand-s) var(--iswc-brand-b));",
            "  --iswc-accent: var(--iswc-color-brand);",
            "  --iswc-accent-bg: rgb(from var(--iswc-accent) r g b / 12%);",
            "  --iswc-brand-soft: rgb(from var(--iswc-accent) r g b / 18%);",
            "  --iswc-hue-rotate: calc((var(--iswc-brand-h) - var(--iswc-logo-h)) * 1deg);",
            "}",
            "",
            "/* superficies: dependen de la PAREJA (tema, paleta) */",
            ".theme-dark[data-palette=\"contapyme\"]  { --iswc-bg: #0a0e14; --iswc-border: #273040; }",
            ".theme-light[data-palette=\"contapyme\"] { --iswc-bg: #fff;    --iswc-border: #ccc; }"
          ]
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Y así se activa. Lo habitual es en <code>&lt;html&gt;</code>, pero",
            "          funciona en cualquier ancestro: por eso los dos paneles de más abajo",
            "          pueden mostrar temas distintos en la misma página.",
            "        </p>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<html class=\"theme-dark\" data-theme=\"dark\" data-palette=\"contapyme\">",
            "",
            "<!-- o acotado a un trozo del DOM -->",
            "<div class=\"theme-light\" data-theme=\"light\" data-palette=\"mi-marca\"> … </div>"
          ]
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Tokens que un consumidor <strong>sí</strong> debería redefinir:",
            "        </p>"
          ]
        },
        {
          "kind": "table",
          "columns": [
            "Grupo",
            "Tokens",
            "Dónde va"
          ],
          "rows": [
            [
              "Marca",
              "<code>--iswc-color-brand</code> <code>--iswc-color-brand-paler</code> <code>--iswc-color-brand-pale</code> <code>--iswc-color-brand-strong</code> <code>--iswc-color-brand-stronger</code> <code>--iswc-color-brand-strongest</code> <code>--iswc-accent</code> <code>--iswc-accent-bg</code> <code>--iswc-on-brand</code>",
              "<code>[data-palette=\"…\"]</code>"
            ],
            [
              "Marca por tema",
              "<code>--iswc-brand-soft</code> <code>--iswc-brand-soft-active</code> <code>--iswc-brand-text</code> <code>--iswc-focus</code>",
              "pareja tema+paleta"
            ],
            [
              "Superficies",
              "<code>--iswc-bg</code> <code>--iswc-bg-soft</code> <code>--iswc-bg-elev</code> <code>--iswc-code-bg</code>",
              "pareja tema+paleta"
            ],
            [
              "Bordes y texto",
              "<code>--iswc-border</code> <code>--iswc-border-soft</code> <code>--iswc-text</code> <code>--iswc-text-soft</code> <code>--iswc-text-dim</code>",
              "pareja tema+paleta"
            ],
            [
              "Controles",
              "<code>--iswc-control-bg</code> <code>--iswc-control-bg-hover</code> <code>--iswc-control-bg-active</code> <code>--iswc-control-border</code> <code>--iswc-control-text</code>",
              "pareja tema+paleta"
            ],
            [
              "Campos",
              "<code>--iswc-b-required</code> <code>--iswc-b-optional</code> <code>--iswc-b-readonly</code> <code>--iswc-bg-readonly</code>",
              "pareja tema+paleta"
            ],
            [
              "Geometría",
              "<code>--iswc-radius</code> <code>--iswc-radius-sm</code> <code>--iswc-shadow</code>",
              "cualquiera de los dos"
            ],
            [
              "Scrollbars",
              "<code>--iswc-scrollbar-thumb</code> <code>--iswc-scrollbar-thumb-hover</code> <code>--iswc-scrollbar-track</code>",
              "opcional"
            ]
          ],
          "className": "ref--tokens"
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Los semánticos (<code>--iswc-color-success-*</code>,",
            "          <code>--iswc-color-warning-*</code>, <code>--iswc-color-danger-*</code>) se",
            "          dejan como están salvo que tu marca los necesite: son señales de",
            "          estado, no decoración.",
            "        </p>"
          ]
        }
      ]
    },
    {
      "id": "taller",
      "title": "Tu paleta",
      "role": "region",
      "ariaLabel": "Editor de paleta: cinco semillas para personalizar marca y temas",
      "lede": [
        "Cinco semillas. Todo lo demás se deriva en OKLCH conservando el tono",
        "          de tu marca."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"tw-seeds\">",
            "            <iswc-input class=\"tw-seed-name\" id=\"palName\" label=\"Nombre de la paleta\" hint=\"Se usa como data-palette=&quot;…&quot;\" value=\"mi-marca\"></iswc-input>",
            "            <iswc-color-picker class=\"tw-seed\" data-seed=\"brand\"     label=\"Marca / acento\" hint=\"--iswc-accent y la rampa\" value=\"#7048e8\" swatches=\"#e03131,#1a6eb0,#9acd32,#7048e8,#0ca678,#f76707\"></iswc-color-picker>",
            "            <iswc-color-picker class=\"tw-seed\" data-seed=\"darkBg\"    label=\"Fondo oscuro\"   hint=\"--iswc-bg en dark\"        value=\"#0b0d10\"></iswc-color-picker>",
            "            <iswc-color-picker class=\"tw-seed\" data-seed=\"darkText\"  label=\"Texto oscuro\"   hint=\"--iswc-text en dark\"      value=\"#e6e8eb\"></iswc-color-picker>",
            "            <iswc-color-picker class=\"tw-seed\" data-seed=\"lightBg\"   label=\"Fondo claro\"    hint=\"--iswc-bg en light\"       value=\"#ffffff\"></iswc-color-picker>",
            "            <iswc-color-picker class=\"tw-seed\" data-seed=\"lightText\" label=\"Texto claro\"    hint=\"--iswc-text en light\"     value=\"#1f2328\"></iswc-color-picker>",
            "          </div>",
            "",
            "          <div class=\"tw-actions\">",
            "            <iswc-switch id=\"applyRoot\" hint=\"Solo esta sesión: F5 lo quita. No se guarda en localStorage.\">Aplicar a toda la página</iswc-switch>",
            "            <iswc-button id=\"btnReset\" variant=\"outlined\">Restaurar defaults</iswc-button>",
            "          </div>",
            "          <p class=\"tw-persist-hint\">Los colores de los inputs se guardan en <code>localStorage</code>. «Restaurar defaults» los borra. «Aplicar a toda la página» es temporal (F5).</p>",
            "",
            "          <div class=\"tw-ramp\" id=\"ramp\"></div>"
          ],
          "heading": "Semillas"
        }
      ]
    },
    {
      "id": "preview",
      "title": "Vista previa · oscuro y claro a la vez",
      "role": "region",
      "ariaLabel": "Vista previa con paneles de tema oscuro y claro a la vez",
      "lede": [
        "Los mismos componentes, dos veces. El panel izquierdo lleva",
        "          <code>class=\"theme-dark\"</code> y el derecho",
        "          <code>class=\"theme-light\"</code>; encima de cada uno se escriben los",
        "          tokens generados como propiedades personalizadas del propio elemento.",
        "          Los <code>is-*</code> los leen por herencia dentro de su shadow root,",
        "          así que no hace falta tocar <code>&lt;html&gt;</code>."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": "<div class=\"tw-panels\">"
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"tw-panel__head\"><span>Tema oscuro</span><span id=\"darkBgLabel\"></span></p>",
            "            <div class=\"tw-panel__body\" data-panel-body role=\"region\" aria-label=\"Panel de previsualización en tema oscuro\"></div>"
          ]
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"tw-panel__head\"><span>Tema claro</span><span id=\"lightBgLabel\"></span></p>",
            "            <div class=\"tw-panel__body\" data-panel-body role=\"region\" aria-label=\"Panel de previsualización en tema claro\"></div>"
          ]
        },
        {
          "kind": "html",
          "html": "</div>"
        }
      ]
    },
    {
      "id": "exportar",
      "title": "Llévatelo",
      "role": "region",
      "ariaLabel": "Exportar paleta: copiar CSS, obtener JSON o ver cómo convertir el JSON en CSS",
      "lede": "Tres piezas de la misma paleta: el CSS para pegar, el JSON que alimenta <code>&lt;iswc-palette-selector&gt;</code>, y cómo se pasa del JSON al CSS.",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<iswc-tab-group class=\"tw-export-tabs\" active=\"css\">",
            "          <iswc-tab slot=\"nav\" panel=\"css\">CSS</iswc-tab>",
            "          <iswc-tab slot=\"nav\" panel=\"json\">JSON</iswc-tab>",
            "          <iswc-tab slot=\"nav\" panel=\"tuto\">Cómo usarlo</iswc-tab>",
            "          <iswc-tab-panel name=\"css\">",
            "            <div class=\"tw-export\">",
            "              <div class=\"tw-export__bar\">",
            "                <span class=\"tw-export__file\">",
            "                  <iswc-icon icon=\"mdi:language-css3\"></iswc-icon>",
            "                  <span id=\"fileName\">mi-marca.css</span>",
            "                </span>",
            "                <span class=\"tw-export__meta\">data-palette=<iswc-tag pill id=\"tagName\">mi-marca</iswc-tag></span>",
            "                <span class=\"tw-export__spacer\"></span>",
            "                <iswc-copy-button id=\"copyCss\" from=\"cssOut.value\" copy-label=\"Copiar CSS\" success-label=\"¡Copiado!\" tooltip=\"Copiar solo el CSS\"></iswc-copy-button>",
            "                <iswc-button id=\"btnDownload\" variant=\"filled\">",
            "                  <iswc-icon slot=\"start\" icon=\"mdi:download\"></iswc-icon>",
            "                  Descargar .css",
            "                </iswc-button>",
            "              </div>",
            "              <pre class=\"code tw-output\" id=\"cssOut\" data-lang=\"css\" data-no-compact=\"\">/* … */</pre>",
            "            </div>",
            "          </iswc-tab-panel>",
            "          <iswc-tab-panel name=\"json\">",
            "            <div class=\"tw-export\">",
            "              <div class=\"tw-export__bar\">",
            "                <span class=\"tw-export__file\">",
            "                  <iswc-icon icon=\"mdi:code-json\"></iswc-icon>",
            "                  <span id=\"fileNameJson\">mi-marca.json</span>",
            "                </span>",
            "                <span class=\"tw-export__meta\">atributo palettes de iswc-palette-selector</span>",
            "                <span class=\"tw-export__spacer\"></span>",
            "                <iswc-copy-button id=\"copyJson\" from=\"jsonOut.value\" copy-label=\"Copiar JSON\" success-label=\"¡Copiado!\" tooltip=\"Copiar el JSON del selector\"></iswc-copy-button>",
            "                <iswc-button id=\"btnDownloadJson\" variant=\"filled\">",
            "                  <iswc-icon slot=\"start\" icon=\"mdi:download\"></iswc-icon>",
            "                  Descargar .json",
            "                </iswc-button>",
            "              </div>",
            "              <pre class=\"code tw-output\" id=\"jsonOut\" data-lang=\"json\" data-no-compact=\"\">[]</pre>",
            "            </div>",
            "          </iswc-tab-panel>",
            "          <iswc-tab-panel name=\"tuto\">",
            "            <div class=\"tw-tuto\">",
            "              <p>El JSON es el catálogo. El CSS sale de <code>h</code>, <code>s</code> y <code>b</code>. Ese mismo array construye <code>&lt;iswc-palette-selector&gt;</code>.</p>",
            "              <ol>",
            "                <li><strong>Semilla.</strong> Por cada objeto, un bloque <code>[data-palette=\"value\"]</code> con <code>--iswc-brand-h</code>, <code>--iswc-brand-s</code> y <code>--iswc-brand-b</code>. Esos tres salen de <code>h</code>, <code>s</code> y <code>b</code>. No escribas el hex de la marca.</li>",
            "                <li><strong>Rampa, una sola vez.</strong> <code>palettes.css</code> ya la declara en <code>:root, [data-palette]</code>: calcula <code>--iswc-color-brand</code>, strong / pale y los alpha con <code>hsl(from …)</code> y <code>rgb(from var(--iswc-accent) …)</code>. Si no cargas esa hoja, pégala una vez. El tab CSS la trae resuelta dentro del bloque, más las superficies de tema oscuro y claro. El selector no las consume.</li>",
            "                <li><strong>Actívala.</strong> Pon <code>data-palette=\"value\"</code> en <code>&lt;html&gt;</code> o en el subárbol que quieras teñir.</li>",
            "                <li><strong>Selector.</strong> Pega el array en el atributo <code>palettes</code>. <code>label</code>, <code>lead</code> y <code>accentLabel</code> arman el menú y el wordmark; <code>h</code>, <code>s</code> y <code>b</code> pintan la muestra. Al elegir, el componente escribe <code>data-palette</code>. Si el objeto trae <code>css</code> (una URL), carga esa hoja al seleccionar.</li>",
            "                <li><strong>Logo.</strong> <code>filter: hue-rotate(var(--iswc-hue-rotate))</code>. <code>--iswc-logo-h</code> es el tono en el que está pintado el SVG (210 en los logos del kit).</li>",
            "              </ol>",
            "              <p class=\"tw-note\">Semilla de la paleta que estás editando:</p>",
            "              <pre class=\"code tw-output\" id=\"tutoSeed\" data-lang=\"css\" data-no-compact=\"\">/* … */</pre>",
            "              <p class=\"tw-note\">El mismo JSON, listo para el componente:</p>",
            "              <pre class=\"code tw-output\" id=\"tutoSelector\" data-lang=\"html\" data-no-compact=\"\">&lt;iswc-palette-selector&gt;</pre>",
            "            </div>",
            "          </iswc-tab-panel>",
            "        </iswc-tab-group>"
          ]
        }
      ]
