              "default true; <code>\"false\"</code> deja solo el vídeo (sin chrome ni overlay)"
            ],
            [
              "<code>muted</code> <code>loop</code> <code>autoplay</code> <code>playsinline</code>",
              "boolean"
            ],
            [
              "<code>play()</code> <code>pause()</code>",
              "métodos"
            ],
            [
              "<code>toggleFullscreen()</code> <code>togglePictureInPicture()</code>",
              "métodos"
            ],
            [
              "<code>media</code>",
              "getter al <code>&lt;video&gt;</code> interno"
