    {
      "id": "icons",
      "title": "Icono fallback por slot",
      "lede": "Sin imagen ni iniciales, el slot <code class=\"code\">icon</code> pinta cualquier <code class=\"code\">&lt;is-icon&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1rem;flex-wrap:wrap;font-size:2.5rem\">\r\n            <is-avatar label=\"Usuario\">\r\n              <is-icon slot=\"icon\" icon=\"mdi:account\"></is-icon>\r\n            </is-avatar>\r\n            <is-avatar label=\"Bot\">\r\n              <is-icon slot=\"icon\" icon=\"mdi:robot\"></is-icon>\r\n            </is-avatar>\r\n            <is-avatar label=\"Soporte\">\r\n              <is-icon slot=\"icon\" icon=\"mdi:lifebuoy\"></is-icon>\r\n            </is-avatar>\r\n            <is-avatar label=\"Comunidad\">\r\n              <is-icon slot=\"icon\" icon=\"mdi:account-group\"></is-icon>\r\n            </is-avatar>\r\n          </div>"
        }
      ]
