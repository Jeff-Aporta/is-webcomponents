    {
      "id": "error",
      "title": "Imagen rota",
      "lede": "Si <code class=\"code\">image</code> falla y hay <code class=\"code\">initials</code>, el avatar cae a las iniciales automáticamente y emite <code class=\"code\">is-error</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"fallback-grid\">\r\n            <figure class=\"fallback-case\">\r\n              <is-avatar image=\"https://i.pravatar.cc/120?u=31\" initials=\"OK\" label=\"Imagen correcta\"></is-avatar>\r\n              <figcaption>\r\n                <b>URL válida</b>\r\n                <small>se muestra la imagen</small>\r\n              </figcaption>\r\n            </figure>\r\n\r\n            <figure class=\"fallback-case\">\r\n              <is-avatar image=\"https://invalid.example/x.jpg\" initials=\"ER\" label=\"Error fallback\" id=\"errAv\"></is-avatar>\r\n              <figcaption>\r\n                <b>URL rota + initials</b>\r\n                <small id=\"errLog\">cargando…</small>\r\n              </figcaption>\r\n            </figure>\r\n\r\n            <figure class=\"fallback-case\">\r\n              <is-avatar image=\"https://invalid.example/y.jpg\" label=\"Sin iniciales\"></is-avatar>\r\n              <figcaption>\r\n                <b>URL rota, sin initials</b>\r\n                <small>cae al icono por defecto</small>\r\n              </figcaption>\r\n            </figure>\r\n          </div>",
          "heading": "El mismo avatar con la imagen buena y con la rota"
        },
        {
          "kind": "html",
          "html": "<script>\r\n          const a = document.getElementById('errAv');\r\n          const log = document.getElementById('errLog');\r\n          a.addEventListener('is-error', () => {\r\n            log.textContent = '✓ is-error emitido — avatar cayó a iniciales \"ER\"';\r\n          });\r\n        </script>"
        }
      ]
    },
