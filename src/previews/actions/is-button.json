        {
          "kind": "demo",
          "html": "<div class=\"demo-row\">\r\n            <is-button id=\"evtBtn\" color=\"brand\">Probar eventos</is-button>\r\n            <is-button id=\"evtBtn2\" color=\"success\" variant=\"outlined\">Segundo botón</is-button>\r\n          </div>\r\n          <div id=\"evtLog\" class=\"log\" aria-live=\"polite\"></div>",
          "equivNote": "Equivalente nativo generico de is-button: button type=button (o a si hay href).",
