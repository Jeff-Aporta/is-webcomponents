    {
      "id": "playground",
      "title": "Playground",
      "lede": "Modifica las opciones y observa el resultado al instante.",
      "blocks": [
        {
          "kind": "html",
          "html": "<div class=\"playground\">\r\n          <div class=\"stage\">\r\n            <is-button id=\"pgBtn\" color=\"brand\">Hola mundo</is-button>\r\n          </div>\r\n\r\n          <div class=\"controls\">\r\n            <h4>Configuración</h4>\r\n\r\n            <div class=\"ctl-row\">\r\n              <label for=\"pgVariant\">variant</label>\r\n              <select id=\"pgVariant\">\r\n                <option>brand</option>\r\n                <option>neutral</option>\r\n                <option>success</option>\r\n                <option>warning</option>\r\n                <option>danger</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"ctl-row\">\r\n              <label for=\"pgAppearance\">appearance</label>\r\n              <select id=\"pgAppearance\">\r\n                <option>filled</option>\r\n                <option>outlined</option>\r\n                <option>plain</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"ctl-row\">\r\n              <label for=\"pgText\">texto</label>\r\n              <input id=\"pgText\" type=\"text\" value=\"Hola mundo\" />\r\n            </div>\r\n            <div class=\"ctl-row\">\r\n              <label for=\"pgStart\">icono start</label>\r\n              <select id=\"pgStart\">\r\n                <option value=\"\">(ninguno)</option>\r\n                <option value=\"i-floppy\">floppy</option>\r\n                <option value=\"i-edit\">edit</option>\r\n                <option value=\"i-trash\">trash</option>\r\n                <option value=\"i-bell\">bell</option>\r\n                <option value=\"i-check\">check</option>\r\n                <option value=\"i-gear\">gear</option>\r\n                <option value=\"i-search\">search</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"ctl-row\">\r\n              <label for=\"pgEnd\">icono end</label>\r\n              <select id=\"pgEnd\">\r\n                <option value=\"\">(ninguno)</option>\r\n                <option value=\"i-arrow-r\">arrow-right</option>\r\n                <option value=\"i-download\">download</option>\r\n                <option value=\"i-link\">link</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"ctl-row\">\r\n              <label>flags</label>\r\n              <div class=\"checks\">\r\n                <label class=\"chip\"><input type=\"checkbox\" id=\"pgPill\" /> pill</label>\r\n                <label class=\"chip\"><input type=\"checkbox\" id=\"pgCaret\" /> caret</label>\r\n                <label class=\"chip\"><input type=\"checkbox\" id=\"pgLoading\" /> loading</label>\r\n                <label class=\"chip\"><input type=\"checkbox\" id=\"pgDisabled\" /> disabled</label>\r\n              </div>\r\n            </div>\r\n            <div class=\"ctl-row\">\r\n              <label for=\"pgHref\">href (opcional)</label>\r\n              <input id=\"pgHref\" type=\"text\" placeholder=\"https://...\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <h4>HTML generado</h4>"
        },
        {
          "kind": "code",
          "code": "<is-button>Hola mundo</is-button>"
        }
      ]
    },
