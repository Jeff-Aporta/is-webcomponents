{
  "$schema": "is-preview/v1",
  "tag": "is-confirm-modal",
  "category": "feedback",
  "title": "<is-confirm-modal>",
  "titleHtml": true,
  "description": "Documentación y demos de is-confirm-modal de InSoft.",
  "storageKey": "docs-is-confirm-modal",
  "sections": [
    {
      "id": "intro",
      "title": "<is-confirm-modal>",
      "lede": "Confirmación en modal centrado con backdrop. Para decisiones que\r\n          merecen foco total. Si prefieres confirmar en línea sin tapar la\r\n          pantalla, usa <code class=\"code\">&lt;is-popconfirm&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-button id=\"btnDelete\" color=\"danger\">\r\n            <is-icon slot=\"start\" icon=\"mdi:trash-can\"></is-icon>\r\n            Eliminar cuenta\r\n          </is-button>\r\n          <is-confirm-modal for=\"btnDelete\" heading=\"Eliminar cuenta\" message=\"Se borrarán todos tus datos. Esta acción no se puede deshacer.\">\r\n            <is-button slot=\"confirm\" color=\"danger\">Sí, eliminar</is-button>\r\n            <is-button slot=\"cancel\">Cancelar</is-button>\r\n          </is-confirm-modal>\r\n          <p id=\"cmLog\">Última acción: <code class=\"code\">—</code></p>"
        },
        {
          "kind": "code",
          "code": "<is-button id=\"btnDelete\">Eliminar cuenta</is-button>\n<is-confirm-modal for=\"btnDelete\" heading=\"Eliminar cuenta\" message=\"¿Seguro?\">\n  <is-button slot=\"confirm\" color=\"danger\">Sí, eliminar</is-button>\n  <is-button slot=\"cancel\">Cancelar</is-button>\n</is-confirm-modal>"
        }
      ]
    },
    {
      "id": "custom",
      "title": "Slot message",
      "lede": "El contenido del slot <code class=\"code\">message</code> reemplaza el atributo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-button id=\"cmMega\" color=\"brand\">Publicar cambios</is-button>\r\n          <is-confirm-modal for=\"cmMega\" heading=\"Publicar a producción\">\r\n            <div slot=\"message\">\r\n              <strong>Vas a publicar 12 cambios.</strong>\r\n              <p style=\"margin:0.25rem 0;font-size:0.85em;color:color-mix(in srgb,currentColor 70%,transparent)\">\r\n                Los usuarios verán la nueva versión de inmediato.\r\n              </p>\r\n            </div>\r\n            <is-button slot=\"cancel\">Revisar de nuevo</is-button>\r\n            <is-button slot=\"confirm\" color=\"brand\">Publicar</is-button>\r\n          </is-confirm-modal>"
        }
      ]
    },
