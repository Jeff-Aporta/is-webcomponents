{
  "$schema": "is-preview/v1",
  "tag": "is-form",
  "category": "isp",
  "title": "<is-form>",
  "titleHtml": true,
  "description": "Documentación y demos de is-form de InSoft.",
  "storageKey": "docs-is-form",
  "sections": [
    {
      "id": "intro",
      "title": "<is-form>",
      "lede": "Ficha con cabecera, cuerpo scrolleable y un pie que ya trae Aceptar y\r\n          Cancelar. Port de <code class=\"code\">form/Form.svelte</code> de ISP.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"height: 22rem; border: 1px solid var(--is-border); border-radius: 0.5rem\">\r\n            <is-form id=\"fDemo\" mode=\"edit\">\r\n              <h3 slot=\"header\" style=\"margin:0.5rem 0\">Nuevo tercero</h3>\r\n              <div slot=\"content\" style=\"display:flex;flex-direction:column;gap:0.75rem;padding:0.5rem\">\r\n                <is-input label=\"Nombre\" label-placement=\"float\" required full-width></is-input>\r\n                <is-input label=\"NIT\" label-placement=\"float\" full-width></is-input>\r\n              </div>\r\n              <span slot=\"pre-buttons\" style=\"color: var(--is-text-dim)\">Los campos obligatorios llevan borde propio</span>\r\n            </is-form>\r\n          </div>\r\n          <p id=\"fLog\">Última acción: <code class=\"code\">—</code></p>"
        },
        {
          "kind": "code",
          "code": "<is-form mode=\"edit\">\n  <h3 slot=\"header\">Nuevo tercero</h3>\n  <div slot=\"content\">…</div>\n  <span slot=\"pre-buttons\">Campos obligatorios</span>\n</is-form>"
        }
      ]
    },
    {
      "id": "modo-vista",
      "title": "Modo consulta",
      "lede": "Con <code class=\"code\">mode=\"view\"</code> desaparece Aceptar: solo queda Cancelar.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"height: 12rem; border: 1px solid var(--is-border); border-radius: 0.5rem\">\r\n            <is-form mode=\"view\">\r\n              <h3 slot=\"header\" style=\"margin:0.5rem 0\">Detalle del tercero</h3>\r\n              <div slot=\"content\" style=\"padding:0.5rem\">Solo lectura.</div>\r\n            </is-form>\r\n          </div>"
        }
      ]
    },
    {
      "id": "responsive",
      "title": "Responsive a 600px",
      "lede": "El breakpoint mide el ancho PROPIO del formulario (container query), no\r\n          el de la ventana: dentro de un panel estrecho los botones se apilan.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"width: 22rem; height: 15rem; border: 1px solid var(--is-border); border-radius: 0.5rem\">\r\n            <is-form>\r\n              <h3 slot=\"header\" style=\"margin:0.5rem 0\">Panel estrecho</h3>\r\n              <div slot=\"content\" style=\"padding:0.5rem\">Menos de 600px de ancho propio.</div>\r\n            </is-form>\r\n          </div>"
        }
      ]
    },
    {
      "id": "escala",
      "title": "Escala por contexto",
      "lede": "Sin atributo <code class=\"code\">size</code>: todo se mide en <code class=\"code\">em</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"font-size: 1.15em; height: 12rem; border: 1px solid var(--is-border); border-radius: 0.5rem\">\r\n            <is-form>\r\n              <h3 slot=\"header\" style=\"margin:0.5rem 0\">Más grande</h3>\r\n              <div slot=\"content\" style=\"padding:0.5rem\">Hereda el font-size del contenedor.</div>\r\n            </is-form>\r\n          </div>"
        }
      ]
    }
  ]
}
