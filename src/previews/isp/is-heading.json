      "title": "<is-heading>",
      "lede": "Un solo módulo para los seis niveles. Port de <code class=\"code\">H1…H6.svelte</code> de ISP:\r\n          el color va mezclando el acento de la paleta con el color de texto según baja el nivel\r\n          (15 · 30 · 45 · 65 · 80 · 90 %).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"display:flex;flex-direction:column;gap:0.5rem\">\r\n            <is-heading level=\"1\">Nivel 1</is-heading>\r\n            <is-heading level=\"2\">Nivel 2</is-heading>\r\n            <is-heading level=\"3\">Nivel 3</is-heading>\r\n            <is-heading level=\"4\">Nivel 4</is-heading>\r\n            <is-heading level=\"5\">Nivel 5</is-heading>\r\n            <is-heading level=\"6\">Nivel 6</is-heading>\r\n          </div>"
        }
      ]
    },
