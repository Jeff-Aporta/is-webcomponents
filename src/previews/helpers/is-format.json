{
  "$schema": "is-preview/v1",
  "tag": "is-format",
  "category": "helpers",
  "title": "<is-format>",
  "titleHtml": true,
  "storageKey": "docs-is-format",
  "sections": [
    {
      "id": "intro",
      "title": "<is-format>",
      "lede": "Formateo con <code class=\"code\">Intl</code> y presets estilo Excel vía <code class=\"code\">pattern</code>. Un solo elemento cubre número, fecha/hora, texto, bytes y tiempo relativo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">vista rápida</span>\n          <div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">#,##0.00</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"#,##0.00\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">yyyy-mm-dd</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-08-01\" pattern=\"yyyy-mm-dd\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00%</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"0.42\" pattern=\"0.00%\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">title case</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"hola mundo contapyme\" case=\"title\"></is-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "excel-number",
      "title": "Números · patrones Excel",
      "lede": "Atributo <code class=\"code\">pattern</code> con códigos habituales de Excel (General, Number, Percent, Scientific, Currency, Accounting, Fraction).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">General · 1234.5</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"General\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"0\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"0.00\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">#,##0</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234567\" pattern=\"#,##0\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">#,##0.00</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234567.8\" pattern=\"#,##0.00\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0%</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"0.42\" pattern=\"0%\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00%</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"0.425\" pattern=\"0.00%\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00E+00</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234567\" pattern=\"0.00E+00\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">$#,##0.00</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"12500\" pattern=\"$#,##0.00\" currency=\"USD\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">Accounting</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"-1250.5\" pattern=\"Accounting\" currency=\"USD\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\"># ?/?</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"2.75\" pattern=\"# ?/?\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\"># ??/??</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"0.333\" pattern=\"# ??/??\"></is-format>\n            </div>\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-format type=\"number\" value=\"1234.5\" pattern=\"#,##0.00\"></is-format>\n<is-format type=\"number\" value=\"0.42\" pattern=\"0.00%\"></is-format>\n<is-format type=\"number\" value=\"2.75\" pattern=\"# ?/?\"></is-format>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "excel-date",
      "title": "Fechas y hora · patrones Excel",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">yyyy-mm-dd</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:00\" pattern=\"yyyy-mm-dd\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">dd/mm/yyyy</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30\" pattern=\"dd/mm/yyyy\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">d-mmm-yyyy</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30\" pattern=\"d-mmm-yyyy\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">mmmm yyyy</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30\" pattern=\"mmmm yyyy\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">h:mm AM/PM</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:00\" pattern=\"h:mm AM/PM\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">h:mm:ss</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:45\" pattern=\"h:mm:ss\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">yyyy-mm-dd hh:mm:ss</code>\n              <is-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:45\" pattern=\"yyyy-mm-dd hh:mm:ss\"></is-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "excel-text",
      "title": "Texto · type=\"text\"",
      "lede": "Equivalente a formato Texto (@) de Excel, más transformaciones útiles.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">@ / as-is</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"00123\" pattern=\"@\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">upper</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"contapyme\" case=\"upper\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">lower</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"ContaPyme\" case=\"lower\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">title</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"hola mundo\" case=\"title\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">truncate 12</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"Texto demasiado largo para la celda\" truncate=\"12\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">pad-start 0 × 6</code>\n              <is-format class=\"format-grid__value\" type=\"text\" value=\"42\" pad-start=\"0\" pad-length=\"6\"></is-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "type-number",
      "title": "format · atajos Intl",
      "lede": "Sin <code class=\"code\">pattern</code>, usa <code class=\"code\">format</code>: decimal, currency, percent, scientific, compact, integer, accounting.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">decimal</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">currency EUR</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"99.99\" format=\"currency\" currency=\"EUR\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">percent</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"0.42\" format=\"percent\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">scientific</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234567\" format=\"scientific\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">compact</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1250000\" format=\"compact\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">integer</code>\n              <is-format class=\"format-grid__value\" type=\"number\" value=\"1234.9\" format=\"integer\"></is-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "type-bytes",
      "title": "type=\"bytes\"",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">512 B</code>\n              <is-format class=\"format-grid__value\" type=\"bytes\" value=\"512\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">2 MB short</code>\n              <is-format class=\"format-grid__value\" type=\"bytes\" value=\"2097152\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">1.5 GB long</code>\n              <is-format class=\"format-grid__value\" type=\"bytes\" value=\"1610612736\" display=\"long\"></is-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "type-relative",
      "title": "type=\"relative\"",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">pasado</code>\n              <is-format class=\"format-grid__value\" type=\"relative\" date=\"2020-01-01T12:00:00\"></is-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">futuro</code>\n              <is-format class=\"format-grid__value\" type=\"relative\" date=\"2099-01-01T12:00:00\"></is-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "api",
      "title": "Referencia de atributos",
      "blocks": [
        {
          "kind": "table",
          "columns": ["Atributo", "Aplica a", "Descripción"],
          "rows": [
            ["<code>type</code>", "todos", "<code>date | number | bytes | relative | text</code>"],
            ["<code>value</code>", "todos", "dato a formatear (string | number)"],
            ["<code>pattern</code>", "number, date, text", "código Excel-like: <code>#,##0.00</code>, <code>0.00%</code>, <code>yyyy-mm-dd</code>, <code>@</code>, <code>Accounting</code>, <code># ?/?</code>…"],
            ["<code>format</code>", "number", "<code>decimal | currency | percent | unit | scientific | compact | integer | accounting</code>"],
            ["<code>currency</code>", "number", "ISO 4217 cuando currency/accounting / patrones <code>$</code>"],
            ["<code>locale</code>", "todos", "BCP 47; cae al <code>lang</code> del documento"],
            ["<code>case</code>", "text", "<code>upper | lower | title | capitalize</code>"],
            ["<code>truncate</code>", "text", "máximo de caracteres (añade …)"],
            ["<code>pad-start</code> / <code>pad-end</code> + <code>pad-length</code>", "text", "relleno tipo Excel personalizado"],
            ["<code>date</code>", "relative", "ISO o timestamp; en relative también vale <code>value</code>"],
            ["<code>unit</code> / <code>display</code> / <code>autofit</code>", "bytes", "unidad de entrada, short|long, autofit"],
            ["<code>style</code> / <code>numeric</code> / <code>sync</code>", "relative", "long|short|narrow · always|auto · re-render 30s"],
            ["<code>weekday era year month day hour minute second hour-format</code>", "date", "opciones de <code>Intl.DateTimeFormat</code> (si no hay <code>pattern</code>)"],
            ["<code>minimum-fraction-digits</code> / <code>maximum-fraction-digits</code>", "number", "decimales Intl (si no hay <code>pattern</code>)"]
          ]
        }
      ]
    }
  ]
