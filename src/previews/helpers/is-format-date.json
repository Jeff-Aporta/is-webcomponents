{
  "$schema": "is-preview/v1",
  "tag": "is-format-date",
  "category": "helpers",
  "title": "<is-format-date>",
  "titleHtml": true,
  "storageKey": "docs-is-format-date",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "<is-format-date>",
      "lede": "Formatea fechas con <code class=\"code\">Intl.DateTimeFormat</code>. Cualquier locale BCP&nbsp;47 vía <code class=\"code\">locale</code> (o <code class=\"code\">lang</code> del documento).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">lang del documento</span>\r\n          <p style=\"margin:0\"><is-format-date date=\"2026-07-30T17:30:00\"></is-format-date></p>"
        }
      ]
    },
    {
      "id": "inputs",
      "title": "Entradas de <code>date</code>",
      "titleHtml": true,
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">ISO datetime</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:00\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">YYYY-MM-DD</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30\" year=\"numeric\" month=\"short\" day=\"numeric\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">timestamp ms</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"1753896600000\" year=\"numeric\" month=\"short\" day=\"numeric\"></is-format-date>\r\n            </div>\r\n          </div>"
        }
      ]
    },
    {
      "id": "locales",
      "title": "Locales (Intl nativo)",
      "lede": "Se filtran con <code class=\"code\">Intl.DateTimeFormat.supportedLocalesOf()</code> y se etiquetan con <code class=\"code\">Intl.DisplayNames</code>. Cualquier BCP&nbsp;47 soportado por el motor funciona en <code class=\"code\">locale</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p class=\"demo-caption\" id=\"localeCaption\">Cargando locales…</p>\r\n          <div class=\"demo-locale-grid\" id=\"localeGrid\"></div>\r\n          <label class=\"demo-caption\" style=\"display:flex;align-items:center;gap:.5rem;margin-top:1rem\">\r\n            Probar locale\r\n            <input id=\"localeProbe\" type=\"text\" value=\"es-MX\" list=\"localeHints\"\r\n              style=\"font:inherit;padding:.35em .6em;border:1px solid var(--is-border);border-radius:var(--is-radius-sm);background:var(--is-control-bg);color:var(--is-text);max-width:10rem\" />\r\n            <datalist id=\"localeHints\"></datalist>\r\n            <span id=\"localeProbeOut\"></span>\r\n          </label>"
        },
        {
          "kind": "code",
          "code": "const asked = ['es','en','fr','de','ja','zh-CN','ar','pt-BR'];\r\nconst ok = Intl.DateTimeFormat.supportedLocalesOf(asked);\r\n// → p.ej. [\"es\",\"en\",\"fr\",\"de\",\"ja\",\"zh-CN\",\"ar\",\"pt-BR\"]\r\n\r\n<is-format-date locale=\"ja\" date=\"2026-07-30\" weekday=\"long\" month=\"long\" day=\"numeric\" year=\"numeric\"></is-format-date>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "parts",
      "title": "Partes de fecha",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">weekday long</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30\" weekday=\"long\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">month short</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30\" month=\"short\" day=\"numeric\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">month narrow · 2-digit</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30\" month=\"narrow\" day=\"numeric\" year=\"2-digit\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">era · long</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30\" era=\"short\" year=\"numeric\" month=\"long\" day=\"numeric\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">year 2-digit</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30\" year=\"2-digit\" month=\"numeric\" day=\"numeric\"></is-format-date>\r\n            </div>\r\n          </div>"
        }
      ]
    },
    {
      "id": "time",
      "title": "Hora · hour-format",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">24h</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:45\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">12h</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:45\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"12\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">auto</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:00\" hour=\"numeric\" minute=\"numeric\" hour-format=\"auto\"></is-format-date>\r\n            </div>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-format-date date=\"2026-07-30T17:30:00\" hour=\"numeric\" minute=\"numeric\" hour-format=\"24\"></is-format-date>\r\n<is-format-date date=\"2026-07-30T17:30:00\" hour=\"numeric\" minute=\"numeric\" hour-format=\"12\"></is-format-date>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "timezone",
      "title": "Zona horaria",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">UTC · short</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:00Z\" time-zone=\"UTC\" time-zone-name=\"short\"\r\n                year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"numeric\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">America/Bogota · long</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:00Z\" time-zone=\"America/Bogota\" time-zone-name=\"long\"\r\n                year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"numeric\" hour-format=\"24\"></is-format-date>\r\n            </div>\r\n            <div class=\"format-grid__row\">\r\n              <code class=\"format-grid__tag\">Europe/Madrid · shortOffset</code>\r\n              <is-format-date class=\"format-grid__value\" date=\"2026-07-30T17:30:00Z\" time-zone=\"Europe/Madrid\" time-zone-name=\"shortOffset\"\r\n                hour=\"numeric\" minute=\"numeric\" hour-format=\"24\"></is-format-date>\r\n            </div>\r\n          </div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
