{
  "$schema": "is-preview/v1",
  "tag": "is-format-date",
  "category": "helpers",
  "title": "<is-format-date>",
  "titleHtml": true,
  "storageKey": "docs-is-format-date",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "<is-format-date>",
      "lede": "Formatea fechas con <code class=\"code\">Intl.DateTimeFormat</code>. En esta página todos los ejemplos usan la <strong>hora actual</strong> y se actualizan cada 1&nbsp;s.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">ahora · en vivo</span>\n          <p style=\"margin:0;font-size:1.25rem;font-weight:600\">\n            <is-format-date hour=\"numeric\" minute=\"numeric\" second=\"numeric\" year=\"numeric\" month=\"short\" day=\"numeric\"></is-format-date>\n          </p>",
          "controls": [
            {
              "control": "text",
              "prop": "attr:hour",
              "label": "hour"
            },
            {
              "control": "text",
              "prop": "attr:minute",
              "label": "minute"
            },
            {
              "control": "text",
              "prop": "attr:second",
              "label": "second"
            },
            {
              "control": "select",
              "prop": "attr:year",
              "label": "year",
              "options": [
                "numeric",
                "2-digit"
              ]
            },
            {
              "control": "select",
              "prop": "attr:month",
              "label": "month",
              "options": [
                "short",
                "narrow",
                "long",
                "numeric"
              ]
            },
            {
              "control": "text",
              "prop": "attr:day",
              "label": "day"
            },
            {
              "control": "text",
              "prop": "attr:weekday",
              "label": "weekday"
            },
            {
              "control": "text",
              "prop": "attr:era",
              "label": "era"
            },
            {
              "control": "select",
              "prop": "attr:hour-format",
              "label": "hour-format",
              "options": [
                "24",
                "12",
                "auto"
              ]
            },
            {
              "control": "select",
              "prop": "attr:time-zone",
              "label": "time-zone",
              "options": [
                "UTC",
                "America/Bogota",
                "Europe/Madrid",
                "Asia/Tokyo"
              ]
            },
            {
              "control": "select",
              "prop": "attr:time-zone-name",
              "label": "time-zone-name",
              "options": [
                "short",
                "shortOffset"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inputs",
      "title": "Entradas de <code>date</code>",
      "titleHtml": true,
      "lede": "El behavior escribe el instante actual en <code class=\"code\">date</code> (ISO). Aquí se ve el mismo now con distintos atributos de formato.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">fecha + hora + s</code>\n              <is-format-date class=\"format-grid__value\" year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">solo día</code>\n              <is-format-date class=\"format-grid__value\" year=\"numeric\" month=\"short\" day=\"numeric\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">timestamp (attr)</code>\n              <is-format-date class=\"format-grid__value\" year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\"></is-format-date>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "locales",
      "title": "Locales (Intl nativo)",
      "lede": "Se filtran con <code class=\"code\">Intl.DateTimeFormat.supportedLocalesOf()</code>. Cada tarjeta muestra el <strong>ahora</strong> en ese locale (con segundos).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p class=\"demo-caption\" id=\"localeCaption\">Cargando locales…</p>\n          <div class=\"demo-locale-grid\" id=\"localeGrid\"></div>\n          <label class=\"demo-caption\" style=\"display:flex;align-items:center;gap:.5rem;margin-top:1rem;flex-wrap:wrap\">\n            Probar locale\n            <input id=\"localeProbe\" type=\"text\" value=\"es-MX\" list=\"localeHints\"\n              style=\"font:inherit;padding:.35em .6em;border:1px solid var(--is-border);border-radius:var(--is-radius-sm);background:var(--is-control-bg);color:var(--is-text);max-width:10rem\" />\n            <datalist id=\"localeHints\"></datalist>\n            <span id=\"localeProbeOut\"></span>\n          </label>"
        },
        {
          "kind": "code",
          "code": "<is-format-date\n  locale=\"ja\"\n  weekday=\"long\" month=\"long\" day=\"numeric\" year=\"numeric\"\n  hour=\"numeric\" minute=\"numeric\" second=\"numeric\"\n></is-format-date>\n<!-- en el preview, date se reescribe cada 1s con Date.now() -->",
          "lang": "html"
        }
      ]
    },
    {
      "id": "parts",
      "title": "Partes de fecha",
      "lede": "Mismo instante actual; cada fila muestra un subconjunto de campos Intl.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">weekday long</code>\n              <is-format-date class=\"format-grid__value\" weekday=\"long\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">month short</code>\n              <is-format-date class=\"format-grid__value\" month=\"short\" day=\"numeric\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">month narrow · 2-digit</code>\n              <is-format-date class=\"format-grid__value\" month=\"narrow\" day=\"numeric\" year=\"2-digit\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">era · short</code>\n              <is-format-date class=\"format-grid__value\" era=\"short\" year=\"numeric\" month=\"long\" day=\"numeric\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">year 2-digit</code>\n              <is-format-date class=\"format-grid__value\" year=\"2-digit\" month=\"numeric\" day=\"numeric\"></is-format-date>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "time",
      "title": "Hora · hour-format (en vivo)",
      "lede": "Segundos visibles: el valor cambia cada segundo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">24h</code>\n              <is-format-date class=\"format-grid__value\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">12h</code>\n              <is-format-date class=\"format-grid__value\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"12\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">auto</code>\n              <is-format-date class=\"format-grid__value\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"auto\"></is-format-date>\n            </div>\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-format-date hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\n<is-format-date hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"12\"></is-format-date>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "timezone",
      "title": "Zona horaria (en vivo)",
      "lede": "Mismo instante UTC actual proyectado en distintas zonas.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">UTC · short</code>\n              <is-format-date class=\"format-grid__value\" time-zone=\"UTC\" time-zone-name=\"short\"\n                year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">America/Bogota</code>\n              <is-format-date class=\"format-grid__value\" time-zone=\"America/Bogota\" time-zone-name=\"short\"\n                year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">Europe/Madrid</code>\n              <is-format-date class=\"format-grid__value\" time-zone=\"Europe/Madrid\" time-zone-name=\"shortOffset\"\n                hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">Asia/Tokyo</code>\n              <is-format-date class=\"format-grid__value\" time-zone=\"Asia/Tokyo\" time-zone-name=\"short\"\n                hour=\"numeric\" minute=\"numeric\" second=\"numeric\" hour-format=\"24\"></is-format-date>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default / notas"
          ],
          "rows": [
            [
              "<code>date</code>",
              "ISO, <code>YYYY-MM-DD</code> o timestamp ms — en este preview se reescribe cada 1&nbsp;s"
            ],
            [
              "<code>locale</code>",
              "BCP 47 · fallback <code>document.documentElement.lang</code>"
            ],
            [
              "<code>hour-format</code>",
              "auto · 12 · 24"
            ],
            [
              "<code>weekday</code> / <code>era</code> / <code>year</code> / <code>month</code> / <code>day</code>",
              "valores Intl"
            ],
            [
              "<code>hour</code> / <code>minute</code> / <code>second</code>",
              "valores Intl"
            ],
            [
              "<code>time-zone</code> / <code>time-zone-name</code>",
              "IANA + estilo de nombre"
            ]
          ]
        }
      ]
    }
  ]
}
