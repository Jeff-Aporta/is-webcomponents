      "id": "intro",
      "title": "<is-resize-observer>",
      "lede": "Observa hijos directos y emite <code class=\"code\">is-resize</code> con entries.\r\n          Alias de <code class=\"code\">&lt;is-observer type=\"resize\"&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">// arrastra la esquina</span>\r\n          <is-resize-observer id=\"ro\">\r\n            <div id=\"roBox\" style=\"resize:both;overflow:auto;min-width:120px;min-height:80px;max-width:100%;padding:1rem;background:var(--is-control-bg);border-radius:8px;border:1px dashed var(--is-control-border)\">\r\n              Arrastra la esquina para redimensionar\r\n            </div>\r\n          </is-resize-observer>\r\n          <div class=\"log\" id=\"roLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Dimensiones al redimensionar.</div></div>"
        }
      ]
    },
