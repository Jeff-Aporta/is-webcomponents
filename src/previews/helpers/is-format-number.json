            ["<code>currency</code>", "ISO 4217 (útil con type=currency)"],
            ["<code>minimum-fraction-digits</code>", "mínimo de decimales"],
            ["<code>maximum-fraction-digits</code>", "máximo de decimales"],
            ["<code>minimum-integer-digits</code>", "ceros a la izquierda vía Intl (1–21)"],
            ["<code>pad-start</code>", "carácter de relleno (default <code>0</code> si hay pad-length)"],
            ["<code>pad-length</code>", "longitud mínima del texto formateado (String.padStart)"]
          ]
        }
      ]
    }
  ]
