    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>is-sort</code>, <code>is-filter</code>, <code>is-quick-filter</code>,\r\n          <code>is-pagination</code>, <code>is-select</code>, <code>is-cell-select</code>,\r\n          <code>is-cell-click</code>, <code>is-cell-double-click</code>, <code>is-row-click</code>,\r\n          <code>is-row-double-click</code>, <code>is-edit-start</code>, <code>is-edit-stop</code>,\r\n          <code>is-row-update</code>, <code>is-column-resize</code>, <code>is-column-reorder</code>,\r\n          <code>is-column-visibility</code>, <code>is-column-pin</code>, <code>is-density</code>,\r\n          <code>is-detail-toggle</code>, <code>is-group-toggle</code>, <code>is-row-reorder</code>,\r\n          <code>is-copy</code>, <code>is-paste</code>, <code>is-undo</code>, <code>is-redo</code>,\r\n          <code>is-rows-scroll-end</code>, <code>is-export</code>.",
