      "lede": "Atributo <code class=\"code\">cover</code> muestra una imagen de cabecera.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-kanban>\r\n            <is-kanban-column title=\"Features\" accent=\"dodgerblue\">\r\n              <is-kanban-card heading=\"Versión 2.0\" tag=\"Release\" tag-color=\"brand\" cover=\"https://picsum.photos/id/1015/600/300\">\r\n                Lanzamiento de la nueva versión con is-stepper.\r\n              </is-kanban-card>\r\n              <is-kanban-card heading=\"Componentes nuevos\" tag=\"Component\" tag-color=\"success\" cover=\"https://picsum.photos/id/1025/600/300\">\r\n                8 componentes añadidos en la fase 8.\r\n              </is-kanban-card>\r\n            </is-kanban-column>\r\n          </is-kanban>"
        }
      ]
