  "sections": [
    {
      "id": "intro",
      "title": "<is-transfer>",
      "lede": "Doble lista de selección tipo Material/Ant. Mueve elementos entre\r\n          origen y destino con botones, click individual, filtro de búsqueda y\r\n          límite máximo configurable.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-transfer id=\"tr1\" source-title=\"Disponibles\" target-title=\"Asignados\" searchable>\r\n            <is-transfer-item value=\"a\">Alpha</is-transfer-item>\r\n            <is-transfer-item value=\"b\" selected>Beta</is-transfer-item>\r\n            <is-transfer-item value=\"c\">Gamma</is-transfer-item>\r\n            <is-transfer-item value=\"d\">Delta</is-transfer-item>\r\n            <is-transfer-item value=\"e\">Epsilon</is-transfer-item>\r\n            <is-transfer-item value=\"f\">Zeta</is-transfer-item>\r\n            <is-transfer-item value=\"g\">Eta</is-transfer-item>\r\n            <is-transfer-item value=\"h\">Theta</is-transfer-item>\r\n          </is-transfer>\r\n          <p id=\"tr1Log\">Seleccionados: <code class=\"code\">b</code></p>"
        },
        {
          "kind": "code",
          "code": "<is-transfer searchable>\n  <is-transfer-item value=\"a\">Alpha</is-transfer-item>\n  <is-transfer-item value=\"b\" selected>Beta</is-transfer-item>\n  <is-transfer-item value=\"c\">Gamma</is-transfer-item>\n  …\n</is-transfer>"
        }
      ]
    },
    {
      "id": "max-target",
      "title": "Límite en target",
      "lede": "Con <code class=\"code\">max-target=\"3\"</code> el botón hacia target se desactiva al llegar.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-transfer max-target=\"3\" source-title=\"Suscriptores\" target-title=\"Newsletter (máx 3)\" searchable>\r\n            <is-transfer-item value=\"a\">Alice</is-transfer-item>\r\n            <is-transfer-item value=\"b\">Bob</is-transfer-item>\r\n            <is-transfer-item value=\"c\" selected>Carol</is-transfer-item>\r\n            <is-transfer-item value=\"d\">David</is-transfer-item>\r\n            <is-transfer-item value=\"e\">Eve</is-transfer-item>\r\n            <is-transfer-item value=\"f\">Frank</is-transfer-item>\r\n          </is-transfer>"
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Disabled",
      "lede": "Con <code class=\"code\">disabled</code> en algunos items.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-transfer source-title=\"Permisos\" target-title=\"Asignados\">\r\n            <is-transfer-item value=\"read\">read</is-transfer-item>\r\n            <is-transfer-item value=\"write\" selected>write</is-transfer-item>\r\n            <is-transfer-item value=\"delete\" disabled>delete</is-transfer-item>\r\n            <is-transfer-item value=\"admin\">admin</is-transfer-item>\r\n          </is-transfer>"
        }
      ]
    },
