{
  "$schema": "is-preview/v1",
  "tag": "is-checkbox",
  "category": "forms",
  "title": "<is-checkbox>",
  "titleHtml": true,
  "styles": ".stack { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }\r\n    .inline { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }\r\n    .placements { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 2rem; }",
  "storageKey": "docs-is-checkbox",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "<is-checkbox>",
      "lede": "Casilla <em>form-associated</em> con paridad funcional con el\r\n          <a href=\"https://mui.com/material-ui/react-checkbox/\" target=\"_blank\" rel=\"noreferrer\">Checkbox de MUI</a>:\r\n          entra en <code class=\"code\">FormData</code> y en la validación nativa del <code class=\"code\">&lt;form&gt;</code>\r\n          sin input oculto, con color por <code class=\"code\">variant</code>, posición de etiqueta, iconos propios y\r\n          estado de error.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <is-checkbox name=\"a\" checked>Marcada</is-checkbox>\r\n            <is-checkbox name=\"b\">Sin marcar</is-checkbox>\r\n            <is-checkbox name=\"c\" indeterminate>Indeterminada</is-checkbox>\r\n            <is-checkbox name=\"d\" checked disabled>Deshabilitada</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">\r\n          El estado indeterminado se limpia en el primer clic, igual que una casilla nativa.\r\n          Al pasar el puntero o al enfocar aparece el halo circular alrededor del control.\r\n        </p>"
        }
      ]
    },
    {
      "id": "color",
      "title": "Color",
      "lede": "<code class=\"code\">variant</code> equivale a la prop <code class=\"code\">color</code> de MUI: redefine el\r\n          acento del control marcado, del halo y del anillo de foco.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <is-checkbox checked>brand (default)</is-checkbox>\r\n            <is-checkbox color=\"neutral\" checked>neutral</is-checkbox>\r\n            <is-checkbox color=\"success\" checked>success</is-checkbox>\r\n            <is-checkbox color=\"warning\" checked>warning</is-checkbox>\r\n            <is-checkbox color=\"danger\" checked>danger</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-checkbox color=\"success\" checked>success</is-checkbox>"
        }
      ]
    },
    {
      "id": "label-placement",
      "title": "Posición de la etiqueta",
      "lede": "<code class=\"code\">label-placement</code> equivale a <code class=\"code\">labelPlacement</code> del\r\n          <code class=\"code\">FormControlLabel</code> de MUI.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"placements\">\r\n            <is-checkbox checked>end (default)</is-checkbox>\r\n            <is-checkbox label-placement=\"start\" checked>start</is-checkbox>\r\n            <is-checkbox label-placement=\"top\" checked>top</is-checkbox>\r\n            <is-checkbox label-placement=\"bottom\" checked>bottom</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-checkbox label-placement=\"start\" checked>start</is-checkbox>\n<is-checkbox label-placement=\"top\" checked>top</is-checkbox>"
        }
      ]
    },
    {
      "id": "groups",
      "title": "Grupos",
      "lede": "No hay componente de grupo: <code class=\"code\">is-checkbox</code> es <code class=\"code\">inline-flex</code>\r\n          y se apila con el <code class=\"code\">display:flex</code> del contenedor. En columna, alinea\r\n          <code class=\"code\">align-items:flex-start</code> para que el halo no recorte.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <is-checkbox name=\"g1\" value=\"gilad\" checked>Gilad Gray</is-checkbox>\r\n            <is-checkbox name=\"g2\" value=\"jason\" checked>Jason Killian</is-checkbox>\r\n            <is-checkbox name=\"g3\" value=\"antoine\">Antoine Llorca</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <is-checkbox name=\"r1\" value=\"lun\" checked>Lun</is-checkbox>\r\n            <is-checkbox name=\"r2\" value=\"mar\" checked>Mar</is-checkbox>\r\n            <is-checkbox name=\"r3\" value=\"mie\">Mié</is-checkbox>\r\n            <is-checkbox name=\"r4\" value=\"jue\">Jue</is-checkbox>\r\n            <is-checkbox name=\"r5\" value=\"vie\" checked>Vie</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<div style=\"display:flex;flex-direction:column;align-items:flex-start;gap:.7rem\">\n  <is-checkbox name=\"g1\" value=\"gilad\" checked>Gilad Gray</is-checkbox>\n  <is-checkbox name=\"g2\" value=\"jason\" checked>Jason Killian</is-checkbox>\n</div>"
        },
        {
          "kind": "html",
          "html": "<h3>Padre indeterminado</h3>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">Patrón clásico: la casilla padre refleja el estado de los hijos.</p>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <is-checkbox id=\"parentBox\">Todos los permisos</is-checkbox>\r\n            <div class=\"stack\" style=\"padding-left:1.6rem\">\r\n              <is-checkbox class=\"childBox\" checked>Lectura</is-checkbox>\r\n              <is-checkbox class=\"childBox\">Escritura</is-checkbox>\r\n              <is-checkbox class=\"childBox\">Borrado</is-checkbox>\r\n            </div>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "const all = children.every(c => c.checked);\nparent.checked = all;\nparent.indeterminate = !all && children.some(c => c.checked);"
        }
      ]
    },
    {
      "id": "icons",
      "title": "Iconos personalizados",
      "lede": "<code class=\"code\">icon</code>, <code class=\"code\">checked-icon</code> e\r\n          <code class=\"code\">indeterminate-icon</code> reciben nombres de <code class=\"code\">is-icon</code>\r\n          (Iconify). Al definir <code class=\"code\">icon</code> el control pierde la caja y queda solo el glifo,\r\n          como el ejemplo de iconos de MUI. Sin estos atributos el <em>look</em> por defecto es el check dibujado.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <is-checkbox icon=\"mdi:heart-outline\" checked-icon=\"mdi:heart\" color=\"danger\" checked>Favorito</is-checkbox>\r\n            <is-checkbox icon=\"mdi:bookmark-outline\" checked-icon=\"mdi:bookmark\">Guardar</is-checkbox>\r\n            <is-checkbox icon=\"mdi:star-outline\" checked-icon=\"mdi:star\" color=\"warning\" checked>Destacar</is-checkbox>\r\n            <is-checkbox checked-icon=\"mdi:check-bold\" indeterminate-icon=\"mdi:dots-horizontal\" indeterminate>Con caja</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-checkbox icon=\"mdi:heart-outline\" checked-icon=\"mdi:heart\" color=\"danger\" checked>\n  Favorito\n</is-checkbox>"
        }
      ]
    },
    {
      "id": "readonly",
      "title": "Solo lectura y deshabilitada",
      "lede": "<code class=\"code\">readonly</code> bloquea el cambio pero mantiene el valor en el formulario y el foco\r\n          navegable con <code class=\"code\">Tab</code>. <code class=\"code\">disabled</code> saca el control del orden\r\n          de tabulación y no aporta entrada al <code class=\"code\">FormData</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <is-checkbox name=\"ro1\" checked readonly>Solo lectura (marcada)</is-checkbox>\r\n            <is-checkbox name=\"ro2\" readonly>Solo lectura (sin marcar)</is-checkbox>\r\n            <is-checkbox name=\"di1\" checked disabled>Deshabilitada</is-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-checkbox name=\"ro1\" checked readonly>Solo lectura</is-checkbox>"
        }
      ]
    },
    {
      "id": "error",
      "title": "Error y texto de ayuda",
      "lede": "<code class=\"code\">hint</code> pinta un texto bajo el control (atributo o slot homónimo).\r\n          <code class=\"code\">error</code> tiñe control y ayuda con el color de peligro y marca\r\n          <code class=\"code\">aria-invalid</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <is-checkbox hint=\"Puedes cambiarlo más tarde en Ajustes.\">Recibir novedades</is-checkbox>\r\n            <is-checkbox error hint=\"Debes aceptar los términos para continuar.\" required>Acepto los términos</is-checkbox>\r\n            <is-checkbox error checked>\r\n              Consentimiento revocado\r\n              <span slot=\"hint\">El texto de ayuda también admite un <b>slot</b>.</span>\r\n            </is-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<is-checkbox error hint=\"Debes aceptar los términos para continuar.\" required>\n  Acepto los términos\n</is-checkbox>"
        }
      ]
    },
    {
      "id": "form",
      "title": "Dentro de un formulario",
      "lede": "Sin marcar no aporta entrada al <code class=\"code\">FormData</code>. Con\r\n          <code class=\"code\">required</code> reporta <code class=\"code\">valueMissing</code> y bloquea el envío.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<form id=\"demoForm\">\r\n            <div class=\"stack\">\r\n              <is-checkbox name=\"terminos\" value=\"si\" required>Acepto los términos (obligatorio)</is-checkbox>\r\n              <is-checkbox name=\"boletin\" value=\"semanal\">Recibir boletín</is-checkbox>\r\n              <is-checkbox name=\"archivado\" value=\"si\" checked readonly hint=\"Fijado por la política de la empresa.\">Archivar copia</is-checkbox>\r\n              <div class=\"inline\" style=\"gap:.5rem\">\r\n                <is-button color=\"brand\" id=\"btnSend\">Enviar</is-button>\r\n                <is-button variant=\"outlined\" id=\"btnReset\">Reset</is-button>\r\n              </div>\r\n            </div>\r\n          </form>"
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"formLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Envía el formulario para ver el FormData.</div></div>"
        },
        {
          "kind": "code",
          "code": "<is-checkbox name=\"terminos\" value=\"si\" required>\n  Acepto los términos\n</is-checkbox>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala por contexto",
      "lede": "Sin atributo <code class=\"code\">size</code>: el control mide <code class=\"code\">1.15em</code> y hereda el\r\n          <code class=\"code\">font-size</code> del contenedor.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <span style=\"font-size:.8rem\"><is-checkbox checked>0.8rem</is-checkbox></span>\r\n            <span style=\"font-size:1rem\"><is-checkbox checked>1rem</is-checkbox></span>\r\n            <span style=\"font-size:1.35rem\"><is-checkbox checked>1.35rem</is-checkbox></span>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<span style=\"font-size:1.35rem\"><is-checkbox checked>Grande</is-checkbox></span>"
        }
      ]
    },
    {
      "id": "keyboard",
      "title": "Teclado",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Tecla",
            "Acción"
          ],
          "rows": [
            [
              "<code>Tab</code>",
              "enfoca la casilla (también con <code>readonly</code>; no con <code>disabled</code>)"
            ],
            [
              "<code>Espacio</code>",
              "alterna marcada / sin marcar y emite <code>is-change</code>"
            ]
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
