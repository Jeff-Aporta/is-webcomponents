    {
      "id": "intro",
      "title": "<is-time-clock>",
      "lede": "Reloj analógico (TimeClock de MUI X). Arrastra la manecilla, haz clic o usa el teclado. Al soltar avanza de horas a minutos.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-time-clock id=\"tc\" value=\"09:30\" ampm locale=\"en-US\"></is-time-clock>\r\n          <is-time-clock value=\"14:15\" hour24 locale=\"es\"></is-time-clock>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\" style=\"font-family:var(--is-mono);font-size:.85em\"></p>"
        }
      ]
    },
    {
      "id": "digital",
      "title": "<is-digital-clock>",
      "lede": "Lista (DigitalClock) o columnas (MultiSectionDigitalClock). <code>step</code> controla el intervalo de la lista; <code>minutes-step</code> el de las columnas.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div>\r\n            <div class=\"demo-label\">lista · step=30</div>\r\n            <is-digital-clock id=\"dc\" value=\"09:30\" locale=\"es\" step=\"30\"></is-digital-clock>\r\n          </div>\r\n          <div>\r\n            <div class=\"demo-label\">columnas · ampm</div>\r\n            <is-digital-clock layout=\"sections\" value=\"09:30\" ampm locale=\"en-US\"></is-digital-clock>\r\n          </div>\r\n          <div>\r\n            <div class=\"demo-label\">columnas · 24 h + segundos</div>\r\n            <is-digital-clock layout=\"sections\" value=\"14:15:00\" hour24 seconds locale=\"es\"></is-digital-clock>\r\n          </div>"
        }
      ]
    },
    {
      "id": "limits",
      "title": "Límites",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-time-clock value=\"10:00\" ampm min-time=\"08:00\" max-time=\"18:00\" locale=\"en-US\"></is-time-clock>\r\n          <is-digital-clock layout=\"sections\" value=\"10:00\" hour24 min-time=\"08:00\" max-time=\"18:00\" skip-disabled locale=\"es\"></is-digital-clock>"
        }
      ]
    },
