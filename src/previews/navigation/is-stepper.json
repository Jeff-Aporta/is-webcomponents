          "kind": "demo",
          "html": "<is-stepper id=\"wizard\" active=\"0\">\r\n            <is-stepper-step label=\"Paso 1\"></is-stepper-step>\r\n            <is-stepper-step label=\"Paso 2\"></is-stepper-step>\r\n            <is-stepper-step label=\"Paso 3\"></is-stepper-step>\r\n          </is-stepper>\r\n\r\n          <div class=\"wizard-card\" id=\"wizardBody\">\r\n            <h4>Paso 1: Tu nombre</h4>\r\n            <p>Introduce tu nombre completo.</p>\r\n          </div>"
        }
