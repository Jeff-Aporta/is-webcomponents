  "sections": [
    {
      "id": "intro",
      "title": "<is-stepper>",
      "lede": "Indicador de flujo por pasos. Ideal para wizards y formularios multipaso.\r\n          Soporta orientación horizontal y vertical, variantes visualmente\r\n          distintas, iconos por slot, descripción y manejo de errores.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-stepper id=\"stepper1\" active=\"1\">\r\n            <is-stepper-step label=\"Cuenta\" description=\"email.verificado@ejemplo.com\" icon=\"mdi:account\"></is-stepper-step>\r\n            <is-stepper-step label=\"Perfil\" description=\"Completa tus datos\" icon=\"mdi:card-account-details\"></is-stepper-step>\r\n            <is-stepper-step label=\"Confirmar\" description=\"Revisa y envía\" icon=\"mdi:check-circle\"></is-stepper-step>\r\n          </is-stepper>\r\n\r\n          <div style=\"display:flex;gap:0.5rem;margin-top:1rem;justify-content:flex-end\">\r\n            <is-button id=\"prevBtn\" color=\"neutral\" variant=\"outlined\">Atrás</is-button>\r\n            <is-button id=\"nextBtn\" color=\"brand\">Siguiente</is-button>\r\n          </div>\r\n          <p id=\"stepLog\" class=\"lede\">Active: <code class=\"code\">1</code></p>"
        },
        {
          "kind": "code",
          "code": "<span class=\"tag\"><is-stepper</span> <span class=\"attr\">active</span>=<span class=\"val\">\"1\"</span><span class=\"tag\">></span>\r\n  <span class=\"tag\"><is-stepper-step</span> <span class=\"attr\">label</span>=<span class=\"val\">\"Cuenta\"</span> <span class=\"attr\">icon</span>=<span class=\"val\">\"mdi:account\"</span><span class=\"tag\">></span><span class=\"tag\"></is-stepper-step></span>\r\n  <span class=\"tag\"><is-stepper-step</span> <span class=\"attr\">label</span>=<span class=\"val\">\"Perfil\"</span> <span class=\"attr\">icon</span>=<span class=\"val\">\"mdi:card-account-details\"</span><span class=\"tag\">></span><span class=\"tag\"></is-stepper-step></span>\r\n  <span class=\"tag\"><is-stepper-step</span> <span class=\"attr\">label</span>=<span class=\"val\">\"Confirmar\"</span> <span class=\"attr\">icon</span>=<span class=\"val\">\"mdi:check-circle\"</span><span class=\"tag\">></span><span class=\"tag\"></is-stepper-step></span>\r\n<span class=\"tag\"></is-stepper></span>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "vertical",
      "title": "Vertical",
      "lede": "Con <code class=\"code\">orientation=\"vertical\"</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-stepper id=\"stepper2\" orientation=\"vertical\" active=\"1\">\r\n            <is-stepper-step label=\"Datos personales\" description=\"Nombre, email, fecha de nacimiento\"></is-stepper-step>\r\n            <is-stepper-step label=\"Dirección\" description=\"Calle, ciudad, código postal\"></is-stepper-step>\r\n            <is-stepper-step label=\"Pago\" description=\"Método de pago preferido\"></is-stepper-step>\r\n            <is-stepper-step label=\"Revisar\" description=\"Confirma antes de enviar\"></is-stepper-step>\r\n          </is-stepper>"
        }
      ]
    },
    {
      "id": "error",
      "title": "Estados de error",
      "lede": "Con <code class=\"code\">error</code> en el step correspondiente.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<is-stepper active=\"2\">\r\n            <is-stepper-step label=\"Datos\"></is-stepper-step>\r\n            <is-stepper-step label=\"Validación\" error></is-stepper-step>\r\n            <is-stepper-step label=\"Pago\"></is-stepper-step>\r\n          </is-stepper>"
        }
      ]
    },
