{
  "$schema": "iswc-preview/v1",
  "tag": "icons",
  "category": "",
  "title": "Mapa",
  "titleHtml": false,
  "storageKey": "docs-icons-map",
  "mainClass": "icons-main",
  "wrapperClass": "icons-map",
  "hasBehavior": true,
  "withoutToc": true,
  "sections": [
    {
      "id": "map",
      "title": "Mapa de componentes",
      "hideTitle": true,
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<header class=\"imap__hero\">",
            "  <p class=\"imap__kicker\">Catálogo</p>",
            "  <h1 class=\"imap__title\">Mapa de componentes</h1>",
            "  <p class=\"imap__lede\">Todas las categorías y tags del kit, en grid — mismo orden que el nav izquierdo. Clic abre el preview.</p>",
            "  <iswc-input id=\"imapFilter\" type=\"search\" clearable placeholder=\"Filtrar por nombre o tag…\" aria-label=\"Filtrar componentes\"></iswc-input>",
            "</header>",
            "<div id=\"iconsMap\" class=\"imap\" aria-label=\"Mapa de categorías\"></div>"
          ]
        }
      ]
    }
  ],
  "styles": [
    ".icons-main {",
    "  display: block;",
    "  height: 100%;",
    "  overflow: auto;",
    "  padding: 0;",
    "  background: var(--iswc-bg);",
    "}",
    ".icons-map {",
    "  max-width: 72rem;",
    "  margin: 0 auto;",
    "  padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem) 3rem;",
    "  box-sizing: border-box;",
    "}",
    ".imap__hero {",
    "  display: grid;",
    "  gap: 0.65rem;",
    "  margin-bottom: 1.75rem;",
    "  max-width: 36rem;",
    "}",
    ".imap__kicker {",
    "  margin: 0;",
    "  font-size: 0.7rem;",
    "  font-weight: 700;",
    "  letter-spacing: 0.12em;",
    "  text-transform: uppercase;",
    "  color: var(--iswc-accent);",
    "}",
    ".imap__title {",
    "  margin: 0;",
    "  font-size: clamp(1.6rem, 3vw, 2.2rem);",
    "  font-weight: 800;",
    "  letter-spacing: -0.03em;",
    "  color: var(--iswc-text);",
    "}",
    ".imap__lede {",
    "  margin: 0;",
    "  font-size: 0.95rem;",
    "  line-height: 1.55;",
    "  color: var(--iswc-text-soft);",
    "}",
    ".imap {",
    "  display: flex;",
    "  flex-direction: column;",
    "  gap: 1.75rem;",
    "}",
    ".imap__cat {",
    "  display: grid;",
    "  gap: 0.75rem;",
    "}",
    ".imap__cat-head {",
    "  display: flex;",
    "  align-items: center;",
    "  gap: 0.55rem;",
    "  margin: 0;",
    "  padding-bottom: 0.45rem;",
    "  border-bottom: 1px solid var(--iswc-border);",
    "  font-size: 0.78rem;",
    "  font-weight: 700;",
    "  letter-spacing: 0.06em;",
    "  text-transform: uppercase;",
    "  color: var(--iswc-text-soft);",
    "}",
    ".imap__cat-head iswc-icon {",
    "  color: var(--iswc-accent);",
    "  font-size: 1.1rem;",
    "}",
    ".imap__cat-count {",
    "  margin-left: auto;",
    "  font-variant-numeric: tabular-nums;",
    "  opacity: 0.75;",
    "  font-weight: 600;",
    "  letter-spacing: 0;",
    "  text-transform: none;",
    "}",
    ".imap__grid {",
    "  display: grid;",
    "  grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));",
    "  gap: 0.65rem;",
    "}",
    ".imap__card {",
    "  appearance: none;",
    "  display: grid;",
    "  grid-template-rows: auto auto 1fr;",
    "  justify-items: start;",
    "  gap: 0.35rem;",
    "  min-height: 6.2rem;",
    "  padding: 0.85rem 0.8rem;",
    "  border-radius: var(--iswc-radius, 0.65rem);",
    "  border: 1px solid var(--iswc-border);",
    "  background: var(--iswc-bg-elev, var(--iswc-bg));",
    "  color: var(--iswc-text);",
    "  text-align: left;",
    "  cursor: pointer;",
    "  box-shadow: var(--iswc-shadow, none);",
    "  transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;",
    "}",
    ".imap__card:hover,",
    ".imap__card:focus-visible {",
    "  border-color: color-mix(in srgb, var(--iswc-accent) 55%, var(--iswc-border));",
    "  transform: translateY(-2px);",
    "  outline: none;",
    "  box-shadow: 0 10px 24px rgb(0 0 0 / 14%);",
    "}",
    ".imap__card iswc-icon {",
    "  font-size: 1.45rem;",
    "  color: var(--iswc-accent);",
    "}",
    ".imap__card-title {",
    "  margin: 0;",
    "  font-size: 0.82rem;",
    "  font-weight: 700;",
    "  line-height: 1.25;",
    "  color: var(--iswc-text);",
    "}",
    ".imap__card-tag {",
    "  margin: 0;",
    "  font-family: var(--iswc-mono, ui-monospace, Consolas, monospace);",
    "  font-size: 0.62rem;",
    "  color: var(--iswc-text-soft);",
    "  word-break: break-all;",
    "}",
    ".imap__empty {",
    "  margin: 1rem 0 0;",
    "  color: var(--iswc-text-soft);",
    "  font-size: 0.9rem;",
    "}",
    ".imap__cat[hidden],",
    ".imap__card[hidden] { display: none !important; }",
    ""
  ]
}
