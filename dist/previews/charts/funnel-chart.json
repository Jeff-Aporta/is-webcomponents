{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-funnel-chart",
  "category": "data-viz",
  "title": "&lt;iswc-funnel-chart&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-funnel-chart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Embudo para seguir la conversión entre etapas de un proceso.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-funnel-chart open-on-click>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Visitas\", \"Registros\", \"Cotizaciones\", \"Cierres\"],",
            "                  \"datasets\": [{ \"label\": \"Conversión\", \"data\": [4200, 1800, 640, 210] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-funnel-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "text",
              "prop": "attr:label",
              "label": "label"
            },
            {
              "control": "select",
              "prop": "attr:legend-position",
              "label": "legend-position",
              "options": [
                "top",
                "bottom",
                "start",
                "end"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:without-legend",
              "label": "without-legend"
            },
            {
              "control": "boolean",
              "prop": "attr:without-tooltip",
              "label": "without-tooltip"
            },
            {
              "control": "boolean",
              "prop": "attr:without-animation",
              "label": "without-animation"
            }
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Embudo para seguir la conversión entre etapas de un proceso."
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-funnel-chart open-on-click>",
          "            <script type=\"application/json\">",
          "              {",
          "                \"data\": {",
          "                  \"labels\": [\"Visitas\", \"Registros\", \"Cotizaciones\", \"Cierres\"],",
          "                  \"datasets\": [{ \"label\": \"Conversión\", \"data\": [4200, 1800, 640, 210] }]",
          "                }",
          "              }",
          "            </script>",
          "          </iswc-funnel-chart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  },
  "description": "Gráfica de embudo para etapas sucesivas de un proceso y su caída entre una y otra."
}
