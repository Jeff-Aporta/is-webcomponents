{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-scatter-chart",
  "category": "data-viz",
  "title": "Scatter Chart",
  "titleHtml": false,
  "styles": [
    ".demo--chart { height: 22rem; display: flex; flex-direction: column; }",
    "    .demo--chart-sm { height: 18rem; }"
  ],
  "storageKey": "docs-iswc-scatter-chart",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Scatter Chart",
      "lede": "<code class=\"code\">&lt;iswc-scatter-chart&gt;</code>",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Muestra la relación entre dos variables con puntos en una rejilla.",
            "          Ideal para correlaciones, clusters y outliers.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-scatter-chart open-on-click label=\"Measurements\" x-label=\"Height (cm)\" y-label=\"Weight (kg)\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"datasets\": [{",
            "                    \"label\": \"Measurements\",",
            "                    \"data\": [",
            "                      { \"x\": 158, \"y\": 55 }, { \"x\": 163, \"y\": 62 }, { \"x\": 165, \"y\": 68 },",
            "                      { \"x\": 170, \"y\": 72 }, { \"x\": 173, \"y\": 75 }, { \"x\": 175, \"y\": 80 },",
            "                      { \"x\": 178, \"y\": 78 }, { \"x\": 180, \"y\": 85 }, { \"x\": 183, \"y\": 82 },",
            "                      { \"x\": 188, \"y\": 90 }",
            "                    ]",
            "                  }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-scatter-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Measurements",
                "Students",
                "Study methods",
                "Ice cream"
              ]
            },
            {
              "control": "select",
              "prop": "attr:x-label",
              "label": "x-label",
              "options": [
                "Height (cm)",
                "Hours studied",
                "Hours",
                "Temp (°F)"
              ]
            },
            {
              "control": "select",
              "prop": "attr:y-label",
              "label": "y-label",
              "options": [
                "Weight (kg)",
                "Score",
                "Sales"
              ]
            },
            {
              "control": "text",
              "prop": "attr:grid",
              "label": "grid"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" style=\"margin-top:1rem\">A diferencia de barras/líneas, cada punto es un objeto <code class=\"code\">{ x, y }</code>.</p>"
        }
      ]
    },
    {
      "id": "json",
      "title": "Datos con JSON",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-scatter-chart open-on-click label=\"Students\" x-label=\"Hours studied\" y-label=\"Score\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"datasets\": [{",
            "                    \"label\": \"Students\",",
            "                    \"data\": [",
            "                      { \"x\": 2, \"y\": 65 }, { \"x\": 3, \"y\": 72 }, { \"x\": 4, \"y\": 78 },",
            "                      { \"x\": 5, \"y\": 82 }, { \"x\": 6, \"y\": 88 }, { \"x\": 7, \"y\": 85 },",
            "                      { \"x\": 8, \"y\": 92 }, { \"x\": 9, \"y\": 95 }",
            "                    ]",
            "                  }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-scatter-chart>"
          ]
        }
      ]
    },
    {
      "id": "js",
      "title": "Datos con JavaScript",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scatter-chart open-on-click id=\"scatterJs\" label=\"Students\" x-label=\"Hours\" y-label=\"Score\"></iswc-scatter-chart>"
        }
      ]
    },
    {
      "id": "multi",
      "title": "Múltiples datasets",
      "lede": "Compara grupos; cada dataset recibe su color de la serie fija.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-scatter-chart open-on-click id=\"scatterMulti\" label=\"Study methods\" x-label=\"Hours\" y-label=\"Score\"></iswc-scatter-chart>"
        }
      ]
    },
    {
      "id": "options",
      "title": "Grid y ejes",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-scatter-chart open-on-click grid=\"y\" x-label=\"Temp (°F)\" y-label=\"Sales\" label=\"Ice cream\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"datasets\": [{",
            "                    \"label\": \"Ice cream sales\",",
            "                    \"data\": [",
            "                      { \"x\": 68, \"y\": 120 }, { \"x\": 74, \"y\": 175 }, { \"x\": 79, \"y\": 210 },",
            "                      { \"x\": 84, \"y\": 280 }, { \"x\": 89, \"y\": 340 }, { \"x\": 95, \"y\": 410 }",
            "                    ]",
            "                  }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-scatter-chart>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / prop",
            "Notas"
          ],
          "rows": [
            [
              "<code>type</code>",
              "Fijo <code>scatter</code>"
            ],
            [
              "Puntos",
              "<code>{ x, y }</code> (opcional: props extra para tooltips)"
            ],
            [
              "<code>x-label</code> / <code>y-label</code> / <code>grid</code>",
              "Ejes"
            ],
            [
              "<code>config</code>",
              "Objeto Chart.js"
            ],
            [
              "<code>--fill-color-*</code> / <code>--border-color-*</code> / <code>--point-radius</code>",
              "Serie fija"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "<code class=\"code\">&lt;iswc-scatter-chart&gt;</code>"
      },
      "atributos": {
        "table": [
          {
            "name": "<code>type</code>",
            "desc": "Fijo <code>scatter</code>"
          },
          {
            "name": "Puntos",
            "desc": "<code>{ x, y }</code> (opcional: props extra para tooltips)"
          },
          {
            "name": "<code>x-label</code> / <code>y-label</code> / <code>grid</code>",
            "desc": "Ejes"
          },
          {
            "name": "<code>config</code>",
            "desc": "Objeto Chart.js"
          },
          {
            "name": "<code>--fill-color-*</code> / <code>--border-color-*</code> / <code>--point-radius</code>",
            "desc": "Serie fija"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-scatter-chart open-on-click label=\"Measurements\" x-label=\"Height (cm)\" y-label=\"Weight (kg)\">",
          "            <script type=\"application/json\">",
          "              {",
          "                \"data\": {",
          "                  \"datasets\": [{",
          "                    \"label\": \"Measurements\",",
          "                    \"data\": [",
          "                      { \"x\": 158, \"y\": 55 }, { \"x\": 163, \"y\": 62 }, { \"x\": 165, \"y\": 68 },",
          "                      { \"x\": 170, \"y\": 72 }, { \"x\": 173, \"y\": 75 }, { \"x\": 175, \"y\": 80 },",
          "                      { \"x\": 178, \"y\": 78 }, { \"x\": 180, \"y\": 85 }, { \"x\": 183, \"y\": 82 },",
          "                      { \"x\": 188, \"y\": 90 }",
          "                    ]",
          "                  }]",
          "                }",
          "              }",
          "            </script>",
          "          </iswc-scatter-chart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
