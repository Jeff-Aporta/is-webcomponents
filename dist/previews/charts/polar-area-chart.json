{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-polar-area-chart",
  "category": "data-viz",
  "title": "&lt;iswc-polar-area-chart&gt;",
  "titleHtml": false,
  "styles": [
    ".demo--chart {",
    "      height: 22rem;",
    "      display: flex;",
    "      flex-direction: column;",
    "    }",
    "    .demo--chart-sm { height: 18rem; }",
    "    .polar-theme-demo {",
    "      --fill-color-1: color-mix(in srgb, #38bdf8 72%, transparent);",
    "      --fill-color-2: color-mix(in srgb, #a78bfa 72%, transparent);",
    "      --fill-color-3: color-mix(in srgb, #34d399 72%, transparent);",
    "      --fill-color-4: color-mix(in srgb, #fbbf24 72%, transparent);",
    "      --fill-color-5: color-mix(in srgb, #f472b6 72%, transparent);",
    "      --border-color-1: #38bdf8;",
    "      --border-color-2: #a78bfa;",
    "      --border-color-3: #34d399;",
    "      --border-color-4: #fbbf24;",
    "      --border-color-5: #f472b6;",
    "    }"
  ],
  "storageKey": "docs-iswc-polar-area-chart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Chart.js <code class=\"code\">polarArea</code> themed. Ángulos iguales por categoría;",
        "          el <strong>radio</strong> refleja la magnitud (a diferencia de un pie, donde el tamaño",
        "          es el ángulo). Ideal para comparar escalas en el mismo “reloj”."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-polar-area-chart open-on-click label=\"Mix energético (GW)\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Solar\", \"Eólica\", \"Hidro\", \"Nuclear\", \"Gas\", \"Carbón\"],",
            "                  \"datasets\": [{ \"label\": \"GW instalados\", \"data\": [85, 72, 110, 95, 58, 40] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-polar-area-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Mix energético (GW)",
                "Canales de tráfico",
                "NPS por segmento",
                "Sin animación",
                "Paleta custom"
              ]
            },
            {
              "control": "text",
              "prop": "attr:legend-position",
              "label": "legend-position"
            },
            {
              "control": "boolean",
              "prop": "attr:without-legend",
              "label": "without-legend"
            },
            {
              "control": "boolean",
              "prop": "attr:without-animation",
              "label": "without-animation"
            }
          ]
        }
      ]
    },
    {
      "id": "datos",
      "title": "Datos",
      "lede": "JSON hijo <code class=\"code\">application/json</code> o propiedad <code class=\"code\">config</code>. El <code class=\"code\">type</code> queda fijo en <code class=\"code\">polarArea</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-polar-area-chart open-on-click label=\"Canales de tráfico\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Orgánico\", \"Directo\", \"Social\", \"Email\", \"Paid\"],",
            "                  \"datasets\": [{ \"label\": \"Sesiones\", \"data\": [4200, 3100, 1800, 950, 2400] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-polar-area-chart>"
          ]
        }
      ]
    },
    {
      "id": "opciones",
      "title": "Opciones",
      "lede": "Misma API de presentación que <code class=\"code\">iswc-chart</code>: leyenda, animación, título.",
      "blocks": [
        {
          "kind": "html",
          "html": "<span class=\"demo-label\">legend-position=\"end\"</span>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-polar-area-chart open-on-click label=\"NPS por segmento\" legend-position=\"end\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Promotores\", \"Pasivos\", \"Detractores\"],",
            "                  \"datasets\": [{ \"label\": \"%\", \"data\": [62, 24, 14] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-polar-area-chart>"
          ]
        },
        {
          "kind": "html",
          "html": "<span class=\"demo-label\">without-legend</span>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-polar-area-chart open-on-click without-legend>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"A\", \"B\", \"C\", \"D\"],",
            "                  \"datasets\": [{ \"data\": [40, 55, 30, 70] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-polar-area-chart>"
          ]
        },
        {
          "kind": "html",
          "html": "<span class=\"demo-label\">without-animation</span>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-polar-area-chart open-on-click label=\"Sin animación\" without-animation>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Q1\", \"Q2\", \"Q3\", \"Q4\"],",
            "                  \"datasets\": [{ \"label\": \"Score\", \"data\": [78, 82, 75, 90] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-polar-area-chart>"
          ]
        }
      ]
    },
    {
      "id": "tema",
      "title": "Tema · CSS variables",
      "lede": [
        "Colores por sector vía <code class=\"code\">--fill-color-1..6</code> y",
        "          <code class=\"code\">--border-color-1..6</code> en el host (o un ancestro)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-polar-area-chart open-on-click class=\"polar-theme-demo\" label=\"Paleta custom\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Alpha\", \"Beta\", \"Gamma\", \"Delta\", \"Epsilon\"],",
            "                  \"datasets\": [{ \"label\": \"Índice\", \"data\": [65, 88, 42, 70, 55] }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-polar-area-chart>"
          ]
        }
      ]
    },
    {
      "id": "referencia",
      "title": "Referencia",
      "lede": "Wrapper tipado de <code class=\"code\">iswc-chart</code>. Hereda atributos, props y tokens.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / prop",
            "Notas"
          ],
          "rows": [
            [
              "<code>type</code>",
              "Fijo <code>polarArea</code> (no override)"
            ],
            [
              "<code>label</code>",
              "Título del chart (plugin title)"
            ],
            [
              "<code>legend-position</code>",
              "top · bottom · left · right · start · end (default top)"
            ],
            [
              "<code>without-legend</code> / <code>without-tooltip</code> / <code>without-animation</code>",
              "boolean"
            ],
            [
              "<code>config</code> (prop)",
              "Objeto Chart.js (<code>data</code>, <code>options</code>…)"
            ],
            [
              "<code>chart</code> (prop)",
              "Instancia Chart.js tras render"
            ],
            [
              "<code>--fill-color-1..6</code> / <code>--border-color-1..6</code>",
              "Colores por sector"
            ],
            [
              "<code>--grid-color</code> / <code>--chart-text</code>",
              "Grid y tipografía del tema"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Chart.js <code class=\"code\">polarArea</code> themed. Ángulos iguales por categoría;",
          "          el <strong>radio</strong> refleja la magnitud (a diferencia de un pie, donde el tamaño",
          "          es el ángulo). Ideal para comparar escalas en el mismo “reloj”."
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-polar-area-chart open-on-click label=\"Mix energético (GW)\">",
          "            <script type=\"application/json\">",
          "              {",
          "                \"data\": {",
          "                  \"labels\": [\"Solar\", \"Eólica\", \"Hidro\", \"Nuclear\", \"Gas\", \"Carbón\"],",
          "                  \"datasets\": [{ \"label\": \"GW instalados\", \"data\": [85, 72, 110, 95, 58, 40] }]",
          "                }",
          "              }",
          "            </script>",
          "          </iswc-polar-area-chart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}