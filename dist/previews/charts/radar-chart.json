{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-radar-chart",
  "category": "data-viz",
  "title": "Radar Chart",
  "titleHtml": false,
  "styles": [
    ".demo--chart { height: 22rem; display: flex; flex-direction: column; }",
    "    .demo--chart-sm { height: 18rem; }"
  ],
  "storageKey": "docs-iswc-radar-chart",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Radar Chart",
      "lede": "<code class=\"code\">&lt;iswc-radar-chart&gt;</code>",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Compara varias variables a la vez sobre una rejilla radial. Ideal para perfiles",
            "          (habilidades, atributos de producto, métricas de rendimiento).",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-radar-chart open-on-click label=\"Employee Skills\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Communication\", \"Technical\", \"Leadership\", \"Creativity\", \"Teamwork\", \"Problem Solving\"],",
            "                  \"datasets\": [",
            "                    {",
            "                      \"label\": \"Alice\",",
            "                      \"data\": [85, 92, 70, 88, 95, 78],",
            "                      \"fill\": true,",
            "                      \"backgroundColor\": \"color-mix(in srgb, crimson 38%, transparent)\",",
            "                      \"borderColor\": \"crimson\"",
            "                    },",
            "                    {",
            "                      \"label\": \"Bob\",",
            "                      \"data\": [72, 78, 90, 65, 80, 88],",
            "                      \"fill\": true,",
            "                      \"backgroundColor\": \"color-mix(in srgb, #339af0 38%, transparent)\",",
            "                      \"borderColor\": \"#339af0\"",
            "                    }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-radar-chart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Employee Skills",
                "Feature Comparison",
                "Product Comparison",
                "Clases"
              ]
            },
            {
              "control": "text",
              "prop": "attr:legend-position",
              "label": "legend-position"
            }
          ]
        }
      ]
    },
    {
      "id": "json",
      "title": "Datos con JSON",
      "lede": [
        "Coloca un <code class=\"code\">&lt;script type=\"application/json\"&gt;</code> hijo.",
        "          Cada valor de <code class=\"code\">data</code> mapea a una etiqueta del eje radial",
        "          (formato Chart.js)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-radar-chart open-on-click label=\"Feature Comparison\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Speed\", \"Reliability\", \"Ease of Use\", \"Features\", \"Support\"],",
            "                  \"datasets\": [{ \"label\": \"Product A\", \"data\": [85, 90, 75, 80, 70], \"fill\": true }]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-radar-chart>"
          ]
        }
      ]
    },
    {
      "id": "js",
      "title": "Datos con JavaScript",
      "lede": "Asigna <code class=\"code\">config</code>; el chart se re-renderiza solo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-radar-chart open-on-click id=\"radarJs\" label=\"Feature Comparison\"></iswc-radar-chart>"
        }
      ]
    },
    {
      "id": "multi",
      "title": "Múltiples datasets",
      "lede": "Superpone perfiles para compararlos directamente.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-radar-chart open-on-click id=\"radarMulti\" label=\"Product Comparison\"></iswc-radar-chart>"
        }
      ]
    },
    {
      "id": "options",
      "title": "Leyenda y features",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-radar-chart open-on-click label=\"Clases\" legend-position=\"end\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Strength\", \"Agility\", \"Intelligence\", \"Wisdom\", \"Charisma\"],",
            "                  \"datasets\": [",
            "                    { \"label\": \"Warrior\", \"data\": [95, 70, 50, 60, 65], \"fill\": true },",
            "                    { \"label\": \"Mage\", \"data\": [40, 55, 95, 90, 70], \"fill\": true }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-radar-chart>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / prop",
            "Notas"
          ],
          "rows": [
            [
              "<code>type</code>",
              "Fijo <code>radar</code>"
            ],
            [
              "<code>label</code> / <code>legend-position</code>",
              "Título y leyenda"
            ],
            [
              "<code>without-legend</code> / <code>without-tooltip</code> / <code>without-animation</code>",
              "boolean"
            ],
            [
              "<code>config</code>",
              "Objeto Chart.js"
            ],
            [
              "<code>--fill-color-*</code> / <code>--border-color-*</code>",
              "Serie fija blue→orange"
            ],
            [
              "<code>--point-radius</code> / <code>--line-border-width</code>",
              "Puntos y trazo"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "<code class=\"code\">&lt;iswc-radar-chart&gt;</code>"
      },
      "atributos": {
        "table": [
          {
            "name": "<code>type</code>",
            "desc": "Fijo <code>radar</code>"
          },
          {
            "name": "<code>label</code> / <code>legend-position</code>",
            "desc": "Título y leyenda"
          },
          {
            "name": "<code>without-legend</code> / <code>without-tooltip</code> / <code>without-animation</code>",
            "desc": "boolean"
          },
          {
            "name": "<code>config</code>",
            "desc": "Objeto Chart.js"
          },
          {
            "name": "<code>--fill-color-*</code> / <code>--border-color-*</code>",
            "desc": "Serie fija blue→orange"
          },
          {
            "name": "<code>--point-radius</code> / <code>--line-border-width</code>",
            "desc": "Puntos y trazo"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-radar-chart open-on-click label=\"Employee Skills\">",
          "            <script type=\"application/json\">",
          "              {",
          "                \"data\": {",
          "                  \"labels\": [\"Communication\", \"Technical\", \"Leadership\", \"Creativity\", \"Teamwork\", \"Problem Solving\"],",
          "                  \"datasets\": [",
          "                    {",
          "                      \"label\": \"Alice\",",
          "                      \"data\": [85, 92, 70, 88, 95, 78],",
          "                      \"fill\": true,",
          "                      \"backgroundColor\": \"color-mix(in srgb, crimson 38%, transparent)\",",
          "                      \"borderColor\": \"crimson\"",
          "                    },",
          "                    {",
          "                      \"label\": \"Bob\",",
          "                      \"data\": [72, 78, 90, 65, 80, 88],",
          "                      \"fill\": true,",
          "                      \"backgroundColor\": \"color-mix(in srgb, #339af0 38%, transparent)\",",
          "                      \"borderColor\": \"#339af0\"",
          "                    }",
          "                  ]",
          "                }",
          "              }",
          "            </script>",
          "          </iswc-radar-chart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}