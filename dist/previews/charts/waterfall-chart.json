            "            <script type=\"application/json\">",
            "              {",
            "                \"data\": {",
            "                  \"labels\": [\"Saldo inicial\", \"Ventas\", \"Costos\", \"Impuestos\", \"Saldo final\"],",
            "                  \"datasets\": [{ \"label\": \"Flujo\", \"data\": [1200, 850, -420, -180, null], \"totals\": [0, 4] }]",
