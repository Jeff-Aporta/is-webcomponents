{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-format",
  "category": "helpers",
  "title": "&lt;iswc-format&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-format",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Formateo con <code class=\"code\">Intl</code> y presets estilo Excel vía <code class=\"code\">pattern</code>. Un solo elemento cubre número, fecha/hora, texto, bytes y tiempo relativo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">vista rápida</span>\n          <div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">#,##0.00</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"#,##0.00\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">yyyy-mm-dd</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-08-01\" pattern=\"yyyy-mm-dd\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00%</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"0.42\" pattern=\"0.00%\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">title case</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"hola mundo contapyme\" case=\"title\"></iswc-format>\n            </div>\n          </div>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:type",
              "label": "type",
              "options": [
                "date",
                "number",
                "bytes",
                "relative",
                "text"
              ]
            },
            {
              "control": "select",
              "prop": "attr:pattern",
              "label": "pattern",
              "options": [
                "#,##0.00",
                "yyyy-mm-dd",
                "0.00%",
                "General",
                "0",
                "0.00",
                "#,##0",
                "0%",
                "0.00E+00",
                "$#,##0.00",
                "Accounting",
                "# ?/?",
                "# ??/??",
                "dd/mm/yyyy",
                "d-mmm-yyyy",
                "mmmm yyyy",
                "h:mm AM/PM",
                "h:mm:ss",
                "yyyy-mm-dd hh:mm:ss",
                "@"
              ]
            },
            {
              "control": "select",
              "prop": "attr:case",
              "label": "case",
              "options": [
                "title",
                "upper",
                "lower"
              ]
            },
            {
              "control": "select",
              "prop": "attr:currency",
              "label": "currency",
              "options": [
                "USD",
                "EUR"
              ]
            },
            {
              "control": "number",
              "prop": "attr:truncate",
              "label": "truncate",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:pad-start",
              "label": "pad-start",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:pad-length",
              "label": "pad-length",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:format",
              "label": "format",
              "options": [
                "currency",
                "percent",
                "scientific",
                "compact",
                "integer"
              ]
            },
            {
              "control": "text",
              "prop": "attr:display",
              "label": "display"
            },
            {
              "control": "select",
              "prop": "attr:date",
              "label": "date",
              "options": [
                "2020-01-01T12:00:00",
                "2099-01-01T12:00:00"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "excel-number",
      "title": "Números · patrones Excel",
      "lede": "Atributo <code class=\"code\">pattern</code> con códigos habituales de Excel (General, Number, Percent, Scientific, Currency, Accounting, Fraction).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">General · 1234.5</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"General\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"0\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\" pattern=\"0.00\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">#,##0</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234567\" pattern=\"#,##0\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">#,##0.00</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234567.8\" pattern=\"#,##0.00\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0%</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"0.42\" pattern=\"0%\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00%</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"0.425\" pattern=\"0.00%\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">0.00E+00</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234567\" pattern=\"0.00E+00\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">$#,##0.00</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"12500\" pattern=\"$#,##0.00\" currency=\"USD\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">Accounting</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"-1250.5\" pattern=\"Accounting\" currency=\"USD\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\"># ?/?</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"2.75\" pattern=\"# ?/?\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\"># ??/??</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"0.333\" pattern=\"# ??/??\"></iswc-format>\n            </div>\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-format type=\"number\" value=\"1234.5\" pattern=\"#,##0.00\"></iswc-format>\n<iswc-format type=\"number\" value=\"0.42\" pattern=\"0.00%\"></iswc-format>\n<iswc-format type=\"number\" value=\"2.75\" pattern=\"# ?/?\"></iswc-format>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "excel-date",
      "title": "Fechas y hora · patrones Excel",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">yyyy-mm-dd</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:00\" pattern=\"yyyy-mm-dd\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">dd/mm/yyyy</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30\" pattern=\"dd/mm/yyyy\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">d-mmm-yyyy</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30\" pattern=\"d-mmm-yyyy\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">mmmm yyyy</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30\" pattern=\"mmmm yyyy\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">h:mm AM/PM</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:00\" pattern=\"h:mm AM/PM\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">h:mm:ss</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:45\" pattern=\"h:mm:ss\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">yyyy-mm-dd hh:mm:ss</code>\n              <iswc-format class=\"format-grid__value\" type=\"date\" value=\"2026-07-30T17:30:45\" pattern=\"yyyy-mm-dd hh:mm:ss\"></iswc-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "excel-text",
      "title": "Texto · type=\"text\"",
      "lede": "Equivalente a formato Texto (@) de Excel, más transformaciones útiles.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">@ / as-is</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"00123\" pattern=\"@\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">upper</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"contapyme\" case=\"upper\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">lower</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"ContaPyme\" case=\"lower\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">title</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"hola mundo\" case=\"title\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">truncate 12</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"Texto demasiado largo para la celda\" truncate=\"12\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">pad-start 0 × 6</code>\n              <iswc-format class=\"format-grid__value\" type=\"text\" value=\"42\" pad-start=\"0\" pad-length=\"6\"></iswc-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "type-number",
      "title": "format · atajos Intl",
      "lede": "Sin <code class=\"code\">pattern</code>, usa <code class=\"code\">format</code>: decimal, currency, percent, scientific, compact, integer, accounting.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">decimal</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234.5\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">currency EUR</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"99.99\" format=\"currency\" currency=\"EUR\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">percent</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"0.42\" format=\"percent\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">scientific</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234567\" format=\"scientific\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">compact</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1250000\" format=\"compact\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">integer</code>\n              <iswc-format class=\"format-grid__value\" type=\"number\" value=\"1234.9\" format=\"integer\"></iswc-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "type-bytes",
      "title": "type=\"bytes\"",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">512 B</code>\n              <iswc-format class=\"format-grid__value\" type=\"bytes\" value=\"512\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">2 MB short</code>\n              <iswc-format class=\"format-grid__value\" type=\"bytes\" value=\"2097152\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">1.5 GB long</code>\n              <iswc-format class=\"format-grid__value\" type=\"bytes\" value=\"1610612736\" display=\"long\"></iswc-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "type-relative",
      "title": "type=\"relative\"",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">pasado</code>\n              <iswc-format class=\"format-grid__value\" type=\"relative\" date=\"2020-01-01T12:00:00\"></iswc-format>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">futuro</code>\n              <iswc-format class=\"format-grid__value\" type=\"relative\" date=\"2099-01-01T12:00:00\"></iswc-format>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "api",
      "title": "Referencia de atributos",
