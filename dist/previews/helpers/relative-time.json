{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-relative-time",
  "category": "helpers",
  "title": "<iswc-relative-time>",
  "titleHtml": true,
  "storageKey": "docs-iswc-relative-time",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Fechas relativas con <code class=\"code\">Intl.RelativeTimeFormat</code> (nativo).\n          Locale por defecto: <code class=\"code\">html lang</code> (sistema al boot) → <strong>es</strong>.\n          Alias de <code class=\"code\">&lt;iswc-format type=\"relative\"&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">sync · refresca cada ~30s · locale del sistema</span>\n          <p style=\"margin:0;font-size:1.15rem\">Actualizado <iswc-relative-time id=\"live\" sync></iswc-relative-time></p>",
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:sync",
              "label": "sync"
            },
            {
              "control": "select",
              "prop": "attr:data-rt-offset",
              "label": "data-rt-offset",
              "options": [
                "-86400",
                "-3600",
                "-120",
                "0",
                "259200"
              ]
            },
            {
              "control": "select",
              "prop": "attr:format",
              "label": "format",
              "options": [
                "long",
                "short",
                "narrow"
              ]
            },
            {
              "control": "text",
              "prop": "attr:numeric",
              "label": "numeric"
            }
          ]
        }
      ]
    },
    {
      "id": "formats",
      "title": "Formatos",
      "lede": "Mismos offsets relativos; cambia solo <code class=\"code\">format</code> / <code class=\"code\">numeric</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">long</code>\n              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"-86400\" format=\"long\"></iswc-relative-time>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">short</code>\n              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"-3600\" format=\"short\"></iswc-relative-time>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">narrow</code>\n              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"-120\" format=\"narrow\"></iswc-relative-time>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">numeric=always</code>\n              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"0\" numeric=\"always\"></iswc-relative-time>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">en 3 días</code>\n              <iswc-relative-time class=\"format-grid__value\" data-rt-offset=\"259200\" format=\"long\"></iswc-relative-time>\n            </div>\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-relative-time date=\"2026-07-30T10:00:00\" format=\"short\" sync></iswc-relative-time>\n<iswc-relative-time date=\"…\" locale=\"en\" numeric=\"always\"></iswc-relative-time>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "locales",
      "title": "Idiomas",
      "lede": "Se filtran con <code class=\"code\">Intl.RelativeTimeFormat.supportedLocalesOf()</code>.\n          Cada tarjeta muestra el mismo instante relativo en ese locale. Como mínimo\n          verás <strong>es</strong> y <strong>en</strong> en cualquier motor moderno.",
      "blocks": [
        {
          "kind": "html",
          "html": "<p class=\"demo-caption\" id=\"localeCaption\">Cargando locales…</p>\n          <div class=\"demo-locale-grid\" id=\"localeGrid\"></div>\n          <label class=\"demo-caption\" style=\"display:flex;align-items:center;gap:.5rem;margin-top:1rem;flex-wrap:wrap\">\n            Probar locale\n            <input id=\"localeProbe\" type=\"text\" value=\"es-CO\" list=\"localeHints\"\n              style=\"font:inherit;padding:.35em .6em;border:1px solid var(--iswc-border);border-radius:var(--iswc-radius-sm);background:var(--iswc-control-bg);color:var(--iswc-text);max-width:10rem\" />\n            <datalist id=\"localeHints\"></datalist>\n            <span id=\"localeProbeOut\"></span>\n          </label>"
        },
        {
          "kind": "code",
          "code": "<iswc-relative-time date=\"…\" locale=\"es\"></iswc-relative-time>\n<iswc-relative-time date=\"…\" locale=\"en\"></iswc-relative-time>\n<iswc-relative-time date=\"…\" locale=\"ja\" format=\"short\"></iswc-relative-time>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "alias",
      "title": "Equivalente unificado",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p style=\"margin:0\">\n            <iswc-format type=\"relative\" data-rt-offset=\"-7200\" style=\"short\"></iswc-format>\n          </p>"
        },
        {
          "kind": "code",
          "code": "<iswc-format type=\"relative\" date=\"…\" style=\"short\" locale=\"en\"></iswc-format>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default"
          ],
          "rows": [
            [
              "<code>date</code>",
              "ISO o timestamp"
            ],
            [
              "<code>format</code>",
              "long · short · narrow"
            ],
            [
              "<code>numeric</code>",
              "auto · always"
            ],
            [
              "<code>locale</code>",
              "<code>html lang</code> (sistema) → <code>es</code>"
            ],
            [
              "<code>sync</code>",
              "actualiza cada ~30s"
            ]
          ]
        }
      ]
    }
  ]
}
