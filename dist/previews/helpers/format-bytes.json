{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-format-bytes",
  "category": "helpers",
  "title": "<iswc-format-bytes>",
  "titleHtml": true,
  "storageKey": "docs-iswc-format-bytes",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Tamaños de archivo legibles. <code class=\"code\">value</code> se interpreta según <code class=\"code\">unit</code> (default byte).",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p>Demo: <iswc-format-bytes value=\"1536000\"></iswc-format-bytes></p>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "1536000",
                "1024",
                "1",
                "2.5",
                "512",
                "1073741824",
                "204800",
                "1048576",
                "0",
                "-2048"
              ]
            },
            {
              "control": "select",
              "prop": "attr:unit",
              "label": "unit",
              "options": [
                "byte",
                "kilobyte",
                "megabyte",
                "gigabyte",
                "terabyte",
                "petabyte"
              ]
            },
            {
              "control": "select",
              "prop": "attr:display",
              "label": "display",
              "options": [
                "short",
                "long"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:autofit",
              "label": "autofit"
            },
            {
              "control": "select",
              "prop": "attr:locale",
              "label": "locale",
              "options": [
                "en",
                "es",
                "fr",
                "ar-EG",
                "de",
                "ja"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "units",
      "title": "Unidades de entrada",
      "titleHtml": true,
      "lede": "El mismo tamaño conceptual con distinta unidad de entrada.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1024&quot; unit=&quot;byte&quot;\">\r\n              <code class=\"format-grid__tag\">byte 1024</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1024\" unit=\"byte\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;kilobyte&quot;\">\r\n              <code class=\"format-grid__tag\">kilobyte 1</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"kilobyte\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;2.5&quot; unit=&quot;megabyte&quot;\">\r\n              <code class=\"format-grid__tag\">megabyte 2.5</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"2.5\" unit=\"megabyte\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;gigabyte&quot;\">\r\n              <code class=\"format-grid__tag\">gigabyte 1</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"gigabyte\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;terabyte&quot;\">\r\n              <code class=\"format-grid__tag\">terabyte 1</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"terabyte\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot; unit=&quot;petabyte&quot;\">\r\n              <code class=\"format-grid__tag\">petabyte 1</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1\" unit=\"petabyte\"></iswc-format-bytes>\r\n            </div>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-format-bytes value=\"2.5\" unit=\"megabyte\"></iswc-format-bytes>\n<iswc-format-bytes value=\"1\" unit=\"gigabyte\"></iswc-format-bytes>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "display",
      "title": "Display short / long",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;512&quot; display=&quot;short&quot;\">\r\n              <code class=\"format-grid__tag\">short · 512 B</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"512\" display=\"short\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;512&quot; display=&quot;long&quot;\">\r\n              <code class=\"format-grid__tag\">long · 512</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"512\" display=\"long\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1073741824&quot; display=&quot;short&quot;\">\r\n              <code class=\"format-grid__tag\">short · 1 GiB</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1073741824\" display=\"short\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1073741824&quot; display=&quot;long&quot;\">\r\n              <code class=\"format-grid__tag\">long · 1 GiB</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1073741824\" display=\"long\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;2.5&quot; unit=&quot;megabyte&quot; display=&quot;short&quot;\">\r\n              <code class=\"format-grid__tag\">short · 2.5 MB in</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"2.5\" unit=\"megabyte\" display=\"short\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;2.5&quot; unit=&quot;megabyte&quot; display=&quot;long&quot;\">\r\n              <code class=\"format-grid__tag\">long · 2.5 MB in</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"2.5\" unit=\"megabyte\" display=\"long\"></iswc-format-bytes>\r\n            </div>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-format-bytes value=\"1073741824\" display=\"short\"></iswc-format-bytes>\n<iswc-format-bytes value=\"1073741824\" display=\"long\"></iswc-format-bytes>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "autofit",
      "title": "Autofit · unidad ≥ 1",
      "lede": "Con <code class=\"code\">autofit</code> se elige la unidad más alta cuyo valor sea al menos 1. <code class=\"code\">204800</code> → 200 KB (no 0.2 MB); desde 1 MiB sí MB.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\" data-code=\"autofit value=&quot;204800&quot;\">\n              <code class=\"format-grid__tag\">autofit · 204800 B</code>\n              <iswc-format-bytes class=\"format-grid__value\" autofit value=\"204800\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\" data-code=\"autofit value=&quot;1048576&quot;\">\n              <code class=\"format-grid__tag\">autofit · 1 MiB</code>\n              <iswc-format-bytes class=\"format-grid__value\" autofit value=\"1048576\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\" data-code=\"autofit value=&quot;512&quot;\">\n              <code class=\"format-grid__tag\">autofit · 512 B</code>\n              <iswc-format-bytes class=\"format-grid__value\" autofit value=\"512\"></iswc-format-bytes>\n            </div>\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-format-bytes autofit value=\"204800\"></iswc-format-bytes>\n<iswc-format-bytes autofit value=\"1048576\"></iswc-format-bytes>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "locale",
      "title": "Locale · mismo valor, distinto resultado",
      "lede": "Mismo tamaño (<code class=\"code\">1 536 000</code> bytes ≈ 1,5 MB). Cambia el <strong>separador decimal</strong> (<code class=\"code\">.</code> vs <code class=\"code\">,</code>), la <strong>unidad</strong> (MB / Mo / م.ب / メガバイト) y, con <code class=\"code\">display=\"long\"</code>, el nombre completo traducido.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<span class=\"demo-label\">value=\"1536000\" · short</span>\n          <div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">en → 1.5 MB</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"en\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">es → 1,5 MB</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"es\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">fr → 1,5 Mo</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"fr\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">ar-EG → ١٫٥ م.ب</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"ar-EG\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n            </div>\n          </div>\n          <span class=\"demo-label\">value=\"1536000\" · long (unidad traducida)</span>\n          <div class=\"format-grid format-grid--cards\">\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">en</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"en\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">es</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"es\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">de</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"de\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">fr</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"fr\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">ja</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"ja\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n            </div>\n            <div class=\"format-grid__row\">\n              <code class=\"format-grid__tag\">ar-EG</code>\n              <iswc-format-bytes class=\"format-grid__value\" locale=\"ar-EG\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n            </div>\n          </div>"
        },
        {
          "kind": "code",
          "code": "<!-- Mismo value; el locale cambia separador y nombre de unidad -->\n<iswc-format-bytes locale=\"en\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n<!-- en → 1.5 MB -->\n<iswc-format-bytes locale=\"es\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n<!-- es → 1,5 MB -->\n<iswc-format-bytes locale=\"fr\" value=\"1536000\" display=\"long\"></iswc-format-bytes>\n<!-- fr → 1,5 mégaoctet -->\n<iswc-format-bytes locale=\"ar-EG\" value=\"1536000\" display=\"short\"></iswc-format-bytes>\n<!-- ar-EG → ١٫٥ م.ب -->",
          "lang": "html"
        }
      ]
    },
    {
      "id": "edge",
      "title": "Casos límite",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"format-grid format-grid--cards\">\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;0&quot;\">\r\n              <code class=\"format-grid__tag\">0</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"0\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;1&quot;\">\r\n              <code class=\"format-grid__tag\">1 byte</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"1\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"value=&quot;-2048&quot;\">\r\n              <code class=\"format-grid__tag\">negativo</code>\r\n              <iswc-format-bytes class=\"format-grid__value\" value=\"-2048\"></iswc-format-bytes>\r\n            </div>\r\n            <div class=\"format-grid__row\" data-code=\"\">\r\n              <code class=\"format-grid__tag\">sin value</code>\r\n              <iswc-format-bytes class=\"format-grid__value\">«<span></span>» (vacío)</iswc-format-bytes>\r\n            </div>\r\n          </div>"
        }
      ]
    },
    {
