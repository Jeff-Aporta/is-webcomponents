{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-format-number",
  "category": "helpers",
  "title": "&lt;iswc-format-number&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-format-number",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Números con <code class=\"code\">Intl.NumberFormat</code>. Locale = <code class=\"code\">lang</code> del documento.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<p>Precio: <iswc-format-number value=\"1234567.89\" type=\"currency\" currency=\"COP\"></iswc-format-number></p>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "1234567.89",
                "1234.5",
                "0.875",
                "12500",
                "99.9",
                "49.99",
                "1234.56",
                "1.2",
                "42",
                "7",
                "12",
                "9.5",
                "0",
                "-42.5",
                "1000000000"
              ]
            },
            {
              "control": "select",
              "prop": "attr:type",
              "label": "type",
              "options": [
                "decimal",
                "currency",
                "percent",
                "unit"
              ]
            },
            {
              "control": "select",
              "prop": "attr:currency",
              "label": "currency",
              "options": [
                "COP",
                "USD",
                "EUR"
              ]
            },
            {
              "control": "number",
              "prop": "attr:minimum-fraction-digits",
              "label": "minimum-fraction-digits",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:maximum-fraction-digits",
              "label": "maximum-fraction-digits",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:pad-start",
              "label": "pad-start",
              "options": [
                "0",
                "*",
                ""
              ]
            },
            {
              "control": "number",
              "prop": "attr:pad-length",
              "label": "pad-length",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:minimum-integer-digits",
              "label": "minimum-integer-digits",
              "min": 0,
              "max": 100,
              "step": 1
            }
          ]
        }
      ]
    },
    {
      "id": "types",
      "title": "Tipos de número",
      "titleHtml": false,
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">decimal · 1234,5</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"1234.5\" type=\"decimal\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">percent · 0,875</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"0.875\" type=\"percent\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">currency COP · 12.500</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"12500\" type=\"currency\" currency=\"COP\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">currency USD · 99,9</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"99.9\" type=\"currency\" currency=\"USD\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">currency EUR · 49,99</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"49.99\" type=\"currency\" currency=\"EUR\"></iswc-format-number>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "digits",
      "title": "Dígitos fraccionarios",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">min 2 · 1234,5</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"1234.5\" minimum-fraction-digits=\"2\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">max 0 · 1234,56</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"1234.56\" maximum-fraction-digits=\"0\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">min 2 · max 4 · 1,2</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"1.2\" minimum-fraction-digits=\"2\" maximum-fraction-digits=\"4\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">currency + max 0 · 99,9</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"99.9\" type=\"currency\" currency=\"USD\" maximum-fraction-digits=\"0\"></iswc-format-number>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "pad",
      "title": "Pad start · ceros a la izquierda",
      "lede": "<code class=\"code\">pad-length</code> + <code class=\"code\">pad-start</code> rellenan el texto ya formateado. <code class=\"code\">minimum-integer-digits</code> usa Intl (recomendado para enteros).",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">pad 0 × 6 · 42</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"42\" pad-start=\"0\" pad-length=\"6\" maximum-fraction-digits=\"0\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">pad 0 × 8 · 7</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"7\" pad-length=\"8\" maximum-fraction-digits=\"0\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">pad * × 5 · 12</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"12\" pad-start=\"*\" pad-length=\"5\" maximum-fraction-digits=\"0\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">min-integer 5 · 42</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"42\" minimum-integer-digits=\"5\" maximum-fraction-digits=\"0\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">min-integer 4 · 1234.5</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"1234.5\" minimum-integer-digits=\"4\" minimum-fraction-digits=\"2\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">pad tras currency</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"9.5\" type=\"currency\" currency=\"USD\" pad-start=\" \" pad-length=\"12\"></iswc-format-number>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "edge",
      "title": "Casos límite",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"format-grid format-grid--cards\">",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">0</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"0\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">negativo · -42,5</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"-42.5\" minimum-fraction-digits=\"1\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">grande · 1.000.000.000</code>",
            "              <iswc-format-number class=\"format-grid__value\" value=\"1000000000\"></iswc-format-number>",
            "            </div>",
            "            <div class=\"format-grid__row\">",
            "              <code class=\"format-grid__tag\">sin value</code>",
            "              <iswc-format-number class=\"format-grid__value\">«<span></span>»</iswc-format-number>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Notas"
          ],
          "rows": [
            [
              "<code>value</code>",
              "número"
            ],
            [
              "<code>type</code>",
              "decimal · currency · percent · unit"
            ],
            [
              "<code>currency</code>",
              "ISO 4217 (útil con type=currency)"
            ],
            [
              "<code>minimum-fraction-digits</code>",
              "mínimo de decimales"
            ],
            [
              "<code>maximum-fraction-digits</code>",
              "máximo de decimales"
            ],
            [
              "<code>minimum-integer-digits</code>",
              "ceros a la izquierda vía Intl (1–21)"
            ],
            [
              "<code>pad-start</code>",
              "carácter de relleno (default <code>0</code> si hay pad-length)"
            ],
            [
              "<code>pad-length</code>",
              "longitud mínima del texto formateado (String.padStart)"
            ]
          ]
        }
      ]
    }
  ],
