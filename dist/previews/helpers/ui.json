{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-ui",
  "category": "helpers",
  "title": "IswcUi <span class=\"ui-chip-title\">(módulo · no es un tag)</span>",
  "titleHtml": true,
  "description": "Utilidad IswcUi: html, adoptCss y define para apps consumidoras del kit.",
  "styles": [
    ".ui-stage {",
    "      display: grid;",
    "      gap: 0.75rem;",
    "      padding: 1rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius-md, 8px);",
    "      background: color-mix(in srgb, var(--iswc-control-bg) 80%, transparent);",
    "    }",
    "    .ui-stage__meta {",
    "      font-size: 0.85em;",
    "      color: var(--iswc-text-muted, var(--iswc-text));",
    "      opacity: 0.85;",
    "    }",
    "    demo-card {",
    "      display: block;",
    "      padding: 0.85rem 1rem;",
    "      border-radius: 8px;",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg);",
    "      color: var(--iswc-text);",
    "    }",
    "    demo-card[data-tone=\"brand\"] {",
    "      border-color: color-mix(in srgb, var(--iswc-accent) 55%, var(--iswc-border));",
    "    }",
    "    .ui-chip-title {",
    "      display: inline-block;",
    "      margin-left: 0.5rem;",
    "      padding: 0.15rem 0.6rem;",
    "      border-radius: 999px;",
    "      font-size: 0.55em;",
    "      font-weight: 600;",
    "      letter-spacing: 0.02em;",
    "      color: var(--iswc-text);",
    "      background: color-mix(in srgb, var(--iswc-accent) 22%, transparent);",
    "      border: 1px solid color-mix(in srgb, var(--iswc-accent) 45%, transparent);",
    "      vertical-align: middle;"
  ],
  "storageKey": "docs-iswc-ui",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Módulo de interfaz",
      "titleHtml": false,
      "lede": [
        "Utilidad de render para apps consumidoras. Tras cargar el CDN queda en",
        "          <code class=\"code\">globalThis.IswcUi</code> (alias <code class=\"code\">Ui</code>).",
        "          No reinventes botones ni tablas: monta <code class=\"code\">is-*</code> con",
        "          <code class=\"code\">html</code> + CSS hermano vía <code class=\"code\">adoptCss</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">// Disponible tras all.min.js</span>",
            "          <div class=\"ui-stage\" id=\"introStage\">",
            "            <div class=\"ui-stage__meta\">Cargando IswcUi…</div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "html",
      "title": "Plantillas",
      "titleHtml": false,
      "lede": "Plantilla etiquetada → <code class=\"code\">DocumentFragment</code>. Soporta valores, eventos y nodos hijos.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"ui-stage\" id=\"htmlStage\"></div>"
        }
      ]
    },
    {
      "id": "define",
      "title": "Definir un componente",
      "titleHtml": false,
      "lede": [
        "Registra un custom element de dominio. El CSS va en archivo hermano",
        "          (aquí se usa <code class=\"code\">IswcUi.css</code> solo para el demo en página)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">// demo-card registrado en esta página</span>",
            "          <div class=\"ui-stage\">",
            "            <demo-card data-tone=\"brand\">",
            "              <strong>app-*</strong> traduce datos → <code>is-*</code>",
            "            </demo-card>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "cdn",
      "title": "CDN",
      "lede": [
        "Tag del catálogo: <code class=\"code\">iswc-ui</code> (módulo). Artefacto:",
        "          <code class=\"code\">dist/cdn/helpers/ui.min.js</code>. También va dentro de",
        "          <code class=\"code\">all.min.js</code>."
      ],
      "blocks": [
        {
          "kind": "code",
          "code": [
            "<script type=\"module\"",
            "  src=\"https://cdn.jsdelivr.net/gh/Jeff-Aporta/iswc-root@main/dist/cdn/helpers/ui.min.js\">",
            "</script>"
          ],
          "lang": "html"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia rápida",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Uso"
          ],
          "rows": [
            [
              "<code>html</code>",
              "Plantilla → fragment"
            ],
            [
              "<code>adoptCss</code>",
              "CSS hermano en ShadowRoot (preferido)"
            ],
            [
              "<code>css</code>",
              "CSS constructable (prototipos)"
            ],
            [
              "<code>define</code>",
              "customElements.define idempotente"
            ],
            [
              "<code>el</code> / <code>esc</code> / <code>raw</code>",
              "createElement / escape / HTML crudo"
            ],
            [
              "<code>crearComponente</code>",
              "Fábrica shadow + props → render"
            ],
            [
              "<code>jsonScript</code>",
              "Config JSON para is-*"
            ],
            [
              "<code>fecha</code> / <code>rec</code>",
              "Fecha es-CO / coerce record"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Utilidad de render para apps consumidoras. Tras cargar el CDN queda en",
          "          <code class=\"code\">globalThis.IswcUi</code> (alias <code class=\"code\">Ui</code>).",
          "          No reinventes botones ni tablas: monta <code class=\"code\">is-*</code> con",
          "          <code class=\"code\">html</code> + CSS hermano vía <code class=\"code\">adoptCss</code>."
        ]
      },
      "apiJs": {
        "table": [
          {
            "metodo": "<code>html</code>",
            "desc": "Plantilla → fragment"
          },
          {
            "metodo": "<code>adoptCss</code>",
            "desc": "CSS hermano en ShadowRoot (preferido)"
          },
          {
            "metodo": "<code>css</code>",
            "desc": "CSS constructable (prototipos)"
          },
          {
            "metodo": "<code>define</code>",
            "desc": "customElements.define idempotente"
          },
          {
            "metodo": "<code>el</code> / <code>esc</code> / <code>raw</code>",
            "desc": "createElement / escape / HTML crudo"
          },
          {
            "metodo": "<code>crearComponente</code>",
            "desc": "Fábrica shadow + props → render"
          },
          {
            "metodo": "<code>jsonScript</code>",
            "desc": "Config JSON para is-*"
          },
          {
            "metodo": "<code>fecha</code> / <code>rec</code>",
            "desc": "Fecha es-CO / coerce record"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<span class=\"demo-label\">// Disponible tras all.min.js</span>",
          "          <div class=\"ui-stage\" id=\"introStage\">",
          "            <div class=\"ui-stage__meta\">Cargando IswcUi…</div>",
          "          </div>",
          "```"
        ]
      }
    },
    "exclude": [
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
