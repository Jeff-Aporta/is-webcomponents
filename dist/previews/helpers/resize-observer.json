{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-resize-observer",
  "category": "helpers",
  "title": "&lt;iswc-resize-observer&gt;",
  "titleHtml": false,
  "styles": [
    ".ro-box {",
    "      resize: both;",
    "      overflow: auto;",
    "      box-sizing: border-box;",
    "      min-width: 140px;",
    "      min-height: 90px;",
    "      max-width: 100%;",
    "      width: 220px;",
    "      height: 120px;",
    "      padding: 1rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      background:",
    "        repeating-linear-gradient(45deg,",
    "          color-mix(in srgb, var(--iswc-border) 35%, transparent) 0 8px,",
    "          transparent 8px 16px),",
    "        var(--iswc-bg-elev);",
    "      color: var(--iswc-text);",
    "      font-size: 0.9rem;",
    "      line-height: 1.4;",
    "    }",
    "    .ro-meta {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      align-items: center;",
    "      gap: 0.75rem 1.25rem;",
    "      margin-top: 0.75rem;",
    "      font-size: 0.9rem;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .ro-size {",
    "      font-variant-numeric: tabular-nums;",
    "      font-weight: 600;",
    "      color: var(--iswc-text);",
    "    }",
    "    .ro-status {",
    "      font-size: 0.75rem;",
    "      font-weight: 600;",
    "      letter-spacing: 0.04em;",
    "      text-transform: uppercase;",
    "      padding: 0.2em 0.55em;",
    "      border-radius: 999px;",
    "      background: var(--iswc-brand-soft, color-mix(in srgb, var(--iswc-color-brand) 18%, transparent));",
    "      color: var(--iswc-brand-text, var(--iswc-color-brand));",
    "    }",
    "    .ro-status.iswc-off {",
    "      background: var(--iswc-control-bg);",
    "      color: var(--iswc-text-dim);",
    "    }",
    "    .ro-actions {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      gap: 0.5rem;",
    "      align-items: center;",
    "      margin-bottom: 0.75rem;",
    "    }",
    "    .log .type-res { color: #74c0fc; }",
    "    .log .type-off { color: #ffa8a8; }"
  ],
  "storageKey": "docs-iswc-resize-observer",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Observa hijos directos y emite <code class=\"code\">iswc-resize</code> con las",
        "          <code class=\"code\">ResizeObserverEntry</code>. Alias de",
        "          <code class=\"code\">&lt;iswc-observer type=\"resize\"&gt;</code>."
      ],
      "blocks": [
        {
          "kind": "callout",
          "html": [
            "Arrastra la esquina ↘ del cuadro. El tamaño en vivo y el log se actualizan",
            "          con cada <code class=\"code\">iswc-resize</code>."
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<span class=\"demo-label\">resize: both · overflow: auto</span>",
            "          <iswc-resize-observer id=\"ro\">",
            "            <div id=\"roBox\" class=\"ro-box\">",
            "              Arrastra la esquina ↘ para redimensionar.",
            "            </div>",
            "          </iswc-resize-observer>",
            "          <div class=\"ro-meta\">",
            "            <span>Tamaño: <span class=\"ro-size\" id=\"roSize\">— × —</span></span>",
            "            <span class=\"ro-status\" id=\"roStatus\">activo</span>",
            "          </div>",
            "          <div class=\"log\" id=\"roLog\" aria-live=\"polite\" style=\"margin-top:12px\">",
            "            <div class=\"row hint\">Los eventos <code class=\"code\">iswc-resize</code> aparecen aquí.</div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Desactivado",
      "titleHtml": false,
      "lede": [
        "Con <code class=\"code\">disabled</code> el observer se desconecta: redimensionar",
        "          ya no emite eventos. El botón alterna el atributo y su propia etiqueta."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"ro-actions\">",
            "            <iswc-button id=\"roToggle\" color=\"neutral\" variant=\"outlined\" type=\"button\">Desactivar observer</iswc-button>",
            "            <span class=\"ro-status\" id=\"ro2Status\">activo</span>",
            "          </div>",
            "          <iswc-resize-observer id=\"ro2\">",
            "            <div id=\"roBox2\" class=\"ro-box\" style=\"width:180px;height:100px\">",
            "              Panel secundario — redimensiona con el observer ON/OFF.",
            "            </div>",
            "          </iswc-resize-observer>",
            "          <div class=\"ro-meta\">",
            "            <span>Tamaño: <span class=\"ro-size\" id=\"roSize2\">— × —</span></span>",
            "          </div>",
            "          <div class=\"log\" id=\"roLog2\" aria-live=\"polite\" style=\"margin-top:12px\">",
            "            <div class=\"row hint\">Solo registra mientras el observer esté activo.</div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "alias",
      "title": "Equivalente unificado",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "<iswc-observer type=\"resize\">",
            "  <div style=\"resize:both;overflow:auto\">…</div>",
            "</iswc-observer>"
          ],
          "lang": "html"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>disabled</code>",
              "Desconecta el ResizeObserver"
            ],
            [
              "<code>iswc-resize</code>",
              "detail: { entries } — array de ResizeObserverEntry"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Observa hijos directos y emite <code class=\"code\">iswc-resize</code> con las",
          "          <code class=\"code\">ResizeObserverEntry</code>. Alias de",
          "          <code class=\"code\">&lt;iswc-observer type=\"resize\"&gt;</code>."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>disabled</code>",
            "desc": "Desconecta el ResizeObserver"
          },
          {
            "name": "<code>iswc-resize</code>",
            "desc": "detail: { entries } — array de ResizeObserverEntry"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-resize-observer>",
          "  <div style=\"resize:both; overflow:auto\">…</div>",
          "</iswc-resize-observer>",
          "",
          "el.addEventListener('iswc-resize', (e) => {",
          "  const entry = e.detail.entries[0];",
          "  console.log(entry.contentRect.width, entry.contentRect.height);",
          "});",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
