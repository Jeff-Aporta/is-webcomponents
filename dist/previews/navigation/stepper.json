{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-stepper",
  "category": "navigation",
  "title": "&lt;iswc-stepper&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-stepper / iswc-stepper-step de InSoft.",
  "styles": ".wizard-card {\r\n      margin-top: 1rem;\r\n      padding: 1.25rem;\r\n      background: var(--iswc-bg-2, #181b22);\r\n      border: 1px solid var(--iswc-border, #2a2f3a);\r\n      border-radius: 0.5rem;\r\n    }",
  "storageKey": "docs-iswc-stepper",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Indicador de flujo por pasos. Ideal para wizards y formularios multipaso.\r\n          Soporta orientación horizontal y vertical, variantes visualmente\r\n          distintas, iconos por slot, descripción y manejo de errores.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-stepper id=\"stepper1\" active=\"1\">\r\n            <iswc-stepper-step label=\"Cuenta\" description=\"email.verificado@ejemplo.com\" icon=\"mdi:account\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Perfil\" description=\"Completa tus datos\" icon=\"mdi:card-account-details\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Confirmar\" description=\"Revisa y envía\" icon=\"mdi:check-circle\"></iswc-stepper-step>\r\n          </iswc-stepper>\r\n\r\n          <div style=\"display:flex;gap:0.5rem;margin-top:1rem;justify-content:flex-end\">\r\n            <iswc-button id=\"prevBtn\" color=\"neutral\" variant=\"outlined\">Atrás</iswc-button>\r\n            <iswc-button id=\"nextBtn\" color=\"brand\">Siguiente</iswc-button>\r\n          </div>\r\n          <p id=\"stepLog\" class=\"lede\">Active: <code class=\"code\">1</code></p>",
          "controls": [
            {
              "control": "number",
              "prop": "attr:active",
              "label": "active",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Cuenta",
                "Perfil",
                "Confirmar",
                "Datos personales",
                "Dirección",
                "Pago",
                "Revisar",
                "Datos",
                "Validación",
                "Pendiente",
                "Bloqueado",
                "También bloqueado",
                "Inicio",
                "Medio",
                "Fin",
                "Paso 1",
                "Paso 2",
                "Paso 3"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:error",
              "label": "error"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            }
          ]
        }
      ]
    },
    {
      "id": "vertical",
      "title": "Vertical",
      "lede": "Con <code class=\"code\">orientation=\"vertical\"</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-stepper id=\"stepper2\" orientation=\"vertical\" active=\"1\">\r\n            <iswc-stepper-step label=\"Datos personales\" description=\"Nombre, email, fecha de nacimiento\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Dirección\" description=\"Calle, ciudad, código postal\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Pago\" description=\"Método de pago preferido\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Revisar\" description=\"Confirma antes de enviar\"></iswc-stepper-step>\r\n          </iswc-stepper>"
        }
      ]
    },
    {
      "id": "error",
      "title": "Estados de error",
      "lede": "Con <code class=\"code\">error</code> en el step correspondiente.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-stepper active=\"2\">\r\n            <iswc-stepper-step label=\"Datos\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Validación\" error></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Pago\"></iswc-stepper-step>\r\n          </iswc-stepper>"
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Disabled",
      "lede": "Pasos bloqueados con <code class=\"code\">disabled</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-stepper active=\"0\">\r\n            <iswc-stepper-step label=\"Pendiente\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Bloqueado\" disabled></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"También bloqueado\" disabled></iswc-stepper-step>\r\n          </iswc-stepper>"
        }
      ]
    },
    {
      "id": "numbered",
      "title": "Variante numbered",
      "lede": "Con <code class=\"code\">variant=\"numbered\"</code> la numeración es automática.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-stepper color=\"numbered\" active=\"1\">\r\n            <iswc-stepper-step label=\"Inicio\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Medio\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Fin\"></iswc-stepper-step>\r\n          </iswc-stepper>"
        }
      ]
    },
    {
      "id": "wizard",
      "title": "Ejemplo de wizard",
      "lede": "Stepper + card con el contenido cambiando al hacer click en Siguiente.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-stepper id=\"wizard\" active=\"0\">\r\n            <iswc-stepper-step label=\"Paso 1\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Paso 2\"></iswc-stepper-step>\r\n            <iswc-stepper-step label=\"Paso 3\"></iswc-stepper-step>\r\n          </iswc-stepper>\r\n\r\n          <div class=\"wizard-card\" id=\"wizardBody\">\r\n            <h4>Paso 1: Tu nombre</h4>\r\n            <p>Introduce tu nombre completo.</p>\r\n          </div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
