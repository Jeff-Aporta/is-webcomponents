{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-tree",
  "category": "navigation",
  "title": "&lt;iswc-tree&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-tree / iswc-tree-item de InSoft.",
  "storageKey": "docs-iswc-tree",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Árbol jerárquico accesible: expansión, selección, navegación por teclado",
        "          (↑/↓/←/→/Home/End/Enter/Space), iconos por slot y selección",
        "          <code class=\"code\">single</code> | <code class=\"code\">leaf</code> | <code class=\"code\">multiple</code> | <code class=\"code\">none</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tree id=\"tree1\" selection=\"single\" expanded>",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Documentos",
            "              <iswc-tree-item>",
            "                <iswc-icon slot=\"icon\" icon=\"mdi:file-document\"></iswc-icon>",
            "                facturas-2024.pdf",
            "              </iswc-tree-item>",
            "              <iswc-tree-item>",
            "                <iswc-icon slot=\"icon\" icon=\"mdi:file-document\"></iswc-icon>",
            "                contratos.odt",
            "              </iswc-tree-item>",
            "            </iswc-tree-item>",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Proyectos",
            "              <iswc-tree-item>",
            "                <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "                ContaPyme",
            "                <iswc-tree-item>",
            "                  <iswc-icon slot=\"icon\" icon=\"mdi:language-typescript\"></iswc-icon>",
            "                  app.ts",
            "                </iswc-tree-item>",
            "                <iswc-tree-item>",
            "                  <iswc-icon slot=\"icon\" icon=\"mdi:language-css3\"></iswc-icon>",
            "                  styles.css",
            "                </iswc-tree-item>",
            "              </iswc-tree-item>",
            "              <iswc-tree-item>",
            "                <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "                InSoft",
            "                <iswc-tree-item>",
            "                  <iswc-icon slot=\"icon\" icon=\"mdi:react\"></iswc-icon>",
            "                  index.jsx",
            "                </iswc-tree-item>",
            "              </iswc-tree-item>",
            "            </iswc-tree-item>",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:image\"></iswc-icon>",
            "              Capturas",
            "            </iswc-tree-item>",
            "          </iswc-tree>",
            "          <p id=\"tree1Log\" class=\"lede\">Seleccionado: <code class=\"code\">—</code></p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:selection",
              "label": "selection",
              "options": [
                "none",
                "single",
                "leaf",
                "multiple"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:expanded",
              "label": "expanded"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            }
          ],
          "equivNote": "El atributo selection define si el árbol selecciona nodos y cómo.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-tree: selection\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"selection=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"none → solo expand\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"single → un nodo\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"leaf → solo hojas\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"multiple → checks\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"none\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"single\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"c\",",
            "          \"label\": \"leaf\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"d\",",
            "          \"label\": \"multiple\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "multiple",
      "title": "Selección múltiple",
      "lede": "Con <code class=\"code\">selection=\"multiple\"</code> cada nodo tiene su checkbox.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tree id=\"tree2\" selection=\"multiple\">",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Backend",
            "              <iswc-tree-item>Python</iswc-tree-item>",
            "              <iswc-tree-item>Node.js</iswc-tree-item>",
            "              <iswc-tree-item>Go</iswc-tree-item>",
            "            </iswc-tree-item>",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Frontend",
            "              <iswc-tree-item>React</iswc-tree-item>",
            "              <iswc-tree-item>Vue</iswc-tree-item>",
            "              <iswc-tree-item>Svelte</iswc-tree-item>",
            "            </iswc-tree-item>",
            "          </iswc-tree>",
            "          <p id=\"tree2Log\" class=\"lede\">Seleccionados: <code class=\"code\">—</code></p>"
          ]
        }
      ]
    },
    {
      "id": "leaf",
      "title": "Selección solo-leaf",
      "lede": "Con <code class=\"code\">selection=\"leaf\"</code> las carpetas no se pueden seleccionar.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tree id=\"tree3\" selection=\"leaf\">",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder-account\"></iswc-icon>",
            "              Usuarios",
            "              <iswc-tree-item>admin</iswc-tree-item>",
            "              <iswc-tree-item>jperez</iswc-tree-item>",
            "              <iswc-tree-item>mlopez</iswc-tree-item>",
            "            </iswc-tree-item>",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder-account\"></iswc-icon>",
            "              Invitados",
            "              <iswc-tree-item>guest</iswc-tree-item>",
            "            </iswc-tree-item>",
            "          </iswc-tree>"
          ]
        }
      ]
    },
    {
      "id": "none",
      "title": "Sin selección",
      "lede": "Con <code class=\"code\">selection=\"none\"</code> solo expande/colapsa.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tree id=\"tree4\" selection=\"none\">",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Sólo expansión",
            "              <iswc-tree-item>uno</iswc-tree-item>",
            "              <iswc-tree-item>dos</iswc-tree-item>",
            "            </iswc-tree-item>",
            "          </iswc-tree>"
          ]
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Disabled",
      "lede": "El atributo <code class=\"code\">disabled</code> bloquea interacción.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-tree selection=\"single\">",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Producción",
            "              <iswc-tree-item disabled>db-master</iswc-tree-item>",
            "              <iswc-tree-item disabled>db-replica</iswc-tree-item>",
            "            </iswc-tree-item>",
            "            <iswc-tree-item>",
            "              <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
            "              Staging",
            "              <iswc-tree-item>db-1</iswc-tree-item>",
            "            </iswc-tree-item>",
            "          </iswc-tree>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-tree&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>selection</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Modo de selección. (valor por defecto)"
            ],
            [
              "<code>expanded</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Inicia todos los nodos expandidos. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-tree-item&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>expanded</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "El nodo está expandido. (valor por defecto)"
            ],
            [
              "<code>selected</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "El nodo está seleccionado. (valor por defecto)"
            ],
            [
              "<code>disabled</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Bloquea interacción. (valor por defecto)"
            ],
            [
              "<code>has-children</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Fuerza presencia de hijos. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-tree-select</code>",
              "Selección. <code>detail: { item, selected, selectedItems }</code>."
            ],
            [
              "<code>iswc-tree-toggle</code>",
              "Expande/colapsa. <code>detail: { item, expanded }</code>."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Árbol jerárquico accesible: expansión, selección, navegación por teclado",
          "          (↑/↓/←/→/Home/End/Enter/Space), iconos por slot y selección",
          "          <code class=\"code\">single</code> | <code class=\"code\">leaf</code> | <code class=\"code\">multiple</code> | <code class=\"code\">none</code>."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>selection</code>",
            "type": "none | single | leaf | multiple",
            "default": "single",
            "desc": "Modo de selección."
          },
          {
            "name": "<code>expanded</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Inicia todos los nodos expandidos."
          },
          {
            "name": "<code>expanded</code>",
            "type": "boolean",
            "default": "false",
            "desc": "El nodo está expandido."
          },
          {
            "name": "<code>selected</code>",
            "type": "boolean",
            "default": "false",
            "desc": "El nodo está seleccionado."
          },
          {
            "name": "<code>disabled</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Bloquea interacción."
          },
          {
            "name": "<code>has-children</code>",
            "type": "boolean",
            "default": "auto",
            "desc": "Fuerza presencia de hijos."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-tree-select</code>",
            "cuando": "Selección. <code>detail: { item, selected, selectedItems }</code>."
          },
          {
            "evento": "<code>iswc-tree-toggle</code>",
            "cuando": "Expande/colapsa. <code>detail: { item, expanded }</code>."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-tree selection=\"single\" expanded>",
          "  <iswc-tree-item>",
          "    <iswc-icon slot=\"icon\" icon=\"mdi:folder\"></iswc-icon>",
          "    Documentos",
          "    <iswc-tree-item>facturas-2024.pdf</iswc-tree-item>",
          "  </iswc-tree-item>",
          "</iswc-tree>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
