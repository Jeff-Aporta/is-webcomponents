{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-figure",
  "category": "media",
  "title": "&lt;iswc-figure&gt;",
  "titleHtml": false,
  "description": "Figura de contenido: imagen + pie + enlace «abrir en una pestaña nueva».",
  "storageKey": "docs-iswc-figure",
