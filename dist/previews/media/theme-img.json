{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-theme-img",
  "category": "media",
  "title": "&lt;iswc-theme-img&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-theme-img",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Una sola imagen dark↔light según el tema del contenedor. Caja <code class=\"code\">1em × 1em</code>; escala con <code class=\"code\">font-size</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"align-items:center;gap:1.25rem;flex-wrap:wrap;font-size:3rem\">",
            "            <iswc-theme-img",
            "              src-dark=\"https://cdn.jsdelivr.net/gh/Jeff-Aporta/iswc-root@main/docs/favicon.svg\"",
            "              src-light=\"https://cdn.jsdelivr.net/gh/Jeff-Aporta/iswc-root@main/docs/favicon.svg\"",
            "              alt=\"Demo\"",
            "              shape=\"circle\"",
            "            ></iswc-theme-img>",
            "            <span style=\"font-size:0.35em;opacity:.7\">cambia el theme-toggle del chrome</span>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "text",
              "prop": "attr:alt",
              "label": "alt"
            }
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Una sola imagen dark↔light según el tema del contenedor. Caja <code class=\"code\">1em × 1em</code>; escala con <code class=\"code\">font-size</code>."
      },
      "ejemplos": {
        "content": [
          "```html",
          "<span style=\"font-size:2rem\">",
          "  <iswc-theme-img",
          "    src-dark=\"./logo-dark.svg\"",
          "    src-light=\"./logo-light.svg\"",
          "    alt=\"Marca\"",
          "    shape=\"circle\"",
          "  ></iswc-theme-img>",
          "</span>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
