{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-image-editor",
  "category": "media",
  "title": "&lt;iswc-image-editor&gt;",
  "titleHtml": false,
  "styles": [
    ".crop-out {",
    "      max-width: 100%;",
    "      max-height: 14rem;",
    "      display: block;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      margin-top: .55rem;",
    "    }",
    "    pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 8rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-image-editor",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Canvas de edición con crop, zoom y rotación. Clic y arrastra el rectángulo para moverlo; las esquinas redimensionan.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-image-editor id=\"editor1\" src=\"https://picsum.photos/id/1015/1600/1000\" aspect=\"16/10\">",
            "            <div slot=\"toolbar\">",
            "              <button data-action=\"zoom-out\">−</button>",
            "              <button data-action=\"zoom-in\">+</button>",
            "              <button data-action=\"rotate-ccw\">↺</button>",
            "              <button data-action=\"rotate\">↻</button>",
            "              <button data-action=\"reset\">Reset</button>",
            "              <button data-action=\"crop\">Recortar</button>",
            "            </div>",
            "          </iswc-image-editor>",
            "          <img id=\"crop1\" class=\"crop-out\" alt=\"Recorte resultante\" hidden",
            "               src=\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1' height='1'><rect width='1' height='1' fill='transparent'/></svg>\">",
            "          <pre class=\"log\" id=\"log\">— logs aquí —</pre>"
          ],
          "controls": [
            {
              "control": "text",
              "prop": "attr:aspect",
              "label": "aspect"
            }
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const e = document.querySelector('iswc-image-editor');",
            "e.zoom = 1.2;             // o e.applyZoom(0.1);",
            "e.rotation = 90;           // grados, sentido horario",
            "e.applyRotation(-90);",
            "",
            "const out = e.cropped();  // dataURL image/png",
            "e.image;                  // HTMLImageElement cargada",
            "",
            "// Eventos",
            "e.addEventListener('iswc-load',   e => ...);",
            "e.addEventListener('iswc-change', e => /* crop rectangle cambia */);",
            "e.addEventListener('iswc-crop',   e => /* resultado recortado listo */);",
            "",
            "// Atributos",
            "// src, zoom, rotation, aspect (\"1\", \"4/3\", \"16/9\" o \"\")"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Canvas de edición con crop, zoom y rotación. Clic y arrastra el rectángulo para moverlo; las esquinas redimensionan."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
