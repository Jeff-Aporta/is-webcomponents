{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-icon-explorer",
  "category": "media",
  "title": "Explorador de iconos",
  "description": "Explorador offline de familias e iconos del CDN.",
  "styles": [
    "/* presentation.css deja html/body en `overflow:hidden` porque el shell de",
    "      docs scrollea dentro de `.main`. Esta página no usa ese shell, así que el",
    "      scroll lo tiene que aportar ella: columna de alto fijo + panel scrollable.",
    "      Sin esto la lista de iconos se corta y no hay forma de bajar. */",
    "    html, body { height: 100%; overflow: hidden; }",
    "    iswc-main { display: flex; flex-direction: column; height: 100%; min-height: 0; }",
    "",
    "    .xp {",
    "      flex: 1;",
    "      min-height: 0;",
    "      overflow-y: auto;",
    "      overscroll-behavior: contain;",
    "      scrollbar-width: thin;",
    "      scrollbar-color: var(--iswc-scrollbar-thumb) transparent;",
    "      padding: 20px clamp(16px, 3vw, 32px) 96px;",
    "    }",
    "    .xp-inner { max-width: 1180px; margin: 0 auto; }",
    "",
    "    .xp-head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }",
    "    .xp-head h1 { margin: 0 0 4px; font-size: 1.5rem; }",
    "    .xp-head .count { color: var(--iswc-text-soft); font-size: 0.8rem; }",
    "",
    "    /* — buscador + filtros —",
    "      Los controles son <iswc-input>, <iswc-select> y <iswc-button-group>: no se",
    "      replican inputs nativos con estilos propios. */",
    "    .xp-bar {",
    "      position: sticky;",
    "      top: 0;",
    "      z-index: 4;",
    "      padding: 12px 0 10px;",
    "      background: linear-gradient(var(--iswc-bg) 78%, transparent);",
    "      display: grid;",
    "      gap: 10px;",
    "    }",
    "    .xp-bar__search { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }",
    "    .xp-bar__search iswc-input { flex: 1; min-width: 240px; }",
    "    .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: end; }",
    "    .filters iswc-select { min-width: 150px; }",
    "",
    "    /* — vista familias — */",
    "    .fam-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }",
    "    .fam { display: block; color: inherit; text-decoration: none; }",
    "    .fam:hover { text-decoration: none; }",
    "    .fam iswc-card { transition: border-color 140ms ease, transform 140ms ease; }",
    "    .fam:hover iswc-card { border-color: var(--iswc-accent); transform: translateY(-1px); }",
    "    .fam b { font-size: 0.95rem; }",
    "    .fam small { color: var(--iswc-text-soft); font-size: 0.75rem; }",
    "    .fam .sample { display: flex; gap: 8px; font-size: 1.2rem; color: var(--iswc-text-soft); min-height: 1.3em; margin: 6px 0; }",
    "    .fam .meta { display: flex; gap: 4px; flex-wrap: wrap; }",
    "",
    "    /* — rejilla de iconos — */",
    "    .tools { display: flex; align-items: end; gap: 0.9rem; flex-wrap: wrap; }",
    "    .tools iswc-slider { min-width: 180px; }",
    "    .icon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px; }",
    "    .icon-cell {",
    "      display: grid;",
    "      justify-items: center;",
    "      gap: 6px;",
    "      padding: 12px 6px 8px;",
    "      border: 1px solid transparent;",
    "      border-radius: 0.55rem;",
    "      background: transparent;",
    "      color: inherit;",
    "      font: inherit;",
    "      cursor: pointer;",
    "      transition: background 120ms ease, border-color 120ms ease;",
    "    }",
    "    .icon-cell:hover { background: var(--iswc-bg-elev); border-color: var(--iswc-border); }",
    "    .icon-cell.sel { border-color: var(--iswc-accent); background: color-mix(in srgb, var(--iswc-accent) 10%, transparent); }",
    "    .icon-cell iswc-icon { font-size: var(--xp-size, 1.6rem); color: var(--xp-color, currentColor); }",
    "    .icon-cell small {",
    "      max-width: 100%;",
    "      overflow: hidden;",
    "      text-overflow: ellipsis;",
    "      white-space: nowrap;",
    "      font-size: 0.7rem;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .icon-cell .fam-tag { font-size: 0.7rem; color: var(--iswc-accent); }",
    "    .more { margin: 18px auto; display: block; }",
    "    .empty { color: var(--iswc-text-soft); padding: 32px 0; text-align: center; }",
    "    .status { display: grid; gap: 8px; padding: 32px 0; justify-items: center; }",
    "    .status iswc-progress-bar { width: min(360px, 100%); }",
    "",
    "    /* — contenido del drawer de personalización — */",
    "    .form__meta { display: grid; gap: 2px; margin-bottom: 10px; }",
    "    .form__idrow { display: flex; align-items: center; gap: 0.4rem; }",
    "    .form__idrow b { font-size: 1rem; word-break: break-all; }",
    "    .form__sub { font-size: 0.75rem; color: var(--iswc-text-soft); }",
    "    .preview {",
    "      display: grid;",
    "      place-items: center;",
    "      min-height: 150px;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: 0.5rem;",
    "      /* Tablero para comprobar visualmente el área completa del icono. */",
    "      background-color: var(--iswc-bg);",
    "      background-image:",
    "        linear-gradient(45deg, var(--iswc-border-soft) 25%, transparent 25%),",
    "        linear-gradient(-45deg, var(--iswc-border-soft) 25%, transparent 25%),",
    "        linear-gradient(45deg, transparent 75%, var(--iswc-border-soft) 75%),",
    "        linear-gradient(-45deg, transparent 75%, var(--iswc-border-soft) 75%);",
    "      background-size: 16px 16px;",
    "      background-position: 0 0, 0 8px, 8px -8px, -8px 0;",
    "      overflow: auto;",
    "      padding: 12px;",
    "      margin-bottom: 12px;",
    "    }",
    "    .preview__box { outline: 1px dashed color-mix(in srgb, var(--iswc-accent) 55%, transparent); outline-offset: 2px; line-height: 0; }",
    "    .preview__box svg { display: block; }",
    "",
    "    .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: end; margin-bottom: 10px; }",
    "    .row--grow iswc-input, .row--grow iswc-select { flex: 1; min-width: 130px; }",
    "    .checks { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }",
    "    .code {",
    "      margin: 0;",
    "      padding: 10px 12px;",
    "      max-height: 240px;",
    "      overflow: auto;",
    "      border-radius: 0.45rem;",
    "      background: var(--iswc-code-bg, #0f1318);",
    "      color: var(--iswc-code-text, #d4d8de);",
    "      font-family: var(--iswc-mono, ui-monospace, monospace);",
    "      font-size: 0.75rem;",
    "      line-height: 1.5;",
    "      white-space: pre;",
    "    }",
    "    .code__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }",
    "    .code__head span { font-size: 0.75rem; color: var(--iswc-text-soft); }"
  ],
  "storageKey": "docs-icon-explorer",
  "hasBehavior": true,
  "sections": [
    {
      "id": "main",
      "title": "Explorador de iconos",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<iswc-main>",
            "    <div class=\"xp\" id=\"scroller\">",
            "      <div class=\"xp-inner\" id=\"app\">",
            "        <div class=\"status\"><iswc-spinner></iswc-spinner><span>Cargando índice de iconos…</span></div>",
            "      </div>",
            "    </div>",
            "  </iswc-main>",
            "",
            "  <!-- Personalizador. Es un <iswc-drawer> real: aporta backdrop, foco atrapado,",
            "      cierre con Esc / light-dismiss, animación y slots de header/footer. Antes",
            "      era un <aside> a mano que reimplementaba todo eso a medias. -->",
            "  <iswc-drawer id=\"form\" placement=\"end\" label=\"Personalizar icono\" light-dismiss>",
            "    <iswc-button slot=\"header-actions\" id=\"fPrev\" color=\"neutral\" variant=\"plain\" title=\"Icono anterior\" aria-label=\"Icono anterior\">",
            "      <iswc-icon icon=\"mdi:chevron-left\"></iswc-icon>",
            "    </iswc-button>",
            "    <iswc-button slot=\"header-actions\" id=\"fNext\" color=\"neutral\" variant=\"plain\" title=\"Icono siguiente\" aria-label=\"Icono siguiente\">",
            "      <iswc-icon icon=\"mdi:chevron-right\"></iswc-icon>",
            "    </iswc-button>",
            "    <iswc-button slot=\"header-actions\" id=\"fMore\" color=\"neutral\" variant=\"plain\" title=\"Más opciones\" aria-label=\"Más opciones\" aria-expanded=\"true\">",
            "      <iswc-icon icon=\"mdi:tune-variant\"></iswc-icon>",
            "    </iswc-button>",
            "",
            "    <div class=\"form__meta\">",
            "      <div class=\"form__idrow\">",
            "        <b id=\"fId\">—</b>",
            "        <iswc-copy-button id=\"fCopyId\" copy-label=\"Copiar identificador\" tooltip=\"Copiar identificador\"></iswc-copy-button>",
            "      </div>",
            "      <span class=\"form__sub\" id=\"fCollection\">—</span>",
            "      <span class=\"form__sub\" id=\"fSize\">—</span>",
            "      <span class=\"form__sub\" id=\"fAlt\">—</span>",
            "    </div>",
            "",
            "    <div class=\"preview\"><span class=\"preview__box\" id=\"fPreview\"></span></div>",
            "",
            "    <div id=\"fOptions\">",
            "      <div class=\"row row--grow\">",
            "        <iswc-select id=\"fFormat\" label=\"Formato de salida\" value=\"svg\">",
            "          <iswc-option value=\"svg\">SVG</iswc-option>",
            "          <iswc-option value=\"css\">CSS (background SVG)</iswc-option>",
            "          <iswc-option value=\"png\">PNG (descarga)</iswc-option>",
            "        </iswc-select>",
            "      </div>",
            "",
            "      <div class=\"row\">",
            "        <iswc-input id=\"fSizeVal\" type=\"number\" label=\"Tamaño\" value=\"24\" min=\"1\" max=\"4096\" step=\"1\" style=\"--iswc-field-width:100px\"></iswc-input>",
            "        <iswc-select id=\"fUnit\" label=\"Unidad\" value=\"auto\" style=\"min-width:140px\">",
            "          <iswc-option value=\"auto\">Automática</iswc-option>",
            "          <iswc-option value=\"px\">px</iswc-option>",
            "          <iswc-option value=\"em\">em</iswc-option>",
            "          <iswc-option value=\"none\">Sin unidad</iswc-option>",
            "        </iswc-select>",
            "      </div>",
            "",
            "      <div class=\"row row--grow\">",
            "        <iswc-input id=\"fColor\" label=\"Color\" value=\"currentColor\" clearable",
            "                  hint=\"hex, rgb(), var(--token) o currentColor\"></iswc-input>",
            "        <iswc-color-picker id=\"fColorPick\" label=\"Muestra\" value=\"#4c9aff\"></iswc-color-picker>",
            "      </div>",
            "",
            "      <div class=\"checks\">",
            "        <iswc-checkbox id=\"fPretty\">Formatear código</iswc-checkbox>",
            "        <iswc-checkbox id=\"fRect\">Rectángulo transparente</iswc-checkbox>",
            "      </div>",
            "    </div>",
            "",
            "    <div class=\"code__head\">",
            "      <span id=\"fCodeLabel\">Código generado</span>",
            "      <iswc-copy-button id=\"fCopyCode\" copy-label=\"Copiar\" tooltip=\"Copiar código\"></iswc-copy-button>",
            "    </div>",
            "    <pre class=\"code\" id=\"fCode\">—</pre>",
            "",
            "    <div slot=\"footer\" style=\"display:flex;gap:6px;flex-wrap:wrap\">",
            "      <iswc-button id=\"fDownload\" color=\"brand\" variant=\"filled\">Descargar</iswc-button>",
            "      <iswc-copy-button id=\"fCopyUrl\" copy-label=\"Copiar URL\" success-label=\"URL copiada\"></iswc-copy-button>",
            "      <iswc-button data-drawer=\"close\" color=\"neutral\" variant=\"outlined\">Cerrar</iswc-button>",
            "    </div>",
            "  </iswc-drawer>",
            "",
            "  <iswc-toast id=\"toaster\" placement=\"bottom-center\"></iswc-toast>"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Explorador offline de familias e iconos del CDN."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
