{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-switch",
  "category": "forms",
  "title": "&lt;iswc-switch&gt;",
  "titleHtml": false,
  "styles": [
    ".stack { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; }",
    "    .inline { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }",
    "    .placements { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 2rem; }",
    "    .settings { display: flex; flex-direction: column; gap: 0.9rem; max-width: 26rem; }",
    "    .settings iswc-switch::part(base) { justify-content: space-between; }"
  ],
  "storageKey": "docs-iswc-switch",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Interruptor <em>form-associated</em> con paridad funcional con el",
        "          <a href=\"https://mui.com/material-ui/react-switch/\" target=\"_blank\" rel=\"noreferrer\">Switch de MUI</a>:",
        "          mismo contrato de formulario que <code class=\"code\">iswc-checkbox</code>, con carril y perilla deslizante,",
        "          color por <code class=\"code\">variant</code>, iconos en la perilla y rótulos dentro del carril."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-switch id=\"swDemo\" name=\"notificaciones\" checked>Notificaciones</iswc-switch>",
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:checked",
              "label": "checked"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "neutral",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "select",
              "prop": "attr:label-placement",
              "label": "label-placement",
              "options": [
                "start",
                "top",
                "bottom"
              ]
            },
            {
              "control": "select",
              "prop": "attr:checked-icon",
              "label": "checked-icon",
              "options": [
                "mdi:white-balance-sunny",
                "mdi:check",
                "mdi:lock"
              ]
            },
            {
              "control": "select",
              "prop": "attr:on-label",
              "label": "on-label",
              "options": [
                "ON",
                "SÍ",
                "24h"
              ]
            },
            {
              "control": "select",
              "prop": "attr:off-label",
              "label": "off-label",
              "options": [
                "OFF",
                "NO",
                "12h"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:readonly",
              "label": "readonly"
            },
            {
              "control": "boolean",
              "prop": "attr:error",
              "label": "error"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            },
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "si",
                "semanal"
              ]
            }
          ],
          "equivNote": "Como checkbox: solo el estado on aporta al FormData.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-switch: FormData\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"checked?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"on → aporta value\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"off → no envía\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"readonly / disabled\",",
            "          \"shape\": \"round\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"no\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"swLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Cambia un interruptor para ver el evento.</div></div>"
        }
      ]
    },
    {
      "id": "color",
      "title": "Color",
      "lede": [
        "<code class=\"code\">variant</code> equivale a la prop <code class=\"code\">color</code> de MUI: redefine el",
        "          carril encendido, el halo de la perilla y el anillo de foco."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"inline\">",
            "            <iswc-switch checked>brand (default)</iswc-switch>",
            "            <iswc-switch color=\"neutral\" checked>neutral</iswc-switch>",
            "            <iswc-switch color=\"success\" checked>success</iswc-switch>",
            "            <iswc-switch color=\"warning\" checked>warning</iswc-switch>",
            "            <iswc-switch color=\"danger\" checked>danger</iswc-switch>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "label-placement",
      "title": "Posición de la etiqueta",
      "lede": [
        "<code class=\"code\">label-placement</code> equivale a <code class=\"code\">labelPlacement</code> del",
        "          <code class=\"code\">FormControlLabel</code> de MUI."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"placements\">",
            "            <iswc-switch checked>end (default)</iswc-switch>",
            "            <iswc-switch label-placement=\"start\" checked>start</iswc-switch>",
            "            <iswc-switch label-placement=\"top\" checked>top</iswc-switch>",
            "            <iswc-switch label-placement=\"bottom\" checked>bottom</iswc-switch>",
            "          </div>"
          ]
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Para un panel de ajustes con la etiqueta a la izquierda y el interruptor pegado al borde derecho,",
            "          combina <code class=\"code\">label-placement=\"start\"</code> con",
            "          <code class=\"code\">::part(base) { justify-content: space-between }</code>.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"settings\">",
            "            <iswc-switch label-placement=\"start\" checked>Modo compacto</iswc-switch>",
            "            <iswc-switch label-placement=\"start\">Sonidos de la interfaz</iswc-switch>",
            "            <iswc-switch label-placement=\"start\" checked>Guardado automático</iswc-switch>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "icons",
      "title": "Iconos en la perilla",
      "lede": [
        "<code class=\"code\">icon</code> (apagado) y <code class=\"code\">checked-icon</code> (encendido) reciben",
        "          nombres de <code class=\"code\">iswc-icon</code>, como el ejemplo de <em>customized switches</em> de MUI.",
        "          Al usarlos el control crece para dar sitio al glifo."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"inline\">",
            "            <iswc-switch icon=\"mdi:weather-night\" checked-icon=\"mdi:white-balance-sunny\" color=\"warning\" checked>Tema claro</iswc-switch>",
            "            <iswc-switch icon=\"mdi:close\" checked-icon=\"mdi:check\" color=\"success\">Sincronizar</iswc-switch>",
            "            <iswc-switch checked-icon=\"mdi:lock\" checked>Bloquear pantalla</iswc-switch>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "track-labels",
      "title": "Rótulos en el carril",
      "lede": [
        "<code class=\"code\">on-label</code> y <code class=\"code\">off-label</code> pintan un texto corto dentro del",
        "          carril, en el hueco que deja la perilla. Pensados para dos o tres caracteres."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"inline\">",
            "            <iswc-switch on-label=\"ON\" off-label=\"OFF\" checked>Encendido</iswc-switch>",
            "            <iswc-switch on-label=\"SÍ\" off-label=\"NO\" color=\"success\">Confirmación</iswc-switch>",
            "            <iswc-switch on-label=\"24h\" off-label=\"12h\" checked>Formato de hora</iswc-switch>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "readonly",
      "title": "Solo lectura y deshabilitado",
      "lede": [
        "<code class=\"code\">readonly</code> bloquea el cambio pero mantiene el valor en el formulario y el foco",
        "          navegable con <code class=\"code\">Tab</code>. <code class=\"code\">disabled</code> saca el control del orden",
        "          de tabulación y no aporta entrada al <code class=\"code\">FormData</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-switch name=\"ro1\" checked readonly>Solo lectura (encendido)</iswc-switch>",
            "            <iswc-switch name=\"ro2\" readonly>Solo lectura (apagado)</iswc-switch>",
            "            <iswc-switch name=\"di1\" checked disabled>Deshabilitado</iswc-switch>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "error",
      "title": "Error y texto de ayuda",
      "lede": [
        "<code class=\"code\">hint</code> pinta un texto bajo el control (atributo o slot homónimo).",
        "          <code class=\"code\">error</code> tiñe carril y ayuda con el color de peligro y marca",
        "          <code class=\"code\">aria-invalid</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-switch hint=\"Se aplica de inmediato, sin guardar.\" checked>Sincronización en la nube</iswc-switch>",
            "            <iswc-switch error hint=\"Actívalo para poder facturar electrónicamente.\" required>Firma electrónica</iswc-switch>",
            "            <iswc-switch error checked>",
            "              Modo mantenimiento",
            "              <span slot=\"hint\">El texto de ayuda también admite un <b>slot</b>.</span>",
            "            </iswc-switch>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "form",
      "title": "Dentro de un formulario",
      "lede": [
        "Apagado no aporta entrada al <code class=\"code\">FormData</code>, igual que una casilla nativa. Con",
        "          <code class=\"code\">required</code> reporta <code class=\"code\">valueMissing</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<form id=\"demoForm\">",
            "            <div class=\"stack\">",
            "              <iswc-switch name=\"privacidad\" value=\"si\" required>Acepto la política de privacidad (obligatorio)</iswc-switch>",
            "              <iswc-switch name=\"boletin\" value=\"semanal\" checked>Boletín semanal</iswc-switch>",
            "              <iswc-switch name=\"auditoria\" value=\"si\" checked readonly hint=\"Fijado por la política de la empresa.\">Registro de auditoría</iswc-switch>",
            "              <div class=\"inline\" style=\"gap:.5rem\">",
            "                <iswc-button color=\"brand\" id=\"btnSend\">Enviar</iswc-button>",
            "                <iswc-button variant=\"outlined\" id=\"btnReset\">Reset</iswc-button>",
            "              </div>",
            "            </div>",
            "          </form>"
          ]
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"formLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Envía el formulario para ver el FormData.</div></div>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala por contexto",
      "lede": [
        "Sin atributo <code class=\"code\">size</code>: carril y perilla se miden en <code class=\"code\">em</code> y",
        "          heredan el <code class=\"code\">font-size</code> del contenedor."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"inline\">",
            "            <span style=\"font-size:.8rem\"><iswc-switch checked>0.8rem</iswc-switch></span>",
            "            <span style=\"font-size:1rem\"><iswc-switch checked>1rem</iswc-switch></span>",
            "            <span style=\"font-size:1.35rem\"><iswc-switch checked>1.35rem</iswc-switch></span>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "keyboard",
      "title": "Teclado",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Tecla",
            "Acción"
          ],
          "rows": [
            [
              "<code>Tab</code>",
              "enfoca el interruptor (también con <code>readonly</code>; no con <code>disabled</code>)"
            ],
            [
              "<code>Espacio</code> <code>Enter</code>",
              "alterna encendido / apagado y emite <code>iswc-change</code>"
            ]
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "<code>name</code>",
              "clave en FormData"
            ],
            [
              "<code>value</code>",
              "default <code>on</code>; solo se envía si está encendido"
            ],
            [
              "<code>checked</code>",
              "boolean, reflejado"
            ],
            [
              "<code>disabled</code> <code>readonly</code> <code>required</code> <code>error</code>",
              "boolean"
            ],
            [
              "<code>variant</code>",
              "<code>brand</code> (default) · <code>neutral</code> · <code>success</code> · <code>warning</code> · <code>danger</code>"
            ],
            [
              "<code>label-placement</code>",
              "<code>end</code> (default) · <code>start</code> · <code>top</code> · <code>bottom</code>"
            ],
            [
              "<code>icon</code> <code>checked-icon</code>",
              "iconos <code>iswc-icon</code> dentro de la perilla (apagado / encendido)"
            ],
            [
              "<code>on-label</code> <code>off-label</code>",
              "texto corto dentro del carril"
            ],
            [
              "<code>hint</code>",
              "texto de ayuda bajo el control; también slot <code>hint</code>"
            ],
            [
              "propiedades JS",
              "<code>checked</code> <code>value</code> <code>name</code> <code>variant</code> <code>labelPlacement</code> <code>icon</code> <code>checkedIcon</code> <code>onLabel</code> <code>offLabel</code> <code>hint</code> <code>error</code> <code>readonly</code> <code>disabled</code> <code>required</code>"
            ],
            [
              "slots",
              "default (etiqueta) · <code>hint</code>"
            ],
            [
              "parts",
              "<code>form-control</code> <code>base</code> <code>control</code> <code>track-label</code> <code>thumb</code> <code>mark</code> <code>label</code> <code>hint</code>"
            ],
            [
              "states",
              "<code>:state(checked)</code> <code>:state(disabled)</code> <code>:state(readonly)</code> <code>:state(error)</code>"
            ],
            [
              "eventos",
              "<code>iswc-change</code> · detail <code>{ checked, value }</code>"
            ],
            [
              "métodos",
              "<code>checkValidity()</code> <code>reportValidity()</code> <code>setCustomValidity()</code>"
            ],
            [
              "rol",
              "<code>switch</code> · Espacio y Enter alternan"
            ],
            [
              "tokens",
              "<code>--iswc-switch-height</code> <code>--iswc-switch-width</code> <code>--iswc-switch-bg</code> <code>--iswc-switch-bg-hover</code> <code>--iswc-switch-border</code> <code>--iswc-switch-accent</code> <code>--iswc-switch-thumb</code> <code>--iswc-switch-icon</code> <code>--iswc-switch-icon-checked</code> <code>--iswc-switch-focus</code> <code>--iswc-switch-halo</code>"
            ]
          ]
        }
      ]
    }
  ],
