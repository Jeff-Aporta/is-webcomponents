{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-time-clock",
  "category": "forms",
  "title": "&lt;iswc-time-clock&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-time-clock",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Reloj analógico (TimeClock de MUI X). Arrastra la manecilla, haz clic o usa el teclado. Al soltar avanza de horas a minutos.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-time-clock id=\"tc\" value=\"09:30\" ampm locale=\"en-US\"></iswc-time-clock>\r\n          <iswc-time-clock value=\"14:15\" hour24 locale=\"es\"></iswc-time-clock>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "09:30",
                "14:15",
                "10:00"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:ampm",
              "label": "ampm"
            },
            {
              "control": "select",
              "prop": "attr:locale",
              "label": "locale",
              "options": [
                "en-US",
                "es"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:hour24",
              "label": "hour24"
            },
            {
              "control": "text",
              "prop": "attr:min-time",
              "label": "min-time"
            },
            {
              "control": "text",
              "prop": "attr:max-time",
              "label": "max-time"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\" style=\"font-family:var(--iswc-mono);font-size:.85em\"></p>"
        }
      ]
    },
    {
      "id": "digital",
      "title": "Reloj digital",
      "lede": "Lista (DigitalClock) o columnas (MultiSectionDigitalClock). <code>step</code> controla el intervalo de la lista; <code>minutes-step</code> el de las columnas.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div>\r\n            <div class=\"demo-label\">lista · step=30</div>\r\n            <iswc-digital-clock id=\"dc\" value=\"09:30\" locale=\"es\" step=\"30\"></iswc-digital-clock>\r\n          </div>\r\n          <div>\r\n            <div class=\"demo-label\">columnas · ampm</div>\r\n            <iswc-digital-clock layout=\"sections\" value=\"09:30\" ampm locale=\"en-US\"></iswc-digital-clock>\r\n          </div>\r\n          <div>\r\n            <div class=\"demo-label\">columnas · 24 h + segundos</div>\r\n            <iswc-digital-clock layout=\"sections\" value=\"14:15:00\" hour24 seconds locale=\"es\"></iswc-digital-clock>\r\n          </div>"
        }
      ]
    },
    {
      "id": "limits",
      "title": "Límites",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-time-clock value=\"10:00\" ampm min-time=\"08:00\" max-time=\"18:00\" locale=\"en-US\"></iswc-time-clock>\r\n          <iswc-digital-clock layout=\"sections\" value=\"10:00\" hour24 min-time=\"08:00\" max-time=\"18:00\" skip-disabled locale=\"es\"></iswc-digital-clock>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>iswc-change { value }</code>, <code>iswc-view-change</code> (reloj).",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default"
          ],
          "rows": [
            [
              "<code>value</code>",
              "HH:mm[:ss]"
            ],
            [
              "<code>ampm</code> / <code>hour24</code>",
              "según locale · fuerza 24 h"
            ],
            [
              "<code>seconds</code>",
              "off"
            ],
            [
              "<code>view</code> (reloj)",
              "hours · minutes · seconds"
            ],
            [
              "<code>layout</code> (digital)",
              "list · sections"
            ],
            [
              "<code>step</code> / <code>minutes-step</code>",
              "30 · 5"
            ],
            [
              "<code>min-time</code> / <code>max-time</code>",
              "—"
            ],
            [
              "<code>skip-disabled</code>",
              "off (solo digital)"
            ]
          ]
        }
      ]
    }
  ]
}
