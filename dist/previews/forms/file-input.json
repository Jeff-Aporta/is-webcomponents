{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-file-input",
  "category": "forms",
  "title": "&lt;iswc-file-input&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-file-input",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Dropzone con input nativo oculto, lista de archivos y estados <code class=\"code\">blank</code> / <code class=\"code\">dragging</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-file-input\r\n            id=\"fi\"\r\n            label=\"Adjuntos\"\r\n            hint=\"PDF o imágenes · máx. varios archivos\"\r\n            accept=\"image/*,.pdf\"\r\n            multiple\r\n            name=\"attachments\"\r\n          ></iswc-file-input>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Adjuntos",
                "Avatar"
              ]
            },
            {
              "control": "select",
              "prop": "attr:accept",
              "label": "accept",
              "options": [
                "image/*,.pdf",
                "image/*"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:multiple",
              "label": "multiple"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\">Archivos: 0</p>"
        }
      ]
    },
    {
      "id": "examples",
      "title": "Single + required",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-file-input label=\"Avatar\" accept=\"image/*\" required hint=\"Obligatorio\"></iswc-file-input>"
        },
        {
          "kind": "code",
          "code": "<iswc-file-input\n  label=\"Adjuntos\"\n  accept=\"image/*,.pdf\"\n  multiple\n  name=\"attachments\"\n></iswc-file-input>"
        }
      ]
    },
    {
