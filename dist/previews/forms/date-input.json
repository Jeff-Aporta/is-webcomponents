{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-date-input",
  "category": "forms",
  "title": "<iswc-date-input>",
  "titleHtml": true,
  "storageKey": "docs-iswc-date-input",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Campo + calendario en un panel del top layer (DatePicker de MUI X). Edita por secciones o abre el calendario. Alt+↓ abre el panel.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-input id=\"di\" label=\"Fecha\" value=\"2026-07-30\" locale=\"es\" clearable></iswc-date-input>\r\n          <iswc-date-input label=\"Con barra\" value=\"2026-07-30\" locale=\"es\" action-bar></iswc-date-input>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Fecha",
                "Con barra",
                "Móvil"
              ]
            },
            {
              "control": "text",
              "prop": "attr:value",
              "label": "value"
            },
            {
              "control": "text",
              "prop": "attr:locale",
              "label": "locale"
            },
            {
              "control": "boolean",
              "prop": "attr:clearable",
              "label": "clearable"
            },
            {
              "control": "boolean",
              "prop": "attr:action-bar",
              "label": "action-bar"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\" style=\"font-family:var(--iswc-mono);font-size:.85em\"></p>"
        }
      ]
    },
    {
      "id": "time",
      "title": "Hora",
      "lede": "<code>panel</code> elige la superficie: columnas, lista o reloj analógico.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-time-input label=\"Columnas\" value=\"09:30\" locale=\"es\"></iswc-time-input>\r\n          <iswc-time-input label=\"Lista\" value=\"09:30\" locale=\"es\" panel=\"list\"></iswc-time-input>\r\n          <iswc-time-input label=\"Reloj\" value=\"09:30\" ampm locale=\"en-US\" panel=\"clock\"></iswc-time-input>"
        }
      ]
    },
    {
      "id": "datetime",
      "title": "Fecha y hora",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-time-input id=\"dti\" label=\"Cita\" locale=\"es\" action-bar></iswc-date-time-input>"
        }
      ]
    },
    {
      "id": "range",
      "title": "Rango de fechas",
      "lede": "Dos campos (inicio y fin) con el calendario de rango y atajos en el panel.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-range-input\r\n            id=\"ri\"\r\n            start-label=\"Desde\"\r\n            end-label=\"Hasta\"\r\n            locale=\"es\"\r\n            calendars=\"2\"\r\n            shortcuts=\"this-week last-7-days current-month reset\"\r\n          ></iswc-date-range-input>"
        }
      ]
    },
    {
      "id": "mobile",
      "title": "Variante móvil",
      "lede": "<code>variant=\"mobile\"</code> centra el panel, atenúa el fondo y muestra toolbar + barra de acciones.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-date-input label=\"Móvil\" locale=\"es\" color=\"mobile\" value=\"2026-07-30\"></iswc-date-input>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>iswc-change { value, source }</code>, <code>iswc-show</code>, <code>iswc-hide</code>. Métodos: <code>show()</code>, <code>hide()</code>.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Default"
          ],
          "rows": [
            [
              "<code>value</code>",
              "fecha · HH:mm · fechaTHora · inicio/fin"
            ],
            [
              "<code>variant</code>",
              "desktop · mobile"
            ],
            [
              "<code>action-bar</code>",
              "off (obligatoria en mobile)"
            ],
            [
              "<code>close-on-select</code>",
              "auto (off si hay action-bar)"
            ],
            [
              "<code>placement</code>",
              "bottom-start"
            ],
            [
              "<code>panel</code> (time)",
              "sections · list · clock"
            ],
            [
              "<code>start-label</code> / <code>end-label</code>",
              "solo range"
            ],
            [
              "resto",
              "se reenvían al campo y al panel"
            ]
          ]
        }
      ]
    }
  ]
}
