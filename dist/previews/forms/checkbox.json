{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-checkbox",
  "category": "forms",
  "title": "&lt;iswc-checkbox&gt;",
  "titleHtml": false,
  "styles": ".stack { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }\r\n    .inline { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }\r\n    .placements { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 2rem; }",
  "storageKey": "docs-iswc-checkbox",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Casilla <em>form-associated</em> con paridad funcional con el\r\n          <a href=\"https://mui.com/material-ui/react-checkbox/\" target=\"_blank\" rel=\"noreferrer\">Checkbox de MUI</a>:\r\n          entra en <code class=\"code\">FormData</code> y en la validación nativa del <code class=\"code\">&lt;form&gt;</code>\r\n          sin input oculto, con color por <code class=\"code\">variant</code>, posición de etiqueta, iconos propios y\r\n          estado de error.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-checkbox id=\"ckDemo\" name=\"a\" checked>Marcada</iswc-checkbox>",
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:checked",
              "label": "checked"
            },
            {
              "control": "boolean",
              "prop": "attr:indeterminate",
              "label": "indeterminate"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "neutral",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "select",
              "prop": "attr:label-placement",
              "label": "label-placement",
              "options": [
                "start",
                "top",
                "bottom"
              ]
            },
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "gilad",
                "jason",
                "antoine",
                "lun",
                "mar",
                "mie",
                "jue",
                "vie",
                "si",
                "semanal"
              ]
            },
            {
              "control": "select",
              "prop": "attr:checked-icon",
              "label": "checked-icon",
              "options": [
                "mdi:heart",
                "mdi:bookmark",
                "mdi:star",
                "mdi:check-bold"
              ]
            },
            {
              "control": "text",
              "prop": "attr:indeterminate-icon",
              "label": "indeterminate-icon"
            },
            {
              "control": "boolean",
              "prop": "attr:readonly",
              "label": "readonly"
            },
            {
              "control": "boolean",
              "prop": "attr:error",
              "label": "error"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            }
          ],
          "equivNote": "checked / indeterminate / bloqueo (readonly vs disabled).",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": "<iswc-flowchart open-on-click animation=\"flow\">\n  <script type=\"application/json\">\n  {\n    \"flowchart\": {\n      \"title\": \"iswc-checkbox: estado\",\n      \"direction\": \"TB\",\n      \"nodes\": [\n        {\n          \"id\": \"q\",\n          \"label\": \"indeterminate?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"a\",\n          \"label\": \"tri-state UI\",\n          \"shape\": \"stadium\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"checked?\",\n          \"shape\": \"diamond\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"on → FormData\",\n          \"shape\": \"round\"\n        },\n        {\n          \"id\": \"d\",\n          \"label\": \"off\",\n          \"shape\": \"round\"\n        },\n        {\n          \"id\": \"e\",\n          \"label\": \"readonly / disabled\",\n          \"shape\": \"stadium\"\n        }\n      ],\n      \"edges\": [\n        {\n          \"from\": \"q\",\n          \"to\": \"a\",\n          \"label\": \"si\"\n        },\n        {\n          \"from\": \"q\",\n          \"to\": \"b\",\n          \"label\": \"no\"\n        },\n        {\n          \"from\": \"b\",\n          \"to\": \"c\",\n          \"label\": \"si\"\n        },\n        {\n          \"from\": \"b\",\n          \"to\": \"d\",\n          \"label\": \"no\"\n        },\n        {\n          \"from\": \"c\",\n          \"to\": \"e\"\n        },\n        {\n          \"from\": \"d\",\n          \"to\": \"e\"\n        },\n        {\n          \"from\": \"a\",\n          \"to\": \"e\"\n        }\n      ]\n    }\n  }\n  </script>\n</iswc-flowchart>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">\r\n          El estado indeterminado se limpia en el primer clic, igual que una casilla nativa.\r\n          Al pasar el puntero o al enfocar aparece el halo circular alrededor del control.\r\n        </p>"
        }
      ]
    },
    {
      "id": "color",
      "title": "Color",
      "lede": "<code class=\"code\">variant</code> equivale a la prop <code class=\"code\">color</code> de MUI: redefine el\r\n          acento del control marcado, del halo y del anillo de foco.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-checkbox checked>brand (default)</iswc-checkbox>\r\n            <iswc-checkbox color=\"neutral\" checked>neutral</iswc-checkbox>\r\n            <iswc-checkbox color=\"success\" checked>success</iswc-checkbox>\r\n            <iswc-checkbox color=\"warning\" checked>warning</iswc-checkbox>\r\n            <iswc-checkbox color=\"danger\" checked>danger</iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-checkbox color=\"success\" checked>success</iswc-checkbox>"
        }
      ]
    },
    {
      "id": "label-placement",
      "title": "Posición de la etiqueta",
      "lede": "<code class=\"code\">label-placement</code> equivale a <code class=\"code\">labelPlacement</code> del\r\n          <code class=\"code\">FormControlLabel</code> de MUI.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"placements\">\r\n            <iswc-checkbox checked>end (default)</iswc-checkbox>\r\n            <iswc-checkbox label-placement=\"start\" checked>start</iswc-checkbox>\r\n            <iswc-checkbox label-placement=\"top\" checked>top</iswc-checkbox>\r\n            <iswc-checkbox label-placement=\"bottom\" checked>bottom</iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-checkbox label-placement=\"start\" checked>start</iswc-checkbox>\n<iswc-checkbox label-placement=\"top\" checked>top</iswc-checkbox>"
        }
      ]
    },
    {
      "id": "groups",
      "title": "Grupos",
      "lede": "No hay componente de grupo: <code class=\"code\">iswc-checkbox</code> es <code class=\"code\">inline-flex</code>\r\n          y se apila con el <code class=\"code\">display:flex</code> del contenedor. En columna, alinea\r\n          <code class=\"code\">align-items:flex-start</code> para que el halo no recorte.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-checkbox name=\"g1\" value=\"gilad\" checked>Gilad Gray</iswc-checkbox>\r\n            <iswc-checkbox name=\"g2\" value=\"jason\" checked>Jason Killian</iswc-checkbox>\r\n            <iswc-checkbox name=\"g3\" value=\"antoine\">Antoine Llorca</iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-checkbox name=\"r1\" value=\"lun\" checked>Lun</iswc-checkbox>\r\n            <iswc-checkbox name=\"r2\" value=\"mar\" checked>Mar</iswc-checkbox>\r\n            <iswc-checkbox name=\"r3\" value=\"mie\">Mié</iswc-checkbox>\r\n            <iswc-checkbox name=\"r4\" value=\"jue\">Jue</iswc-checkbox>\r\n            <iswc-checkbox name=\"r5\" value=\"vie\" checked>Vie</iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<div style=\"display:flex;flex-direction:column;align-items:flex-start;gap:.7rem\">\n  <iswc-checkbox name=\"g1\" value=\"gilad\" checked>Gilad Gray</iswc-checkbox>\n  <iswc-checkbox name=\"g2\" value=\"jason\" checked>Jason Killian</iswc-checkbox>\n</div>"
        },
        {
          "kind": "html",
          "html": "<h3>Padre indeterminado</h3>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">Patrón clásico: la casilla padre refleja el estado de los hijos.</p>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-checkbox id=\"parentBox\">Todos los permisos</iswc-checkbox>\r\n            <div class=\"stack\" style=\"padding-left:1.6rem\">\r\n              <iswc-checkbox class=\"childBox\" checked>Lectura</iswc-checkbox>\r\n              <iswc-checkbox class=\"childBox\">Escritura</iswc-checkbox>\r\n              <iswc-checkbox class=\"childBox\">Borrado</iswc-checkbox>\r\n            </div>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "const all = children.every(c => c.checked);\nparent.checked = all;\nparent.indeterminate = !all && children.some(c => c.checked);"
        }
      ]
    },
    {
      "id": "icons",
      "title": "Iconos personalizados",
      "lede": "<code class=\"code\">icon</code>, <code class=\"code\">checked-icon</code> e\r\n          <code class=\"code\">indeterminate-icon</code> reciben nombres de <code class=\"code\">iswc-icon</code>\r\n          (Iconify). Al definir <code class=\"code\">icon</code> el control pierde la caja y queda solo el glifo,\r\n          como el ejemplo de iconos de MUI. Sin estos atributos el <em>look</em> por defecto es el check dibujado.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-checkbox icon=\"mdi:heart-outline\" checked-icon=\"mdi:heart\" color=\"danger\" checked>Favorito</iswc-checkbox>\r\n            <iswc-checkbox icon=\"mdi:bookmark-outline\" checked-icon=\"mdi:bookmark\">Guardar</iswc-checkbox>\r\n            <iswc-checkbox icon=\"mdi:star-outline\" checked-icon=\"mdi:star\" color=\"warning\" checked>Destacar</iswc-checkbox>\r\n            <iswc-checkbox checked-icon=\"mdi:check-bold\" indeterminate-icon=\"mdi:dots-horizontal\" indeterminate>Con caja</iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-checkbox icon=\"mdi:heart-outline\" checked-icon=\"mdi:heart\" color=\"danger\" checked>\n  Favorito\n</iswc-checkbox>"
        }
      ]
    },
    {
      "id": "readonly",
      "title": "Solo lectura y deshabilitada",
      "lede": "<code class=\"code\">readonly</code> bloquea el cambio pero mantiene el valor en el formulario y el foco\r\n          navegable con <code class=\"code\">Tab</code>. <code class=\"code\">disabled</code> saca el control del orden\r\n          de tabulación y no aporta entrada al <code class=\"code\">FormData</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <iswc-checkbox name=\"ro1\" checked readonly>Solo lectura (marcada)</iswc-checkbox>\r\n            <iswc-checkbox name=\"ro2\" readonly>Solo lectura (sin marcar)</iswc-checkbox>\r\n            <iswc-checkbox name=\"di1\" checked disabled>Deshabilitada</iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-checkbox name=\"ro1\" checked readonly>Solo lectura</iswc-checkbox>"
        }
      ]
    },
    {
      "id": "error",
      "title": "Error y texto de ayuda",
      "lede": "<code class=\"code\">hint</code> pinta un texto bajo el control (atributo o slot homónimo).\r\n          <code class=\"code\">error</code> tiñe control y ayuda con el color de peligro y marca\r\n          <code class=\"code\">aria-invalid</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"stack\">\r\n            <iswc-checkbox hint=\"Puedes cambiarlo más tarde en Ajustes.\">Recibir novedades</iswc-checkbox>\r\n            <iswc-checkbox error hint=\"Debes aceptar los términos para continuar.\" required>Acepto los términos</iswc-checkbox>\r\n            <iswc-checkbox error checked>\r\n              Consentimiento revocado\r\n              <span slot=\"hint\">El texto de ayuda también admite un <b>slot</b>.</span>\r\n            </iswc-checkbox>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-checkbox error hint=\"Debes aceptar los términos para continuar.\" required>\n  Acepto los términos\n</iswc-checkbox>"
        }
      ]
    },
    {
      "id": "form",
      "title": "Dentro de un formulario",
      "lede": "Sin marcar no aporta entrada al <code class=\"code\">FormData</code>. Con\r\n          <code class=\"code\">required</code> reporta <code class=\"code\">valueMissing</code> y bloquea el envío.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<form id=\"demoForm\">\r\n            <div class=\"stack\">\r\n              <iswc-checkbox name=\"terminos\" value=\"si\" required>Acepto los términos (obligatorio)</iswc-checkbox>\r\n              <iswc-checkbox name=\"boletin\" value=\"semanal\">Recibir boletín</iswc-checkbox>\r\n              <iswc-checkbox name=\"archivado\" value=\"si\" checked readonly hint=\"Fijado por la política de la empresa.\">Archivar copia</iswc-checkbox>\r\n              <div class=\"inline\" style=\"gap:.5rem\">\r\n                <iswc-button color=\"brand\" id=\"btnSend\">Enviar</iswc-button>\r\n                <iswc-button variant=\"outlined\" id=\"btnReset\">Reset</iswc-button>\r\n              </div>\r\n            </div>\r\n          </form>"
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"formLog\" aria-live=\"polite\" style=\"margin-top:12px\"><div class=\"row hint\">Envía el formulario para ver el FormData.</div></div>"
        },
        {
          "kind": "code",
          "code": "<iswc-checkbox name=\"terminos\" value=\"si\" required>\n  Acepto los términos\n</iswc-checkbox>"
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala por contexto",
      "lede": "Sin atributo <code class=\"code\">size</code>: el control mide <code class=\"code\">1.15em</code> y hereda el\r\n          <code class=\"code\">font-size</code> del contenedor.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"inline\">\r\n            <span style=\"font-size:.8rem\"><iswc-checkbox checked>0.8rem</iswc-checkbox></span>\r\n            <span style=\"font-size:1rem\"><iswc-checkbox checked>1rem</iswc-checkbox></span>\r\n            <span style=\"font-size:1.35rem\"><iswc-checkbox checked>1.35rem</iswc-checkbox></span>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<span style=\"font-size:1.35rem\"><iswc-checkbox checked>Grande</iswc-checkbox></span>"
        }
      ]
    },
    {
      "id": "keyboard",
      "title": "Teclado",
      "blocks": [
