{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-mention",
  "category": "forms",
  "title": "&lt;iswc-mention&gt;",
  "titleHtml": false,
  "styles": [
    ".mention-wrap { padding: 1.25rem; border: 1px solid var(--iswc-border); border-radius: var(--iswc-radius); background: var(--iswc-bg-elev); }",
    "    .mention-wrap > iswc-mention { width: 100%; }",
    "    pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 9rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-mention",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Input con autocompletado al tipear <code class=\"code\">@</code> (usuario) o <code class=\"code\">#</code> (etiqueta). Popup se posiciona y se navega con flechas + Enter.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"mention-wrap\">",
            "            <label for=\"cmt\" style=\"font-size:.85rem;display:block;margin-bottom:.35rem;color:var(--iswc-text-soft)\">Comentario</label>",
            "            <iswc-mention id=\"cmt\" trigger=\"@#\" placeholder=\"Escribe @ o # para autocompletar…\">",
            "              <script type=\"application/json\">",
            "                {",
            "                  \"@\": [\"Ana Ramírez\", \"Pedro Castaño\", \"Sofía Velez\", \"Jorge Arias\", \"Lina Mora\", \"Camilo Pérez\", \"Valentina López\"],",
            "                  \"#\": [\"urgente\", \"bug\", \"idea\", \"blocked\", \"wip\", \"ready-to-ship\", \"tech-debt\"]",
            "                }",
            "              </script>",
            "            </iswc-mention>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:trigger",
              "label": "trigger",
              "options": [
                "@#",
                "@"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "trigger",
      "title": "Disparador personalizable",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Limitá los triggers con el atributo <code class=\"code\">trigger</code>.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"mention-wrap\">",
            "            <label style=\"font-size:.85rem;display:block;margin-bottom:.35rem;color:var(--iswc-text-soft)\">Solo usuarios</label>",
            "            <iswc-mention trigger=\"@\" placeholder=\"Escribe @ para nombrar…\">",
            "              <script type=\"application/json\">",
            "                { \"@\": [\"Ana\", \"Pedro\", \"Sofía\", \"Jorge\", \"Lina\", \"Camilo\"] }",
            "              </script>",
            "            </iswc-mention>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const m = document.querySelector('iswc-mention');",
            "m.value;          // string con tokens ya insertos: \"uy @Ana esto es #urgente\"",
            "m.suggestions;    // { \"@\": [...], \"#\": [...] }",
            "m.addEventListener('iswc-select', e => {",
            "  console.log('elegiste:', e.detail.trigger, e.detail.item, e.detail.range);",
            "});",
            "",
            "// Sugerencias vía propiedad (alternativa al script)",
            "m.suggestions = { '@': persons, '#': tags };",
            "",
            "// Atributos:",
            "// trigger   caracteres que abren el popup (default \"@#\")",
            "// max-items tope del popup (default 8)"
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\"></pre>"
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Input con autocompletado al tipear <code class=\"code\">@</code> (usuario) o <code class=\"code\">#</code> (etiqueta). Popup se posiciona y se navega con flechas + Enter."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
