{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-duration-picker",
  "category": "forms",
  "title": "&lt;iswc-duration-picker&gt;",
  "titleHtml": false,
  "styles": [
    "pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 6rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-duration-picker",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Duración HH:MM:SS. Tres columnas con botones ±, inputs numéricos y saltos con <kbd class=\"ic\">:</kbd> o <kbd class=\"ic\">Tab</kbd>.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-duration-picker id=\"dur\" value=\"3725\"></iswc-duration-picker>",
            "          <p class=\"kbd-hint\" style=\"color:var(--iswc-text-soft); font-size:.78rem; margin-top:.5rem\">",
            "            <code>value=\"3725\"</code> = 1h 02m 05s",
            "          </p>"
          ],
          "controls": [
            {
              "control": "number",
              "prop": "attr:value",
              "label": "value",
              "min": 0,
              "max": 3725,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:min",
              "label": "min",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:max",
              "label": "max",
              "min": 0,
              "max": 5400,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:step",
              "label": "step",
              "min": 0,
              "max": 100,
              "step": 1
            }
          ]
        }
      ]
    },
    {
      "id": "limites",
      "title": "Con límites",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-duration-picker min=\"60\" max=\"5400\" step=\"5\" value=\"600\"></iswc-duration-picker>",
            "          <p class=\"kbd-hint\" style=\"color:var(--iswc-text-soft); font-size:.78rem\">De 1 minuto a 1:30:00, paso de 5 segundos.</p>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const d = document.querySelector('iswc-duration-picker');",
            "d.value;        // segundos totales",
            "d.text;        // \"01:02:05\" o \"02:05\" si hours=0",
            "d.hours; d.minutes; d.seconds;",
            "d.tick(30);    // suma 30 segundos respetando límites",
            "d.setSeconds(3600);",
            "d.set(1, 30, 0);",
            "",
            "d.addEventListener('iswc-change', e => console.log(e.detail.value, e.detail.text));",
            "",
            "// Atributos",
            "// value, min, max  límites en segundos",
            "// step             incremento del botón (default 1)"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Duración HH:MM:SS. Tres columnas con botones ±, inputs numéricos y saltos con <kbd class=\"ic\">:</kbd> o <kbd class=\"ic\">Tab</kbd>."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
