{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-doc-editor",
  "category": "forms",
  "title": "&lt;iswc-doc-editor&gt;",
  "titleHtml": false,
  "styles": [
    "pre.output {",
    "      font-family: ui-monospace, monospace; font-size: .78rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .65rem .85rem;",
    "      max-height: 14rem; overflow: auto;",
    "      white-space: pre-wrap;",
    "    }",
    "    .kbd-hint {",
    "      font-size: .78rem; color: var(--iswc-text-soft);",
    "    }",
    "    .kbd-hint kbd {",
    "      font-family: ui-monospace, monospace; font-size: .72rem;",
    "      padding: 1px 5px;",
    "      border-radius: 4px;",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg-elev);",
    "    }"
  ],
  "storageKey": "docs-iswc-doc-editor",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Editor por bloques tipo Notion. Escribe <kbd class=\"ic\">/</kbd> al inicio de una línea para cambiar el tipo. <kbd class=\"ic\">Enter</kbd> crea otro bloque, <kbd class=\"ic\">Backspace</kbd> sobre texto vacío elimina.",
      "blocks": []
    },
    {
      "id": "basico",
      "title": "Básico",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-doc-editor id=\"doc\" placeholder=\"Escribe algo…\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"type\": \"heading-1\", \"text\": \"Bitácora de julio\" },",
            "                { \"type\": \"paragraph\", \"text\": \"Resumen del cierre mensual. Edita lo que necesites.\" },",
            "                { \"type\": \"heading-2\", \"text\": \"Por hacer\" },",
            "                { \"type\": \"todo\", \"text\": \"Cruzar facturas con el banco\", \"checked\": true },",
            "                { \"type\": \"todo\", \"text\": \"Revisar depreciaciones\" },",
            "                { \"type\": \"todo\", \"text\": \"Pasar al board de cierre\" },",
            "                { \"type\": \"divider\" },",
            "                { \"type\": \"heading-2\", \"text\": \"Notas\" },",
            "                { \"type\": \"bullet-list\", \"text\": \"Cartera con morosidad al alza\" },",
            "                { \"type\": \"bullet-list\", \"text\": \"Inventario estable, revisar lento\" },",
            "                { \"type\": \"quote\",     \"text\": \"Lo importante se hizo; lo urgente se va acumulando.\" },",
            "                { \"type\": \"code\",      \"text\": \"SELECT sum(saldo) FROM cartera WHERE vencida = true;\" }",
            "              ]",
            "            </script>",
            "          </iswc-doc-editor>"
          ]
        }
      ]
    },
    {
      "id": "json",
      "title": "JSON actual",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"code output\" id=\"out\" data-lang=\"javascript\"></pre>"
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const doc = document.querySelector('iswc-doc-editor');",
            "doc.value;          // string JSON",
            "doc.blocks;         // array vivo",
            "doc.addBlock('paragraph');",
            "doc.removeBlock(id);",
            "doc.updateBlock(id, { text: '…' });",
            "doc.addEventListener('iswc-change', e => console.log(e.detail.blocks));",
            "",
            "// Atajos en bloques",
            "// Enter          crear bloque del mismo tipo",
            "// Backspace      eliminar bloque si está vacío",
            "// \"/\" inicio     abre menú de tipos (heading-1..3, list, todo, quote, code, divider)",
            "// Shift+Enter    salto de línea dentro del bloque"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Editor por bloques tipo Notion. Escribe <kbd class=\"ic\">/</kbd> al inicio de una línea para cambiar el tipo. <kbd class=\"ic\">Enter</kbd> crea otro bloque, <kbd class=\"ic\">Backspace</kbd> sobre texto vacío elimina."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
