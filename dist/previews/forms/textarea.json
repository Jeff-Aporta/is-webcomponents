{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-textarea",
  "category": "forms",
  "title": "&lt;iswc-textarea&gt;",
  "titleHtml": false,
  "styles": [
    ".stack { display: grid; gap: 1.25rem; max-width: 30rem; }",
    "    .actions { display: flex; gap: 0.5rem; margin-top: 1rem; }"
  ],
  "storageKey": "docs-iswc-textarea",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Área de texto form-associated con las mismas piezas que",
        "          <a href=\"https://mui.com/material-ui/react-text-field/\" target=\"_blank\" rel=\"noreferrer\">TextField</a>",
        "          en modo <em>multiline</em> y el crecimiento automático de",
        "          <a href=\"https://mui.com/material-ui/react-textarea-autosize/\" target=\"_blank\" rel=\"noreferrer\">TextareaAutosize</a>:",
        "          appearances, error, contador y <code class=\"code\">autosize</code> con",
        "          <code class=\"code\">min-rows</code> / <code class=\"code\">max-rows</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-textarea id=\"demo\" label=\"Descripción\" hint=\"Máximo 200 caracteres\" maxlength=\"200\" show-count rows=\"4\" placeholder=\"Cuéntanos…\" name=\"descripcion\"></iswc-textarea>",
          "controls": [
            {
              "control": "number",
              "prop": "attr:maxlength",
              "label": "maxlength",
              "min": 0,
              "max": 500,
              "step": 1
            },
            {
              "control": "boolean",
              "prop": "attr:show-count",
              "label": "show-count"
            },
            {
              "control": "number",
              "prop": "attr:rows",
              "label": "rows",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:variant",
              "label": "variant",
              "options": [
                "filled",
                "underlined"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:autosize",
              "label": "autosize"
            },
            {
              "control": "number",
              "prop": "attr:min-rows",
              "label": "min-rows",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:max-rows",
              "label": "max-rows",
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:resize",
              "label": "resize",
              "options": [
                "none",
                "vertical",
                "both",
                "auto"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:alias",
              "label": "alias"
            },
            {
              "control": "boolean",
              "prop": "attr:de",
              "label": "de"
            },
            {
              "control": "boolean",
              "prop": "attr:error",
              "label": "error"
            },
            {
              "control": "boolean",
              "prop": "attr:required",
              "label": "required"
            },
            {
              "control": "boolean",
              "prop": "attr:full-width",
              "label": "full-width"
            },
            {
              "control": "text",
              "prop": "attr:label-placement",
              "label": "label-placement"
            },
            {
              "control": "boolean",
              "prop": "attr:readonly",
              "label": "readonly"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"log\">0 caracteres</p>"
        }
      ]
    },
    {
      "id": "appearance",
      "title": "Appearance",
      "lede": [
        "Mismas variantes que <code class=\"code\">iswc-input</code>:",
        "          <code class=\"code\">outlined</code> (default) · <code class=\"code\">filled</code> ·",
        "          <code class=\"code\">underlined</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-textarea label=\"outlined (default)\" rows=\"2\" placeholder=\"Caja con borde completo\"></iswc-textarea>",
            "            <iswc-textarea variant=\"filled\" label=\"filled\" rows=\"2\" placeholder=\"Superficie + línea inferior\"></iswc-textarea>",
            "            <iswc-textarea variant=\"underlined\" label=\"underlined\" rows=\"2\" placeholder=\"Solo línea inferior\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "autosize",
      "title": "Autosize",
      "lede": [
        "<code class=\"code\">autosize</code> hace que la altura siga al contenido. Se mide el",
        "          <code class=\"code\">scrollHeight</code> real del textarea (sin clones ni librerías) y se acota entre",
        "          <code class=\"code\">min-rows</code> y <code class=\"code\">max-rows</code>; al pasar de",
        "          <code class=\"code\">max-rows</code> aparece el scroll. Sin <code class=\"code\">min-rows</code>",
        "          el mínimo es el valor de <code class=\"code\">rows</code>.",
        "          Con autosize el <em>resize</em> manual se desactiva: pelearía con la altura calculada."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-textarea autosize min-rows=\"2\" label=\"min-rows 2 · sin techo\" placeholder=\"Escribe varias líneas y mira cómo crece…\"></iswc-textarea>",
            "            <iswc-textarea autosize min-rows=\"3\" max-rows=\"6\" label=\"min-rows 3 · max-rows 6\"",
            "              hint=\"A partir de 6 líneas hace scroll\"",
            "              value=\"Uno&#10;Dos&#10;Tres&#10;Cuatro\"></iswc-textarea>",
            "            <iswc-textarea resize=\"auto\" min-rows=\"1\" max-rows=\"4\" label='resize=\"auto\" (alias de autosize)' placeholder=\"Empieza en una línea\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "resize",
      "title": "Resize",
      "lede": [
        "<code class=\"code\">resize</code>: <code class=\"code\">none</code> ·",
        "          <code class=\"code\">vertical</code> (default) · <code class=\"code\">both</code> ·",
        "          <code class=\"code\">auto</code> (autosize)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-textarea label=\"none\" resize=\"none\" rows=\"3\" value=\"El usuario no puede redimensionar.\"></iswc-textarea>",
            "            <iswc-textarea label=\"vertical (default)\" rows=\"3\" placeholder=\"Arrastra el borde inferior\"></iswc-textarea>",
            "            <iswc-textarea label=\"both\" resize=\"both\" rows=\"3\" placeholder=\"Arrastra la esquina\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "counter",
      "title": "Contador de caracteres",
      "lede": [
        "<code class=\"code\">show-count</code> pinta <code class=\"code\">n/maxlength</code> a la derecha de la",
        "          fila del hint; sin <code class=\"code\">maxlength</code>, solo <code class=\"code\">n</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-textarea label=\"Reseña\" maxlength=\"120\" show-count rows=\"3\" hint=\"Cuenta tu experiencia\" value=\"Muy buena atención.\"></iswc-textarea>",
            "            <iswc-textarea label=\"Sin límite\" show-count rows=\"2\" placeholder=\"Escribe algo…\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "validation",
      "title": "Error y validación",
      "lede": [
        "<code class=\"code\">error</code> fuerza el estado de peligro y <code class=\"code\">error-text</code>",
        "          sustituye al <code class=\"code\">hint</code>. Sin forzarlo, el campo entra en error cuando la",
        "          validación nativa (<code class=\"code\">required</code>, <code class=\"code\">maxlength</code>) falla tras",
        "          la primera interacción; si no diste <code class=\"code\">error-text</code>, se muestra el mensaje del",
        "          navegador. El estado se expone como <code class=\"code\">:state(invalid)</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-textarea label=\"Error forzado\" error error-text=\"El comentario contiene términos no permitidos\"",
            "              rows=\"2\" value=\"Texto rechazado por el backend\"></iswc-textarea>",
            "            <iswc-textarea label=\"Error sin error-text\" error hint=\"El hint se pinta en rojo\" rows=\"2\"></iswc-textarea>",
            "            <iswc-textarea id=\"autoErr\" label=\"Obligatorio (sal del campo)\" required rows=\"2\"",
            "              hint=\"Se valida al perder el foco\" error-text=\"Este comentario es obligatorio\"></iswc-textarea>",
            "          </div>",
            "          <div class=\"actions\">",
            "            <button type=\"button\" id=\"btnReport\">Validar</button>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "width",
      "title": "Ancho",
      "lede": [
        "Mismo token que <code class=\"code\">iswc-input</code>: <code class=\"code\">--iswc-field-width</code>",
        "          (heredable) y <code class=\"code\">full-width</code> para ocupar todo el ancho disponible."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:grid; gap:1.25rem; --iswc-field-width:18rem;\">",
            "            <iswc-textarea label=\"--iswc-field-width: 18rem\" rows=\"2\" placeholder=\"Heredado del contenedor\"></iswc-textarea>",
            "            <iswc-textarea label=\"full-width\" full-width rows=\"2\" placeholder=\"Ignora el token\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "label-placement",
      "title": "Label a la izquierda",
      "lede": [
        "<code class=\"code\">label-placement=\"start\"</code> para formularios horizontales.",
        "          El label se alinea con la primera línea del textarea y",
        "          <code class=\"code\">--iswc-field-label-width</code> fija su columna."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:grid; gap:0.75rem; --iswc-field-label-width:7rem; max-width:34rem;\">",
            "            <iswc-textarea label-placement=\"start\" label=\"Asunto\" full-width rows=\"1\"></iswc-textarea>",
            "            <iswc-textarea label-placement=\"start\" label=\"Mensaje\" full-width autosize min-rows=\"3\" max-rows=\"8\"",
            "              hint=\"Crece con el texto\" show-count maxlength=\"500\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "states",
      "title": "Estados",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stack\">",
            "            <iswc-textarea label=\"Solo lectura\" readonly rows=\"2\" value=\"Contenido fijo\"></iswc-textarea>",
            "            <iswc-textarea label=\"Deshabilitado\" disabled rows=\"2\" value=\"Sin acceso\"></iswc-textarea>",
            "            <iswc-textarea variant=\"filled\" label=\"filled · readonly\" readonly rows=\"2\" value=\"Contenido fijo\"></iswc-textarea>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "form",
      "title": "Dentro de un formulario",
      "lede": "FormData: —",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<form id=\"f\" style=\"display:grid; gap:0.75rem; max-width:30rem;\">",
            "            <iswc-textarea name=\"comentario\" label=\"Comentario\" required autosize min-rows=\"3\" max-rows=\"8\"",
            "              maxlength=\"300\" show-count error-text=\"El comentario es obligatorio\"></iswc-textarea>",
            "            <div class=\"actions\">",
            "              <button type=\"submit\">Enviar</button>",
            "              <button type=\"reset\">Reset</button>",
            "            </div>",
            "          </form>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3>Atributos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Detalle"
          ],
          "rows": [
            [
              "<code>appearance</code>",
              "<code>outlined</code> (default) · <code>filled</code> · <code>underlined</code>"
            ],
            [
              "<code>label-placement</code>",
              "<code>top</code> (default) · <code>start</code>"
            ],
            [
              "<code>name</code> <code>value</code> <code>placeholder</code>",
              "string"
            ],
            [
              "<code>label</code> <code>hint</code>",
              "texto o slots homónimos"
            ],
            [
              "<code>error-text</code>",
              "mensaje que sustituye al <code>hint</code> cuando hay error"
            ],
            [
              "<code>rows</code>",
              "filas visibles (default 3)"
            ],
            [
              "<code>resize</code>",
              "<code>none</code> · <code>vertical</code> (default) · <code>both</code> · <code>auto</code>"
            ],
            [
              "<code>min-rows</code> <code>max-rows</code>",
              "límites del autosize; <code>min-rows</code> cae en <code>rows</code>"
            ],
            [
              "<code>maxlength</code>",
              "límite de caracteres (pasa al textarea nativo)"
            ],
            [
              "<code>autosize</code>",
              "boolean · altura pegada al contenido (= <code>resize=\"auto\"</code>)"
            ],
            [
              "<code>disabled</code> <code>required</code> <code>readonly</code>",
              "boolean"
            ],
            [
              "<code>error</code>",
              "boolean · fuerza el estado visual de peligro"
            ],
            [
              "<code>show-count</code>",
              "boolean · contador <code>n/maxlength</code> (o <code>n</code>)"
            ],
            [
              "<code>full-width</code>",
              "boolean · 100% del ancho disponible, ignora <code>--iswc-field-width</code>"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Propiedades y métodos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "<code>value</code> <code>defaultValue</code>",
              "valor actual · valor del atributo <code>value</code> (el del reset)"
            ],
            [
              "<code>appearance</code> <code>labelPlacement</code> <code>resize</code>",
              "sanitizan valores no válidos al default"
            ],
            [
              "<code>autosize</code> <code>minRows</code> <code>maxRows</code>",
              "<code>autosize</code> devuelve <code>true</code> también con <code>resize=\"auto\"</code>"
            ],
            [
              "<code>error</code> <code>errorText</code> <code>showCount</code> <code>fullWidth</code>",
              "reflejan sus atributos"
            ],
            [
              "<code>textarea</code>",
              "el <code>&lt;textarea&gt;</code> nativo interno"
            ],
            [
              "<code>validity</code> <code>validationMessage</code> <code>willValidate</code>",
              "espejo de <code>ElementInternals</code>"
            ],
            [
              "<code>focus()</code> <code>blur()</code> <code>select()</code> <code>setSelectionRange()</code>",
              "delegan en el textarea interno"
            ],
            [
              "<code>checkValidity()</code> <code>reportValidity()</code> <code>setCustomValidity()</code>",
              "<code>reportValidity()</code> además marca el campo como tocado"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Slots, parts y estados</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "slots",
              "<code>label</code> <code>hint</code>"
            ],
            [
              "parts",
              "<code>form-control</code> <code>label</code> <code>base</code> <code>textarea</code> <code>support</code> <code>hint</code> <code>error-text</code> <code>count</code>"
            ],
            [
              "states",
              "<code>blank</code> <code>disabled</code> <code>readonly</code> <code>focused</code> <code>invalid</code>"
            ],
            [
              "events",
              "<code>iswc-input</code> <code>iswc-change</code> (<code>detail.value</code>) + nativos <code>input</code> / <code>change</code>"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Tokens</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Token",
            "Detalle"
          ],
          "rows": [
            [
              "<code>--iswc-field-width</code>",
              "ancho del control (default <code>auto</code>); heredable desde el contenedor"
            ],
            [
              "<code>--iswc-field-label-width</code>",
              "columna del label con <code>label-placement=\"start\"</code>"
            ],
            [
              "<code>--iswc-textarea-bg</code> <code>--iswc-textarea-border</code> <code>--iswc-textarea-text</code>",
              "caen en <code>--iswc-control-*</code>"
            ],
            [
              "<code>--iswc-textarea-border-radius</code> <code>--iswc-textarea-focus</code>",
              "caen en <code>--iswc-radius-sm</code> / <code>--iswc-focus</code>"
            ],
            [
              "<code>--iswc-textarea-danger</code> <code>--iswc-textarea-danger-text</code>",
              "borde y texto del estado de error"
            ]
          ]
        }
      ]
    }
  ],
