{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-command-palette",
  "category": "overlays",
  "title": "&lt;iswc-command-palette&gt;",
  "titleHtml": false,
  "styles": [
    ".hero-cmd {",
    "      position: relative;",
    "      min-height: 22rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      display: grid; place-items: center;",
    "      text-align: center;",
    "      padding: 1rem;",
    "    }",
    "    .hero-cmd h3 { margin: 0; font-size: 1.4rem; }",
    "    .hero-cmd kbd {",
    "      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;",
    "      font-size: .85rem;",
    "      padding: .15rem .5rem;",
    "      border-radius: 6px;",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg-elev);",
    "    }",
    "    .trigger-btn {",
    "      margin-top: .85rem;",
    "      font: inherit;",
    "      padding: .55rem 1rem;",
    "      border-radius: 999px;",
    "      border: 1px solid var(--iswc-border);",
    "      background: var(--iswc-bg-elev);",
    "      color: inherit;",
    "      cursor: pointer;",
    "    }",
    "    .trigger-btn:hover { border-color: var(--iswc-accent); color: var(--iswc-accent); }"
  ],
  "storageKey": "docs-iswc-command-palette",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Paleta modal al estilo <kbd>⌘K</kbd> / <kbd>Ctrl</kbd>+<kbd>K</kbd>. Búsqueda difusa sobre una lista de comandos configurada vía JSON.",
      "blocks": []
    },
    {
      "id": "demo",
      "title": "Pruébalo",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"hero-cmd\">",
            "            <div>",
            "              <h3>Busca un comando</h3>",
            "              <p style=\"color:var(--iswc-text-soft)\">Pulsa <kbd>⌘K</kbd> / <kbd>Ctrl+K</kbd>, o:</p>",
            "              <button class=\"trigger-btn\" id=\"openBtn\">Abrir paleta</button>",
            "            </div>",
            "          </div>",
            "          <iswc-command-palette id=\"cmd\" placeholder=\"Buscar comando…\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"id\": \"new\",          \"title\": \"Nuevo documento\", \"group\": \"Archivo\",    \"icon\": \"mdi:file-plus-outline\",    \"hint\": \"Crear archivo en blanco\", \"keywords\": [\"crear\", \"blank\"], \"keys\": [\"Ctrl\", \"N\"] },",
            "                { \"id\": \"open\",         \"title\": \"Abrir…\",          \"group\": \"Archivo\",    \"icon\": \"mdi:folder-open-outline\", \"hint\": \"Abrir archivo existente\", \"keys\": [\"Ctrl\", \"O\"] },",
            "                { \"id\": \"save\",         \"title\": \"Guardar\",         \"group\": \"Archivo\",    \"icon\": \"mdi:content-save-outline\", \"hint\": \"Guardar el archivo actual\", \"keys\": [\"Ctrl\", \"S\"] },",
            "                { \"id\": \"export-pdf\",   \"title\": \"Exportar PDF\",    \"group\": \"Archivo\",    \"icon\": \"mdi:file-pdf-box\",        \"hint\": \"PDF listo para enviar\" },",
            "                { \"id\": \"duplicate\",    \"title\": \"Duplicar\",        \"group\": \"Edición\",    \"icon\": \"mdi:content-duplicate\",   \"hint\": \"Clonar y abrir nueva pestaña\", \"keys\": [\"Ctrl\", \"D\"] },",
            "                { \"id\": \"rename\",       \"title\": \"Renombrar\",       \"group\": \"Edición\",    \"icon\": \"mdi:rename-box\",         \"hint\": \"Cambiar el nombre del archivo\", \"keys\": [\"F2\"] },",
            "                { \"id\": \"find\",         \"title\": \"Buscar en archivo\", \"group\": \"Edición\",  \"icon\": \"mdi:magnify\",            \"hint\": \"Abre el editor de búsqueda\", \"keys\": [\"Ctrl\", \"F\"] },",
            "                { \"id\": \"palette\",      \"title\": \"Cambiar paleta\",  \"group\": \"Apariencia\", \"icon\": \"mdi:palette-swatch-outline\", \"hint\": \"Cambiar tema de marca\" },",
            "                { \"id\": \"toggle-theme\", \"title\": \"Tema claro/oscuro\", \"group\": \"Apariencia\", \"icon\": \"mdi:theme-light-dark\", \"hint\": \"Alternar modo claro y oscuro\", \"keys\": [\"Ctrl\", \"Shift\", \"L\"] },",
            "                { \"id\": \"logout\",       \"title\": \"Cerrar sesión\",   \"group\": \"Sesión\",     \"icon\": \"mdi:logout\",             \"hint\": \"Salir de la cuenta actual\" }",
            "              ]",
            "            </script>",
            "          </iswc-command-palette>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const cm = document.querySelector('iswc-command-palette');",
            "cm.open();",
            "cm.close();",
            "cm.toggle();",
            "",
            "cm.addEventListener('iswc-select', e => console.log(e.detail.command.title));",
            "cm.addEventListener('iswc-open',   () => ...);",
            "cm.addEventListener('iswc-close',  () => ...);",
            "",
            "// Atributos",
            "// hotkey        \"mod+k\" (default), \"ctrl+k\", \"cmd+k\", \"mod+/\", \"\" (desactivado)",
            "// placeholder   texto del input",
            "// max-results   tope de resultados (default 12)",
            "// empty-text    texto cuando no hay resultados",
            "",
            "// Comandos vía <script type=\"application/json\">:",
            "// { id, title, group, icon, hint, keys?/shortcut?, keywords?, disabled? }",
            "// keys: string | string[]  → chips <kbd> a la derecha de cada fila",
            "// Footer: atajos ↑↓/↵/Esc van embebidos; slot=\"footer\" suma contenido extra"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Paleta modal al estilo <kbd>⌘K</kbd> / <kbd>Ctrl</kbd>+<kbd>K</kbd>. Búsqueda difusa sobre una lista de comandos configurada vía JSON."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
