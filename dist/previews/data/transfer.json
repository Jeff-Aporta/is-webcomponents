{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-transfer",
  "category": "data",
  "title": "&lt;iswc-transfer&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-transfer / iswc-transfer-item de InSoft.",
  "storageKey": "docs-iswc-transfer",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Doble lista de selección tipo Material/Ant. Mueve elementos entre",
        "          origen y destino con botones, click individual, filtro de búsqueda y",
        "          límite máximo configurable."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-transfer id=\"tr1\" source-title=\"Disponibles\" target-title=\"Asignados\" searchable>",
            "            <iswc-transfer-item value=\"a\">Alpha</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"b\" selected>Beta</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"c\">Gamma</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"d\">Delta</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"e\">Epsilon</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"f\">Zeta</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"g\">Eta</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"h\">Theta</iswc-transfer-item>",
            "          </iswc-transfer>",
            "          <p id=\"tr1Log\">Seleccionados: <code class=\"code\">b</code></p>"
          ]
        }
      ]
    },
    {
      "id": "max-target",
      "title": "Límite en target",
      "lede": "Con <code class=\"code\">max-target=\"3\"</code> el botón hacia target se desactiva al llegar.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-transfer max-target=\"3\" source-title=\"Suscriptores\" target-title=\"Newsletter (máx 3)\" searchable>",
            "            <iswc-transfer-item value=\"a\">Alice</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"b\">Bob</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"c\" selected>Carol</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"d\">David</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"e\">Eve</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"f\">Frank</iswc-transfer-item>",
            "          </iswc-transfer>"
          ]
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Disabled",
      "lede": "Con <code class=\"code\">disabled</code> en algunos items.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-transfer source-title=\"Permisos\" target-title=\"Asignados\">",
            "            <iswc-transfer-item value=\"read\">read</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"write\" selected>write</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"delete\" disabled>delete</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"admin\">admin</iswc-transfer-item>",
            "          </iswc-transfer>"
          ]
        }
      ]
    },
    {
      "id": "plain",
      "title": "Sin chrome",
      "lede": "Sin botones ni headings.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-transfer without-buttons without-headings searchable>",
            "            <iswc-transfer-item value=\"rojo\">Rojo</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"verde\" selected>Verde</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"azul\">Azul</iswc-transfer-item>",
            "            <iswc-transfer-item value=\"amarillo\">Amarillo</iswc-transfer-item>",
            "          </iswc-transfer>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-transfer&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>source-title</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Título del panel origen. (valor por defecto)"
            ],
            [
              "<code>target-title</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Título del panel destino. (valor por defecto)"
            ],
            [
              "<code>searchable</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Muestra campo de búsqueda. (valor por defecto)"
            ],
            [
              "<code>without-buttons</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Oculta los botones de mover. (valor por defecto)"
            ],
            [
              "<code>without-headings</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Oculta los headers. (valor por defecto)"
            ],
            [
              "<code>max-target</code>",
              "Máximo de items en target."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-transfer-item&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>value</code>",
              "Identificador del item."
            ],
            [
              "<code>selected</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Está en target. (valor por defecto)"
            ],
            [
              "<code>disabled</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "No se puede mover. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-transfer-change</code>",
              "Cambia selección. <code>detail: { item, source, target, values }</code>."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Doble lista de selección tipo Material/Ant. Mueve elementos entre",
          "          origen y destino con botones, click individual, filtro de búsqueda y",
          "          límite máximo configurable."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>source-title</code>",
            "type": "string",
            "default": "Disponibles",
            "desc": "Título del panel origen."
          },
          {
            "name": "<code>target-title</code>",
            "type": "string",
            "default": "Asignados",
            "desc": "Título del panel destino."
          },
          {
            "name": "<code>searchable</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Muestra campo de búsqueda."
          },
          {
            "name": "<code>without-buttons</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Oculta los botones de mover."
          },
          {
            "name": "<code>without-headings</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Oculta los headers."
          },
          {
            "name": "<code>max-target</code>",
            "type": "number",
            "default": "—",
            "desc": "Máximo de items en target."
          },
          {
            "name": "<code>value</code>",
            "type": "string",
            "default": "—",
            "desc": "Identificador del item."
          },
          {
            "name": "<code>selected</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Está en target."
          },
          {
            "name": "<code>disabled</code>",
            "type": "boolean",
            "default": "false",
            "desc": "No se puede mover."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-transfer-change</code>",
            "cuando": "Cambia selección. <code>detail: { item, source, target, values }</code>."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-transfer searchable>",
          "  <iswc-transfer-item value=\"a\">Alpha</iswc-transfer-item>",
          "  <iswc-transfer-item value=\"b\" selected>Beta</iswc-transfer-item>",
          "  <iswc-transfer-item value=\"c\">Gamma</iswc-transfer-item>",
          "  …",
          "</iswc-transfer>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
