{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-transfer",
  "category": "data",
  "title": "&lt;iswc-transfer&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-transfer / iswc-transfer-item de InSoft.",
  "storageKey": "docs-iswc-transfer",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Doble lista de selección tipo Material/Ant. Mueve elementos entre\r\n          origen y destino con botones, click individual, filtro de búsqueda y\r\n          límite máximo configurable.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-transfer id=\"tr1\" source-title=\"Disponibles\" target-title=\"Asignados\" searchable>\r\n            <iswc-transfer-item value=\"a\">Alpha</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"b\" selected>Beta</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"c\">Gamma</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"d\">Delta</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"e\">Epsilon</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"f\">Zeta</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"g\">Eta</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"h\">Theta</iswc-transfer-item>\r\n          </iswc-transfer>\r\n          <p id=\"tr1Log\">Seleccionados: <code class=\"code\">b</code></p>"
        }
      ]
    },
    {
      "id": "max-target",
      "title": "Límite en target",
      "lede": "Con <code class=\"code\">max-target=\"3\"</code> el botón hacia target se desactiva al llegar.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-transfer max-target=\"3\" source-title=\"Suscriptores\" target-title=\"Newsletter (máx 3)\" searchable>\r\n            <iswc-transfer-item value=\"a\">Alice</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"b\">Bob</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"c\" selected>Carol</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"d\">David</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"e\">Eve</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"f\">Frank</iswc-transfer-item>\r\n          </iswc-transfer>"
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Disabled",
      "lede": "Con <code class=\"code\">disabled</code> en algunos items.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-transfer source-title=\"Permisos\" target-title=\"Asignados\">\r\n            <iswc-transfer-item value=\"read\">read</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"write\" selected>write</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"delete\" disabled>delete</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"admin\">admin</iswc-transfer-item>\r\n          </iswc-transfer>"
        }
      ]
    },
    {
      "id": "plain",
      "title": "Sin chrome",
      "lede": "Sin botones ni headings.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-transfer without-buttons without-headings searchable>\r\n            <iswc-transfer-item value=\"rojo\">Rojo</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"verde\" selected>Verde</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"azul\">Azul</iswc-transfer-item>\r\n            <iswc-transfer-item value=\"amarillo\">Amarillo</iswc-transfer-item>\r\n          </iswc-transfer>"
        }
      ]
    },
