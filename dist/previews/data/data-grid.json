          ],
          "rows": [
            [
              "<code>columns</code>",
              "<code>[{ field, headerName, type, width, flex, minWidth, maxWidth, align, headerAlign, sortable, filterable, hideable, resizable, editable, groupable, description, valueGetter, valueFormatter, valueParser, renderCell, renderHeader, cellClassName, headerClassName, colSpan, getActions, valueOptions, filterOperators, sortComparator, preProcessEditCellProps }]</code>"
