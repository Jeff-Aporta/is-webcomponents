    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Eventos: <code>iswc-sort</code>, <code>iswc-filter</code>, <code>iswc-quick-filter</code>,\r\n          <code>iswc-pagination</code>, <code>iswc-select</code>, <code>iswc-cell-select</code>,\r\n          <code>iswc-cell-click</code>, <code>iswc-cell-double-click</code>, <code>iswc-row-click</code>,\r\n          <code>iswc-row-double-click</code>, <code>iswc-edit-start</code>, <code>iswc-edit-stop</code>,\r\n          <code>iswc-row-update</code>, <code>iswc-column-resize</code>, <code>iswc-column-reorder</code>,\r\n          <code>iswc-column-visibility</code>, <code>iswc-column-pin</code>, <code>iswc-density</code>,\r\n          <code>iswc-detail-toggle</code>, <code>iswc-group-toggle</code>, <code>iswc-row-reorder</code>,\r\n          <code>iswc-copy</code>, <code>iswc-paste</code>, <code>iswc-undo</code>, <code>iswc-redo</code>,\r\n          <code>iswc-rows-scroll-end</code>, <code>iswc-export</code>.",
      "blocks": [
        {
