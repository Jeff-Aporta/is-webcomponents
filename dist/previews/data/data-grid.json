              "<code>getRowId</code>, <code>getRowHeight</code>, <code>getRowClassName</code>, <code>getCellClassName</code>, <code>getTreeDataPath</code>, <code>getDetailPanelContent</code>, <code>isRowSelectable</code>, <code>isCellEditable</code>, <code>processRowUpdate</code>, <code>rowsLoader</code>"
            ]
          ]
        },
        {
          "kind": "table",
          "columns": [
            "Método",
            "Uso"
          ],
          "rows": [
            [
              "<code>setPage</code>, <code>setPageSize</code>",
              "paginación"
