            ],
            [
              "<code>detail-height</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>clipboard</code> / <code>undo-redo</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>aggregation-position</code>"
            ],
            [
              "<code>tab-navigation</code>"
            ],
            [
