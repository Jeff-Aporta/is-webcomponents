{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-gauge",
  "category": "data-viz",
  "title": "&lt;iswc-gauge&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-gauge de InSoft.",
  "styles": [
    ".gauge-grid {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));",
    "      gap: 1rem;",
    "      align-items: center;",
    "    }",
    "    .gauge-cell {",
    "      display: flex;",
    "      flex-direction: column;",
    "      align-items: center;",
    "      gap: 0.5rem;",
    "      padding: 1rem;",
    "      background: var(--iswc-bg-2, #181b22);",
    "      border: 1px solid var(--iswc-border, #2a2f3a);",
    "      border-radius: 0.5rem;",
    "    }"
  ],
  "storageKey": "docs-iswc-gauge",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Medidor circular SVG de porcentaje. Soporta variantes, semicírculo,",
        "          custom min/max, unidad, formato y tamaño."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-gauge id=\"g1\" value=\"67\" label=\"Conversión\" unit=\"%\"></iswc-gauge>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "67",
                "42",
                "92",
                "15",
                "68",
                "88",
                "3.14159",
                "12345",
                "0.5",
                "50"
              ]
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Conversión",
                "CPU",
                "RAM",
                "Errores",
                "0.7em",
                "1em",
                "1.35em",
                "Velocímetro",
                "π",
                "USD",
                "CTR",
                "Dinámico"
              ]
            },
            {
              "control": "select",
              "prop": "attr:unit",
              "label": "unit",
              "options": [
                "%",
                "€",
                ""
              ]
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:half",
              "label": "half"
            },
            {
              "control": "select",
              "prop": "attr:format",
              "label": "format",
              "options": [
                "0.00",
                "0,0",
                "0.0%"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sizes",
      "title": "Tamaños",
      "lede": "small, medium, large.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"gauge-grid\">",
            "            <div class=\"gauge-cell\"><iswc-gauge style=\"font-size:0.7em\" value=\"42\" label=\"0.7em\"></iswc-gauge></div>",
            "            <div class=\"gauge-cell\"><iswc-gauge value=\"42\" label=\"1em\"></iswc-gauge></div>",
            "            <div class=\"gauge-cell\"><iswc-gauge style=\"font-size:1.35em\" value=\"42\" label=\"1.35em\"></iswc-gauge></div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "half",
      "title": "Semicírculo",
      "lede": "Con <code class=\"code\">half</code> pinta solo medio arco.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"gauge-grid\">",
            "            <div class=\"gauge-cell\"><iswc-gauge half value=\"68\" label=\"Velocímetro\"></iswc-gauge></div>",
            "            <div class=\"gauge-cell\"><iswc-gauge half value=\"42\" label=\"Velocímetro\" color=\"warning\"></iswc-gauge></div>",
            "            <div class=\"gauge-cell\"><iswc-gauge half value=\"88\" label=\"Velocímetro\" color=\"success\"></iswc-gauge></div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "format",
      "title": "Formato",
      "lede": "Con <code class=\"code\">format</code> controla los decimales.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"gauge-grid\">",
            "            <div class=\"gauge-cell\"><iswc-gauge value=\"3.14159\" label=\"π\" format=\"0.00\"></iswc-gauge></div>",
            "            <div class=\"gauge-cell\"><iswc-gauge value=\"12345\" label=\"USD\" format=\"0,0\" unit=\"€\"></iswc-gauge></div>",
            "            <div class=\"gauge-cell\"><iswc-gauge value=\"0.5\" label=\"CTR\" format=\"0.0%\" unit=\"\"></iswc-gauge></div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "interactive",
      "title": "Interactivo",
      "lede": "Vinculado a un slider.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-gauge id=\"gInteractive\" value=\"50\" label=\"Dinámico\"></iswc-gauge>",
            "          <iswc-slider id=\"gSlider\" min=\"0\" max=\"100\" value=\"50\" label=\"Valor\"></iswc-slider>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-gauge&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>value</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Valor actual. (valor por defecto)"
            ],
            [
              "<code>min</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Mínimo. (valor por defecto)"
            ],
            [
              "<code>max</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Máximo. (valor por defecto)"
            ],
            [
              "<code>label</code>",
              "Etiqueta."
            ],
            [
              "<code>unit</code>",
              "Unidad (e.g. \"%\")."
            ],
            [
              "<code>format</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Intl format. (valor por defecto)"
            ],
            [
              "<code>thickness</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Ancho del trazo. (valor por defecto)"
            ],
            [
              "<code>variant</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Color. (valor por defecto)"
            ],
            [
              "<code>half</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Semicírculo. (valor por defecto)"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Medidor circular SVG de porcentaje. Soporta variantes, semicírculo,",
          "          custom min/max, unidad, formato y tamaño."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>value</code>",
            "type": "number",
            "default": "0",
            "desc": "Valor actual."
          },
          {
            "name": "<code>min</code>",
            "type": "number",
            "default": "0",
            "desc": "Mínimo."
          },
          {
            "name": "<code>max</code>",
            "type": "number",
            "default": "100",
            "desc": "Máximo."
          },
          {
            "name": "<code>label</code>",
            "type": "string",
            "default": "—",
            "desc": "Etiqueta."
          },
          {
            "name": "<code>unit</code>",
            "type": "string",
            "default": "—",
            "desc": "Unidad (e.g. \"%\")."
          },
          {
            "name": "<code>format</code>",
            "type": "string",
            "default": "0",
            "desc": "Intl format."
          },
          {
            "name": "<code>thickness</code>",
            "type": "number",
            "default": "8",
            "desc": "Ancho del trazo."
          },
          {
            "name": "<code>variant</code>",
            "type": "brand | success | warning | danger",
            "default": "brand",
            "desc": "Color."
          },
          {
            "name": "<code>half</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Semicírculo."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-gauge value=\"67\" label=\"Conversión\" unit=\"%\"></iswc-gauge>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
