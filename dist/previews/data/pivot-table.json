{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-pivot-table",
  "category": "data",
  "title": "&lt;iswc-pivot-table&gt;",
  "titleHtml": false,
  "styles": [
    "pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 8rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-pivot-table",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Tabla pivot: agrupa por filas y columnas, agrega una medida. Soporta <code>sum</code>, <code>avg</code>, <code>count</code>, <code>min</code> y <code>max</code>.",
      "blocks": []
    },
    {
      "id": "sum",
      "title": "Suma de ventas",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-pivot-table rows=\"region\" cols=\"trimestre\" measure=\"ventas\" agg=\"sum\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"region\": \"Norte\", \"trimestre\": \"Q1\", \"ventas\": 320 },",
            "                { \"region\": \"Norte\", \"trimestre\": \"Q2\", \"ventas\": 410 },",
            "                { \"region\": \"Norte\", \"trimestre\": \"Q3\", \"ventas\": 380 },",
            "                { \"region\": \"Norte\", \"trimestre\": \"Q4\", \"ventas\": 520 },",
            "                { \"region\": \"Sur\",   \"trimestre\": \"Q1\", \"ventas\": 220 },",
            "                { \"region\": \"Sur\",   \"trimestre\": \"Q2\", \"ventas\": 280 },",
            "                { \"region\": \"Sur\",   \"trimestre\": \"Q3\", \"ventas\": 350 },",
            "                { \"region\": \"Sur\",   \"trimestre\": \"Q4\", \"ventas\": 410 },",
            "                { \"region\": \"Este\",  \"trimestre\": \"Q1\", \"ventas\": 180 },",
            "                { \"region\": \"Este\",  \"trimestre\": \"Q2\", \"ventas\": 240 },",
            "                { \"region\": \"Este\",  \"trimestre\": \"Q3\", \"ventas\": 300 },",
            "                { \"region\": \"Este\",  \"trimestre\": \"Q4\", \"ventas\": 360 },",
            "                { \"region\": \"Oeste\", \"trimestre\": \"Q1\", \"ventas\": 140 },",
            "                { \"region\": \"Oeste\", \"trimestre\": \"Q2\", \"ventas\": 190 },",
            "                { \"region\": \"Oeste\", \"trimestre\": \"Q3\", \"ventas\": 230 },",
            "                { \"region\": \"Oeste\", \"trimestre\": \"Q4\", \"ventas\": 280 }",
            "              ]",
            "            </script>",
            "          </iswc-pivot-table>"
          ]
        }
      ]
    },
    {
      "id": "avg",
      "title": "Promedio de tickets",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-pivot-table rows=\"canal\" cols=\"mes\" measure=\"ticket\" agg=\"avg\" decimals=\"0\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"canal\": \"Web\",     \"mes\": \"Ene\", \"ticket\": 420 },",
            "                { \"canal\": \"Web\",     \"mes\": \"Feb\", \"ticket\": 480 },",
            "                { \"canal\": \"Web\",     \"mes\": \"Mar\", \"ticket\": 510 },",
            "                { \"canal\": \"Móvil\",   \"mes\": \"Ene\", \"ticket\": 320 },",
            "                { \"canal\": \"Móvil\",   \"mes\": \"Feb\", \"ticket\": 360 },",
            "                { \"canal\": \"Móvil\",   \"mes\": \"Mar\", \"ticket\": 410 },",
            "                { \"canal\": \"Mostrador\",\"mes\": \"Ene\", \"ticket\": 580 },",
            "                { \"canal\": \"Mostrador\",\"mes\": \"Feb\", \"ticket\": 600 },",
            "                { \"canal\": \"Mostrador\",\"mes\": \"Mar\", \"ticket\": 640 }",
            "              ]",
            "            </script>",
            "          </iswc-pivot-table>"
          ]
        }
      ]
    },
    {
      "id": "count",
      "title": "Cuenta (sin medida)",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Si no pasás <code class=\"code\">measure</code>, cuenta filas por combinación.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-pivot-table rows=\"estado\" cols=\"prioridad\" agg=\"count\">",
            "            <script type=\"application/json\">",
            "              [",
            "                { \"estado\": \"Nuevo\",    \"prioridad\": \"Alta\" },",
            "                { \"estado\": \"Nuevo\",    \"prioridad\": \"Alta\" },",
            "                { \"estado\": \"En curso\", \"prioridad\": \"Alta\" },",
            "                { \"estado\": \"En curso\", \"prioridad\": \"Media\" },",
            "                { \"estado\": \"En curso\", \"prioridad\": \"Baja\" },",
            "                { \"estado\": \"Cerrado\",  \"prioridad\": \"Media\" },",
            "                { \"estado\": \"Cerrado\",  \"prioridad\": \"Baja\" }",
            "              ]",
            "            </script>",
            "          </iswc-pivot-table>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "// Atributos",
            "// rows, cols            nombre de campo (requeridos)",
            "// measure               nombre de campo a agregar (opcional)",
            "// agg                   sum | avg | count | min | max   (default sum)",
            "// format                locale para Intl.NumberFormat (default 'es-CO')",
            "// decimals              dígitos (default 0; máximo 2)",
            "",
            "// Datos: cualquier objeto plano serializable en <script type=\"application/json\">",
            "// o vía propiedad: chart.dataset = [...]",
            "",
            "// Evento",
            "table.addEventListener('iswc-cell-click', e => {",
            "  console.log(e.detail.row, '·', e.detail.col, '=', e.detail.value);",
            "});"
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\"></pre>"
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Tabla pivot: agrupa por filas y columnas, agrega una medida. Soporta <code>sum</code>, <code>avg</code>, <code>count</code>, <code>min</code> y <code>max</code>."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
