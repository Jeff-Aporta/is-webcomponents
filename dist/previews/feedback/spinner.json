{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-spinner",
  "category": "feedback",
  "title": "&lt;iswc-spinner&gt;",
  "titleHtml": false,
  "styles": ".speed-demo {\r\n      display: flex;\r\n      flex-direction: column;\r\n      gap: 1rem;\r\n      max-width: 28rem;\r\n    }\r\n    .speed-demo__row {\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 1.25rem;\r\n    }\r\n    .speed-demo__control {\r\n      display: flex;\r\n      flex-direction: column;\r\n      gap: 0.35rem;\r\n      flex: 1;\r\n      min-width: 0;\r\n    }\r\n    .speed-demo__meta {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      font-size: 0.8rem;\r\n      color: var(--iswc-text-dim);\r\n      font-variant-numeric: tabular-nums;\r\n    }\r\n    .speed-demo__meta strong { color: var(--iswc-text-soft); }\r\n    .speed-demo input[type=\"range\"] {\r\n      width: 100%;\r\n      accent-color: var(--iswc-accent, var(--iswc-color-brand));\r\n      cursor: pointer;\r\n    }",
  "storageKey": "docs-iswc-spinner",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Indicador de carga animado. Sin atributos; personalizable vía CSS vars.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-spinner></iswc-spinner>"
        }
      ]
    },
    {
      "id": "examples",
      "title": "Escala y colores",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"align-items:center;gap:1.5rem\">\r\n            <iswc-spinner style=\"font-size:1rem\"></iswc-spinner>\r\n            <iswc-spinner style=\"font-size:2rem;--indicator-color:var(--iswc-color-success)\"></iswc-spinner>\r\n            <iswc-spinner style=\"font-size:2.5rem;--track-width:4px\"></iswc-spinner>\r\n          </div>"
        }
      ]
    },
    {
      "id": "speed",
      "title": "Velocidad",
      "lede": "Controla <code class=\"code\">--speed</code> (duración de un giro). Más % = más rápido.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"speed-demo\">\r\n            <div class=\"speed-demo__row\">\r\n              <iswc-spinner id=\"speedSpinner\" style=\"font-size:2.5rem;--track-width:4px\"></iswc-spinner>\r\n              <div class=\"speed-demo__control\">\r\n                <div class=\"speed-demo__meta\">\r\n                  <span>Velocidad</span>\r\n                  <strong><span id=\"speedPct\">40</span>% · <span id=\"speedSec\">1.05</span>s</strong>\r\n                </div>\r\n                <input id=\"speedRange\" type=\"range\" min=\"5\" max=\"100\" value=\"40\" step=\"1\"\r\n                  aria-label=\"Velocidad del spinner\" />\r\n              </div>\r\n            </div>\r\n          </div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Part: <code class=\"code\">::part(spinner)</code>. role=status.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Variable CSS",
            "Default"
          ],
          "rows": [
            [
              "<code>--track-width</code>",
              "0.15em"
            ],
            [
              "<code>--track-color</code>",
              "borde control"
            ],
            [
              "<code>--indicator-color</code>",
              "brand-500"
            ],
            [
              "<code>--speed</code>",
              "0.75s"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Indicador de carga animado. Sin atributos; personalizable vía CSS vars."
      },
      "atributos": {
        "table": [
          {
            "name": "<code>--track-width</code>",
            "default": "0.15em"
          },
          {
            "name": "<code>--track-color</code>",
            "default": "borde control"
          },
          {
            "name": "<code>--indicator-color</code>",
            "default": "brand-500"
          },
          {
            "name": "<code>--speed</code>",
            "default": "0.75s"
          }
        ]
      },
      "ejemplos": {
        "content": "```html\n<iswc-spinner></iswc-spinner>\n```"
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
