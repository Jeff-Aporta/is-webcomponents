{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-toast",
  "category": "feedback",
  "title": "&lt;iswc-toast&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-toast",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Contenedor fijo de notificaciones. Crea ítems con <code class=\"code\">create()</code> o declara <code class=\"code\">&lt;iswc-toast-item&gt;</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">",
            "            <iswc-button color=\"brand\" id=\"btn-brand\">brand</iswc-button>",
            "            <iswc-button color=\"success\" id=\"btn-success\">success</iswc-button>",
            "            <iswc-button color=\"warning\" id=\"btn-warning\">warning</iswc-button>",
            "            <iswc-button color=\"danger\" id=\"btn-danger\">danger</iswc-button>",
            "            <iswc-button color=\"neutral\" id=\"btn-sticky\">sticky (duration 0)</iswc-button>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "placement",
      "title": "Placement",
      "lede": [
        "Seis anclas: <code class=\"code\">top|bottom</code> ×",
        "          <code class=\"code\">start|center|end</code>",
        "          (logical; en LTR start=izquierda, end=derecha)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">",
            "            <iswc-button data-place=\"top-start\">top-start</iswc-button>",
            "            <iswc-button data-place=\"top-center\">top-center</iswc-button>",
            "            <iswc-button data-place=\"top-end\">top-end</iswc-button>",
            "            <iswc-button data-place=\"bottom-start\">bottom-start</iswc-button>",
            "            <iswc-button data-place=\"bottom-center\">bottom-center</iswc-button>",
            "            <iswc-button data-place=\"bottom-end\">bottom-end</iswc-button>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "promise",
      "title": "Promise",
      "lede": [
        "<code class=\"code\">toaster.promise(p, { loading, success, error })</code> muestra un",
        "          toast loading con spinner y lo actualiza en sitio al resolver o rechazar.",
        "          Cada callback acepta string, función o <code class=\"code\">{ message, options }</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">",
            "            <iswc-button id=\"btn-promise-ok\" color=\"success\">Simular éxito</iswc-button>",
            "            <iswc-button id=\"btn-promise-err\" color=\"danger\">Simular error</iswc-button>",
            "            <iswc-button id=\"btn-promise-dynamic\" color=\"brand\">Mensaje dinámico</iswc-button>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "<code>placement</code>",
              "top-start · top-center · top-end · bottom-start · bottom-center · bottom-end (default bottom-end)"
            ],
            [
              "<code>create(msg, opts)</code>",
              "variant, icon, duration, allowHtml → Promise&lt;iswc-toast-item&gt;"
            ],
            [
              "<code>iswc-toast-item</code>",
              "variant, duration, open · show()/hide() · iswc-after-show/hide"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Contenedor fijo de notificaciones. Crea ítems con <code class=\"code\">create()</code> o declara <code class=\"code\">&lt;iswc-toast-item&gt;</code>."
      },
      "apiJs": {
        "table": [
          {
            "metodo": "<code>placement</code>",
            "desc": "top-start · top-center · top-end · bottom-start · bottom-center · bottom-end (default bottom-end)"
          },
          {
            "metodo": "<code>create(msg, opts)</code>",
            "desc": "variant, icon, duration, allowHtml → Promise&lt;iswc-toast-item&gt;"
          },
          {
            "metodo": "<code>iswc-toast-item</code>",
            "desc": "variant, duration, open · show()/hide() · iswc-after-show/hide"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```javascript",
          "const toaster = document.getElementById('toaster');",
          "",
          "document.getElementById('btn-brand').addEventListener('click', () => {",
          "  toaster.create('Mensaje brand', { variant: 'brand' });",
          "});",
          "document.getElementById('btn-success').addEventListener('click', () => {",
          "  toaster.create('Operación correcta', { variant: 'success' });",
          "});",
          "document.getElementById('btn-warning').addEventListener('click', () => {",
          "  toaster.create('Revisa los datos', { variant: 'warning' });",
          "});",
          "document.getElementById('btn-danger').addEventListener('click', () => {",
          "  toaster.create('Error al guardar', { variant: 'danger' });",
          "});",
          "document.getElementById('btn-sticky').addEventListener('click', () => {",
          "  toaster.create('Quédate hasta cerrar', { variant: 'neutral', duration: 0 });",
          "});",
          "```"
        ]
      }
    },
    "exclude": [
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
