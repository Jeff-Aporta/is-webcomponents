{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-progress-ring",
  "category": "feedback",
  "title": "Progress Ring",
  "titleHtml": false,
  "styles": [
    ".ring-row {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      align-items: flex-end;",
    "      gap: 2rem 2.5rem;",
    "    }",
    "    .ring-card {",
    "      display: flex;",
    "      flex-direction: column;",
    "      align-items: center;",
    "      gap: 0.65rem;",
    "      min-width: 5.5rem;",
    "    }",
    "    .ring-card__title {",
    "      margin: 0;",
    "      font-size: 0.8125rem;",
    "      font-weight: 600;",
    "      color: var(--iswc-text);",
    "      letter-spacing: -0.01em;",
    "    }",
    "    .ring-card__cap {",
    "      margin: 0;",
    "      font-family: var(--iswc-mono);",
    "      font-size: 0.68rem;",
    "      color: var(--iswc-text-dim);",
    "    }",
    "    .ring-inline {",
    "      display: flex;",
    "      align-items: center;",
    "      gap: 0.85rem;",
    "      max-width: 28rem;",
    "      padding: 0.85rem 1rem;",
    "      border: 1px solid var(--iswc-border-soft);",
    "      border-radius: var(--iswc-radius);",
    "      background:",
    "        linear-gradient(135deg,",
    "          color-mix(in srgb, var(--iswc-accent) 6%, transparent),",
    "          transparent 55%),",
    "        var(--iswc-bg-elev);",
    "    }",
    "    .ring-inline__copy {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.15rem;",
    "      min-width: 0;",
    "    }",
    "    .ring-inline__copy strong {",
    "      font-size: 0.95rem;",
    "      font-weight: 650;",
    "      color: var(--iswc-text);",
    "    }",
    "    .ring-inline__copy span {",
    "      font-size: 0.8rem;",
    "      color: var(--iswc-text-soft);",
    "    }"
  ],
  "storageKey": "docs-iswc-progress-ring",
  "sections": [
    {
      "id": "intro",
      "title": "Progress Ring",
      "lede": "<code class=\"code\">&lt;iswc-progress-ring&gt;</code>",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Anillo SVG de progreso. La caja es <code class=\"code\">1em × 1em</code>:",
            "          escala solo con <code class=\"code\">font-size</code> del contexto (o del propio host).",
            "          El centro muestra un valor corto; el detalle va fuera del anillo.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"ring-row\">",
            "            <div class=\"ring-card\" style=\"font-size: 5rem\">",
            "              <iswc-progress-ring id=\"ringPlay\" value=\"75\" label=\"75%\"></iswc-progress-ring>",
            "              <p class=\"ring-card__title\">Completado</p>",
            "              <p class=\"ring-card__cap\">value 75</p>",
            "            </div>",
            "          </div>"
          ],
          "target": "#ringPlay",
          "controls": [
            {
              "control": "range",
              "prop": "attr:value",
              "label": "value",
              "min": 0,
              "max": 100,
              "step": 5
            },
            {
              "control": "text",
              "prop": "attr:label",
              "label": "label"
            }
          ]
        }
      ]
    },
    {
      "id": "scale",
      "title": "Escala por font-size",
      "lede": "Mismo componente; solo cambia el tamaño tipográfico del contenedor.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"ring-row\">",
            "            <div class=\"ring-card\" style=\"font-size: 2rem\">",
            "              <iswc-progress-ring value=\"60\" label=\"60%\"></iswc-progress-ring>",
            "              <p class=\"ring-card__cap\">2rem</p>",
            "            </div>",
            "            <div class=\"ring-card\" style=\"font-size: 3.5rem\">",
            "              <iswc-progress-ring value=\"60\" label=\"60%\"></iswc-progress-ring>",
            "              <p class=\"ring-card__cap\">3.5rem</p>",
            "            </div>",
            "            <div class=\"ring-card\" style=\"font-size: 5.5rem\">",
            "              <iswc-progress-ring",
            "                value=\"60\"",
            "                label=\"60%\"",
            "                style=\"--indicator-color: var(--iswc-color-success)\"",
            "              ></iswc-progress-ring>",
            "              <p class=\"ring-card__cap\">5.5rem</p>",
            "            </div>",
            "            <div class=\"ring-card\" style=\"font-size: 7rem\">",
            "              <iswc-progress-ring",
            "                value=\"60\"",
            "                label=\"60%\"",
            "                style=\"--track-width: 2; --indicator-width: 4.5\"",
            "              ></iswc-progress-ring>",
            "              <p class=\"ring-card__cap\">7rem · stroke</p>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "inline",
      "title": "Inline en UI",
      "lede": "El anillo lleva el %, el contexto narrativo queda al lado.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"demo-stack\" style=\"gap:0.75rem\">",
            "            <div class=\"ring-inline\" style=\"font-size:2.25rem\">",
            "              <iswc-progress-ring value=\"35\" label=\"35%\"></iswc-progress-ring>",
            "              <div class=\"ring-inline__copy\">",
            "                <strong>Descargando paquete</strong>",
            "                <span>35% · ~2 min restantes</span>",
            "              </div>",
            "            </div>",
            "            <div class=\"ring-inline\" style=\"font-size:2.25rem\">",
            "              <iswc-progress-ring",
            "                value=\"90\"",
            "                label=\"90%\"",
            "                style=\"--indicator-color: var(--iswc-color-warning)\"",
            "              ></iswc-progress-ring>",
            "              <div class=\"ring-inline__copy\">",
            "                <strong>Sincronizando</strong>",
            "                <span>90% · casi listo</span>",
            "              </div>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / var",
            "Notas"
          ],
          "rows": [
            [
              "<code>value</code>",
              "0–100"
            ],
            [
              "<code>label</code>",
              "Texto central + a11y (preferir corto: <code>75%</code>)"
            ],
            [
              "<code>font-size</code>",
              "Define el diámetro (1em)"
            ],
            [
              "<code>--track-width</code> / <code>--indicator-width</code>",
              "Grosor SVG"
            ],
            [
              "<code>--indicator-color</code> / <code>--track-color</code>",
              "Colores (default: accent / border)"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "<code class=\"code\">&lt;iswc-progress-ring&gt;</code>"
      },
      "atributos": {
        "table": [
          {
            "name": "<code>value</code>",
            "desc": "0–100"
          },
          {
            "name": "<code>label</code>",
            "desc": "Texto central + a11y (preferir corto: <code>75%</code>)"
          },
          {
            "name": "<code>font-size</code>",
            "desc": "Define el diámetro (1em)"
          },
          {
            "name": "<code>--track-width</code> / <code>--indicator-width</code>",
            "desc": "Grosor SVG"
          },
          {
            "name": "<code>--indicator-color</code> / <code>--track-color</code>",
            "desc": "Colores (default: accent / border)"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<div class=\"ring-row\">",
          "            <div class=\"ring-card\" style=\"font-size: 5rem\">",
          "              <iswc-progress-ring id=\"ringPlay\" value=\"75\" label=\"75%\"></iswc-progress-ring>",
          "              <p class=\"ring-card__title\">Completado</p>",
          "              <p class=\"ring-card__cap\">value 75</p>",
          "            </div>",
          "          </div>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}