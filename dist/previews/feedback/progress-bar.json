{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-progress-bar",
  "category": "feedback",
  "title": "Progress Bar",
  "titleHtml": false,
  "styles": ".pb-demo { max-width: 28rem; display: flex; flex-direction: column; gap: 0.85rem; }\r\n    .pb-meta {\r\n      display: flex; justify-content: space-between; align-items: baseline;\r\n      font-size: 0.9rem; color: var(--iswc-text-soft);\r\n    }\r\n    .pb-meta strong { color: var(--iswc-text); font-variant-numeric: tabular-nums; }\r\n    .pb-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }",
  "storageKey": "docs-iswc-progress-bar",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Progress Bar",
      "lede": "<code class=\"code\">&lt;iswc-progress-bar&gt;</code>",
      "blocks": [
        {
          "kind": "html",
          "html": "<p class=\"lede\">Barra de progreso determinada (<code class=\"code\">value</code> 0–100) o indeterminada.</p>"
        },
        {
          "kind": "demo",
          "html": "<div class=\"pb-demo\">\r\n            <iswc-progress-bar id=\"pb-play\" value=\"65\" label=\"Subiendo archivo\"></iswc-progress-bar>\r\n          </div>",
          "target": "#pb-play",
          "controls": [
            {
              "control": "range",
              "prop": "attr:value",
              "label": "Valor",
              "min": 0,
              "max": 100,
              "step": 5
            },
            {
              "control": "text",
              "prop": "attr:label",
              "label": "Label"
            },
            {
              "control": "boolean",
              "prop": "attr:indeterminate",
              "label": "Indeterminada"
            }
          ]
        }
      ]
    },
    {
      "id": "interactive",
      "title": "Contador interactivo",
      "lede": "Cada clic avanza el progreso; Reset vuelve a 0. El <code class=\"code\">value</code>\r\n          y la etiqueta se actualizan en vivo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"pb-demo\">\r\n            <div class=\"pb-meta\">\r\n              <span id=\"pbStatus\">Listo para empezar</span>\r\n              <strong><span id=\"pbPct\">0</span>%</strong>\r\n            </div>\r\n            <iswc-progress-bar id=\"pbLive\" value=\"0\" label=\"Progreso 0%\"></iswc-progress-bar>\r\n            <div class=\"pb-actions\">\r\n              <iswc-button id=\"pbPlus\" color=\"brand\">\r\n                <iswc-icon slot=\"start\" icon=\"mdi:plus\"></iswc-icon>\r\n                +10\r\n              </iswc-button>\r\n              <iswc-button id=\"pbMinus\" variant=\"outlined\">\r\n                <iswc-icon slot=\"start\" icon=\"mdi:minus\"></iswc-icon>\r\n                −10\r\n              </iswc-button>\r\n              <iswc-button id=\"pbReset\" variant=\"plain\">\r\n                <iswc-icon slot=\"start\" icon=\"mdi:restart\"></iswc-icon>\r\n                Reset\r\n              </iswc-button>\r\n            </div>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "let value = 0;\nconst bar = document.querySelector('#pbLive');\n\ndocument.querySelector('#pbPlus').addEventListener('click', () => {\n  value = Math.min(100, value + 10);\n  bar.value = value;\n  bar.label = `Progreso ${value}%`;\n});\n\ndocument.querySelector('#pbReset').addEventListener('click', () => {\n  value = 0;\n  bar.value = 0;\n});",
          "lang": "javascript"
        }
      ]
    },
    {
      "id": "states",
      "title": "Estados",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"pb-demo\">\r\n            <iswc-progress-bar value=\"30\" label=\"30%\"></iswc-progress-bar>\r\n            <iswc-progress-bar value=\"100\" label=\"Completado\"\r\n              style=\"--indicator-color: var(--iswc-color-success)\"></iswc-progress-bar>\r\n            <iswc-progress-bar indeterminate label=\"Procesando\"></iswc-progress-bar>\r\n          </div>"
        },
        {
          "kind": "code",
          "code": "<iswc-progress-bar value=\"65\" label=\"Carga\"></iswc-progress-bar>\n<iswc-progress-bar indeterminate label=\"Procesando\"></iswc-progress-bar>",
          "lang": "html"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>value</code>",
              "0–100 (propiedad reflectada)"
            ],
            [
              "<code>label</code>",
              "aria-label / valuetext"
            ],
            [
              "<code>indeterminate</code>",
              "Animación continua"
            ],
            [
              "<code>--indicator-color</code>",
              "Color del fill"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "<code class=\"code\">&lt;iswc-progress-bar&gt;</code>"
      },
      "atributos": {
        "table": [
          {
            "name": "<code>value</code>",
            "desc": "0–100 (propiedad reflectada)"
          },
          {
            "name": "<code>label</code>",
            "desc": "aria-label / valuetext"
          },
          {
            "name": "<code>indeterminate</code>",
            "desc": "Animación continua"
          },
          {
            "name": "<code>--indicator-color</code>",
            "desc": "Color del fill"
          }
        ]
      },
      "ejemplos": {
        "content": "```html\n<div class=\"pb-demo\">\r\n            <iswc-progress-bar id=\"pb-play\" value=\"65\" label=\"Subiendo archivo\"></iswc-progress-bar>\r\n          </div>\n```"
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
