{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-palette-selector",
  "category": "feedback",
  "title": "&lt;iswc-palette-selector&gt;",
  "titleHtml": false,
  "styles": [
    ".row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }",
    "    .event-log {",
    "      margin-top: 12px;",
    "      padding: 12px;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: 8px;",
    "      background: var(--iswc-bg-soft);",
    "      font-family: var(--iswc-mono);",
    "      font-size: 0.8rem;",
    "      min-height: 2em;",
    "      color: var(--iswc-text);",
    "    }",
    "    .event-log .hint { opacity: 0.6; }",
    "",
    "    /* --- Trigger tipo \"logo\" — el consumer pone SU HTML --- */",
    "    .logo-trigger {",
    "      display: inline-flex;",
    "      align-items: baseline;",
    "      gap: 0;",
    "      padding: 0.45em 0.85em;",
    "      background: var(--iswc-logo-bg, #fff);",
    "      color: var(--iswc-logo-fg, #111);",
    "      border-radius: 0.45em;",
    "      font: inherit;",
    "      font-weight: 800;",
    "      letter-spacing: -0.045em;",
    "      text-transform: lowercase;",
    "      transition: filter 120ms ease, transform 120ms ease;",
    "    }",
    "    .logo-trigger:hover { filter: brightness(1.05); }",
    "    .logo-trigger:active { transform: translateY(1px); }",
    "    .logo-trigger__lead { color: #000; }",
    "    .logo-trigger__accent { color: var(--iswc-accent, dodgerblue); }",
    "    .logo-trigger__caret {",
    "      margin-left: 0.5em;",
    "      font-size: 0.95em;",
    "      opacity: 0.7;",
    "      color: var(--iswc-text, #111);",
    "    }"
  ],
  "storageKey": "docs-iswc-palette-selector",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Selector visual de paletas de marca. Por defecto expone las 3 paletas de <code class=\"code\">styles/palettes.css</code>; el consumidor puede pasar su propio array JSON para usar SU marca y SU CSS, y opcionalmente inyectar un trigger personalizado en el slot <code class=\"code\">trigger</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"row\">",
            "            <iswc-palette-selector id=\"defaultPalette\" scope=\"root\"></iswc-palette-selector>",
            "            <iswc-theme-toggle id=\"defaultTheme\" scope=\"root\"></iswc-theme-toggle>",
            "          </div>",
            "          <div data-palette=\"insoft\" data-theme=\"light\" class=\"theme-light\" style=\"margin-top:1rem;padding:1rem;border-radius:0.6em;background:var(--iswc-bg);color:var(--iswc-text)\">",
            "            <iswc-palette-selector scope=\"closest\"></iswc-palette-selector>",
            "            <iswc-theme-toggle scope=\"closest\"></iswc-theme-toggle>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "custom-trigger",
      "title": "Botón personalizado",
      "lede": "El <code class=\"code\">slot=\"trigger\"</code> del componente permite al consumidor inyectar SU HTML para el botón. Esto es ideal cuando el botón lleva el logo de marca (dos mitades con colores) o cualquier look que el trigger interno no represente bien.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"row\">",
            "            <iswc-palette-selector id=\"logoPalette\">",
            "              <button type=\"button\" slot=\"trigger\" class=\"logo-trigger\" aria-label=\"Elegir paleta de marca\">",
            "                <span class=\"logo-trigger__lead\" data-role=\"lead\">in</span><span class=\"logo-trigger__accent\" data-role=\"accent\">soft</span>",
            "                <iswc-icon class=\"logo-trigger__caret\" icon=\"mdi:chevron-down\" aria-hidden=\"true\"></iswc-icon>",
            "              </button>",
            "            </iswc-palette-selector>",
            "          </div>"
          ]
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\">El sitio actualiza el contenido del trigger cuando cambia la paleta (lead/accent pueden cambiar con la marca). Mira el código demo para ver cómo se sincroniza.</p>"
        }
      ]
    },
    {
      "id": "custom",
      "title": "Paletas personalizadas",
      "lede": "Cada paleta trae bg y content. content es json2xml: un objeto { iswc-text: { color, content } } se vuelve el elemento iswc-text. Al cambiar value se repinta el botón.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"row\" data-palette=\"acme\">",
            "            <iswc-palette-selector id=\"customPalette\" scope=\"closest\" value=\"acme\" palettes='[{\"value\":\"acme\",\"label\":\"Acme Corp\",\"bg\":\"#fff\",\"fg\":\"#111\",\"content\":[{\"iswc-text\":{\"color\":\"#111\",\"content\":[\"ac\"]}},{\"iswc-text\":{\"color\":\"#e03131\",\"content\":[\"me\"]}}]},{\"value\":\"ocean\",\"label\":\"Ocean\",\"bg\":\"#fff\",\"fg\":\"#111\",\"content\":[{\"iswc-text\":{\"color\":\"#111\",\"content\":[\"o\"]}},{\"iswc-text\":{\"color\":\"#0ea5e9\",\"content\":[\"cean\"]}}]},{\"value\":\"forest\",\"label\":\"Forest\",\"bg\":\"#fff\",\"fg\":\"#111\",\"content\":[{\"iswc-text\":{\"color\":\"#111\",\"content\":[\"f\"]}},{\"iswc-text\":{\"color\":\"#22c55e\",\"content\":[\"orest\"]}}]},{\"value\":\"dusk\",\"label\":\"Dusk\",\"bg\":\"#fff\",\"fg\":\"#111\",\"content\":[{\"iswc-text\":{\"color\":\"#111\",\"content\":[\"d\"]}},{\"iswc-text\":{\"color\":\"#a855f7\",\"content\":[\"usk\"]}}]}]'></iswc-palette-selector>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "acme",
                "ocean",
                "forest",
                "dusk"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "events",
      "title": "Eventos",
      "lede": "El componente emite <code class=\"code\">iswc-palette-change</code> cuando el usuario selecciona una paleta. <code class=\"code\">detail.value</code> trae el identificador, <code class=\"code\">detail.palette</code> trae el objeto entero.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-palette-selector id=\"evPalette\"></iswc-palette-selector>",
            "          <div class=\"event-log\" id=\"evLog\"><div class=\"hint\">Selecciona una paleta para ver el evento.</div></div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo"
          ],
          "rows": [
            [
              "<code>palettes</code>"
            ],
            [
              "<code>value</code>"
            ],
            [
              "<code>storage-key</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ],
            [
              "<code>aria-label</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Slots</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Slot",
            "Descripción"
          ],
          "rows": [
            [
              "<code>trigger</code>",
              "Sustituye el botón trigger interno. El consumidor pone SU HTML; el componente aún abre/cierra el menu y emite <code>iswc-palette-change</code>."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Campos del objeto <code>palette</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Campo",
            "Uso"
          ],
          "rows": [
            [
              "<code>value</code>",
              "identificador (requerido)"
            ],
            [
              "<code>label</code>",
              "texto en el menu y el trigger interno"
            ],
            [
              "<code>accent</code>",
              "color del swatch en el menu"
            ],
            [
              "<code>css</code>",
              "URL de <code>&lt;link rel=\"stylesheet\"&gt;</code> cargado al seleccionar"
            ],
            [
              "<code>lead</code> + <code>accentLabel</code>",
              "dos mitades para el trigger interno (estilo logo)"
            ],
            [
              "<code>leadColor</code> + <code>accentColor</code>",
              "colores de las dos mitades"
            ],
            [
              "<code>bg</code> + <code>fg</code>",
              "background y color del trigger interno"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Detail"
          ],
          "rows": [
            [
              "<code>iswc-palette-change</code>",
              "<code>{ value, palette }</code>"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Mutaciones en el documento</h3>"
        },
        {
          "kind": "html",
          "html": [
            "<ul>",
            "          <li><code>&lt;html data-palette=\"X\"&gt;</code> — aplica la paleta activa</li>",
            "          <li><code>localStorage[\"iswc-palette\"] = X</code> — persiste la elección</li>",
            "        </ul>"
          ]
        }
      ]
    }
  ],
