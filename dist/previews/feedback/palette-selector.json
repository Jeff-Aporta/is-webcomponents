          "html": "<div class=\"row\">\r\n            <is-palette-selector id=\"defaultPalette\" scope=\"root\"></is-palette-selector>\r\n            <is-theme-toggle id=\"defaultTheme\" scope=\"root\"></is-theme-toggle>\r\n          </div>\r\n          <div data-palette=\"insoft\" data-theme=\"light\" class=\"theme-light\" style=\"margin-top:1rem;padding:1rem;border-radius:0.6em;background:var(--iswc-bg);color:var(--iswc-text)\">\r\n            <is-palette-selector scope=\"closest\"></is-palette-selector>\r\n            <is-theme-toggle scope=\"closest\"></is-theme-toggle>\r\n          </div>",
