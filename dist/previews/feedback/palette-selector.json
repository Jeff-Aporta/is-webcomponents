          ]
        },
        {
          "kind": "html",
          "html": "<h3>Mutaciones en el documento</h3>"
        },
        {
          "kind": "html",
          "html": "<ul>\r\n          <li><code>&lt;html data-palette=\"X\"&gt;</code> — aplica la paleta activa</li>\r\n          <li><code>localStorage[\"iswc-palette\"] = X</code> — persiste la elección</li>\r\n        </ul>"
        }
