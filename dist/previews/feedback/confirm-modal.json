{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-confirm-modal",
  "category": "feedback",
  "title": "&lt;iswc-confirm-modal&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-confirm-modal de InSoft.",
  "storageKey": "docs-iswc-confirm-modal",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Confirmación en modal centrado con backdrop. Para decisiones que",
        "          merecen foco total. Si prefieres confirmar en línea sin tapar la",
        "          pantalla, usa <code class=\"code\">&lt;iswc-popconfirm&gt;</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"btnDelete\" color=\"danger\">",
            "            <iswc-icon slot=\"start\" icon=\"mdi:trash-can\"></iswc-icon>",
            "            Eliminar cuenta",
            "          </iswc-button>",
            "          <iswc-confirm-modal for=\"btnDelete\" heading=\"Eliminar cuenta\" message=\"Se borrarán todos tus datos. Esta acción no se puede deshacer.\">",
            "            <iswc-button slot=\"confirm\" color=\"danger\">Sí, eliminar</iswc-button>",
            "            <iswc-button slot=\"cancel\">Cancelar</iswc-button>",
            "          </iswc-confirm-modal>",
            "          <p id=\"cmLog\">Última acción: <code class=\"code\">—</code></p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:heading",
              "label": "heading",
              "options": [
                "Eliminar cuenta",
                "Publicar a producción"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "custom",
      "title": "Mensaje propio",
      "lede": "El contenido del slot <code class=\"code\">message</code> reemplaza el atributo.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"cmMega\" color=\"brand\">Publicar cambios</iswc-button>",
            "          <iswc-confirm-modal for=\"cmMega\" heading=\"Publicar a producción\">",
            "            <div slot=\"message\">",
            "              <strong>Vas a publicar 12 cambios.</strong>",
            "              <p style=\"margin:0.25rem 0;font-size:0.85em;color:color-mix(in srgb,currentColor 70%,transparent)\">",
            "                Los usuarios verán la nueva versión de inmediato.",
            "              </p>",
            "            </div>",
            "            <iswc-button slot=\"cancel\">Revisar de nuevo</iswc-button>",
            "            <iswc-button slot=\"confirm\" color=\"brand\">Publicar</iswc-button>",
            "          </iswc-confirm-modal>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-confirm-modal\">",
            "  <iswc-confirm-modal open label=\"Eliminar registro\">",
            "    <p>Esta accion no se puede deshacer.</p>",
            "  </iswc-confirm-modal>",
            "  <strong slot=\"message\">Vas a eliminar el registro seleccionado.</strong>",
            "  <iswc-button slot=\"cancel\" variant=\"text\" color=\"neutral\">Cancelar</iswc-button>",
            "  <iswc-button slot=\"confirm\" color=\"danger\">Eliminar</iswc-button>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-confirm-modal&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>for</code>",
              "id del trigger que abre el modal."
            ],
            [
              "<code>heading</code>",
              "Título del modal."
            ],
            [
              "<code>message</code>",
              "Texto del mensaje."
            ],
            [
              "<code>open</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Estado controlado. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-confirm-show</code>",
              "Modal visible."
            ],
            [
              "<code>iswc-confirm-hide</code>",
              "Modal se cierra."
            ],
            [
              "<code>iswc-confirm-confirm</code>",
              "Click en confirmar."
            ],
            [
              "<code>iswc-confirm-cancel</code>",
              "Click en cancelar, backdrop o Escape."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Confirmación en modal centrado con backdrop. Para decisiones que",
          "          merecen foco total. Si prefieres confirmar en línea sin tapar la",
          "          pantalla, usa <code class=\"code\">&lt;iswc-popconfirm&gt;</code>."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>for</code>",
            "type": "string",
            "default": "—",
            "desc": "id del trigger que abre el modal."
          },
          {
            "name": "<code>heading</code>",
            "type": "string",
            "default": "—",
            "desc": "Título del modal."
          },
          {
            "name": "<code>message</code>",
            "type": "string",
            "default": "—",
            "desc": "Texto del mensaje."
          },
          {
            "name": "<code>open</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Estado controlado."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-confirm-show</code>",
            "cuando": "Modal visible."
          },
          {
            "evento": "<code>iswc-confirm-hide</code>",
            "cuando": "Modal se cierra."
          },
          {
            "evento": "<code>iswc-confirm-confirm</code>",
            "cuando": "Click en confirmar."
          },
          {
            "evento": "<code>iswc-confirm-cancel</code>",
            "cuando": "Click en cancelar, backdrop o Escape."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-button id=\"btnDelete\">Eliminar cuenta</iswc-button>",
          "<iswc-confirm-modal for=\"btnDelete\" heading=\"Eliminar cuenta\" message=\"¿Seguro?\">",
          "  <iswc-button slot=\"confirm\" color=\"danger\">Sí, eliminar</iswc-button>",
          "  <iswc-button slot=\"cancel\">Cancelar</iswc-button>",
          "</iswc-confirm-modal>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
