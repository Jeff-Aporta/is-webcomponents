{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-theme-toggle",
  "category": "feedback",
  "title": "&lt;iswc-theme-toggle&gt;",
  "titleHtml": false,
  "styles": [
    ".theme-boxes {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));",
    "      gap: 1rem;",
    "    }",
    "    .container-theme {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.75rem;",
    "      padding: 1rem 1.1rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background: var(--iswc-bg);",
    "      color: var(--iswc-text);",
    "      box-shadow: var(--iswc-shadow);",
    "      min-height: 8rem;",
    "    }",
    "    .container-theme__head {",
    "      display: flex;",
    "      align-items: center;",
    "      justify-content: space-between;",
    "      gap: 0.75rem;",
    "    }",
    "    .container-theme__title {",
    "      font-weight: 650;",
    "      font-size: 0.95rem;",
    "    }",
    "    .container-theme__hint {",
    "      margin: 0;",
    "      font-size: 0.85rem;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .container-theme__chip {",
    "      display: inline-flex;",
    "      align-items: center;",
    "      gap: 0.35em;",
    "      padding: 0.35em 0.65em;",
    "      border-radius: var(--iswc-radius-sm);",
    "      background: var(--iswc-control-bg);",
    "      color: var(--iswc-control-text);",
    "      font-size: 0.8rem;",
    "      border: 1px solid var(--iswc-control-border);",
    "    }"
  ],
  "storageKey": "docs-iswc-theme-toggle",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Alterna el tema del contenedor más cercano",
        "          (<code class=\"code\">[container-theme]</code> / <code class=\"code\">.container-theme</code>",
        "          / <code class=\"code\">.theme-dark|.theme-light</code> / <code class=\"code\">[data-theme]</code>;",
        "          si no hay, <code class=\"code\">&lt;html&gt;</code>).",
        "          Compone <code class=\"code\">iswc-check-icon-button</code> (noche ↔ sol).",
        "          Emite <code class=\"code\">theme-toggle</code> con <code class=\"code\">detail.theme</code> y",
        "          <code class=\"code\">detail.container</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-theme-toggle dark></iswc-theme-toggle>",
            "          <span class=\"demo-label\" style=\"margin-left:.75rem\">afecta al documento (html)</span>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:dark",
              "label": "dark"
            }
          ],
          "equivNote": "Cascada de dónde escribe el tema al conmutar.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-theme-toggle: contenedor\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"buscar contenedor\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"[container-theme]\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \".container-theme\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \".theme-* / data-theme\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"<html>\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"1º\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"b\",",
            "          \"label\": \"2º\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\",",
            "          \"label\": \"3º\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"d\",",
            "          \"label\": \"fallback\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "scoped",
      "title": "Contenedores anidados",
      "lede": [
        "Cada caja es un <code class=\"code\">.container-theme</code> independiente.",
        "          El toggle usa <code class=\"code\">closest()</code> y solo cambia esa caja."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"theme-boxes\">",
            "            <div class=\"container-theme theme-dark\" data-theme=\"dark\" data-palette=\"contapyme\">",
            "              <div class=\"container-theme__head\">",
            "                <span class=\"container-theme__title\">Panel oscuro</span>",
            "                <iswc-theme-toggle dark></iswc-theme-toggle>",
            "              </div>",
            "              <p class=\"container-theme__hint\">Tokens <code>--iswc-*</code> locales a este nodo.</p>",
            "              <span class=\"container-theme__chip\">chip de control</span>",
            "            </div>",
            "            <div class=\"container-theme theme-light\" data-theme=\"light\" data-palette=\"contapyme\">",
            "              <div class=\"container-theme__head\">",
            "                <span class=\"container-theme__title\">Panel claro</span>",
            "                <iswc-theme-toggle></iswc-theme-toggle>",
            "              </div>",
            "              <p class=\"container-theme__hint\">Su propio tema; no toca el documento ni el otro panel.</p>",
            "              <span class=\"container-theme__chip\">chip de control</span>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo / API",
            "Descripción"
          ],
          "rows": [
            [
              "<code>dark</code>",
              "boolean reflected — tema actual del scope"
            ],
            [
              "<code>themeContainer</code>",
              "getter — nodo resuelto por <code>closest</code>"
            ],
            [
              "<code>theme-toggle</code>",
              "CustomEvent · <code>detail: { theme, dark, container }</code>"
            ],
            [
              "Scope",
              "<code>[container-theme]</code>, <code>.container-theme</code>, <code>.theme-*</code>, <code>[data-theme]</code>, else <code>&lt;html&gt;</code>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Alterna el tema del contenedor más cercano",
          "          (<code class=\"code\">[container-theme]</code> / <code class=\"code\">.container-theme</code>",
          "          / <code class=\"code\">.theme-dark|.theme-light</code> / <code class=\"code\">[data-theme]</code>;",
          "          si no hay, <code class=\"code\">&lt;html&gt;</code>).",
          "          Compone <code class=\"code\">iswc-check-icon-button</code> (noche ↔ sol).",
          "          Emite <code class=\"code\">theme-toggle</code> con <code class=\"code\">detail.theme</code> y",
          "          <code class=\"code\">detail.container</code>."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>dark</code>",
            "desc": "boolean reflected — tema actual del scope"
          },
          {
            "name": "<code>themeContainer</code>",
            "desc": "getter — nodo resuelto por <code>closest</code>"
          },
          {
            "name": "<code>theme-toggle</code>",
            "desc": "CustomEvent · <code>detail: { theme, dark, container }</code>"
          },
          {
            "name": "Scope",
            "desc": "<code>[container-theme]</code>, <code>.container-theme</code>, <code>.theme-*</code>, <code>[data-theme]</code>, else <code>&lt;html&gt;</code>"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-theme-toggle dark></iswc-theme-toggle>",
          "          <span class=\"demo-label\" style=\"margin-left:.75rem\">afecta al documento (html)</span>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
