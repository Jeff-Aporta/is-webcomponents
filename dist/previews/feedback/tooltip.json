{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-tooltip",
  "category": "feedback",
  "title": "&lt;iswc-tooltip&gt;",
  "titleHtml": false,
  "styles": ".grid { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }",
  "storageKey": "docs-iswc-tooltip",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Tip breve anclado con <code class=\"code\">for</code>. Depende de <code class=\"code\">iswc-popover</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"tip-target\">Hover Me</iswc-button>",
            "          <iswc-tooltip for=\"tip-target\">This is a tooltip</iswc-tooltip>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:placement",
              "label": "placement",
              "options": [
                "top",
                "right",
                "bottom",
                "left",
                "bottom-start"
              ]
            },
            {
              "control": "select",
              "prop": "attr:trigger",
              "label": "trigger",
              "options": [
                "click",
                "manual"
              ]
            }
          ],
          "equivNote": "trigger decide cómo se abre; tip con HTML suele ir mejor con click.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-tooltip: trigger\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"trigger=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"hover → show/hide\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"click → toggle\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"manual → API\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"hover\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"click\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"c\",",
            "          \"label\": \"manual\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "placement",
      "title": "Placement",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"t-top\">top</iswc-button>",
            "          <iswc-tooltip for=\"t-top\" placement=\"top\">top</iswc-tooltip>",
            "          <iswc-button id=\"t-right\">right</iswc-button>",
            "          <iswc-tooltip for=\"t-right\" placement=\"right\">right</iswc-tooltip>",
            "          <iswc-button id=\"t-bottom\">bottom</iswc-button>",
            "          <iswc-tooltip for=\"t-bottom\" placement=\"bottom\">bottom</iswc-tooltip>",
            "          <iswc-button id=\"t-left\">left</iswc-button>",
            "          <iswc-tooltip for=\"t-left\" placement=\"left\">left</iswc-tooltip>"
          ]
        }
      ]
    },
    {
      "id": "trigger",
      "title": "Trigger click / manual",
      "lede": "Clic fuera o <code class=\"code\">Escape</code> cierra el tip.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"t-click\">Click to Toggle</iswc-button>",
            "          <iswc-tooltip for=\"t-click\" trigger=\"click\">Click nuevamente o fuera para cerrar</iswc-tooltip>",
            "          <iswc-button id=\"t-manual-btn\">Toggle Manually</iswc-button>",
            "          <iswc-tooltip id=\"t-manual\" for=\"t-manual-btn\" trigger=\"manual\">Manual tooltip</iswc-tooltip>"
          ]
        }
      ]
    },
    {
      "id": "html",
      "title": "Contenido HTML largo",
      "lede": [
        "El slot acepta markup. Útil para tips densos; preferir",
        "          <code class=\"code\">trigger=\"click\"</code> si hay enlaces o texto seleccionable."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-button id=\"t-html\" color=\"brand\">Auditoría · tip largo</iswc-button>",
            "          <iswc-tooltip",
            "            for=\"t-html\"",
            "            trigger=\"click\"",
            "            placement=\"bottom-start\"",
            "            style=\"--max-width: 22rem\"",
            "          >",
            "            <p><strong>Resumen de cumplimiento</strong></p>",
            "            <p>",
            "              Este tip muestra contenido enriquecido para revisar wrapping,",
            "              contraste y dismiss al clic fuera.",
            "            </p>",
            "            <ul>",
            "              <li>Tokens <code>--iswc-*</code> y tipografía del tema</li>",
            "              <li>Máximo ancho vía <code>--max-width</code></li>",
            "              <li>Enlace de ejemplo:",
            "                <a href=\"https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Roles/tooltip_role\" target=\"_blank\" rel=\"noopener\">ARIA tooltip</a>",
            "              </li>",
            "            </ul>",
            "            <p>Última revisión: sprint actual · owner: Design System</p>",
            "          </iswc-tooltip>"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-tooltip\">",
            "  <iswc-tooltip label=\"Informacion extra\">",
            "    <iswc-button>Pasa el mouse</iswc-button>",
            "  </iswc-tooltip>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "<code>for</code>",
              "id del target"
            ],
            [
              "<code>trigger</code>",
              "hover focus | click | manual — click/manual: fuera + Escape cierra"
            ],
            [
              "<code>--max-width</code>",
              "ancho del tip (default 16rem)"
            ],
            [
              "slot",
              "texto o HTML (p, ul, a, code…)"
            ],
            [
              "<code>placement</code> <code>distance</code> <code>skidding</code>",
              "posicionamiento"
            ],
            [
              "<code>show()</code> <code>hide()</code>",
              "métodos"
            ],
            [
              "events",
              "iswc-show, iswc-after-show, iswc-hide, iswc-after-hide"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Tip breve anclado con <code class=\"code\">for</code>. Depende de <code class=\"code\">iswc-popover</code>."
      },
      "apiJs": {
        "table": [
          {
            "metodo": "<code>for</code>",
            "desc": "id del target"
          },
          {
            "metodo": "<code>trigger</code>",
            "desc": "hover focus | click | manual — click/manual: fuera + Escape cierra"
          },
          {
            "metodo": "<code>--max-width</code>",
            "desc": "ancho del tip (default 16rem)"
          },
          {
            "metodo": "slot",
            "desc": "texto o HTML (p, ul, a, code…)"
          },
          {
            "metodo": "<code>placement</code> <code>distance</code> <code>skidding</code>",
            "desc": "posicionamiento"
          },
          {
            "metodo": "<code>show()</code> <code>hide()</code>",
            "desc": "métodos"
          },
          {
            "metodo": "events",
            "desc": "iswc-show, iswc-after-show, iswc-hide, iswc-after-hide"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-button id=\"tip-target\">Hover Me</iswc-button>",
          "<iswc-tooltip for=\"tip-target\">This is a tooltip</iswc-tooltip>",
          "```"
        ]
      }
    },
    "exclude": [
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
