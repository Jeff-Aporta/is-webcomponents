{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-popconfirm",
  "category": "feedback",
  "title": "&lt;iswc-popconfirm&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-popconfirm de InSoft.",
  "storageKey": "docs-iswc-popconfirm",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Cuadro de confirmación rápido anclado a un botón. Sin modal, sin tapar\r\n          la pantalla. Perfecto para \"¿Seguro que quieres borrar?\" en línea.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"btnDelete\" color=\"danger\">\r\n            <iswc-icon slot=\"start\" icon=\"mdi:trash-can\"></iswc-icon>\r\n            Borrar elemento\r\n          </iswc-button>\r\n          <iswc-popconfirm for=\"btnDelete\" message=\"¿Seguro que quieres borrarlo? Esta acción no se puede deshacer.\" placement=\"bottom-end\">\r\n            <iswc-button slot=\"confirm\" color=\"danger\">Sí, borrar</iswc-button>\r\n            <iswc-button slot=\"cancel\">Cancelar</iswc-button>\r\n          </iswc-popconfirm>\r\n          <p id=\"pcLog\">Última acción: <code class=\"code\">—</code></p>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:placement",
              "label": "placement",
              "options": [
                "top",
                "bottom",
                "start",
                "end",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:hide-arrow",
              "label": "hide-arrow"
            }
          ]
        }
      ]
    },
    {
      "id": "placements",
      "title": "Posiciones",
      "lede": "top, top-start, top-end, bottom, bottom-start, bottom-end, start, end.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div style=\"display:flex;gap:0.5rem;flex-wrap:wrap\">\r\n            <iswc-button id=\"pc1\">top</iswc-button>\r\n            <iswc-popconfirm for=\"pc1\" message=\"Top popconfirm\" placement=\"top\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc2\">top-start</iswc-button>\r\n            <iswc-popconfirm for=\"pc2\" placement=\"top-start\" message=\"Top start\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc3\">top-end</iswc-button>\r\n            <iswc-popconfirm for=\"pc3\" placement=\"top-end\" message=\"Top end\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc4\">bottom</iswc-button>\r\n            <iswc-popconfirm for=\"pc4\" placement=\"bottom\" message=\"Bottom\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc5\">bottom-start</iswc-button>\r\n            <iswc-popconfirm for=\"pc5\" placement=\"bottom-start\" message=\"Bottom start\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc6\">bottom-end</iswc-button>\r\n            <iswc-popconfirm for=\"pc6\" placement=\"bottom-end\" message=\"Bottom end\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc7\">start</iswc-button>\r\n            <iswc-popconfirm for=\"pc7\" placement=\"start\" message=\"Start\"></iswc-popconfirm>\r\n\r\n            <iswc-button id=\"pc8\">end</iswc-button>\r\n            <iswc-popconfirm for=\"pc8\" placement=\"end\" message=\"End\"></iswc-popconfirm>\r\n          </div>"
        }
      ]
    },
    {
      "id": "custom",
      "title": "Mensaje propio",
      "lede": "El contenido del slot <code class=\"code\">message</code> reemplaza el atributo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"pcMega\">Power action</iswc-button>\r\n          <iswc-popconfirm for=\"pcMega\" placement=\"bottom\" hide-arrow>\r\n            <div slot=\"message\">\r\n              <strong>¿Reiniciar el servidor?</strong>\r\n              <p style=\"margin:0.25rem 0;font-size:0.85em;color:color-mix(in srgb,currentColor 70%,transparent)\">\r\n                Esto detendrá todos los servicios activos.\r\n              </p>\r\n            </div>\r\n            <iswc-button slot=\"cancel\">Cancelar</iswc-button>\r\n            <iswc-button slot=\"confirm\" color=\"danger\">Reiniciar</iswc-button>\r\n          </iswc-popconfirm>"
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-slots-pg tag=\"iswc-popconfirm\">\n  <iswc-popconfirm>\n    <iswc-button color=\"danger\" variant=\"outlined\">\n      <iswc-icon icon=\"mdi:trash-can-outline\"></iswc-icon>\n      Eliminar\n    </iswc-button>\n  </iswc-popconfirm>\n  <span slot=\"message\">¿Eliminar este elemento?</span>\n</iswc-slots-pg>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
