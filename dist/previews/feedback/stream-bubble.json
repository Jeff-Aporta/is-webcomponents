{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-stream-bubble",
  "category": "feedback",
  "title": "&lt;iswc-stream-bubble&gt;",
  "titleHtml": false,
  "description": "Burbuja de una respuesta que llega por partes, con estado, pasos previos y markdown ligero.",
  "storageKey": "docs-iswc-stream-bubble",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Burbuja de una respuesta que llega por partes: estado, pasos previos, escritura letra a letra y markdown ligero. El texto se escapa antes de darle formato, así que es seguro pintar lo que llegue de un modelo.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-stream-bubble id=\"u\" name=\"Asistente\" avatar=\"A\" state=\"streaming\" text=\"Revisé **tres documentos**:&#10;- Contrato&#10;- Factura `A-12`&#10;- [Política](https://example.com)\"></iswc-stream-bubble>"
          ],
          "target": "#u",
          "controls": [
            {
              "control": "select",
              "prop": "attr:state",
              "label": "state",
              "options": [
                "idle",
                "streaming",
                "end",
                "error"
              ]
            },
            {
              "control": "text",
              "prop": "attr:text",
              "label": "text"
            },
            {
              "control": "text",
              "prop": "attr:name",
              "label": "name"
            },
            {
              "control": "text",
              "prop": "attr:avatar",
              "label": "avatar"
            },
            {
              "control": "boolean",
              "prop": "attr:animated",
              "label": "animated",
              "default": false
            },
            {
              "control": "json",
              "prop": "props:progress",
              "label": "progress",
              "default": "[\n  {\n    \"icono\": \"🔎\",\n    \"texto\": \"Buscando documentos\"\n  },\n  {\n    \"icono\": \"🧠\",\n    \"texto\": \"Armando la respuesta\"\n  }\n]"
            }
          ]
        },
        {
          "kind": "html",
          "html": "<iswc-callout tone=\"info\"><strong slot=\"title\">Cuándo usarlo</strong>Respuesta de un asistente o de un proceso por stream.</iswc-callout><iswc-callout tone=\"warning\"><strong slot=\"title\">Cuándo no</strong>Mensajes ya completos de un chat entre personas.</iswc-callout>"
        }
      ]
    }
  ]
}
