          "kind": "demo",
          "html": "<div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem\">\r\n            <is-badge color=\"brand\" variant=\"accent\">accent</is-badge>\r\n            <is-badge color=\"brand\" variant=\"filled\">filled</is-badge>\r\n            <is-badge color=\"brand\" variant=\"outlined\">outlined</is-badge>\r\n            <is-badge color=\"brand\" variant=\"filled-outlined\">filled-outlined</is-badge>\r\n            <is-badge color=\"danger\" pill attention=\"bounce\">pill bounce</is-badge>\r\n          </div>\r\n          <div class=\"demo-row\" style=\"flex-wrap:wrap;gap:.5rem\">\r\n            <is-badge color=\"neutral\" variant=\"filled\">neutral</is-badge>\r\n            <is-badge color=\"success\" variant=\"filled\">success</is-badge>\r\n            <is-badge color=\"warning\" variant=\"outlined\">warning</is-badge>\r\n            <is-badge color=\"danger\" variant=\"accent\">danger</is-badge>\r\n            <is-badge attention=\"pulse\">pulse</is-badge>\r\n          </div>"
        },
