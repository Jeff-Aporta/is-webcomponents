{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-main",
  "category": "layout",
  "title": "&lt;iswc-main&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-main",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Contenedor scrollable equivalente a <code class=\"code\">&lt;main&gt;</code>.\r\n          La persistencia de scroll es <strong>opt-in estricta</strong>: requiere\r\n          <code class=\"code\">remember-scroll</code> y <code class=\"code\">storage-key</code>.",
      "blocks": [
        {
          "kind": "code",
          "code": "<iswc-main class=\"main\" remember-scroll storage-key=\"docs-mi-vista\">\n  …\n</iswc-main>"
        }
      ]
    },
    {
      "id": "remember",
      "title": "Remember scroll",
      "lede": "Guarda <code class=\"code\">top</code> + <code class=\"code\">savedAt</code> en\r\n          <code class=\"code\">localStorage → is-webcomponents.iswc-main[key]</code>.\r\n          Si pasan más de <code class=\"code\">scroll-ttl</code> ms (default 1h), se ignora.",
      "blocks": [
        {
          "kind": "html",
          "html": "<ul>\r\n          <li>Sin <code class=\"code\">remember-scroll</code> o sin <code class=\"code\">storage-key</code> → no hay LS.</li>\r\n          <li>Cambio de componente (iframe <code class=\"code\">navigate</code>) → siempre top.</li>\r\n          <li>F5 / back-forward → restore si el TTL sigue vigente.</li>\r\n        </ul>"
        },
        {
          "kind": "demo",
          "html": "<iswc-button id=\"btnTop\" variant=\"outlined\">scrollToTop()</iswc-button>\r\n          <iswc-button id=\"btnClear\" variant=\"outlined\">clearRememberedScroll()</iswc-button>\r\n          <iswc-button id=\"btnSave\" variant=\"filled\">saveScroll()</iswc-button>"
        },
        {
          "kind": "html",
          "html": "<p class=\"lede\" id=\"scrollLog\">Scroll…</p>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "lede": "Espaciador para probar scroll ↓",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "API",
            "Detalle"
          ],
          "rows": [
            [
              "<code>remember-scroll</code>",
              "boolean — opt-in (default off)"
            ],
            [
              "<code>storage-key</code>",
              "id único; obligatorio si remember-scroll"
            ],
            [
              "<code>scroll-ttl</code>",
              "ms; default <code>3600000</code> (1h)"
            ],
            [
              "<code>scrollToTop()</code>",
              "sube al inicio"
            ],
            [
              "<code>saveScroll()</code> <code>restoreScroll()</code>",
              "API manual"
            ],
            [
              "<code>clearRememberedScroll()</code>",
              "invalida la entrada guardada"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<div style=\"height:120vh;border:1px dashed var(--iswc-border);border-radius:8px;padding:1rem;color:var(--iswc-text-soft)\">\r\n          Zona alta — scrollea y recarga (F5) para ver restore.\r\n        </div>"
        }
      ]
    }
  ]
}
