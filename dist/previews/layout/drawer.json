{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-drawer",
  "category": "layout",
  "title": "&lt;iswc-drawer&gt;",
  "titleHtml": false,
  "description": "Documentación y demos del componente iswc-drawer de InSoft.",
  "storageKey": "docs-iswc-drawer",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Panel que se desliza desde un borde del viewport (derecha, izquierda, arriba o abajo).",
        "          Ideal para menús, filtros y contenido secundario."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openDefault\">Abrir drawer (end)</iswc-button>",
          "equivNote": "placement define el eje; light-dismiss el cierre por backdrop.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-drawer: placement\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"placement=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"start / end → ancho\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"top / bottom → alto\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"light-dismiss?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"clic fuera cierra\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"e\",",
            "          \"label\": \"solo chrome / Escape\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"lat\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"vert\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"d\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"e\",",
            "          \"label\": \"no\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        },
        {
          "kind": "html",
          "html": [
            "<iswc-drawer id=\"drwDefault\" label=\"Drawer estándar\">",
            "          <p>Un drawer es una excelente manera de mostrar contenido adicional sin salir de la página actual.</p>",
            "          <div slot=\"footer\">",
            "            <iswc-button data-drawer=\"close\" variant=\"outlined\">Cancelar</iswc-button>",
            "            <iswc-button data-drawer=\"close\" color=\"brand\">Aceptar</iswc-button>",
            "          </div>",
            "        </iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "placements",
      "title": "Placements",
      "lede": "El atributo <code class=\"code\">placement</code> elige desde qué borde se desliza.",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<div class=\"demo-stack\">",
            "          <iswc-button id=\"openEnd\">end (default)</iswc-button>",
            "          <iswc-button id=\"openStart\">start</iswc-button>",
            "          <iswc-button id=\"openTop\">top</iswc-button>",
            "          <iswc-button id=\"openBottom\">bottom</iswc-button>",
            "        </div>",
            "",
            "        <iswc-drawer id=\"drwEnd\" label=\"End\" placement=\"end\">",
            "          <p>Este drawer se desliza desde la derecha (default).</p>",
            "        </iswc-drawer>",
            "        <iswc-drawer id=\"drwStart\" label=\"Start\" placement=\"start\">",
            "          <p>Este drawer se desliza desde la izquierda.</p>",
            "        </iswc-drawer>",
            "        <iswc-drawer id=\"drwTop\" label=\"Top\" placement=\"top\">",
            "          <p>Este drawer se desliza desde arriba.</p>",
            "        </iswc-drawer>",
            "        <iswc-drawer id=\"drwBottom\" label=\"Bottom\" placement=\"bottom\">",
            "          <p>Este drawer se desliza desde abajo.</p>",
            "        </iswc-drawer>"
          ]
        },
        {
          "kind": "code",
          "code": [
            "<iswc-drawer placement=\"start\">…</iswc-drawer>",
            "<iswc-drawer placement=\"top\">…</iswc-drawer>",
            "<iswc-drawer placement=\"bottom\">…</iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "size",
      "title": "Tamaño",
      "lede": "Ajusta <code class=\"code\">size</code> en el host. Se aplica al ancho o alto según el placement.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openWide\">Drawer ancho (50%)</iswc-button>"
        },
        {
          "kind": "html",
          "html": [
            "<iswc-drawer id=\"drwWide\" label=\"50%\" size=\"50%\">",
            "          <p>Este drawer ocupa siempre el 50% del viewport.</p>",
            "        </iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "no-header",
      "title": "Sin header",
      "lede": "<code class=\"code\">without-header</code> oculta el header y el botón de cerrar.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openNoHeader\">Abrir sin header</iswc-button>"
        },
        {
          "kind": "html",
          "html": [
            "<iswc-drawer id=\"drwNoHeader\" without-header>",
            "          <p>¡Mira mamá, sin header!</p>",
            "          <div slot=\"footer\">",
            "            <iswc-button data-drawer=\"close\" color=\"brand\">Cerrar</iswc-button>",
            "          </div>",
            "        </iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "light-dismiss",
      "title": "Light dismiss",
      "lede": "<code class=\"code\">light-dismiss</code> cierra al hacer click fuera del drawer.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openLD\">Abrir (click fuera cierra)</iswc-button>"
        },
        {
          "kind": "html",
          "html": [
            "<iswc-drawer id=\"drwLD\" label=\"Light dismiss\" light-dismiss>",
            "          <p>Haz click fuera del drawer para cerrarlo.</p>",
            "        </iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "nav-example",
      "title": "Drawer de navegación",
      "lede": "Caso típico: menú lateral persistente.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-button id=\"openNav\">Menú</iswc-button>"
        },
        {
          "kind": "html",
          "html": [
            "<iswc-drawer id=\"drwNav\" placement=\"start\" label=\"Navegación\" size=\"280px\">",
            "          <nav style=\"display:flex;flex-direction:column;gap:.5em\">",
            "            <a href=\"#\" style=\"text-decoration:none\">Inicio</a>",
            "            <a href=\"#\" style=\"text-decoration:none\">Productos</a>",
            "            <a href=\"#\" style=\"text-decoration:none\">Clientes</a>",
            "            <a href=\"#\" style=\"text-decoration:none\">Reportes</a>",
            "            <a href=\"#\" style=\"text-decoration:none\">Configuración</a>",
            "          </nav>",
            "        </iswc-drawer>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia completa",
      "blocks": [
