{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-server-api-docs",
  "category": "layout",
  "title": "&lt;iswc-server-api-docs&gt;",
  "titleHtml": false,
  "description": "Endpoints de la API de un server al estilo Swagger: valida su documento con Zod (y dice si admite el parse estricto InSoft v2), lista los endpoints en una tabla con filtro y abre cada uno con método, ruta, sesión y permiso, parámetros, cuerpo, respuestas con schema y ejemplo, su diagrama de secuencia en estilo InSoft y «Probar».",
  "storageKey": "docs-iswc-server-api-docs",
  "loads": [
    "iswc-doc-layout",
    "iswc-doc-index",
    "iswc-pager",
    "iswc-code",
    "iswc-tag",
    "iswc-spinner",
    "iswc-copy-button",
    "iswc-button",
    "iswc-button-group",
    "iswc-icon",
    "iswc-input",
    "iswc-dialog",
    "iswc-callout",
    "iswc-sequence-diagram"
  ],
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "El server publica su documento (InSoft <code class=\"code\">kind:\"config\"</code> u OpenAPI 3) y la página solo monta la etiqueta: aquí el documento va en un <code class=\"code\">script type=\"application/json\"</code> hijo; también se asigna por propiedad (<code class=\"code\">el.doc = obj</code>) o se pide por <code class=\"code\">src</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-server-api-docs api-base=\"https://ayudascp-ia-staging.azurewebsites.net/api\" style=\"height: 620px\">",
            "  <script type=\"application/json\">",
            "    {",
            "      \"kind\": \"config\",",
            "      \"version\": 2,",
            "      \"info\": {",
            "        \"title\": \"API PatyIA\",",
            "        \"version\": \"1.0.0\",",
            "        \"description\": \"Endpoints del ISS PatyIA (documento de ejemplo): conversaciones y configuración del sistema.\"",
            "      },",
            "      \"viewer\": {",
            "        \"ns\": \"ISS\",",
            "        \"brand\": {",
            "          \"title\": \"ISS PatyIA\",",
            "          \"icon\": \"mdi:robot-happy-outline\"",
            "        },",
            "        \"auth\": {",
            "          \"enabled\": true,",
            "          \"loginKind\": \"portal\",",
            "          \"loginPath\": \"/auth/portal-login\",",
            "          \"app\": \"isa-patyia\",",
            "          \"provider\": \"patyia-portal\"",
            "        },",
            "        \"exports\": {",
            "          \"openApiDownloadName\": \"iss-ayudascpia.openapi.json\",",
            "          \"isDownloadName\": \"iss-ayudascpia.is.json\"",
            "        }",
            "      },",
            "      \"tags\": [",
            "        {",
            "          \"name\": \"Conversaciones\",",
            "          \"description\": \"Chat PatyIA: turno en streaming, detalle, bitácora, calificación, tiquetes, auditoría, circuito MCP y su configuración.\",",
            "          \"subgroups\": [",
            "            {",
            "              \"id\": \"chat\",",
            "              \"name\": \"Chat\",",
            "              \"icon\": \"mdi:forum-outline\",",
            "              \"description\": \"Turno SSE, listado propio, detalle y baja lógica.\"",
            "            }",
            "          ]",
            "        },",
            "        {",
            "          \"name\": \"Sistema\",",
            "          \"description\": \"Autenticación, salud, configuración en caliente, catálogo de instrucciones, bandeja de errores y documentación.\",",
            "          \"subgroups\": [",
            "            {",
            "              \"id\": \"configuracion\",",
            "              \"name\": \"Configuración\",",
            "              \"icon\": \"mdi:cog-outline\",",
            "              \"description\": \"Filas de `patyia_sys_values` y proveedor de IA.\"",
            "            },",
            "            {",
            "              \"id\": \"documentacion\",",
            "              \"name\": \"Documentación\",",
            "              \"icon\": \"mdi:file-code-outline\",",
            "              \"description\": \"Este visor y su documento.\"",
            "            }",
            "          ]",
            "        }",
            "      ],",
            "      \"paths\": {",
            "        \"/sistema/cfg\": {",
            "          \"get\": {",
            "            \"summary\": \"Leer la configuración del host\",",
            "            \"description\": \"Fila `runtime` (o sus defaults): bitácora, retención, timers, purga e interruptores de audio y MCP.\",",
            "            \"tags\": [",
            "              \"Sistema\"",
            "            ],",
            "            \"subgroup\": \"configuracion\",",
            "            \"security\": \"bearer\",",
            "            \"permission\": \"CFG:/sistema\",",
            "            \"controller\": \"TSysValueController.leerCfg\",",
            "            \"responses\": {",
            "              \"template\": \"auth\",",
            "              \"description\": \"Fila `runtime` (jvalue serializado)\",",
            "              \"payload\": \"cfg-runtime\"",
            "            }",
            "          },",
            "          \"put\": {",
            "            \"summary\": \"Actualizar la configuración del host\",",
            "            \"description\": \"Push parcial del `jvalue` de `runtime` validado con su schema.\",",
            "            \"tags\": [",
            "              \"Sistema\"",
            "            ],",
            "            \"subgroup\": \"configuracion\",",
            "            \"security\": \"bearer\",",
            "            \"permission\": \"CFG:/sistema\",",
            "            \"controller\": \"TSysValueController.escribirCfg\",",
            "            \"requestBody\": {",
            "              \"required\": true,",
            "              \"description\": \"Fragmento del `jvalue` a cambiar.\",",
            "              \"schema\": {",
            "                \"type\": \"object\",",
            "                \"required\": [",
            "                  \"jvalue\"",
            "                ],",
            "                \"properties\": {",
            "                  \"jvalue\": {",
            "                    \"type\": \"object\",",
            "                    \"properties\": {",
            "                      \"purga\": {",
            "                        \"type\": \"object\",",
            "                        \"description\": \"Purga del log\"",
            "                      },",
            "                      \"timers\": {",
            "                        \"type\": \"object\",",
            "                        \"description\": \"Interruptores de timers\"",
            "                      },",
            "                      \"convlog\": {",
            "                        \"type\": \"boolean\",",
            "                        \"description\": \"Bitácora de conversación\"",
            "                      },",
            "                      \"procesarMcp\": {",
            "                        \"type\": \"boolean\",",
            "                        \"description\": \"Circuito MCP\"",
            "                      },",
            "                      \"clean_convlog\": {",
            "                        \"type\": \"integer\",",
            "                        \"description\": \"Retención en días\"",
            "                      },",
            "                      \"procesarAudio\": {",
            "                        \"type\": \"boolean\",",
            "                        \"description\": \"Transcribir notas de voz\"",
            "                      }",
            "                    }",
            "                  }",
            "                }",
            "              },",
            "              \"bodyKey\": \"cfg-runtime\"",
            "            },",
            "            \"responses\": {",
            "              \"template\": \"authForbidden\",",
            "              \"description\": \"Fila tras el push\",",
            "              \"payload\": \"cfg-runtime\"",
            "            }",
            "          }",
            "        },",
            "        \"/conversacion/{iconversacion}\": {",
            "          \"get\": {",
            "            \"summary\": \"Detalle de una conversación\",",
            "            \"description\": \"Conversación con sus mensajes, calificados y tiquetes; si la lee el dueño y venció la inactividad, la cierra. Contrato del portal de soporte.\",",
            "            \"tags\": [",
            "              \"Conversaciones\"",
            "            ],",
            "            \"subgroup\": \"chat\",",
            "            \"security\": \"bearer\",",
            "            \"permission\": \"GET:/conversacion/{iconversacion}\",",
            "            \"controller\": \"TConversacionController.get\",",
            "            \"parameters\": [",
            "              {",
            "                \"name\": \"iconversacion\",",
            "                \"in\": \"path\",",
            "                \"required\": true,",
            "                \"description\": \"Id de la conversación (entero positivo).\",",
            "                \"schema\": {",
            "                  \"type\": \"integer\",",
            "                  \"minimum\": 1",
            "                },",
            "                \"example\": 4821",
            "              }",
            "            ],",
            "            \"responses\": {",
            "              \"template\": \"authNotFound\",",
            "              \"description\": \"Detalle de la conversación\",",
            "              \"payload\": \"conversacion-detalle\"",
            "            }",
            "          },",
            "          \"delete\": {",
            "            \"summary\": \"Eliminar una conversación\",",
            "            \"description\": \"Baja lógica (`itdestado = 2`), solo el dueño; nunca borra filas.\",",
            "            \"tags\": [",
            "              \"Conversaciones\"",
            "            ],",
            "            \"subgroup\": \"chat\",",
            "            \"security\": \"bearer\",",
            "            \"permission\": \"DELETE:/conversacion/{iconversacion}\",",
            "            \"controller\": \"TConversacionController.delete\",",
            "            \"parameters\": [",
            "              {",
            "                \"name\": \"iconversacion\",",
            "                \"in\": \"path\",",
            "                \"required\": true,",
            "                \"description\": \"Id de la conversación (entero positivo).\",",
            "                \"schema\": {",
            "                  \"type\": \"integer\",",
            "                  \"minimum\": 1",
            "                },",
            "                \"example\": 4821",
            "              }",
            "            ],",
            "            \"responses\": {",
            "              \"template\": \"deleteEnvelope\",",
            "              \"description\": \"Conversación releída tras la baja\",",
            "              \"payload\": \"conversacion-eliminada\",",
            "              \"schema\": \"conversacion-row\"",
            "            }",
            "          }",
            "        },",
            "        \"/conversacion\": {",
            "          \"post\": {",
            "            \"summary\": \"Enviar un turno (SSE)\",",
            "            \"description\": \"Turno de chat en streaming (`text/event-stream`): `begin` → `log`/`process`/`message` → `end` o `error`. Sin `iconversacion` abre una conversación nueva. Contrato del portal de soporte.\",",
            "            \"tags\": [",
            "              \"Conversaciones\"",
            "            ],",
            "            \"subgroup\": \"chat\",",
            "            \"security\": \"bearer\",",
            "            \"permission\": \"POST:/conversacion\",",
            "            \"controller\": \"TConversacionController.insertPortal\",",
            "            \"requestBody\": {",
            "              \"required\": true,",
            "              \"description\": \"Mensaje del usuario y, si continúa, su `iconversacion`.\",",
            "              \"schema\": {",
            "                \"type\": \"object\",",
            "                \"properties\": {",
            "                  \"xml\": {",
            "                    \"type\": \"boolean\",",
            "                    \"description\": \"Emite eventos `process`\"",
            "                  },",
            "                  \"hilo\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"Hilo del proveedor\"",
            "                  },",
            "                  \"mode\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"`libre` exige la capacidad `conversacionLibre`\"",
            "                  },",
            "                  \"model\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"Modelo, si el proveedor lo lista\"",
            "                  },",
            "                  \"top_p\": {",
            "                    \"type\": \"number\",",
            "                    \"description\": \"Solo con capacidad irrestricta\"",
            "                  },",
            "                  \"audios\": {",
            "                    \"type\": \"array\",",
            "                    \"items\": {",
            "                      \"type\": \"string\"",
            "                    },",
            "                    \"description\": \"Notas de voz (máx. 20; http(s) o data:audio/)\"",
            "                  },",
            "                  \"prompt\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"Texto del usuario (vacío solo con adjuntos)\"",
            "                  },",
            "                  \"contexto\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"Raíces enteras separadas por espacio\"",
            "                  },",
            "                  \"imagenes\": {",
            "                    \"type\": \"array\",",
            "                    \"items\": {",
            "                      \"type\": \"object\"",
            "                    },",
            "                    \"description\": \"Imágenes (`url`, `dataUrl`)\"",
            "                  },",
            "                  \"itdconsulta\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"Instrucción a usar\"",
            "                  },",
            "                  \"temperature\": {",
            "                    \"type\": \"number\",",
            "                    \"description\": \"Solo con capacidad irrestricta\"",
            "                  },",
            "                  \"iconversacion\": {",
            "                    \"type\": \"integer\",",
            "                    \"description\": \"> 0 continúa esa conversación; sin él se abre una nueva\"",
            "                  },",
            "                  \"reasoningEffort\": {",
            "                    \"type\": \"string\",",
            "                    \"description\": \"low · medium · high\"",
            "                  }",
            "                }",
            "              },",
            "              \"bodyKey\": \"turno\"",
            "            },",
            "            \"responses\": {",
            "              \"template\": \"raw\",",
            "              \"items\": {",
            "                \"200\": {",
            "                  \"description\": \"text/event-stream: begin · log · process · message · end · error\",",
            "                  \"payload\": \"sse-turno\"",
            "                },",
            "                \"400\": {",
            "                  \"description\": \"Body inválido, prompt vacío sin adjuntos o conversación cerrada\"",
            "                },",
            "                \"401\": {",
            "                  \"description\": \"Sin JWT o no es el dueño\"",
            "                },",
            "                \"403\": {",
            "                  \"description\": \"Modo libre sin capacidad o contexto 9999.x\"",
            "                }",
            "              }",
            "            },",
            "            \"tryitAttachments\": \"turno\"",
            "          }",
            "        },",
            "        \"/docs\": {",
            "          \"get\": {",
            "            \"summary\": \"Visor de la API\",",
            "            \"description\": \"Este visor: HTML que monta `<iswc-server-api-docs>` (kit iswc por CDN, pin por SHA) con la fila `doc` incrustada. `?v=json` entrega el documento, `?v=md` en markdown y `?v=routes` los ids SEG montados. Público y sin sobre.\",",
            "            \"tags\": [",
            "              \"Sistema\"",
            "            ],",
            "            \"subgroup\": \"documentacion\",",
            "            \"security\": \"none\",",
            "            \"controller\": \"TSysValueController.docs\",",
            "            \"parameters\": [",
            "              {",
            "                \"name\": \"v\",",
            "                \"in\": \"query\",",
            "                \"required\": false,",
            "                \"description\": \"Formato: json · md · routes (sin él, HTML).\",",
            "                \"schema\": {",
            "                  \"enum\": [",
            "                    \"json\",",
            "                    \"md\",",
            "                    \"routes\"",
            "                  ],",
            "                  \"type\": \"string\"",
            "                }",
            "              }",
            "            ],",
            "            \"responses\": {",
            "              \"template\": \"raw\",",
            "              \"items\": {",
            "                \"200\": {",
            "                  \"description\": \"text/html (visor) · application/json (?v=json, ?v=routes) · text/markdown (?v=md)\",",
            "                  \"schema\": {",
            "                    \"type\": \"string\"",
            "                  }",
            "                },",
            "                \"503\": {",
            "                  \"description\": \"Fila `doc` ausente o inválida\"",
            "                }",
            "              }",
            "            }",
            "          }",
            "        }",
            "      },",
            "      \"catalog\": {",
            "        \"payloads\": {",
            "          \"cfg-runtime\": {",
            "            \"jvalue\": \"{\\\"convlog\\\":true,\\\"clean_convlog\\\":21,\\\"procesarAudio\\\":false,\\\"procesarMcp\\\":false}\",",
            "            \"fhultact\": \"2026-10-01T15:30:00.000Z\",",
            "            \"isystemkey\": \"runtime\"",
            "          },",
            "          \"conversacion-detalle\": {",
            "            \"hilo\": \"thread_demo\",",
            "            \"fhcre\": \"2026-10-01T14:22:10.000Z\",",
            "            \"titulo\": \"Consulta de saldos\",",
            "            \"convLog\": null,",
            "            \"imodulo\": \"CP-IA\",",
            "            \"qtokens\": 1840,",
            "            \"tiquete\": [],",
            "            \"fhultact\": \"2026-10-01T15:30:00.000Z\",",
            "            \"itercero\": \"T-0001\",",
            "            \"tiquetes\": [],",
            "            \"icontacto\": \"C-0001\",",
            "            \"itdestado\": 0,",
            "            \"modelo_ia\": \"gpt-5-mini\",",
            "            \"qmensajes\": 6,",
            "            \"iconversacion\": 4821,",
            "            \"mensajesOpenAI\": [",
            "              {",
            "                \"autor\": \"user\",",
            "                \"mensaje\": \"¿Cómo creo una factura?\",",
            "                \"imensaje\": 1,",
            "                \"fecha_hora\": \"2026-10-01T14:22:11.000Z\"",
            "              },",
            "              {",
            "                \"autor\": \"assistant\",",
            "                \"mensaje\": \"Para crear una factura…\",",
            "                \"imensaje\": 2,",
            "                \"fecha_hora\": \"2026-10-01T14:22:14.000Z\"",
            "              }",
            "            ],",
            "            \"mensajesCalificados\": [],",
            "            \"bautoriza_visualizacion\": false",
            "          },",
            "          \"conversacion-eliminada\": {",
            "            \"hilo\": \"thread_demo\",",
            "            \"fhcre\": \"2026-10-01T14:22:10.000Z\",",
            "            \"titulo\": \"Consulta de saldos\",",
            "            \"imodulo\": \"CP-IA\",",
            "            \"qtokens\": 1840,",
            "            \"fhultact\": \"2026-10-01T15:30:00.000Z\",",
            "            \"itercero\": \"T-0001\",",
            "            \"icontacto\": \"C-0001\",",
            "            \"itdestado\": 2,",
            "            \"modelo_ia\": \"gpt-5-mini\",",
            "            \"qmensajes\": 6,",
            "            \"iconversacion\": 4821,",
            "            \"bautoriza_visualizacion\": false",
            "          },",
            "          \"sse-turno\": {",
            "            \"data\": {",
            "              \"meta\": {",
            "                \"providerDegraded\": false",
            "              },",
            "              \"delta\": \"factura…\",",
            "              \"modelo\": \"gpt-5-mini\",",
            "              \"prompt\": \"¿Cómo creo una factura?\",",
            "              \"titulo\": \"\",",
            "              \"qtokens\": 0,",
            "              \"itdestado\": 0,",
            "              \"qmensajes\": 1,",
            "              \"respuesta\": \"Para crear una factura…\",",
            "              \"itdconsulta\": \"1\",",
            "              \"iconversacion\": \"4821\"",
            "            },",
            "            \"event\": \"message\"",
            "          }",
            "        },",
            "        \"requestBodies\": {",
            "          \"cfg-runtime\": {",
            "            \"jvalue\": {",
            "              \"clean_convlog\": 30",
            "            }",
            "          },",
            "          \"turno\": {",
            "            \"prompt\": \"¿Cómo creo una factura en ContaPyme?\",",
            "            \"iconversacion\": 4821",
            "          }",
            "        },",
            "        \"schemas\": {",
            "          \"conversacion-row\": {",
            "            \"type\": \"object\",",
            "            \"properties\": {",
            "              \"hilo\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"Hilo del proveedor\"",
            "              },",
            "              \"fhcre\": {",
            "                \"type\": \"string\",",
            "                \"format\": \"date-time\",",
            "                \"description\": \"Creación\"",
            "              },",
            "              \"titulo\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"Título\"",
            "              },",
            "              \"imodulo\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"Módulo\"",
            "              },",
            "              \"qtokens\": {",
            "                \"type\": \"integer\",",
            "                \"description\": \"Tokens usados\"",
            "              },",
            "              \"fhultact\": {",
            "                \"type\": \"string\",",
            "                \"format\": \"date-time\",",
            "                \"description\": \"Última actividad\"",
            "              },",
            "              \"itercero\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"Tercero dueño\"",
            "              },",
            "              \"icontacto\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"Contacto dueño\"",
            "              },",
            "              \"itdestado\": {",
            "                \"type\": \"integer\",",
            "                \"description\": \"0 activa, 1 cerrada, 2 borrada\"",
            "              },",
            "              \"modelo_ia\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"Modelo\"",
            "              },",
            "              \"qmensajes\": {",
            "                \"type\": \"integer\",",
            "                \"description\": \"Mensajes del usuario\"",
            "              },",
            "              \"iconversacion\": {",
            "                \"type\": \"integer\",",
            "                \"description\": \"PK\"",
            "              },",
            "              \"bautoriza_visualizacion\": {",
            "                \"type\": \"boolean\",",
            "                \"description\": \"Autoriza a soporte\"",
            "              }",
            "            }",
            "          }",
            "        },",
            "        \"tryitAttachments\": {",
            "          \"templates\": {",
            "            \"turno\": {",
            "              \"mode\": \"json\",",
            "              \"bodyRawRule\": \"merge\",",
            "              \"audios\": {",
            "                \"max\": 5,",
            "                \"field\": \"audios\",",
            "                \"encoding\": \"dataUrl\",",
            "                \"filePicker\": true",
            "              },",
            "              \"images\": {",
            "                \"max\": 10,",
            "                \"field\": \"imagenes\",",
            "                \"encoding\": \"dataUrl\",",
            "                \"filePicker\": true,",
            "                \"clipboard\": true",
            "              }",
            "            }",
            "          }",
            "        }",
            "      }",
            "    }",
            "  </script>",
            "</iswc-server-api-docs>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:api-base",
              "label": "api-base (servidor de «Probar»)",
              "options": [
                "https://ayudascp-ia-staging.azurewebsites.net/api",
                "http://127.0.0.1:8802/api"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "ejemplos": {
        "content": [
          "```html",
          "<!-- Página que sirve el server en GET /api/docs: solo el kit por CDN, pin por SHA. -->",
          "<script type=\"module\">",
          "  const { ISWebComponentsLoader: L } = await import('https://cdn.jsdelivr.net/gh/Jeff-Aporta/is-webcomponents@<sha40>/dist/cdn/core/loader.min.js');",
          "  await L.loadPageStyles(['iswc-palettes-default']);",
          "  await L.ensure('iswc-server-api-docs');",
          "</script>",
          "<iswc-server-api-docs style=\"height: 100dvh\">",
          "  <script type=\"application/json\">{ \"kind\": \"config\", \"version\": 2, \"paths\": { … } }</script>",
          "</iswc-server-api-docs>",
          "```"
        ]
      }
    },
    "exclude": []
  }
}
