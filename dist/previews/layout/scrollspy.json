{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-scrollspy",
  "category": "layout",
  "title": "&lt;iswc-scrollspy&gt;",
  "titleHtml": false,
  "styles": [
    ".spy-card {",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background: var(--iswc-bg-elev);",
    "      padding: .85rem 1rem;",
    "      margin: .5rem 0;",
    "    }",
    "    .spy-card h4 { margin: 0 0 .35rem; font-size: .9rem; }",
    "    .spy-target-wrap {",
    "      max-height: 18rem;",
    "      overflow: auto;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      padding: .5rem .75rem;",
    "    }",
    "    .spy-target-wrap > * { margin: .5rem 0; }",
    "    .spy-nav {",
    "      display: flex; flex-direction: column; gap: .25rem;",
    "    }",
    "    .spy-nav a { padding: .25rem .5rem; border-radius: 6px; }",
    "    .spy-nav a[aria-current=\"location\"],",
    "    .spy-nav a.iswc-scrollspy-active {",
    "      background: color-mix(in srgb, var(--iswc-accent) 18%, transparent);",
    "      color: var(--iswc-accent);",
    "    }"
  ],
  "storageKey": "docs-iswc-scrollspy",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Observa la intersección de las secciones de un contenedor scrollable y",
        "          va marcando el enlace correspondiente. Pensado para la navegación",
        "          lateral de los previews de docs, pero sirve para cualquier nav largo."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<iswc-demo class=\"demo\">",
            "          <iswc-main id=\"spyIntro\" style=\"max-height: 16rem; overflow: auto; padding: .5rem .75rem; border: 1px solid var(--iswc-border); border-radius: var(--iswc-radius);\">",
            "            <section id=\"spyA\"><h4>Sección A</h4><p>Desplaza este panel para ver el comportamiento.</p>"
          ]
        }
      ]
    },
    {
      "id": "spyB",
      "title": "Sección B",
      "blocks": [
        {
          "kind": "html",
          "html": "<h4>Sección B</h4><p>El enlace gana <code>aria-current=\"location\"</code> al entrar al viewport.</p>"
        }
      ]
    },
    {
      "id": "spyC",
      "title": "Sección C",
      "blocks": [
        {
          "kind": "html",
          "html": "<h4>Sección C</h4><p>El IO observa con la <code>root-margin</code> por defecto.</p>"
        }
      ]
    },
    {
      "id": "spyD",
      "title": "Sección D",
      "blocks": [
        {
          "kind": "html",
          "html": "<h4>Sección D</h4><p>El último enlace visible gana; los demás se liberan.</p>"
        }
      ]
    },
    {
      "id": "spyE",
      "title": "Sección E",
      "blocks": [
        {
          "kind": "html",
          "html": "<h4>Sección E</h4><p>Fin del contenido observable.</p>"
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Observa la intersección de las secciones de un contenedor scrollable y",
          "          va marcando el enlace correspondiente. Pensado para la navegación",
          "          lateral de los previews de docs, pero sirve para cualquier nav largo."
