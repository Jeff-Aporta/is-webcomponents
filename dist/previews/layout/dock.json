{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-dock",
  "category": "layout",
  "title": "&lt;iswc-dock&gt;",
  "titleHtml": false,
  "styles": [
    ".stage {",
    "      height: 28rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background:",
    "        radial-gradient(60rem 30rem at 50% 100%,",
    "          color-mix(in srgb, var(--iswc-accent) 14%, transparent),",
    "          transparent 60%);",
    "      position: relative;",
    "      transform: translateZ(0);",
    "      overflow: hidden;",
    "    }",
    "    pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 9rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-dock",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Barra tipo macOS: los íconos se magnifican al acercar el cursor. Anclada abajo por defecto; podés moverla con el atributo <code class=\"code\">position</code>.",
      "blocks": []
    },
    {
      "id": "bottom",
      "title": "Inferior",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stage\"></div>",
            "          <iswc-dock>",
            "            <iswc-dock-item label=\"Inicio\"     icon=\"mdi:home-variant\" active></iswc-dock-item>",
            "            <iswc-dock-item label=\"Buscar\"     icon=\"mdi:magnify\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Mensajes\"   icon=\"mdi:message-text\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Calendario\" icon=\"mdi:calendar\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Notas\"      icon=\"mdi:notebook\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Música\"     icon=\"mdi:music\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Ajustes\"    icon=\"mdi:cog\"></iswc-dock-item>",
            "          </iswc-dock>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Inicio",
                "Buscar",
                "Mensajes",
                "Calendario",
                "Notas",
                "Música",
                "Ajustes",
                "VS Code",
                "Git",
                "Terminal",
                "Docker",
                "Browser"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:active",
              "label": "active"
            },
            {
              "control": "text",
              "prop": "attr:position",
              "label": "position"
            }
          ],
          "contain": true
        }
      ]
    },
    {
      "id": "left",
      "title": "Lateral izquierdo",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stage\"></div>",
            "          <iswc-dock position=\"left\">",
            "            <iswc-dock-item label=\"VS Code\"  icon=\"mdi:code-braces\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Git\"      icon=\"mdi:source-branch\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Terminal\" icon=\"mdi:console\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Docker\"   icon=\"mdi:docker\"></iswc-dock-item>",
            "            <iswc-dock-item label=\"Browser\"  icon=\"mdi:web\"></iswc-dock-item>",
            "          </iswc-dock>"
          ],
          "contain": true
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "// Cambia el ítem activo programáticamente",
            "document.querySelector('iswc-dock-item[label=\"Inicio\"]').setAttribute('active', '');",
            "",
            "// Escucha selección",
            "dock.addEventListener('iswc-select', e => console.log(e.detail.item.getAttribute('label')));",
            "",
            "// Atributos",
            "// position    bottom (default) | top | left | right",
            "// max-scale   factor máximo (default 1.6)",
            "// range       píxeles de alcance (default 110)",
            "",
            "<iswc-dock-item label=\"…\" icon=\"mdi:…\" href=\"…\" active />"
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\"></pre>"
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Barra tipo macOS: los íconos se magnifican al acercar el cursor. Anclada abajo por defecto; podés moverla con el atributo <code class=\"code\">position</code>."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
