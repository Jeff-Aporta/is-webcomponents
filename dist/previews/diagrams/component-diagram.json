          "<iswc-component-diagram min-gap=\"64\" open-on-click>",
          "  <script type=\"application/json\">",
          "    {",
          "      \"componentDiagram\": {",
          "        \"title\": \"Servicio de voz\",",
          "        \"packages\": [",
          "          { \"id\": \"pkg-api\", \"label\": \"API\", \"hue\": 210, \"x\": 36, \"y\": 56, \"w\": 540, \"h\": 220 }",
          "        ],",
          "        \"components\": [",
          "          { \"id\": \"gw\", \"label\": \"Gateway\", \"stereotype\": \"worker\", \"hue\": 210, \"x\": 56, \"y\": 100, \"w\": 140, \"h\": 56 },",
          "          { \"id\": \"sess\", \"label\": \"Sesion\", \"stereotype\": \"module\", \"hue\": 210, \"x\": 300, \"y\": 100, \"w\": 140, \"h\": 56 },",
          "          { \"id\": \"db\", \"label\": \"D1\", \"stereotype\": \"db\", \"hue\": 150, \"x\": 300, \"y\": 188, \"w\": 140, \"h\": 50 }",
          "        ],",
          "        \"links\": [",
