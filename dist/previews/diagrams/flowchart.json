{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-flowchart",
  "category": "diagrams",
  "title": "&lt;iswc-flowchart&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-flowchart",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Diagrama de flujo en SVG, sin Mermaid. Tú declaras nodos y aristas; el",
        "          componente decide las capas, reduce los cruces y rutea las flechas",
        "          rodeando las cajas."
      ],
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p>",
            "          Comparte motor con <code>&lt;iswc-sequence-diagram&gt;</code>: mismo esquema",
            "          JSON, mismo visor a pantalla completa y la misma animación tortuga, que",
            "          aquí recorre las aristas en orden.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"flowchart\": {",
            "                  \"title\": \"Facturación electrónica\",",
            "                  \"subtitle\": \"de la venta al acuse de la DIAN\",",
            "                  \"direction\": \"TB\",",
            "                  \"groups\": [",
            "                    { \"id\": \"g-emision\", \"name\": \"Emisión\", \"hue\": 239 },",
            "                    { \"id\": \"g-dian\", \"name\": \"DIAN\", \"hue\": 199 },",
            "                    { \"id\": \"g-cierre\", \"name\": \"Cierre\", \"hue\": 38 }",
            "                  ],",
            "                  \"nodes\": [",
            "                    { \"id\": \"a\", \"label\": \"Inicio\", \"shape\": \"stadium\", \"group\": \"g-emision\" },",
            "                    { \"id\": \"b\", \"label\": \"Registrar venta\", \"group\": \"g-emision\",",
            "                      \"desc\": \"Se arma el documento con el tercero y los ítems facturados.\" },",
            "                    { \"id\": \"c\", \"label\": \"¿Datos completos?\", \"shape\": \"diamond\", \"group\": \"g-emision\" },",
            "                    { \"id\": \"d\", \"label\": \"Corregir datos\", \"group\": \"g-emision\" },",
            "                    { \"id\": \"e\", \"label\": \"Generar XML y firmar\", \"group\": \"g-dian\",",
            "                      \"desc\": \"Se construye el **XML UBL** y se aplica la firma digital del emisor.\" },",
            "                    { \"id\": \"f\", \"label\": \"Enviar a la DIAN\", \"group\": \"g-dian\" },",
            "                    { \"id\": \"g\", \"label\": \"Almacenar CUFE\", \"shape\": \"cylinder\", \"group\": \"g-cierre\" },",
            "                    { \"id\": \"h\", \"label\": \"Fin\", \"shape\": \"stadium\", \"group\": \"g-cierre\" }",
            "                  ],",
            "                  \"edges\": [",
            "                    { \"from\": \"a\", \"to\": \"b\" },",
            "                    { \"from\": \"b\", \"to\": \"c\" },",
            "                    { \"from\": \"c\", \"to\": \"d\", \"label\": \"no\" },",
            "                    { \"from\": \"d\", \"to\": \"b\", \"kind\": \"dashed\" },",
            "                    { \"from\": \"c\", \"to\": \"e\", \"label\": \"sí\" },",
            "                    { \"from\": \"e\", \"to\": \"f\" },",
            "                    { \"from\": \"f\", \"to\": \"g\" },",
            "                    { \"from\": \"g\", \"to\": \"h\" }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-flowchart>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:open-on-click",
              "label": "open-on-click"
            }
          ]
        }
      ]
    },
    {
      "id": "direccion",
      "title": "Dirección",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p>",
            "          <code>direction</code> acepta <code>TB</code> (por defecto), <code>BT</code>,",
            "          <code>LR</code> y <code>RL</code>. <code>TD</code> se acepta como alias de",
            "          <code>TB</code>, igual que en Mermaid.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-flowchart open-on-click>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"flowchart\": {",
            "                  \"direction\": \"LR\",",
            "                  \"nodes\": [",
            "                    { \"id\": \"p\", \"label\": \"Pedido\", \"shape\": \"stadium\" },",
            "                    { \"id\": \"q\", \"label\": \"Alistamiento\" },",
            "                    { \"id\": \"r\", \"label\": \"Despacho\" },",
            "                    { \"id\": \"s\", \"label\": \"Entregado\", \"shape\": \"stadium\" }",
            "                  ],",
            "                  \"edges\": [",
            "                    { \"from\": \"p\", \"to\": \"q\" },",
            "                    { \"from\": \"q\", \"to\": \"r\" },",
            "                    { \"from\": \"r\", \"to\": \"s\" }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "formas",
      "title": "Formas",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p>",
            "          Nueve formas, equivalentes a las de Mermaid: <code>rect</code> (por defecto),",
            "          <code>round</code>, <code>stadium</code>, <code>circle</code>,",
            "          <code>diamond</code>, <code>hexagon</code>, <code>parallelogram</code>,",
            "          <code>cylinder</code> y <code>subroutine</code>.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-flowchart open-on-click>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"flowchart\": {",
            "                  \"direction\": \"LR\",",
            "                  \"nodes\": [",
            "                    { \"id\": \"n1\", \"label\": \"rect\" },",
            "                    { \"id\": \"n2\", \"label\": \"round\", \"shape\": \"round\" },",
            "                    { \"id\": \"n3\", \"label\": \"stadium\", \"shape\": \"stadium\" },",
            "                    { \"id\": \"n4\", \"label\": \"diamond\", \"shape\": \"diamond\" },",
            "                    { \"id\": \"n5\", \"label\": \"hexagon\", \"shape\": \"hexagon\" },",
            "                    { \"id\": \"n6\", \"label\": \"parallelogram\", \"shape\": \"parallelogram\" },",
            "                    { \"id\": \"n7\", \"label\": \"cylinder\", \"shape\": \"cylinder\" },",
            "                    { \"id\": \"n8\", \"label\": \"subroutine\", \"shape\": \"subroutine\" },",
            "                    { \"id\": \"n9\", \"label\": \"circle\", \"shape\": \"circle\" }",
            "                  ],",
            "                  \"edges\": [",
            "                    { \"from\": \"n1\", \"to\": \"n2\" }, { \"from\": \"n2\", \"to\": \"n3\" },",
            "                    { \"from\": \"n3\", \"to\": \"n4\" }, { \"from\": \"n4\", \"to\": \"n5\" },",
            "                    { \"from\": \"n5\", \"to\": \"n6\" }, { \"from\": \"n6\", \"to\": \"n7\" },",
            "                    { \"from\": \"n7\", \"to\": \"n8\" }, { \"from\": \"n8\", \"to\": \"n9\" }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "ciclos",
      "title": "Ciclos y aristas de retorno",
      "blocks": [
        {
          "kind": "html",
          "html": [
            "<p>",
            "          El motor detecta las aristas que vuelven atrás y las rutea por un lado, en",
            "          vez de colgarse intentando ordenar un grafo cíclico. Los reprocesos y los",
            "          reintentos se declaran sin ceremonia.",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-flowchart open-on-click>",
            "            <script type=\"application/json\">",
            "              {",
            "                \"flowchart\": {",
            "                  \"direction\": \"TB\",",
            "                  \"nodes\": [",
            "                    { \"id\": \"r1\", \"label\": \"Recibir soporte\", \"shape\": \"stadium\" },",
            "                    { \"id\": \"r2\", \"label\": \"Clasificar\" },",
            "                    { \"id\": \"r3\", \"label\": \"¿Aprobado?\", \"shape\": \"diamond\" },",
            "                    { \"id\": \"r4\", \"label\": \"Devolver al área\" },",
            "                    { \"id\": \"r5\", \"label\": \"Contabilizar\" },",
            "                    { \"id\": \"r6\", \"label\": \"Archivo\", \"shape\": \"cylinder\" }",
            "                  ],",
            "                  \"edges\": [",
            "                    { \"from\": \"r1\", \"to\": \"r2\" },",
            "                    { \"from\": \"r2\", \"to\": \"r3\" },",
            "                    { \"from\": \"r3\", \"to\": \"r4\", \"label\": \"no\" },",
            "                    { \"from\": \"r4\", \"to\": \"r2\", \"kind\": \"dashed\", \"label\": \"reproceso\" },",
            "                    { \"from\": \"r3\", \"to\": \"r5\", \"label\": \"sí\" },",
            "                    { \"from\": \"r5\", \"to\": \"r6\" }",
            "                  ]",
            "                }",
            "              }",
            "            </script>",
            "          </iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "animation",
      "title": "Animación de flujo",
      "lede": "Atributo <code class=\"code\">animation</code> (tokens espacio-separados). Default off. Token <code class=\"code\">flow</code>: arista dashed brand detrás de la continua, con dashes en movimiento.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"animation=flow\",",
            "      \"direction\": \"LR\",",
            "      \"nodes\": [",
            "        { \"id\": \"a\", \"label\": \"Inicio\", \"shape\": \"stadium\" },",
            "        { \"id\": \"b\", \"label\": \"Procesar\" },",
            "        { \"id\": \"c\", \"label\": \"¿Ok?\", \"shape\": \"diamond\" },",
            "        { \"id\": \"d\", \"label\": \"Fin\", \"shape\": \"stadium\" }",
            "      ],",
            "      \"edges\": [",
            "        { \"from\": \"a\", \"to\": \"b\" },",
            "        { \"from\": \"b\", \"to\": \"c\" },",
            "        { \"from\": \"c\", \"to\": \"d\", \"label\": \"sí\" }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3>Atributos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Nombre",
            "Valores",
            "Descripción"
          ],
          "rows": [
            [
              "<code>variant</code>",
              "<code>inline</code> · <code>viewer</code>",
              "inline abre el visor al hacer clic; viewer activa hover, tooltips, leyenda clickeable y auto-animación."
            ],
            [
              "<code>open-on-click</code>",
              "booleano",
              "Habilita abrir el visor a pantalla completa al hacer clic. Por defecto el componente no tiene visor."
            ],
            [
              "<code>animation</code>",
              "tokens (`flow`, …)",
              "Efectos opcionales (espacio-separados). <code>flow</code>: dashed brand animada detrás de cada arista continua. Default: off."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Esquema del JSON</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Campo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>direction</code>",
              "<code>TB</code> · <code>BT</code> · <code>LR</code> · <code>RL</code>."
            ],
            [
              "<code>nodes[].id</code>",
              "Identificador que referencian las aristas."
            ],
            [
              "<code>nodes[].label</code>",
              "Texto de la caja. Admite markdown inline e <code>{{iconify}}</code>."
            ],
            [
              "<code>nodes[].shape</code>",
              "Una de las nueve formas; cualquier otro valor cae a <code>rect</code>."
            ],
            [
              "<code>nodes[].group</code>",
              "Id del grupo; define el color del nodo."
            ],
            [
              "<code>nodes[].desc</code>",
              "Descripción extendida para el tooltip del visor."
            ],
            [
              "<code>edges[].from</code> · <code>to</code>",
              "Ids de nodo. Una arista a un id inexistente se descarta."
            ],
            [
              "<code>edges[].label</code>",
              "Rótulo sobre la flecha."
            ],
            [
              "<code>edges[].kind</code>",
              "<code>solid</code> (default) · <code>dashed</code> · <code>thick</code>."
            ],
            [
              "<code>groups[].hue</code>",
              "Tono HSL 0–360."
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Propiedades y eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Nombre",
            "Descripción"
          ],
          "rows": [
            [
              "<code>payload</code>",
              "Configuración JSON; alternativa al script hijo."
            ],
            [
              "<code>layout</code>",
              "Geometría calculada (solo lectura)."
            ],
            [
              "<code>turtle</code>",
              "API de la animación: play / pause / stop / next / prev."
            ],
            [
              "<code>hiddenGroups</code>",
              "Set de grupos ocultos; al cambiar, el diagrama se re-diseña sin esos nodos."
            ],
            [
              "<code>iswc-render</code>",
              "Evento: el SVG terminó de construirse."
            ],
            [
              "<code>iswc-turtle-state</code>",
              "Evento: estado de la animación."
            ]
          ]
        }
      ]
    },
    {
      "id": "app-api",
      "title": "App API",
      "lede": "El mismo documento se abre en el visor o en el editor. El parámetro json no se reescribe al modificar el diagrama.",
      "blocks": [
        {
          "kind": "html",
          "html": "<p><a href=\"demos/diagramas/app/view.html?kind=flowchart\" target=\"_blank\" rel=\"noopener\">Abrir visor</a> · <a href=\"demos/diagramas/app/edit.html?kind=flowchart\" target=\"_blank\" rel=\"noopener\">Abrir editor</a></p>"
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Diagrama de flujo en SVG, sin Mermaid. Tú declaras nodos y aristas; el",
          "          componente decide las capas, reduce los cruces y rutea las flechas",
          "          rodeando las cajas."
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-flowchart open-on-click animation=\"flow\">",
          "            <script type=\"application/json\">",
          "              {",
          "                \"flowchart\": {",
          "                  \"title\": \"Facturación electrónica\",",
          "                  \"subtitle\": \"de la venta al acuse de la DIAN\",",
          "                  \"direction\": \"TB\",",
          "                  \"groups\": [",
          "                    { \"id\": \"g-emision\", \"name\": \"Emisión\", \"hue\": 239 },",
          "                    { \"id\": \"g-dian\", \"name\": \"DIAN\", \"hue\": 199 },",
          "                    { \"id\": \"g-cierre\", \"name\": \"Cierre\", \"hue\": 38 }",
          "                  ],",
          "                  \"nodes\": [",
          "                    { \"id\": \"a\", \"label\": \"Inicio\", \"shape\": \"stadium\", \"group\": \"g-emision\" },",
          "                    { \"id\": \"b\", \"label\": \"Registrar venta\", \"group\": \"g-emision\",",
          "                      \"desc\": \"Se arma el documento con el tercero y los ítems facturados.\" },",
          "                    { \"id\": \"c\", \"label\": \"¿Datos completos?\", \"shape\": \"diamond\", \"group\": \"g-emision\" },",
          "                    { \"id\": \"d\", \"label\": \"Corregir datos\", \"group\": \"g-emision\" },",
          "                    { \"id\": \"e\", \"label\": \"Generar XML y firmar\", \"group\": \"g-dian\",",
          "                      \"desc\": \"Se construye el **XML UBL** y se aplica la firma digital del emisor.\" },",
          "                    { \"id\": \"f\", \"label\": \"Enviar a la DIAN\", \"group\": \"g-dian\" },",
          "                    { \"id\": \"g\", \"label\": \"Almacenar CUFE\", \"shape\": \"cylinder\", \"group\": \"g-cierre\" },",
          "                    { \"id\": \"h\", \"label\": \"Fin\", \"shape\": \"stadium\", \"group\": \"g-cierre\" }",
          "                  ],",
          "                  \"edges\": [",
          "                    { \"from\": \"a\", \"to\": \"b\" },",
          "                    { \"from\": \"b\", \"to\": \"c\" },",
          "                    { \"from\": \"c\", \"to\": \"d\", \"label\": \"no\" },",
          "                    { \"from\": \"d\", \"to\": \"b\", \"kind\": \"dashed\" },",
          "                    { \"from\": \"c\", \"to\": \"e\", \"label\": \"sí\" },",
          "                    { \"from\": \"e\", \"to\": \"f\" },",
          "                    { \"from\": \"f\", \"to\": \"g\" },",
          "                    { \"from\": \"g\", \"to\": \"h\" }",
          "                  ]",
          "                }",
          "              }",
          "            </script>",
          "          </iswc-flowchart>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}