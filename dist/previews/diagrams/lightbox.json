      "ejemplos": {
        "content": [
          "```html",
          "<!-- default: backdrop 20% + blur 2px -->",
          "<iswc-lightbox id=\"lb\">…</iswc-lightbox>",
          "",
          "<!-- lienzo opaco a pantalla completa -->",
          "<iswc-lightbox variant=\"solid\">…</iswc-lightbox>",
