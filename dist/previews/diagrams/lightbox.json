          },
          {
            "metodo": "<code>open</code> · <code>show()</code> · <code>hide()</code>",
            "desc": "visibilidad del dialog"
          },
          {
            "metodo": "<code>zoomable</code> · <code>zoomIn()</code> · <code>zoomOut()</code> · <code>resetView()</code>",
            "desc": "zoom + pan anclado al cursor"
          },
          {
            "metodo": "<code>view</code> · <code>iswc-reposition</code>",
            "desc": "estado <code>{scale, x, y}</code> actual"
          },
          {
