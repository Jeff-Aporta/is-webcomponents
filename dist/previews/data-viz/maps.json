{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-maps",
  "category": "data-viz",
  "title": "&lt;iswc-maps&gt;",
  "titleHtml": false,
  "styles": [
    ".row { padding-bottom: 1rem; }",
    "    .legend {",
    "      display: flex; flex-wrap: wrap; gap: .35rem;",
    "      margin-bottom: .5rem;",
    "      font-size: .75rem;",
    "    }",
    "    .legend b { color: var(--iswc-accent); }",
    "    pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .78rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 6rem; overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-maps",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Modo nativo (default): lienzo SVG con proyección equirectangular, sin dependencias externas. Modo <code class=\"ic\">engine=\"tile\"</code>: iframe al proveedor de tiles (OpenStreetMap, etc.).",
      "blocks": []
    },
    {
      "id": "bogota",
      "title": "Colombia",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-maps id=\"m1\" viewbox=\"-79,-5,-66,13\" interactive>",
            "            <iswc-map-marker lat=\"4.7110\"  lon=\"-74.0721\"  label=\"Bogotá\"></iswc-map-marker>",
            "            <iswc-map-marker lat=\"6.2442\"  lon=\"-75.5812\"  label=\"Medellín\"></iswc-map-marker>",
            "            <iswc-map-marker lat=\"3.4516\"  lon=\"-76.5320\"  label=\"Cali\"></iswc-map-marker>",
            "            <iswc-map-marker lat=\"10.9685\" lon=\"-74.7813\"  label=\"Barranquilla\"></iswc-map-marker>",
            "            <iswc-map-marker lat=\"11.2408\" lon=\"-74.2110\"  label=\"Santa Marta\"></iswc-map-marker>",
            "            <iswc-map-marker lat=\"7.1193\"  lon=\"-73.1227\"  label=\"Bucaramanga\"></iswc-map-marker>",
            "            <iswc-map-marker lat=\"4.8144\"  lon=\"-75.6945\"  label=\"Pereira\"></iswc-map-marker>",
            "          </iswc-maps>"
          ],
          "controls": [
            {
              "control": "text",
              "prop": "attr:viewbox",
              "label": "viewbox"
            },
            {
              "control": "text",
              "prop": "attr:interactive",
              "label": "interactive"
            },
            {
              "control": "text",
              "prop": "attr:engine",
              "label": "engine"
            }
          ]
        }
      ]
    },
    {
      "id": "tile",
      "title": "Modo tile (OpenStreetMap embebido)",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-maps engine=\"tile\" interactive=\"false\">",
            "            <script type=\"application/json\">",
            "              {",
            "                \"tileUrl\": \"https://www.openstreetmap.org/export/embed.html\",",
            "                \"zoom\": 4,",
            "                \"bbox\": \"-79,-5,-66,13\",",
            "                \"center\": \"-72.5,4\",",
            "                \"attribution\": \"© OpenStreetMap contributors\"",
            "              }",
            "            </script>",
            "          </iswc-maps>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "// Modo nativo (SVG)",
            "const m = document.querySelector('iswc-maps');",
            "// Atributos",
            "// viewbox     \"minLon,minLat,maxLon,maxLat\"  viewport inicial",
            "// interactive boolean — habilita pan/zoom con mouse/touch",
            "//",
            "// Marcadores",
            "//   <iswc-map-marker lat=\"4.6\" lon=\"-74.0\" label=\"Bogotá\"></iswc-map-marker>",
            "//",
            "// Modo tile",
            "//   <iswc-maps engine=\"tile\">",
            "//     <script type=\"application/json\">",
            "//       { \"tileUrl\": \"...\", \"zoom\": 4, \"bbox\": \"...\", \"center\": \"...\",",
            "//         \"attribution\": \"...\" }",
            "//     </script>",
            "//   </iswc-maps>",
            "//",
            "// Eventos",
            "m.addEventListener('iswc-viewport',     e => console.log(e.detail));",
            "m.addEventListener('iswc-marker-click', e => console.log(e.detail.marker));"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": "Modo nativo (default): lienzo SVG con proyección equirectangular, sin dependencias externas. Modo <code class=\"ic\">engine=\"tile\"</code>: iframe al proveedor de tiles (OpenStreetMap, etc.)."
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "ejemplos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
