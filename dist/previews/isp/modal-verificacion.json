{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-modal-verificacion",
  "category": "isp",
  "title": "&lt;iswc-modal-verificacion&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-modal-verificacion de InSoft.",
  "storageKey": "docs-iswc-modal-verificacion",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Al abrirse ejecuta <code class=\"code\">controller.actVerificar(record)</code>",
        "          y pinta los mensajes devueltos coloreados por severidad, con contadores",
        "          de infos, warnings y errores."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:flex;gap:.5rem;flex-wrap:wrap\">",
            "            <iswc-button id=\"mvBtnOk\" color=\"brand\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:check\"></iswc-icon>",
            "              Verificar tercero (caso OK)",
            "            </iswc-button>",
            "            <iswc-button id=\"mvBtnWarn\" color=\"warning\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:alert\"></iswc-icon>",
            "              Verificar con warnings",
            "            </iswc-button>",
            "            <iswc-button id=\"mvBtnErr\" color=\"danger\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:close-circle\"></iswc-icon>",
            "              Verificar con errores",
            "            </iswc-button>",
            "          </div>",
            "          <iswc-modal-verificacion id=\"mvDemoOk\" entity=\"tercero\"></iswc-modal-verificacion>",
            "          <iswc-modal-verificacion id=\"mvDemoWarn\" entity=\"tercero\"></iswc-modal-verificacion>",
            "          <iswc-modal-verificacion id=\"mvDemoErr\" entity=\"tercero\"></iswc-modal-verificacion>",
            "          <script type=\"application/json\" data-mv-scenarios>{",
            "            \"ok\": {",
            "              \"entrie\": \"tercero\",",
            "              \"record\": { \"nit\": \"900123456-7\", \"razonSocial\": \"InSoft S.A.\" },",
            "              \"mensajes\": [",
            "                { \"itdmensaje\": \"info\",    \"mensaje\": \"NIT valido y activo en DIAN.\" },",
            "                { \"itdmensaje\": \"info\",    \"mensaje\": \"Razon social coincide con registro mercantil.\" },",
            "                { \"itdmensaje\": \"success\", \"mensaje\": \"Verificacion satisfactoria.\" }",
            "              ]",
            "            },",
            "            \"warn\": {",
            "              \"entrie\": \"tercero\",",
            "              \"record\": { \"nit\": \"900999999-9\", \"razonSocial\": \"Demo S.A.S.\" },",
            "              \"mensajes\": [",
            "                { \"itdmensaje\": \"info\",    \"mensaje\": \"NIT valido.\" },",
            "                { \"itdmensaje\": \"warning\", \"mensaje\": \"Sin correo registrado: las notificaciones llegaran al admin.\" },",
            "                { \"itdmensaje\": \"warning\", \"mensaje\": \"Actividad economica requiere clasificacion CIIU v4.\" },",
            "                { \"itdmensaje\": \"info\",    \"mensaje\": \"Continuar y completar despues desde el perfil.\" }",
            "              ]",
            "            },",
            "            \"err\": {",
            "              \"entrie\": \"tercero\",",
            "              \"record\": { \"nit\": \"800000000-0\", \"razonSocial\": \"Inactiva Ltda.\" },",
            "              \"mensajes\": [",
            "                { \"itdmensaje\": \"error\",   \"mensaje\": \"NIT no encontrado en el registro unico tributario.\" },",
            "                { \"itdmensaje\": \"error\",   \"mensaje\": \"Razon social con estado inactiva desde 2021.\" },",
            "                { \"itdmensaje\": \"warning\", \"mensaje\": \"Documentos de soporte obligatorios pendientes.\" },",
            "                { \"itdmensaje\": \"info\",    \"mensaje\": \"No se puede continuar hasta corregir.\" }",
            "              ]",
            "            }",
            "          }</script>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API rápida",
      "lede": [
        "Propiedades JS: <code class=\"code\">controller</code>, <code class=\"code\">record</code>,",
        "          <code class=\"code\">onError</code>. Métodos: <code class=\"code\">show()</code>,",
        "          <code class=\"code\">hide()</code>, <code class=\"code\">verify()</code>."
      ],
      "blocks": []
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Al abrirse ejecuta <code class=\"code\">controller.actVerificar(record)</code>",
          "          y pinta los mensajes devueltos coloreados por severidad, con contadores",
          "          de infos, warnings y errores."
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "const modal = document.querySelector('iswc-modal-verificacion');",
          "modal.controller = {",
          "  entrie: 'tercero',",
          "  async actVerificar(record) {",
          "    return { mensajes: [",
          "      { itdmensaje: 'info', mensaje: 'NIT válido.' },",
          "      { itdmensaje: 'warning', mensaje: 'Sin correo registrado.' },",
          "    ] };",
          "  },",
          "};",
          "modal.record = { nit: '900123456' };",
          "modal.show();",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
