{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-text",
  "category": "isp",
  "title": "&lt;iswc-text&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-text",
  "hasBehavior": true,
  "styles": ".tx-pg {\n      display: grid;\n      gap: 1rem;\n      padding: 0.85rem 1rem;\n      border: 1px solid var(--iswc-border);\n      border-radius: var(--iswc-radius, 0.5em);\n      background: var(--iswc-bg-elev);\n    }\n    .tx-stage {\n      min-height: 3rem;\n      max-width: 24rem;\n      padding: 0.5rem 0;\n      border-bottom: 1px dashed var(--iswc-border);\n    }\n    .tx-controls {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));\n      gap: 0.75rem 1rem;\n      align-items: end;\n    }\n    .tx-field {\n      display: flex;\n      flex-direction: column;\n      gap: 0.3rem;\n      font-size: 0.75rem;\n      color: var(--iswc-text-soft);\n    }\n    .tx-field input, .tx-field select, .tx-field textarea {\n      font: inherit;\n      font-size: 0.875rem;\n      color: var(--iswc-text);\n      background: var(--iswc-bg);\n      border: 1px solid var(--iswc-border);\n      border-radius: var(--iswc-radius-sm, 0.35em);\n      padding: 0.35rem 0.5rem;\n    }\n    .tx-field input[type=\"range\"] { width: 100%; accent-color: var(--iswc-accent, var(--iswc-brand)); }\n    .tx-range-row { display: flex; align-items: center; gap: 0.5rem; }\n    .tx-range-val { font-variant-numeric: tabular-nums; min-width: 1.5rem; color: var(--iswc-text); }\n    .tx-caption { margin: 0; font-size: 0.75rem; color: var(--iswc-text-dim); }\n    .tx-snippet {\n      margin: 0;\n      font-family: ui-monospace, Menlo, Consolas, monospace;\n      font-size: 0.75rem;\n      color: var(--iswc-text-soft);\n      word-break: break-all;\n    }\n    .tx-stack { display: flex; flex-direction: column; gap: 0.75rem; }\n    .tx-ex { display: flex; flex-direction: column; gap: 0.2rem; }",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Color semántico, <code class=\"code\">current</code>, CSS libre y <code class=\"code\">mix</code>. Playground abajo.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"tx-pg\" id=\"txPlayground\">\n            <div class=\"tx-stage\" style=\"color:#2f9e44\">\n              <iswc-text id=\"txLive\">Texto de ejemplo para probar color y clamp.</iswc-text>\n            </div>\n            <div class=\"tx-controls\">\n              <label class=\"tx-field\">color\n                <select id=\"txColorMode\">\n                  <option value=\"\" selected>(hereda)</option>\n                  <option value=\"brand\">brand</option>\n                  <option value=\"neutral\">neutral</option>\n                  <option value=\"info\">info</option>\n                  <option value=\"success\">success</option>\n                  <option value=\"warning\">warning</option>\n                  <option value=\"danger\">danger</option>\n                  <option value=\"current\">current</option>\n                  <option value=\"css\">CSS libre…</option>\n                </select>\n              </label>\n              <label class=\"tx-field\">color CSS\n                <input id=\"txColorCss\" type=\"text\" value=\"#e8590c\" disabled />\n              </label>\n              <label class=\"tx-field\">\n                <span><input id=\"txMixOn\" type=\"checkbox\" /> usar mix</span>\n              </label>\n              <label class=\"tx-field\">mix (%)\n                <div class=\"tx-range-row\">\n                  <input id=\"txMix\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"40\" disabled />\n                  <span class=\"tx-range-val\" id=\"txMixVal\">off</span>\n                </div>\n              </label>\n              <label class=\"tx-field\">mix-with\n                <select id=\"txMixWith\">\n                  <option value=\"\" selected>text (default)</option>\n                  <option value=\"transparent\">transparent</option>\n                  <option value=\"white\">white</option>\n                  <option value=\"black\">black</option>\n                  <option value=\"current\">current</option>\n                </select>\n              </label>\n              <label class=\"tx-field\">lines\n                <div class=\"tx-range-row\">\n                  <input id=\"txLines\" type=\"range\" min=\"0\" max=\"6\" step=\"1\" value=\"0\" />\n                  <span class=\"tx-range-val\" id=\"txLinesVal\">0</span>\n                </div>\n              </label>\n              <label class=\"tx-field\">texto\n                <textarea id=\"txText\" rows=\"2\">Texto de ejemplo para probar color y clamp. Puedes alargar este párrafo para ver el ellipsis.</textarea>\n              </label>\n            </div>\n            <p class=\"tx-caption\">Props: <code>color</code>, <code>mix</code>, <code>mix-with</code>, <code>lines</code></p>\n            <pre class=\"tx-snippet\" id=\"txSnippet\"></pre>\n          </div>",
          "controls": [
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "info",
                "success",
                "warning",
                "danger",
                "current",
                "#e8590c",
                "tomato"
              ]
            },
            {
              "control": "text",
              "prop": "attr:mix",
              "label": "mix"
            },
            {
              "control": "text",
              "prop": "attr:mix-with",
              "label": "mix-with"
            },
            {
              "control": "number",
              "prop": "attr:lines",
              "label": "lines",
              "min": 0,
              "max": 100,
              "step": 1
            }
          ]
        }
      ]
    },
    {
      "id": "color",
      "title": "color",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"tx-stack\">\n            <div class=\"tx-ex\"><iswc-text color=\"brand\">brand</iswc-text><p class=\"tx-caption\"><code>color=\"brand\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"neutral\">neutral</iswc-text><p class=\"tx-caption\"><code>color=\"neutral\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"info\">info</iswc-text><p class=\"tx-caption\"><code>color=\"info\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"success\">success</iswc-text><p class=\"tx-caption\"><code>color=\"success\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"warning\">warning</iswc-text><p class=\"tx-caption\"><code>color=\"warning\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"danger\">danger</iswc-text><p class=\"tx-caption\"><code>color=\"danger\"</code></p></div>\n            <div class=\"tx-ex\" style=\"color:#7048e8\"><iswc-text color=\"current\">current (hereda)</iswc-text><p class=\"tx-caption\"><code>color=\"current\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"#e8590c\">#e8590c</iswc-text><p class=\"tx-caption\"><code>color=\"#e8590c\"</code></p></div>\n            <div class=\"tx-ex\"><iswc-text color=\"tomato\" mix=\"55%\" mix-with=\"transparent\">tomato · mix transparent</iswc-text><p class=\"tx-caption\"><code>color=\"tomato\"</code> · <code>mix=\"55%\"</code> · <code>mix-with=\"transparent\"</code></p></div>\n          </div>"
        }
      ]
    },
    {
      "id": "lines",
      "title": "lines",
      "lede": "Prop <code class=\"code\">lines</code> — clamp con ellipsis.",
      "blocks": [
        {
          "kind": "demo",
          "html": "<div class=\"tx-stack\" style=\"max-width:22rem\">\n            <div class=\"tx-ex\">\n              <iswc-text lines=\"1\">Una sola línea: este párrafo se corta con puntos suspensivos en cuanto no cabe en el ancho disponible del contenedor.</iswc-text>\n              <p class=\"tx-caption\"><code>lines=\"1\"</code></p>\n            </div>\n            <div class=\"tx-ex\">\n              <iswc-text lines=\"2\">Dos líneas: este párrafo se recorta al llegar a la segunda línea, y el resto del contenido desaparece con la elipsis al final.</iswc-text>\n              <p class=\"tx-caption\"><code>lines=\"2\"</code></p>\n            </div>\n            <div class=\"tx-ex\">\n              <iswc-text lines=\"3\">Tres líneas: el mismo párrafo, ahora con más aire. El clamp usa <code>--mx-lns</code>, que escribe el JS a partir del atributo <code>lines</code>.</iswc-text>\n              <p class=\"tx-caption\"><code>lines=\"3\"</code></p>\n            </div>\n          </div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Valores"
          ],
          "rows": [
            [
              "<code>color</code>",
              "semántico · <code>current</code> · color CSS (ausente = hereda)"
            ],
            [
              "<code>mix</code>",
              "% hacia <code>mix-with</code>"
            ],
            [
              "<code>mix-with</code>",
              "text · transparent · white · black · current · CSS"
            ],
            [
              "<code>lines</code>",
              "entero ≥ 1; ausente o 0 = sin clamp"
            ]
          ]
        }
      ]
    }
  ]
}
