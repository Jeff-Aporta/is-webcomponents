{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-text",
  "category": "isp",
  "title": "&lt;iswc-text&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-text",
  "hasBehavior": true,
  "styles": [
    ".tx-pg {",
    "      display: grid;",
    "      gap: 1rem;",
    "      padding: 0.85rem 1rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius, 0.5em);",
    "      background: var(--iswc-bg-elev);",
    "    }",
    "    .tx-stage {",
    "      min-height: 3rem;",
    "      max-width: 24rem;",
    "      padding: 0.5rem 0;",
    "      border-bottom: 1px dashed var(--iswc-border);",
    "    }",
    "    .tx-controls {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));",
    "      gap: 0.75rem 1rem;",
    "      align-items: end;",
    "    }",
    "    .tx-field {",
    "      display: flex;",
    "      flex-direction: column;",
    "      gap: 0.3rem;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .tx-field input, .tx-field select, .tx-field textarea {",
    "      font: inherit;",
    "      font-size: 0.875rem;",
    "      color: var(--iswc-text);",
    "      background: var(--iswc-bg);",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius-sm, 0.35em);",
    "      padding: 0.35rem 0.5rem;",
    "    }",
    "    .tx-field input[type=\"range\"] { width: 100%; accent-color: var(--iswc-accent, var(--iswc-brand)); }",
    "    .tx-range-row { display: flex; align-items: center; gap: 0.5rem; }",
    "    .tx-range-val { font-variant-numeric: tabular-nums; min-width: 1.5rem; color: var(--iswc-text); }",
    "    .tx-caption { margin: 0; font-size: 0.75rem; color: var(--iswc-text-dim); }",
    "    .tx-snippet {",
    "      margin: 0;",
    "      font-family: ui-monospace, Menlo, Consolas, monospace;",
    "      font-size: 0.75rem;",
    "      color: var(--iswc-text-soft);",
    "      word-break: break-all;",
    "    }",
    "    .tx-stack { display: flex; flex-direction: column; gap: 0.75rem; }",
    "    .tx-ex { display: flex; flex-direction: column; gap: 0.2rem; }"
  ],
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Color semántico, <code class=\"code\">current</code>, CSS libre y <code class=\"code\">mix</code>. Playground abajo.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"tx-pg\" id=\"txPlayground\">",
            "            <div class=\"tx-stage\" style=\"color:#2f9e44\">",
            "              <iswc-text id=\"txLive\">Texto de ejemplo para probar color y clamp.</iswc-text>",
            "            </div>",
            "            <div class=\"tx-controls\">",
            "              <label class=\"tx-field\">color",
            "                <select id=\"txColorMode\">",
            "                  <option value=\"\" selected>(hereda)</option>",
            "                  <option value=\"brand\">brand</option>",
            "                  <option value=\"neutral\">neutral</option>",
            "                  <option value=\"info\">info</option>",
            "                  <option value=\"success\">success</option>",
            "                  <option value=\"warning\">warning</option>",
            "                  <option value=\"danger\">danger</option>",
            "                  <option value=\"current\">current</option>",
            "                  <option value=\"css\">CSS libre…</option>",
            "                </select>",
            "              </label>",
            "              <label class=\"tx-field\">color CSS",
            "                <input id=\"txColorCss\" type=\"text\" value=\"#e8590c\" disabled />",
            "              </label>",
            "              <label class=\"tx-field\">",
            "                <span><input id=\"txMixOn\" type=\"checkbox\" /> usar mix</span>",
            "              </label>",
            "              <label class=\"tx-field\">mix (%)",
            "                <div class=\"tx-range-row\">",
            "                  <input id=\"txMix\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"40\" disabled />",
            "                  <span class=\"tx-range-val\" id=\"txMixVal\">off</span>",
            "                </div>",
            "              </label>",
            "              <label class=\"tx-field\">mix-with",
            "                <select id=\"txMixWith\">",
            "                  <option value=\"\" selected>text (default)</option>",
            "                  <option value=\"transparent\">transparent</option>",
            "                  <option value=\"white\">white</option>",
            "                  <option value=\"black\">black</option>",
            "                  <option value=\"current\">current</option>",
            "                </select>",
            "              </label>",
            "              <label class=\"tx-field\">lines",
            "                <div class=\"tx-range-row\">",
            "                  <input id=\"txLines\" type=\"range\" min=\"0\" max=\"6\" step=\"1\" value=\"0\" />",
            "                  <span class=\"tx-range-val\" id=\"txLinesVal\">0</span>",
            "                </div>",
            "              </label>",
            "              <label class=\"tx-field\">texto",
            "                <textarea id=\"txText\" rows=\"2\">Texto de ejemplo para probar color y clamp. Puedes alargar este párrafo para ver el ellipsis.</textarea>",
            "              </label>",
            "            </div>",
            "            <p class=\"tx-caption\">Props: <code>color</code>, <code>mix</code>, <code>mix-with</code>, <code>lines</code></p>",
            "            <pre class=\"tx-snippet\" id=\"txSnippet\"></pre>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "info",
                "success",
                "warning",
                "danger",
                "current",
                "#e8590c",
                "tomato"
              ]
            },
            {
              "control": "text",
              "prop": "attr:mix",
              "label": "mix"
            },
            {
              "control": "text",
              "prop": "attr:mix-with",
              "label": "mix-with"
            },
            {
              "control": "number",
              "prop": "attr:lines",
              "label": "lines",
              "min": 0,
              "max": 100,
              "step": 1
            }
          ]
        }
      ]
    },
    {
      "id": "color",
      "title": "color",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"tx-stack\">",
            "            <div class=\"tx-ex\"><iswc-text color=\"brand\">brand</iswc-text><p class=\"tx-caption\"><code>color=\"brand\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"neutral\">neutral</iswc-text><p class=\"tx-caption\"><code>color=\"neutral\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"info\">info</iswc-text><p class=\"tx-caption\"><code>color=\"info\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"success\">success</iswc-text><p class=\"tx-caption\"><code>color=\"success\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"warning\">warning</iswc-text><p class=\"tx-caption\"><code>color=\"warning\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"danger\">danger</iswc-text><p class=\"tx-caption\"><code>color=\"danger\"</code></p></div>",
            "            <div class=\"tx-ex\" style=\"color:#7048e8\"><iswc-text color=\"current\">current (hereda)</iswc-text><p class=\"tx-caption\"><code>color=\"current\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"#e8590c\">#e8590c</iswc-text><p class=\"tx-caption\"><code>color=\"#e8590c\"</code></p></div>",
            "            <div class=\"tx-ex\"><iswc-text color=\"tomato\" mix=\"55%\" mix-with=\"transparent\">tomato · mix transparent</iswc-text><p class=\"tx-caption\"><code>color=\"tomato\"</code> · <code>mix=\"55%\"</code> · <code>mix-with=\"transparent\"</code></p></div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "lines",
      "title": "lines",
      "lede": "Prop <code class=\"code\">lines</code> — clamp con ellipsis.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"tx-stack\" style=\"max-width:22rem\">",
            "            <div class=\"tx-ex\">",
            "              <iswc-text lines=\"1\">Una sola línea: este párrafo se corta con puntos suspensivos en cuanto no cabe en el ancho disponible del contenedor.</iswc-text>",
            "              <p class=\"tx-caption\"><code>lines=\"1\"</code></p>",
            "            </div>",
            "            <div class=\"tx-ex\">",
            "              <iswc-text lines=\"2\">Dos líneas: este párrafo se recorta al llegar a la segunda línea, y el resto del contenido desaparece con la elipsis al final.</iswc-text>",
            "              <p class=\"tx-caption\"><code>lines=\"2\"</code></p>",
            "            </div>",
            "            <div class=\"tx-ex\">",
            "              <iswc-text lines=\"3\">Tres líneas: el mismo párrafo, ahora con más aire. El clamp usa <code>--mx-lns</code>, que escribe el JS a partir del atributo <code>lines</code>.</iswc-text>",
            "              <p class=\"tx-caption\"><code>lines=\"3\"</code></p>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Valores"
          ],
          "rows": [
            [
              "<code>color</code>",
              "semántico · <code>current</code> · color CSS (ausente = hereda)"
            ],
            [
              "<code>mix</code>",
              "% hacia <code>mix-with</code>"
            ],
            [
              "<code>mix-with</code>",
              "text · transparent · white · black · current · CSS"
            ],
            [
              "<code>lines</code>",
              "entero ≥ 1; ausente o 0 = sin clamp"
            ]
          ]
        }
      ]
    }
  ],
