{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-accordion-group",
  "category": "isp",
  "title": "&lt;iswc-accordion-group&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-accordion-group de InSoft.",
  "storageKey": "docs-iswc-accordion-group",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Coordina varios <code class=\"code\">&lt;iswc-details&gt;</code>: por defecto solo uno",
        "          queda abierto. No reimplementa el disclosure, solo lo orquesta."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-accordion-group id=\"agDemo\">",
            "            <iswc-details summary=\"Datos básicos\" open>Nombre, documento y régimen.</iswc-details>",
            "            <iswc-details summary=\"Contacto\">Teléfono, correo y dirección.</iswc-details>",
            "            <iswc-details summary=\"Contabilidad\">Cuentas por defecto y retenciones.</iswc-details>",
            "          </iswc-accordion-group>",
            "          <p id=\"agLog\">Abiertos: <code class=\"code\">1</code></p>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:multiple",
              "label": "multiple"
            }
          ]
        }
      ]
    },
    {
      "id": "multiple",
      "title": "Varios abiertos",
      "lede": "Con <code class=\"code\">multiple</code> el grupo deja de cerrar los demás.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-accordion-group multiple>",
            "            <iswc-details summary=\"Primero\" open>Contenido uno.</iswc-details>",
            "            <iswc-details summary=\"Segundo\" open>Contenido dos.</iswc-details>",
            "            <iswc-details summary=\"Tercero\">Contenido tres.</iswc-details>",
            "          </iswc-accordion-group>"
          ]
        }
      ]
    },
    {
      "id": "escala",
      "title": "Escala por contexto",
      "lede": "Sin atributo <code class=\"code\">size</code>: todo se mide en <code class=\"code\">em</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"font-size: 1.2em\">",
            "            <iswc-accordion-group>",
            "              <iswc-details summary=\"Grande\" open>Hereda el font-size del contenedor.</iswc-details>",
            "              <iswc-details summary=\"También grande\">Igual.</iswc-details>",
            "            </iswc-accordion-group>",
            "          </div>"
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Coordina varios <code class=\"code\">&lt;iswc-details&gt;</code>: por defecto solo uno",
          "          queda abierto. No reimplementa el disclosure, solo lo orquesta."
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-accordion-group>",
          "  <iswc-details summary=\"Datos básicos\" open>…</iswc-details>",
          "  <iswc-details summary=\"Contacto\">…</iswc-details>",
          "</iswc-accordion-group>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "atributos",
      "eventos",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}