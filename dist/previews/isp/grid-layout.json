{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-grid-layout",
  "category": "isp",
  "title": "&lt;iswc-grid-layout&gt;",
  "titleHtml": false,
  "storageKey": "docs-iswc-grid-layout",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Grid declarativo. Port del <code class=\"code\">GridLayout.svelte</code> de ISP:",
        "          <code class=\"code\">cells</code> acepta un número o una track list CSS cruda."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-grid-layout cells=\"3\" gap=\"0.5rem\" style=\"width:100%\">",
            "            <iswc-card>1</iswc-card><iswc-card>2</iswc-card><iswc-card>3</iswc-card>",
            "            <iswc-card>4</iswc-card><iswc-card>5</iswc-card><iswc-card>6</iswc-card>",
            "          </iswc-grid-layout>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:cells",
              "label": "cells",
              "options": [
                "3",
                "12rem 1fr",
                "2"
              ]
            },
            {
              "control": "select",
              "prop": "attr:gap",
              "label": "gap",
              "options": [
                "0.5rem",
                "0.75rem"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:cells-fit",
              "label": "cells-fit"
            },
            {
              "control": "text",
              "prop": "attr:items",
              "label": "items"
            }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "cells-fit · track list · direction",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Con <code class=\"code\">cells-fit</code> las celdas son <code class=\"code\">max-content</code> en vez de <code class=\"code\">minmax(0, 1fr)</code>.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-grid-layout cells=\"3\" cells-fit gap=\"0.5rem\" justify=\"start\" style=\"width:100%\">",
            "            <iswc-tag>corto</iswc-tag><iswc-tag>un poco más largo</iswc-tag><iswc-tag>x</iswc-tag>",
            "          </iswc-grid-layout>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-grid-layout cells=\"12rem 1fr\" gap=\"0.75rem\" items=\"center\" style=\"width:100%\">",
            "            <iswc-text color=\"neutral\">Etiqueta</iswc-text>",
            "            <iswc-input placeholder=\"valor\"></iswc-input>",
            "            <iswc-text color=\"neutral\">Otra</iswc-text>",
            "            <iswc-input placeholder=\"valor\"></iswc-input>",
            "          </iswc-grid-layout>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-grid-layout direction=\"row\" cells=\"2\" gap=\"0.5rem\" style=\"width:100%\">",
            "            <iswc-card>fila 1 · col 1</iswc-card>",
            "            <iswc-card>fila 2 · col 1</iswc-card>",
            "            <iswc-card>fila 1 · col 2</iswc-card>",
            "            <iswc-card>fila 2 · col 2</iswc-card>",
            "          </iswc-grid-layout>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Valores / default"
          ],
          "rows": [
            [
              "<code>cells</code>",
              "número → <code>repeat(n, minmax(0,1fr))</code> · o track list CSS cruda"
            ],
            [
              "<code>cells-fit</code>",
              "boolean → <code>repeat(n, max-content)</code>"
            ],
            [
              "<code>direction</code>",
              "column (default, alimenta columnas) · row (filas + auto-flow columna)"
            ],
            [
              "<code>gap</code>",
              "valor CSS · default responsive 0.2 / 0.35 / 0.5rem"
            ],
            [
              "<code>justify</code>",
              "start · center · end · stretch · between · around · evenly · …"
            ],
            [
              "<code>items</code>",
              "start · center · end · stretch · baseline · normal"
            ],
            [
              "<code>inline</code>",
              "boolean → <code>display: inline-grid</code>"
            ],
            [
              "<code>cscroll</code>",
              "boolean → <code>overflow: auto</code>"
            ],
            [
              "<code>data-sizew</code> · <code>--lerpw</code>",
              "igual que <code>&lt;iswc-block-layout&gt;</code>"
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Grid declarativo. Port del <code class=\"code\">GridLayout.svelte</code> de ISP:",
          "          <code class=\"code\">cells</code> acepta un número o una track list CSS cruda."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>cells</code>",
            "type": "número → <code>repeat(n, minmax(0,1fr))</code> · o track list CSS cruda"
          },
          {
            "name": "<code>cells-fit</code>",
            "type": "boolean → <code>repeat(n, max-content)</code>"
          },
          {
            "name": "<code>direction</code>",
            "type": "column (default, alimenta columnas) · row (filas + auto-flow columna)"
          },
          {
            "name": "<code>gap</code>",
            "type": "valor CSS · default responsive 0.2 / 0.35 / 0.5rem"
          },
          {
            "name": "<code>justify</code>",
            "type": "start · center · end · stretch · between · around · evenly · …"
          },
          {
            "name": "<code>items</code>",
            "type": "start · center · end · stretch · baseline · normal"
          },
          {
            "name": "<code>inline</code>",
            "type": "boolean → <code>display: inline-grid</code>"
          },
          {
            "name": "<code>cscroll</code>",
            "type": "boolean → <code>overflow: auto</code>"
          },
          {
            "name": "<code>data-sizew</code> · <code>--lerpw</code>",
            "type": "igual que <code>&lt;iswc-block-layout&gt;</code>"
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-grid-layout cells=\"3\" gap=\"0.5rem\" style=\"width:100%\">",
          "            <iswc-card>1</iswc-card><iswc-card>2</iswc-card><iswc-card>3</iswc-card>",
          "            <iswc-card>4</iswc-card><iswc-card>5</iswc-card><iswc-card>6</iswc-card>",
          "          </iswc-grid-layout>",
          "```"
        ]
