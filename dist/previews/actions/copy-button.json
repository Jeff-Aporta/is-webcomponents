{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-copy-button",
  "category": "actions",
  "title": "&lt;iswc-copy-button&gt;",
  "titleHtml": false,
  "description": "Documentación y demos del componente iswc-copy-button de InSoft.",
  "styles": [
    ".cluster { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }",
    "    .stack { display: flex; flex-direction: column; gap: 0.75rem; }",
    "    /* Hueco generoso: los tooltips de los 12 placements se despliegan sin taparse */",
    "    .placement-cell {",
    "      display: inline-flex;",
    "      flex-direction: column;",
    "      align-items: center;",
    "      gap: 0.45rem;",
    "    }",
    "    /* El nombre visible evita la \"pared de botones grises\": sin el, las 12",
    "      celdas son identicas y hay que pasar el raton para saber cual es cual. */",
    "    .placement-cell__name {",
    "      font-family: var(--iswc-mono, ui-monospace, Consolas, monospace);",
    "      font-size: 0.68rem;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "",
    "    .placements {",
    "      display: grid;",
    "      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));",
    "      gap: 2.5rem 1rem;",
    "      justify-items: center;",
    "      padding: 2rem 1rem;",
    "    }",
    "    /* El demo debe dejar claro QUE se copia: valor visible, boton pegado a el",
    "      y un campo donde pegar para comprobar el resultado. */",
    "    .copy-showcase {",
    "      display: grid;",
    "      gap: 1.25rem;",
    "      max-width: 34rem;",
    "    }",
    "    .copy-field__label,",
    "    .copy-proof__label {",
    "      display: block;",
    "      margin-bottom: 0.4rem;",
    "      font-size: 0.72rem;",
    "      font-weight: 700;",
    "      letter-spacing: 0.06em;",
    "      text-transform: uppercase;",
    "      color: var(--iswc-text-soft);",
    "    }",
    "    .copy-field__row {",
    "      display: flex;",
    "      align-items: center;",
    "      gap: 0.5rem;",
    "      padding: 0.45rem 0.5rem 0.45rem 0.85rem;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: 0.5rem;",
    "      background: var(--iswc-code-bg, var(--iswc-bg-elev));",
    "    }",
    "    .copy-field__value {",
    "      flex: 1;",
    "      min-width: 0;",
    "      overflow-x: auto;",
    "      white-space: nowrap;",
    "      font-family: var(--iswc-mono, ui-monospace, Consolas, monospace);",
    "      font-size: 0.85rem;",
    "      color: var(--iswc-code-text, var(--iswc-text));",
    "    }",
    "",
    "    .from-input {",
    "      font: inherit;",
    "      padding: 0.45em 0.7em;",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: 6px;",
    "      background: var(--iswc-bg-elev, transparent);",
    "      color: var(--iswc-text);",
    "      max-width: 280px;",
    "      width: 100%;",
    "    }"
  ],
  "storageKey": "docs-iswc-copy-button",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Copia texto al portapapeles con feedback de éxito/error.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"copy-showcase\">",
            "            <div class=\"copy-field\">",
            "              <span class=\"copy-field__label\">Endpoint de la API</span>",
            "              <div class=\"copy-field__row\">",
            "                <code class=\"copy-field__value\" id=\"cbValue\">https://api.insoft.com.co/v1</code>",
            "                <iswc-copy-button from=\"cbValue\" copy-label=\"Copiar\" success-label=\"¡Copiado!\"></iswc-copy-button>",
            "              </div>",
            "            </div>",
            "",
            "            <div class=\"copy-proof\">",
            "              <label class=\"copy-proof__label\" for=\"cbPaste\">Pega aquí para comprobarlo</label>",
            "              <input id=\"cbPaste\" class=\"from-input\" type=\"text\" placeholder=\"Ctrl+V / Cmd+V\">",
            "            </div>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:from",
              "label": "from",
              "options": [
                "cbValue",
                "my-phone",
                "my-input.value",
                "my-link[href]"
              ]
            },
            {
              "control": "select",
              "prop": "attr:copy-label",
              "label": "copy-label",
              "options": [
                "Copiar",
                "Clic para copiar",
                "250ms",
                "3s",
                "full",
                "copy (solo feedback)",
                "none",
                "top",
                "top-start",
                "top-end",
                "right",
                "right-start",
                "right-end",
                "bottom",
                "bottom-start",
                "bottom-end",
                "left",
                "left-start",
                "left-end"
              ]
            },
            {
              "control": "select",
              "prop": "attr:success-label",
              "label": "success-label",
              "options": [
                "¡Copiado!",
                "¡Listo!"
              ]
            },
            {
              "control": "select",
              "prop": "attr:value",
              "label": "value",
              "options": [
                "Labels custom",
                "Iconos custom",
                "Desde un botón custom",
                "No se puede copiar",
                "Rápido",
                "Lento",
                "full",
                "copy",
                "none",
                "top",
                "top-start",
                "top-end",
                "right",
                "right-start",
                "right-end",
                "bottom",
                "bottom-start",
                "bottom-end",
                "left",
                "left-start",
                "left-end",
                "hola-iswc-copy"
              ]
            },
            {
              "control": "text",
              "prop": "attr:error-label",
              "label": "error-label"
            },
            {
              "control": "boolean",
              "prop": "attr:disabled",
              "label": "disabled"
            },
            {
              "control": "number",
              "prop": "attr:feedback-duration",
              "label": "feedback-duration",
              "min": 0,
              "max": 3000,
              "step": 1
            },
            {
              "control": "select",
              "prop": "attr:tooltip",
              "label": "tooltip",
              "options": [
                "full",
                "copy",
                "none"
              ]
            },
            {
              "control": "select",
              "prop": "attr:tooltip-placement",
              "label": "tooltip-placement",
              "options": [
                "top",
                "top-start",
                "top-end",
                "right",
                "right-start",
                "right-end",
                "bottom",
                "bottom-start",
                "bottom-end",
                "left",
                "left-start",
                "left-end"
              ]
            }
          ],
          "equivNote": "from gana sobre value. Sin fuente válida emite iswc-error.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-copy-button: fuente\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"tiene from?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"resolver #id / .value\",",
            "          \"shape\": \"round\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"tiene value?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"copiar literal\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"e\",",
            "          \"label\": \"iswc-error\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"no\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"e\",",
            "          \"label\": \"no\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        },
        {
          "kind": "callout",
          "html": [
            "<strong>Requiere contexto seguro.</strong>",
            "          <code class=\"code\">clipboard.writeText()</code> necesita HTTPS o localhost."
          ]
        }
      ]
    },
    {
      "id": "from",
      "title": "Copiar desde otros elementos",
      "lede": [
        "Usa <code class=\"code\">from</code> para apuntar a un <code class=\"code\">id</code>.",
        "          Si hay <code class=\"code\">value</code> y <code class=\"code\">from</code>, gana <code class=\"code\">from</code>."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"cluster\">",
            "            <span id=\"my-phone\">+57 300 123 4567</span>",
            "            <iswc-copy-button from=\"my-phone\"></iswc-copy-button>",
            "          </div>",
            "          <div class=\"cluster\">",
            "            <input id=\"my-input\" class=\"from-input\" type=\"text\" value=\"Texto del usuario\" />",
            "            <iswc-copy-button from=\"my-input.value\"></iswc-copy-button>",
            "          </div>",
            "          <div class=\"cluster\">",
            "            <a id=\"my-link\" href=\"https://insoft.com.co\">Sitio InSoft</a>",
            "            <iswc-copy-button from=\"my-link[href]\"></iswc-copy-button>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "labels",
      "title": "Labels custom",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-copy-button",
            "            value=\"Labels custom\"",
            "            copy-label=\"Clic para copiar\"",
            "            success-label=\"¡Listo!\"",
            "            error-label=\"Tu navegador no lo soporta\"",
            "          ></iswc-copy-button>"
          ]
        }
      ]
    },
    {
      "id": "icons",
      "title": "Iconos custom",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-copy-button value=\"Iconos custom\">",
            "            <iswc-icon slot=\"copy-icon\" icon=\"mdi:clipboard-outline\"></iswc-icon>",
            "            <iswc-icon slot=\"success-icon\" icon=\"mdi:thumb-up\"></iswc-icon>",
            "            <iswc-icon slot=\"error-icon\" icon=\"mdi:close-circle\"></iswc-icon>",
            "          </iswc-copy-button>"
          ]
        }
      ]
    },
    {
      "id": "trigger",
      "title": "Trigger custom",
      "lede": "Slot default: mete un <code class=\"code\">iswc-button</code> u otro control.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-copy-button value=\"Desde un botón custom\">",
            "            <iswc-button variant=\"outlined\" style=\"font-size:.8125rem\">",
            "              <iswc-icon slot=\"start\" icon=\"mdi:content-copy\"></iswc-icon>",
            "              Copiar al portapapeles",
            "            </iswc-button>",
            "          </iswc-copy-button>"
          ]
        }
      ]
    },
    {
      "id": "disabled",
      "title": "Disabled",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-copy-button value=\"No se puede copiar\" disabled></iswc-copy-button>"
        }
      ]
    },
    {
      "id": "errors",
      "title": "Manejo de errores",
      "lede": "Sin <code class=\"code\">value</code> ni <code class=\"code\">from</code> válido → <code class=\"code\">iswc-error</code>.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-copy-button id=\"errBtn\"></iswc-copy-button>",
            "          <span class=\"card-meta\" id=\"errLog\">Haz clic para forzar error.</span>"
          ]
        }
      ]
    },
    {
      "id": "duration",
      "title": "Feedback duration",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-copy-button value=\"Rápido\" feedback-duration=\"250\" copy-label=\"250ms\"></iswc-copy-button>",
            "          <iswc-copy-button value=\"Lento\" feedback-duration=\"3000\" copy-label=\"3s\"></iswc-copy-button>"
          ]
        }
      ]
    },
    {
      "id": "tooltip-mode",
      "title": "Tooltip mode",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-copy-button value=\"full\" tooltip=\"full\" copy-label=\"full\"></iswc-copy-button>",
            "          <iswc-copy-button value=\"copy\" tooltip=\"copy\" copy-label=\"copy (solo feedback)\"></iswc-copy-button>",
            "          <iswc-copy-button value=\"none\" tooltip=\"none\" copy-label=\"none\"></iswc-copy-button>"
          ]
        }
      ]
    },
    {
      "id": "placement",
      "title": "Tooltip placement",
      "lede": [
        "El tooltip es un <code class=\"code\">iswc-tooltip</code> interno, así que acepta los",
        "          doce placements de <code class=\"code\">iswc-popover</code> y hace flip solo si no cabe",
        "          en la dirección pedida."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"placements\">",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"top\" tooltip-placement=\"top\" copy-label=\"top\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">top</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"top-start\" tooltip-placement=\"top-start\" copy-label=\"top-start\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">top-start</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"top-end\" tooltip-placement=\"top-end\" copy-label=\"top-end\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">top-end</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"right\" tooltip-placement=\"right\" copy-label=\"right\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">right</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"right-start\" tooltip-placement=\"right-start\" copy-label=\"right-start\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">right-start</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"right-end\" tooltip-placement=\"right-end\" copy-label=\"right-end\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">right-end</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"bottom\" tooltip-placement=\"bottom\" copy-label=\"bottom\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">bottom</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"bottom-start\" tooltip-placement=\"bottom-start\" copy-label=\"bottom-start\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">bottom-start</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"bottom-end\" tooltip-placement=\"bottom-end\" copy-label=\"bottom-end\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">bottom-end</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"left\" tooltip-placement=\"left\" copy-label=\"left\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">left</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"left-start\" tooltip-placement=\"left-start\" copy-label=\"left-start\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">left-start</small>",
            "            </span>",
            "            <span class=\"placement-cell\">",
            "              <iswc-copy-button value=\"left-end\" tooltip-placement=\"left-end\" copy-label=\"left-end\"></iswc-copy-button>",
            "              <small class=\"placement-cell__name\">left-end</small>",
            "            </span>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API live",
      "blocks": [
        {
          "kind": "demo",
          "html": "<iswc-copy-button id=\"apiCopy\" value=\"hola-iswc-copy\"></iswc-copy-button>"
        },
        {
          "kind": "html",
          "html": "<div class=\"log\" id=\"apiLog\"><div class=\"row\"><span class=\"hint\">Eventos iswc-copy / iswc-error aparecerán aquí.</span></div></div>"
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "table",
          "columns": [
