{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-speed-dial",
  "category": "actions",
  "title": "&lt;iswc-speed-dial&gt;",
  "titleHtml": false,
  "styles": [
    ".stage {",
    "      position: relative;",
    "      min-height: 16rem;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      display: grid;",
    "      place-items: end center;",
    "      padding: 1rem;",
    "    }",
    "    .col { display: flex; flex-direction: column; gap: .85rem; padding: .5rem; }",
    "    .col > h4 { margin: 0; font-size: .85rem; }",
    "    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }",
    "    pre.log {",
    "      font-family: ui-monospace, monospace; font-size: .8rem;",
    "      background: var(--iswc-bg-elev); border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius); padding: .55rem .75rem;",
    "      max-height: 9rem; overflow: auto;",
    "    }",
    "    /* Lienzos del demo radial: `transform` crea el containing block para que",
    "       el abanico se calcule (y se acote) contra ESTA caja, no el viewport. */",
    "    .radial-stage {",
    "      position: relative;",
    "      transform: translateZ(0);",
    "      display: grid;",
    "      place-items: center;",
    "      height: 340px;",
    "      border: 1px dashed var(--iswc-border);",
    "      border-radius: 0.6rem;",
    "      background: var(--iswc-bg);",
    "    }",
    "    .radial-stage--tall { height: 440px; }",
    "    .radial-stage--corner { place-items: end start; padding: 1rem; }"
  ],
  "storageKey": "docs-iswc-speed-dial",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "FAB que al clic despliega un puñado de acciones rápidas. Apunta arriba por defecto; cambiá la dirección con el atributo <code class=\"code\">direction</code>.",
      "blocks": []
    },
    {
      "id": "up",
      "title": "Dirección: arriba",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"stage\">",
            "            <iswc-speed-dial id=\"dial1\">",
            "              <iswc-speed-dial-action icon=\"mdi:content-copy\" label=\"Copiar\">Copiar</iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:share-variant\" label=\"Compartir\">Compartir</iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:download\" label=\"Descargar\">Descargar</iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:pencil\" label=\"Editar\">Editar</iswc-speed-dial-action>",
            "            </iswc-speed-dial>",
            "          </div>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Copiar",
                "Compartir",
                "Descargar",
                "Editar",
                "Ajustes",
                "Tema",
                "Idioma",
                "Más",
                "Copiar enlace",
                "Crear",
                "Documento",
                "Imagen",
                "Enlace",
                "Evento",
                "Contacto",
                "Etiqueta",
                "Avisos",
                "Privacidad",
                "Todo",
                "Reporte",
                "Correo",
                "Ubicación",
                "Audio",
                "Video",
                "Código",
                "Carpeta",
                "Favorito"
              ]
            },
            {
              "control": "select",
              "prop": "attr:direction",
              "label": "direction",
              "options": [
                "left",
                "right",
                "radial"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:open",
              "label": "open"
            },
            {
              "control": "select",
              "prop": "attr:data-wrapper",
              "label": "data-wrapper",
              "options": [
                ".radial-stage",
                ".radial-stage--tall",
                ".radial-stage--corner"
              ]
            },
            {
              "control": "number",
              "prop": "attr:data-arc",
              "label": "data-arc",
              "min": 0,
              "max": 180,
              "step": 1
            },
            {
              "control": "number",
              "prop": "attr:data-start-angle",
              "label": "data-start-angle",
              "min": -90,
              "max": 100,
              "step": 1
            },
            {
              "control": "text",
              "prop": "attr:data-sweep",
              "label": "data-sweep"
            }
          ],
          "equivNote": "direction lineal vs radial cambia el layout de acciones.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-speed-dial: layout\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"direction=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"radial → grid/flex\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"up/down/left/right\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"radial\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"lineal\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "dirs",
      "title": "Otras direcciones",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"row-2\">",
            "            <div class=\"stage\" style=\"align-items:start\">",
            "              <iswc-speed-dial direction=\"left\" icon=\"mdi:cog\" label=\"Ajustes\">",
            "                <iswc-speed-dial-action icon=\"mdi:brush\" label=\"Tema\">Tema</iswc-speed-dial-action>",
            "                <iswc-speed-dial-action icon=\"mdi:translate\" label=\"Idioma\">Idioma</iswc-speed-dial-action>",
            "              </iswc-speed-dial>",
            "            </div>",
            "            <div class=\"stage\" style=\"align-items:start\">",
            "              <iswc-speed-dial direction=\"right\" icon=\"mdi:dots-vertical\" label=\"Más\">",
            "                <iswc-speed-dial-action icon=\"mdi:share-variant\" label=\"Compartir\">Compartir</iswc-speed-dial-action>",
            "                <iswc-speed-dial-action icon=\"mdi:link-variant\" label=\"Copiar enlace\">Copiar enlace</iswc-speed-dial-action>",
            "              </iswc-speed-dial>",
            "            </div>",
            "          </div>"
          ]
        }
      ]
    },
    {
      "id": "radial",
      "title": "Radial",
      "lede": [
        "<code class=\"code\">direction=\"radial\"</code> reparte las acciones en un abanico",
        "          alrededor del trigger. El ángulo inicial y la amplitud del arco se calculan",
        "          según el espacio libre dentro del contenedor, y cuando el arco no alcanza para",
        "          todas las acciones se abren <strong>anillos concéntricos</strong> con los",
        "          elementos desfasados medio paso (distribución en panal)."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"radial-stage\">",
            "            <iswc-speed-dial direction=\"radial\" icon=\"mdi:plus\" label=\"Crear\" open",
            "                           data-wrapper=\".radial-stage\">",
            "              <iswc-speed-dial-action icon=\"mdi:file-document\" label=\"Documento\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:image\" label=\"Imagen\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:link\" label=\"Enlace\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:calendar\" label=\"Evento\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:account\" label=\"Contacto\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:tag\" label=\"Etiqueta\"></iswc-speed-dial-action>",
            "            </iswc-speed-dial>",
            "          </div>"
          ],
          "heading": "360° completo, sentido horario"
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"radial-stage\">",
            "            <iswc-speed-dial direction=\"radial\" icon=\"mdi:cog\" label=\"Ajustes\" open",
            "                           data-arc=\"180\" data-start-angle=\"-90\" data-sweep=\"counter-clockwise\"",
            "                           data-wrapper=\".radial-stage\">",
            "              <iswc-speed-dial-action icon=\"mdi:brush\" label=\"Tema\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:translate\" label=\"Idioma\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:bell\" label=\"Avisos\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:shield\" label=\"Privacidad\"></iswc-speed-dial-action>",
            "            </iswc-speed-dial>",
            "          </div>"
          ],
          "heading": "Arco de 180° antihorario con ángulo inicial fijo"
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"radial-stage radial-stage--tall\">",
            "            <iswc-speed-dial direction=\"radial\" icon=\"mdi:apps\" label=\"Todo\" open",
            "                           data-wrapper=\".radial-stage--tall\">",
            "              <iswc-speed-dial-action icon=\"mdi:file-document\" label=\"Documento\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:image\" label=\"Imagen\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:link\" label=\"Enlace\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:calendar\" label=\"Evento\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:account\" label=\"Contacto\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:tag\" label=\"Etiqueta\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:chart-bar\" label=\"Reporte\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:email\" label=\"Correo\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:map-marker\" label=\"Ubicación\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:music\" label=\"Audio\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:video\" label=\"Video\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:code-tags\" label=\"Código\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:folder\" label=\"Carpeta\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:star\" label=\"Favorito\"></iswc-speed-dial-action>",
            "            </iswc-speed-dial>",
            "          </div>"
          ],
          "heading": "Panal: 14 acciones no caben en un anillo"
        },
        {
          "kind": "html",
          "html": [
            "<p class=\"lede\">",
            "          Pega el dial contra una esquina y el abanico se recorta y se gira solo hacia",
            "          donde hay sitio:",
            "        </p>"
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"radial-stage radial-stage--corner\">",
            "            <iswc-speed-dial direction=\"radial\" icon=\"mdi:plus\" label=\"Crear\" open",
            "                           data-wrapper=\".radial-stage--corner\">",
            "              <iswc-speed-dial-action icon=\"mdi:file-document\" label=\"Documento\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:image\" label=\"Imagen\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:link\" label=\"Enlace\"></iswc-speed-dial-action>",
            "              <iswc-speed-dial-action icon=\"mdi:calendar\" label=\"Evento\"></iswc-speed-dial-action>",
            "            </iswc-speed-dial>",
            "          </div>"
          ],
          "heading": "Contra la esquina: arco y ángulo automáticos"
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const dial = document.querySelector('iswc-speed-dial');",
            "dial.open();         // abre",
            "dial.close();        // cierra",
            "dial.toggle();       // alterna",
            "dial.isOpen;         // boolean",
            "dial.addEventListener('iswc-select', e => console.log(e.detail.action.getAttribute('label')));",
            "dial.addEventListener('iswc-toggle', e => console.log('open=', e.detail.open));",
            "",
            "// Acciones: cada <iswc-speed-dial-action> emite iswc-select en el padre.",
            "// Si tiene href, no se cierra el dial al elegir.",
            "<iswc-speed-dial-action icon=\"…\" label=\"…\" color=\"brand|neutral|success|warning|danger\" href=\"…\">Texto</iswc-speed-dial-action>"
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora de eventos",
      "lede": [
        "Cada interacción con los diales de arriba aparece aquí. Sirve para ver",
        "          qué evento emite el componente y con qué detalle."
      ],
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Hora",
            "Dial",
            "Evento",
            "Detalle"
          ],
          "rows": [
            [
              "Abre un dial o elige una acción para ver los eventos."
            ]
          ]
        }
      ]
    }
