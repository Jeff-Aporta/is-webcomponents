{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-context-menu",
  "category": "actions",
  "title": "&lt;iswc-context-menu&gt;",
  "titleHtml": false,
  "styles": [
    ".canvas {",
    "      position: relative;",
    "      min-height: 14rem;",
    "      border: 2px dashed var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      background:",
    "        repeating-linear-gradient(45deg,",
    "          color-mix(in srgb, var(--iswc-bg-elev) 60%, transparent) 0 8px,",
    "          transparent 8px 16px);",
    "      display: grid; place-items: center;",
    "      color: var(--iswc-text-soft);",
    "      font-size: .85rem;",
    "      cursor: context-menu;",
    "    }",
    "    .log {",
    "      font-family: ui-monospace, monospace;",
    "      font-size: .8rem;",
    "      background: var(--iswc-bg-elev);",
    "      border: 1px solid var(--iswc-border);",
    "      border-radius: var(--iswc-radius);",
    "      padding: .55rem .75rem;",
    "      margin-top: .85rem;",
    "      max-height: 9rem;",
    "      overflow: auto;",
    "    }"
  ],
  "storageKey": "docs-iswc-context-menu",
  "hasBehavior": true,
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": "Menú anclado al <strong>clic derecho</strong> sobre un elemento. Compatible con cualquier árbol DOM: target por selector. Tres áreas del lienzo más abajo muestran contextos típicos (archivo, fila de lista, lienzo con scroll-lock).",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:.85rem;min-height:11rem\">",
            "            <div class=\"canvas\" id=\"cm-intro-1\" data-label=\"Archivo\">",
            "              <span>📄 reporte-mensual.xlsx</span>",
            "              <small style=\"opacity:.6;font-size:.75em\">Clic derecho aquí</small>",
            "            </div>",
            "            <ul style=\"list-style:none;padding:0;margin:0;border:2px dashed var(--iswc-border);border-radius:var(--iswc-radius);background:repeating-linear-gradient(45deg,color-mix(in srgb,var(--iswc-bg-elev) 60%,transparent) 0 8px,transparent 8px 16px);min-height:11rem\" id=\"cm-intro-2\">",
            "              <li class=\"row\" data-id=\"r1\" style=\"padding:.6rem .75rem;border-bottom:1px solid var(--iswc-border)\">Reporte mensual</li>",
            "              <li class=\"row\" data-id=\"r2\" style=\"padding:.6rem .75rem;border-bottom:1px solid var(--iswc-border)\">Inventario</li>",
            "              <li class=\"row\" data-id=\"r3\" style=\"padding:.6rem .75rem\">Cartera vencida</li>",
            "            </ul>",
            "            <div class=\"canvas\" id=\"cm-intro-3\" data-label=\"Scroll-lock\">",
            "              <span>🔒 Acción importante</span>",
            "              <small style=\"opacity:.6;font-size:.75em\">Bloquea scroll al abrir</small>",
            "            </div>",
            "          </div>",
            "          <iswc-context-menu for=\"#cm-intro-1\">",
            "            <button class=\"item\" data-value=\"open\">Abrir</button>",
            "            <button class=\"item\" data-value=\"download\">Descargar</button>",
            "            <hr />",
            "            <button class=\"item\" data-value=\"rename\">Renombrar…</button>",
            "            <button class=\"item\" data-value=\"delete\">Eliminar</button>",
            "          </iswc-context-menu>",
            "          <iswc-context-menu for=\".row\">",
            "            <button class=\"item\" data-value=\"view\">Ver detalle</button>",
            "            <button class=\"item\" data-value=\"archive\">Archivar</button>",
            "            <hr />",
            "            <button class=\"item\" data-value=\"delete\">Eliminar</button>",
            "          </iswc-context-menu>",
            "          <iswc-context-menu for=\"#cm-intro-3\" scroll-lock>",
            "            <button class=\"item\" data-value=\"confirm\">Confirmar acción</button>",
            "            <button class=\"item\" data-value=\"cancel\">Cancelar</button>",
            "          </iswc-context-menu>"
          ]
        }
      ]
    },
    {
      "id": "basico",
      "title": "Básico",
      "lede": "Por defecto el menú <strong>se cierra al hacer scroll</strong> (no persigue el viewport). Con <code class=\"code\">scroll-lock</code> bloquea el scroll del documento mientras está abierto.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"canvas\" id=\"canvas1\">Clic derecho aquí →</div>",
            "          <iswc-context-menu for=\"#canvas1\">",
            "            <button class=\"item\" data-value=\"open\">Abrir</button>",
            "            <button class=\"item\" data-value=\"open-tab\">Abrir en pestaña nueva</button>",
            "            <button class=\"item\" data-value=\"duplicate\">Duplicar</button>",
            "            <hr />",
            "            <button class=\"item\" data-value=\"rename\">Renombrar…</button>",
            "            <button class=\"item\" data-value=\"properties\">Propiedades</button>",
            "            <hr />",
            "            <button class=\"item\" data-value=\"delete\" disabled>Eliminar</button>",
            "          </iswc-context-menu>"
          ],
          "controls": [
            {
              "control": "boolean",
              "prop": "attr:scroll-lock",
              "label": "scroll-lock"
            }
          ],
          "equivNote": "Por defecto el scroll cierra el menú; scroll-lock lo evita.",
          "equivHtml": "<!-- ver diagrama de ramas -->",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-context-menu: scroll\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"scroll-lock?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"congela documento\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"scroll → cierra\",",
            "          \"shape\": \"stadium\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"si\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"no\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "scroll-lock",
      "title": "scroll-lock",
      "lede": "Menú importante: el atributo <code class=\"code\">scroll-lock</code> congela el documento hasta cerrar (Escape, clic fuera o elegir ítem).",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"canvas\" id=\"canvas-lock\">Clic derecho (scroll bloqueado) →</div>",
            "          <iswc-context-menu for=\"#canvas-lock\" scroll-lock>",
            "            <button class=\"item\" data-value=\"confirm\">Confirmar acción</button>",
            "            <button class=\"item\" data-value=\"cancel\">Cancelar</button>",
            "          </iswc-context-menu>"
          ]
        }
      ]
    },
    {
      "id": "lista",
      "title": "Sobre varios ítems",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Aplica el mismo context-menu a cada fila del listado. El menú sabe qué fila disparó.</p>"
        },
        {
          "kind": "demo",
          "html": [
            "<ul style=\"list-style:none; padding:0; margin:0;\">",
            "            <li class=\"row\" data-id=\"row-1\" style=\"padding:.55rem .65rem; border-bottom:1px solid var(--iswc-border); display:flex; justify-content:space-between\"><span>Reporte mensual</span><small>2026-07</small></li>",
            "            <li class=\"row\" data-id=\"row-2\" style=\"padding:.55rem .65rem; border-bottom:1px solid var(--iswc-border); display:flex; justify-content:space-between\"><span>Inventario</span><small>2026-07</small></li>",
            "            <li class=\"row\" data-id=\"row-3\" style=\"padding:.55rem .65rem; display:flex; justify-content:space-between\"><span>Cartera vencida</span><small>2026-07</small></li>",
            "          </ul>",
            "          <iswc-context-menu for=\".row\">",
            "            <button class=\"item\" data-value=\"open\">Ver</button>",
            "            <button class=\"item\" data-value=\"download\">Descargar</button>",
            "            <hr />",
            "            <button class=\"item\" data-value=\"archive\">Archivar</button>",
            "            <button class=\"item\" data-value=\"delete\">Eliminar</button>",
            "          </iswc-context-menu>"
          ]
        }
      ]
    },
    {
      "id": "api",
      "title": "API",
      "blocks": [
        {
          "kind": "code",
          "code": [
            "const menu = document.querySelector('iswc-context-menu');",
            "menu.openAt(x, y);",
            "menu.close();",
            "menu.isOpen;",
            "menu.scrollLock = true; // opcional: bloquear scroll en vez de cerrar",
            "",
            "menu.addEventListener('iswc-select', e => {",
            "  console.log('elegido:', e.detail.value);",
            "});",
            "",
            "// Default: cierra al scroll. Importante: scroll-lock.",
            "<iswc-context-menu for=\"#canvas\">…</iswc-context-menu>",
            "<iswc-context-menu for=\"#canvas\" scroll-lock>…</iswc-context-menu>"
          ]
        }
      ]
    },
    {
      "id": "log",
      "title": "Bitácora de selección",
      "blocks": [
        {
          "kind": "html",
          "html": "<pre class=\"log\" id=\"log\"></pre>"
        }
      ]
    }
  ],
  "ficha": {
