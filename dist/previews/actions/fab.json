{
  "$schema": "iswc-preview/v1",
  "tag": "iswc-fab",
  "category": "actions",
  "title": "&lt;iswc-fab&gt;",
  "titleHtml": false,
  "description": "Documentación y demos de iswc-fab (Floating Action Button) de InSoft.",
  "styles": [
    ".fab-stage {",
    "      /* `position: relative` NO contiene hijos `position: fixed` — solo lo",
    "         hacen transform/filter/contain/perspective. Sin esto el FAB del",
    "         ejemplo se ancla al viewport y se sale de la caja del demo. */",
    "      position: relative;",
    "      transform: translateZ(0);",
    "      height: 360px;",
    "      border: 1px dashed var(--iswc-border, #2a2f3a);",
    "      border-radius: 0.5rem;",
    "      background: var(--iswc-bg, #0f1117);",
    "      overflow: hidden;",
    "    }",
    "    /* Los demos se organizan con flex: alineados por linea base, con hueco",
    "       uniforme y envolviendo en pantallas estrechas. */",
    "    .fab-row {",
    "      display: flex;",
    "      flex-wrap: wrap;",
    "      align-items: flex-end;",
    "      gap: 1.5rem;",
    "    }",
    "    .fab-row__item {",
    "      display: inline-flex;",
    "      flex-direction: column;",
    "      align-items: center;",
    "      gap: 0.5rem;",
    "    }"
  ],
  "storageKey": "docs-iswc-fab",
  "sections": [
    {
      "id": "intro",
      "title": "Uso",
      "lede": [
        "Floating Action Button: botón circular principal que se posiciona de",
        "          forma fija en la ventana. Soporta variantes, tamaños, etiquetas",
        "          extendidas, pulso de atención y posicionamiento en cualquier esquina."
      ],
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"fab-stage\">",
            "            <iswc-fab id=\"fb1\" icon=\"mdi:plus\" position=\"bottom-end\" label=\"Crear\"></iswc-fab>",
            "          </div>",
            "          <p>Click: <span id=\"fbLog\">0</span></p>"
          ],
          "controls": [
            {
              "control": "select",
              "prop": "attr:position",
              "label": "position",
              "options": [
                "bottom-end",
                "bottom-start",
                "top-end",
                "top-start",
                "inline"
              ]
            },
            {
              "control": "select",
              "prop": "attr:label",
              "label": "label",
              "options": [
                "Crear",
                "Notificación",
                "brand",
                "neutral",
                "danger",
                "success",
                "warning",
                "Nuevo proyecto",
                "Compartir",
                "Descargar",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end",
                "Notificaciones",
                "Mensajes"
              ]
            },
            {
              "control": "select",
              "prop": "attr:color",
              "label": "color",
              "options": [
                "brand",
                "neutral",
                "success",
                "warning",
                "danger"
              ]
            },
            {
              "control": "boolean",
              "prop": "attr:extended",
              "label": "extended"
            },
            {
              "control": "boolean",
              "prop": "attr:pulse",
              "label": "pulse"
            }
          ],
          "equivNote": "position fija vs inline; pulse es atención opcional.",
          "equivHtml": "<button type=\"button\" aria-label=\"Crear\">+</button>",
          "equivFlow": [
            "<iswc-flowchart open-on-click animation=\"flow\">",
            "  <script type=\"application/json\">",
            "  {",
            "    \"flowchart\": {",
            "      \"title\": \"iswc-fab: position\",",
            "      \"direction\": \"TB\",",
            "      \"nodes\": [",
            "        {",
            "          \"id\": \"q\",",
            "          \"label\": \"position=?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"a\",",
            "          \"label\": \"inline → en flujo\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"b\",",
            "          \"label\": \"esquina fixed\",",
            "          \"shape\": \"stadium\"",
            "        },",
            "        {",
            "          \"id\": \"c\",",
            "          \"label\": \"pulse?\",",
            "          \"shape\": \"diamond\"",
            "        },",
            "        {",
            "          \"id\": \"d\",",
            "          \"label\": \"anillo de atención\",",
            "          \"shape\": \"round\"",
            "        }",
            "      ],",
            "      \"edges\": [",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"a\",",
            "          \"label\": \"inline\"",
            "        },",
            "        {",
            "          \"from\": \"q\",",
            "          \"to\": \"b\",",
            "          \"label\": \"corner\"",
            "        },",
            "        {",
            "          \"from\": \"a\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"b\",",
            "          \"to\": \"c\"",
            "        },",
            "        {",
            "          \"from\": \"c\",",
            "          \"to\": \"d\",",
            "          \"label\": \"si\"",
            "        }",
            "      ]",
            "    }",
            "  }",
            "  </script>",
            "</iswc-flowchart>"
          ]
        }
      ]
    },
    {
      "id": "sizes",
      "title": "Escala",
      "lede": "Sin atributo size. Se mide en em y hereda el font-size del contexto.",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Key",
            "Value"
          ],
          "rows": [
            [
              "<code>Escalar</code>",
              "Cambia el font-size del ancestro: icono, padding y radio escalan con él."
            ]
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<div class=\"fab-row\">",
            "            <span class=\"fab-row__item\">",
            "              <iswc-fab icon=\"mdi:bell\" style=\"font-size:0.75em\" position=\"inline\" label=\"Notificación\"></iswc-fab>",
            "              <code class=\"code\">0.75em</code>",
            "            </span>",
            "            <span class=\"fab-row__item\">",
            "              <iswc-fab icon=\"mdi:bell\" style=\"font-size:1em\" position=\"inline\" label=\"Notificación\"></iswc-fab>",
            "              <code class=\"code\">1em</code>",
            "            </span>",
            "            <span class=\"fab-row__item\">",
            "              <iswc-fab icon=\"mdi:bell\" style=\"font-size:1.25em\" position=\"inline\" label=\"Notificación\"></iswc-fab>",
            "              <code class=\"code\">1.25em</code>",
            "            </span>",
            "          </div>"
          ],
          "heading": "El mismo FAB con tres font-size",
          "equivHtml": [
            "<!-- font-size del host escala el FAB -->",
            "<button type=\"button\" aria-label=\"Crear\" style=\"font-size:0.85rem\">+</button>",
            "<button type=\"button\" aria-label=\"Crear\" style=\"font-size:1rem\">+</button>",
            "<button type=\"button\" aria-label=\"Crear\" style=\"font-size:1.25rem\">+</button>"
          ]
        }
      ]
    },
    {
      "id": "variants",
      "title": "Color",
      "lede": "color = color semántico (brand, neutral, danger, success, warning).",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Key",
            "Value"
          ],
          "rows": [
            [
              "<code>Ortogonalidad</code>",
              "Distinto de variant, que gobierna la presentación (filled, outlined, plain…)."
            ]
          ]
        },
        {
          "kind": "demo",
          "html": [
            "<iswc-fab icon=\"mdi:plus\" color=\"brand\" position=\"inline\" label=\"brand\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:pencil\" color=\"neutral\" position=\"inline\" label=\"neutral\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:trash-can\" color=\"danger\" position=\"inline\" label=\"danger\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:check\" color=\"success\" position=\"inline\" label=\"success\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:alert\" color=\"warning\" position=\"inline\" label=\"warning\"></iswc-fab>"
          ],
          "equivHtml": [
            "<button type=\"button\" aria-label=\"Crear\">+</button>",
            "<button type=\"button\" aria-label=\"Crear\">+</button><!-- outlined vía CSS propio -->"
          ]
        }
      ]
    },
    {
      "id": "extended",
      "title": "Extendido",
      "lede": "Con <code class=\"code\">extended</code> el FAB tiene label al lado del icono.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-fab icon=\"mdi:plus\" extended label=\"Nuevo proyecto\" position=\"inline\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:share\" color=\"neutral\" extended label=\"Compartir\" position=\"inline\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:download\" color=\"success\" extended label=\"Descargar\" position=\"inline\"></iswc-fab>"
          ],
          "equivNote": "extended = icono + etiqueta visible.",
          "equivHtml": [
            "<button type=\"button\">",
            "  <span aria-hidden=\"true\">+</span>",
            "  Crear",
            "</button>"
          ]
        }
      ]
    },
    {
      "id": "positions",
      "title": "Posiciones",
      "lede": "bottom-end (default), bottom-start, top-end, top-start.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<div class=\"fab-stage\">",
            "            <iswc-fab icon=\"mdi:plus\" position=\"top-start\" label=\"top-start\"></iswc-fab>",
            "            <iswc-fab icon=\"mdi:pencil\" position=\"top-end\" label=\"top-end\"></iswc-fab>",
            "            <iswc-fab icon=\"mdi:share\" position=\"bottom-start\" label=\"bottom-start\"></iswc-fab>",
            "            <iswc-fab icon=\"mdi:check\" color=\"success\" position=\"bottom-end\" label=\"bottom-end\"></iswc-fab>",
            "          </div>"
          ],
          "equivHtml": [
            "<button type=\"button\" aria-label=\"Crear\"",
            "  style=\"position:fixed; inset:auto 1.5rem 1.5rem auto\">+</button>"
          ]
        }
      ]
    },
    {
      "id": "pulse",
      "title": "Pulso",
      "lede": "Con <code class=\"code\">pulse</code> el FAB anima un anillo de atención cada 2s.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-fab icon=\"mdi:bell\" pulse color=\"warning\" position=\"inline\" label=\"Notificaciones\"></iswc-fab>",
            "          <iswc-fab icon=\"mdi:message\" pulse color=\"brand\" position=\"inline\" label=\"Mensajes\"></iswc-fab>"
          ],
          "equivHtml": [
            "<button type=\"button\" aria-label=\"Crear\" class=\"pulse\">+</button>",
            "<!-- .pulse sería CSS propio; el kit usa el atributo pulse -->"
          ]
        }
      ]
    },
    {
      "id": "slots-pg",
      "title": "Slots Playground",
      "lede": "Estandar W11: dos tabs (Simple + Slots). El tab Slots muestra shadow template, codigo editable y un editor por cada slot detectado del componente.",
      "blocks": [
        {
          "kind": "demo",
          "html": [
            "<iswc-slots-pg tag=\"iswc-fab\">",
            "  <iswc-fab color=\"brand\">",
            "    <iswc-icon icon=\"mdi:plus\"></iswc-icon>",
            "    Crear nuevo",
            "  </iswc-fab>",
            "  <iswc-icon slot=\"icon\" icon=\"mdi:plus\"></iswc-icon>",
            "</iswc-slots-pg>"
          ]
        }
      ]
    },
    {
      "id": "reference",
      "title": "Referencia",
      "blocks": [
        {
          "kind": "html",
          "html": "<h3><code class=\"code\">&lt;iswc-fab&gt;</code></h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Atributo",
            "Descripción"
          ],
          "rows": [
            [
              "<code>icon</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Iconify id. (valor por defecto)"
            ],
            [
              "<code>position</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Posición fija. (valor por defecto)"
            ],
            [
              "<code>color</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Color semántico. (valor por defecto)"
            ],
            [
              "<code>extended</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Forma pill con label. (valor por defecto)"
            ],
            [
              "<code>pulse</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Pulso de atención. (valor por defecto)"
            ],
            [
              "<code>label</code>",
              "aria-label."
            ],
            [
              "<code>without-shadow</code> <span class=\"iswc-default-marker\" aria-hidden=\"true\">★</span>",
              "Sin sombra. (valor por defecto)"
            ]
          ]
        },
        {
          "kind": "html",
          "html": "<h3>Eventos</h3>"
        },
        {
          "kind": "table",
          "columns": [
            "Evento",
            "Descripción"
          ],
          "rows": [
            [
              "<code>iswc-fab-click</code>",
              "Click. <code>detail: { originalEvent }</code>."
            ]
          ]
        }
      ]
    }
  ],
  "ficha": {
    "sections": {
      "anatomia": {
        "content": [
          "Floating Action Button: botón circular principal que se posiciona de",
          "          forma fija en la ventana. Soporta variantes, tamaños, etiquetas",
          "          extendidas, pulso de atención y posicionamiento en cualquier esquina."
        ]
      },
      "atributos": {
        "table": [
          {
            "name": "<code>icon</code>",
            "type": "string",
            "default": "mdi:plus",
            "desc": "Iconify id."
          },
          {
            "name": "<code>position</code>",
            "type": "bottom-end | bottom-start | top-end | top-start | inline",
            "default": "bottom-end",
            "desc": "Posición fija."
          },
          {
            "name": "<code>color</code>",
            "type": "brand | neutral | danger | success | warning",
            "default": "brand",
            "desc": "Color semántico."
          },
          {
            "name": "<code>extended</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Forma pill con label."
          },
          {
            "name": "<code>pulse</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Pulso de atención."
          },
          {
            "name": "<code>label</code>",
            "type": "string",
            "default": "—",
            "desc": "aria-label."
          },
          {
            "name": "<code>without-shadow</code>",
            "type": "boolean",
            "default": "false",
            "desc": "Sin sombra."
          }
        ]
      },
      "eventos": {
        "table": [
          {
            "evento": "<code>iswc-fab-click</code>",
            "cuando": "Click. <code>detail: { originalEvent }</code>."
          }
        ]
      },
      "ejemplos": {
        "content": [
          "```html",
          "<iswc-fab icon=\"mdi:plus\" label=\"Crear\"></iswc-fab>",
          "```"
        ]
      }
    },
    "exclude": [
      "apiJs",
      "parts",
      "props",
      "slots",
      "states"
    ]
  }
}
