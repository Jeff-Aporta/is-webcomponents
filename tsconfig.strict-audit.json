{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/**", "dist/**", "**/*.test.ts", "**/*.selfcheck.ts"]
}