{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/manifest.ts"
  ],
  "exclude": [
    "src/components/**",
    "src/previews/**",
    "src/gallery/**",
    "src/core/**",
    "src/cdn/**",
    "src/styles/**",
    "src/consts/**",
    "src/skills/**",
    "src/utils/**",
    "src/assets/**",
    "node_modules/**"
  ]
}
